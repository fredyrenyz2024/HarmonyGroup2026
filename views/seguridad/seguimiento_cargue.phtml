		<script type="text/javascript">
			// Función que muestra detalles del seguimiento
			function mostrarDetalle( id_solicitud, id_agrupamiento, id_actividad_seguimiento ){
				$("#ver_detalle_content").empty();
				$("#ver_detalle_title").empty();

				params={
					accion 						: "detalle_seguimiento_cargue",
					id 							: id_solicitud,
					id_agrupamiento 			: id_agrupamiento,
					id_actividad_seguimiento 	: id_actividad_seguimiento
				}
				// console.log(params);

				$.ajax({
					type		: "POST",
					cache		: false,
					url			: "' . BASE_URL . 'libs/seguridad_ajax.php",
					data		: params,
					dataType	: "json",
					error 		: function(data){
								console.log("Error en el ajax");
								console.log(data);
								},
					success		: function(data) {
								// console.log(data);
								$("#ver_detalle_title").append(data.content.title);
								$("#ver_detalle_content").append(data.content.body.general);
								$("#ver_detalle_content").append(data.content.body.vehiculo);
								$("#ver_detalle_content").append(data.content.body.cliente);
								$("#ver_detalle_content").append(data.content.body.seguimientos);
					}
				});
			}

			// Función para gestionar la actividad de seguimiento
			function gestionarActividad(id_agrupamiento, id_actividades, id_tramo_solicitud, flag_valida_gestion_tramo, id_solicitud){
				// Se limpian los campos del formularios
				if(id_solicitud != $("#id_solicitud").val() ){
					$("#gestionar .form-control").val("");
					$("#fin_cargue").hide();
				}

				$("#id_agrupamiento").val(id_agrupamiento);
				$("#id_solicitud").val(id_solicitud);
				$("#id").val(id_actividades);
				$("#id_tramo_solicitud").val(id_tramo_solicitud);
				$("#flag_valida_gestion_tramo").val(flag_valida_gestion_tramo);
			}

			$("#btn_gestiona_seguimiento").click(function () {
				// console.log("entro en funcion de gestion de actividades");
				$(".nexos-messages").html("");
				var msg_error = "";
				var flag_click = false;
				if(!flag_click){
					flag_click = true;

					// Se toman los datos a validar
					if( !$("#slct_tipo_seguimiento_").val() ){
						msg_error+= "<p>Para continuar debe seleccionar un <strong>Tipo de Seguimiento de Carga</strong>.</p>";
					}else{
						if( $("#slct_tipo_seguimiento_").val() == "Cargue Terminado" ){
							if( !$("#fecha").val() ){
								msg_error+= "<p>Para continuar debe diligenciar el campo <strong>Hora Finalización Cargue</strong>.</p>";
							}
							if( !$("#slct_origen").val() ){
								msg_error+= "<p>Para continuar debe seleccionar un <strong>Tramo Origen</strong>.</p>";
							}
						}
					}
					if( !$("#observacion").val() ){
						msg_error+= "<p>Para continuar debe diligenciar el campo <strong>Observación</strong>.</p>";
					}

					if(!msg_error){
						// console.log($("#form_gestionar").serialize());

						$.ajax({
							url			: "' . BASE_URL . 'libs/gestion_seguridad.php?action=seguimiento_carga&id_usuario=' . $ssn_id_usuario . '",
							type		: "POST",
							cache		: false,
							dataType	: "json",
							data		: $("#form_gestionar").serialize(),
							beforeSend	: function(jqXHR, settings){
								$(".nexos-messages").html(\'<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' . BASE_URL . 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>\');
							},
							error: function (jqXHR, textStatus, errorThrown){
								console.log(jqXHR);
								console.log(textStatus);
								console.log(errorThrown);
								$(".nexos-messages").html(\'<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong><p>\' + jqXHR.responseText + \'</p></div></div>\');
							},
							success		: function(data) {
								// console.log(data);
								if(data.actividades.length > 0){
									var id = "";
									var id_material = "";
									for (var i = 0; i < data.actividades.length; i++) {
										id+= data.actividades[i]["id"]  + ",";
										id_material+= data.actividades[i]["id_material"]  + ",";
									}
									var params = {
										id 					: id,
										id_importacion		: data.actividades[0]["id_importacion"],
										id_material			: id_material,
										orden				: data.actividades[0]["orden"],
										tipo_actividad 		: data.actividades[0]["tipo_actividad"],
										fecha_hora_inicio	: data.actividades[0]["fecha_hora_inicio"],
										costo_real 			: data.actividades[0]["costo_real"],
										respuesta 			: data.actividades[0]["respuesta"]
									};
									// console.log(params);

									$.ajaxSetup({async: false});
									$.ajax({
										type		: "POST",
										cache		: false,
										url			: "' . $url_gestion_actividad . '",
										data		: params,
										beforeSend	: function(jqXHR, settings){
											$(".nexos-messages").html(\'<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' . BASE_URL . 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>\');
										},
										error 		: function (jqXHR, textStatus, errorThrown){
											console.log(jqXHR);
											console.log(textStatus);
											console.log(errorThrown);
										},
										success		: function(data) {
											console.log(data);
										}
									});
									$.ajaxSetup({async: true});
								}else{
									msg_error+= "<p>No se gestionaron las actividades.</p>";
								}
							}
						});
					}
					if(!msg_error){
						$(".nexos-messages").html(\'<div role="alert" class="alert alert-success alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Proceso terminado!</strong><p>Se ha creado el registro con éxito.</p></div></div>\');
						$("html, body").animate({ scrollTop: 0 }, 600);
						setTimeout(function() { location.reload(false); }, 800);
					}
					if(msg_error){
						flag_click = false;
						$(".nexos-messages").html(\'<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-close"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>\' + msg_error + \'</div></div>\');
						$("html, body").animate({ scrollTop: 0 }, 600);
					}
				}
			});

			$("#slct_tipo_seguimiento_").change(function () {
				$("#fin_cargue").fadeOut("fast");
				$("#fecha").val("");
				$("#div_slct_origen").empty();
				if( $("#slct_tipo_seguimiento_").val() == "Cargue Terminado" ){
					params = {
						accion 	: "slct_origen_carga",
						id 		: $("#id_solicitud").val()
					}
					// console.log(params);
					$.ajax({
						type		: "POST",
