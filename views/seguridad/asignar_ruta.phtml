			// Funcion que muestra detalles del seguimiento
			function mostrarDetalle( id_agrupamiento ){
				$("#ver_detalle_content").empty();
				$("#ver_detalle_title").empty();

				params={
					accion 	: "detalle_asignacion_ruta",
					id 		: id_agrupamiento
				}
				// console.log(params);

				$.ajax({
					type		: "POST",
					cache		: false,
					url			: "' . BASE_URL . '/libs/seguridad_ajax.php",
					data		: params,
					dataType	: "json",
					error 		: function(data){
								console.log("Error en el ajax");
								console.log(data);
								},
					success		: function(data) {
								// console.log(data);
								$("#ver_detalle_title").append(data.content.title);
								$("#ver_detalle_content").append(data.content.body.general);
								$("#ver_detalle_content").append(data.content.body.vehiculo);
								$("#ver_detalle_content").append(data.content.body.cliente);
					}
				});
			}

			// Funcion para gestionar la actividad de seguimiento
			function gestionarActividad(id_agrupamiento, id_actividades, id_origen, id_destino){
				var msg_error = "";
				$(".nexos_messages_popup").empty();
				// Se limpian los campos del formularios
				if(id_agrupamiento != $("#id_agrupamiento").val() ){
					$("#gestionar .form-control").val("");
				}

				$("#id_agrupamiento").val(id_agrupamiento);
				$("#id").val(id_actividades);

				$("#gestion_detalle_title").html("");
				$("#ver_gestion_content").html("");

				params={
					accion 		: "gestion_asignacion_ruta",
					id 			: id_agrupamiento,
					id_origen 	: id_origen, 
					id_destino 	: id_destino
				}
				// console.log(params);

				$.ajaxSetup({async: false});
				$.ajax({
					type		: "POST",
					cache		: false,
					url			: "' . BASE_URL . '/libs/seguridad_ajax.php",
					data		: params,
					dataType	: "json",
					error: function (jqXHR, textStatus, errorThrown){
						$(".nexos-messages").html("");
						msg_error+= "<p>" + jqXHR.responseText + "</p>";
						console.log(jqXHR);
						console.log(textStatus);
						console.log(errorThrown);
					},
					success		: function(data) {
						// console.log(data);
						$("#gestion_detalle_title").append(data.content.title);
						$("#id").val(data.actividades);
						$("#ver_gestion_content").append(data.content.body.general);
						$("#ver_gestion_content").append(data.content.body.vehiculo);
						$("#ver_gestion_content").append(data.content.body.tramos);
						$("#ver_gestion_content").append(data.content.body.slct_planes_ruta);
					}
				});
				$.ajaxSetup({async: true});
				if (msg_error) {
					$(".nexos_messages_popup").html(\'<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>\' + msg_error + \'</div></div>\');
					$("#gestionar").animate({ scrollTop: 0 }, 600);
				}
			}

