			/******* FUNCIONES DEL API DE GOOGLE MAPS *******/
			var markers = [];
			var status_ruta = false;
			function initMap(params) {

				var flag_plan_ruta = false;
				if(!params){
					var latitud_inicial = 4.7097100;
					var longitud_inicial = -74.0677500;
				}else{
					var latitud_inicial = params["latitud"];
					var longitud_inicial = params["longitud"];

					if(params["ruta"]){
						flag_plan_ruta = true;
					}
				}

				var code = {lat: latitud_inicial, lng: longitud_inicial};
				mapa = new google.maps.Map(document.getElementById(\'mapa_ruta\'), {
					zoom: 7,
					center: code
				});

				// Se crea el marcardor del punto del último seguimeinto   
				markers[0] = new google.maps.Marker({
					map: mapa,
					position: code
				});

				var trafficLayer = new google.maps.TrafficLayer();
				trafficLayer.setMap(mapa);
				var directionsService = new google.maps.DirectionsService;
				var directionsDisplay = new google.maps.DirectionsRenderer;

				//add map
				directionsDisplay.setMap(mapa);

				if( flag_plan_ruta ){
					// Se debe crear aqui la ruta del plan de ruta 
					var markers_plan_ruta = [];

					for (var i = 0; i < params["ruta"].length; i++) {
						var LatLng = params["ruta"][i]["latitud"] + "," + params["ruta"][i]["longitud"];
						markers_plan_ruta.push({
							location: LatLng,
							stopover: true
						});
					}

					if(params["origen"][0]["latitud"] && params["origen"][0]["longitud"]){
						var ubicacion_origen = params["origen"][0]["latitud"] + ","+ params["origen"][0]["longitud"];
						var ubicacion_destino = params["destino"][0]["latitud"] + ","+ params["destino"][0]["longitud"];

						directionsService.route({
							origin: ubicacion_origen,
							destination: ubicacion_destino,
							waypoints: markers_plan_ruta,
							optimizeWaypoints: true,
							travelMode: "DRIVING"
						}, function (response, status) {
							if (status === google.maps.DirectionsStatus.OK) {
								directionsDisplay.setDirections(response);
							} else {
								window.alert(\'Ha fallado la comunicación en el mapa a causa de: \' + status);
							}
						});
					}
				}

				mapa.addListener(\'click\', function (event) {
					$("#latitud").val("Cargando...");
					$("#longitud").val("Cargando...");
					$("#ubicacion").val("Cargando Ubicación...");

					deleteMarkers();
					var point = new google.maps.LatLng(
						event.latLng.lat(),
						event.latLng.lng()
					);

					markers[1] = new google.maps.Marker({
						map: mapa,
						position: point
					});

					var latitud = event.latLng.lat();
					var longitud = event.latLng.lng();

					// Se busca en nombre de la posición se leccionada
					var geocoder = new google.maps.Geocoder;
					var latlng = {
						lat: parseFloat(latitud),
						lng: parseFloat(longitud)
					};
					geocoder.geocode({
						\'location\': latlng
					}, function(results, status) {
						if (status === google.maps.GeocoderStatus.OK) {
							var ubicacion = results[1].formatted_address;
							$("#ubicacion").val(ubicacion);
						} else {
							latitud = "";
							longitud = "";
							$("#ubicacion").val("");
							window.alert(\'Error en la ubicación seleccionada: \' + status);
						}
						$("#latitud").val(latitud);
						$("#longitud").val(longitud);
					});
				});
			}

			getKilometros = function (lat1, lon1, lat2, lon2){
				rad = function (x) {
					return x * Math.PI / 180;
				}
				var R = 6378.137; //Radio de la tierra en km
				var dLat = rad(lat2 - lat1);
				var dLong = rad(lon2 - lon1);
				var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) + Math.cos(rad(lat1)) * Math.cos(rad(lat2)) * Math.sin(dLong / 2) * Math.sin(dLong / 2);
				var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
				var d = (R * c) * 1.1;
				return d.toFixed(3); //Retorna tres decimales
			}

			// Adds a marker to the map and push to the array.
			function addMarkerruta(location, mapa) {
				if (status_ruta == false) {
					var marker = new google.maps.Marker({
						position: location,
						map: mapa
					});
					marker.setTitle("Control");
					markers.push(marker);
				}
			}

			function addMarkertramo(location) {
				var tramo = new google.maps.Marker({
					position: location,
					map: mapa_ruta
				});
				tramo.setTitle("Control");
				tramos.push(tramo);
			}

			// Sets the map on all markers in the array.
			function setMapOnAll(map) {
				for (var i = 1; i < markers.length; i++) {
					markers[i].setMap(map);
				}
			}

			function setMaprutaOnAll(map) {
				for (var i = 0; i < tramos.length; i++) {
					tramos[i].setMap(map);
				}
			}

			// Removes the markers from the map, but keeps them in the array.
			function clearMarkers() {
				setMapOnAll(null);
			}
			function clearTramos() {
				setMaprutaOnAll(null);
			}

			// Shows any markers currently in the array.
			function showMarkers() {
				setMapOnAll(map);
			}

			// Deletes all markers in the array by removing references to them.
			function deleteMarkers() {
				clearMarkers();
				markers = [];
			}
			function deleteTramos() {
				clearTramos();
				tramos = [];
			}
			/******* FIN - FUNCIONES DEL API DE GOOGLE MAPS *******/
		</script>
	';

