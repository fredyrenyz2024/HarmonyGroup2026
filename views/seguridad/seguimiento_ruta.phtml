		<script type="text/javascript">
			// Funcion que muestra detalles del seguimiento
			function mostrarDetalle( id_agrupamiento ){
				$("#ver_detalle_content").empty();
				$("#ver_detalle_title").empty();

				params={
					accion 	: "detalle_seguimiento_ruta",
					id 		: id_agrupamiento
				}
				// console.log(params);

				$.ajax({
					type		: "POST",
					cache		: false,
					url			: "' . BASE_URL . '/libs/seguridad_ajax.php",
					data		: params,
					dataType	: "json",
					error 		: function(data){
								console.log("Error en el ajax");
								console.log(data);
								},
					success		: function(data) {
								// console.log(data);
								$("#ver_detalle_title").append(data.content.title);
								$("#ver_detalle_content").append(data.content.body.general);
								$("#ver_detalle_content").append(data.content.body.vehiculo);
								$("#ver_detalle_content").append(data.content.body.cliente);
					}
				});
			}

			// Funcion para gestionar la actividad de seguimiento
			function gestionarActividad(id_agrupamiento, latitud, longitud, id_actividades){
 				// Se limpian los campos del formularios
				if(id_agrupamiento != $("#id_agrupamiento").val() ){
					$("#gestionar .form-control").val("");
					$("#slct_destino").empty();
				}

				$("#id_agrupamiento").val(id_agrupamiento);
				$("#id").val(id_actividades);

				// Se busca la ruta que debe seguir el vehículo
				params={
					accion 	: "busca_ruta_agrupamiento",
					id 		: id_agrupamiento
				}
				// console.log(params);
				$.ajax({
					url			: "' . BASE_URL . 'libs/seguridad_ajax.php",
					type		: "POST",
					cache		: false,
					data		: params,
					dataType 	: "json",
					error		: function(data) {
								// console.log(data);
					},
					success		: function(data) {
								// console.log(data);

								// Se envian los parámetros para crear el mapa de seguimiento 
								var params = {
									latitud 	: latitud,
									longitud 	: longitud,
									ruta 		: data.ruta_control,
									origen 		: data.origen,
									destino		: data.destino
								}
								initMap(params);
								App.wizard();
					}
				});
			}

			// Función para buscar coordenadas de un remitente-destinatario
			function buscarCoordenadas(destino){
				let longitud = destino.parents(".modal-body").find("#longitud");
				let latitud = destino.parents(".modal-body").find("#latitud");
				let ubicacion = destino.parents(".modal-body").find("#ubicacion");
				let id_destino = destino.find("option:selected").data("id_destino");
				let nom_destino = destino.find("option:selected").text();

				let params={
					accion 	: "busca_coordenadas",
					id 		: id_destino
				}
				// console.log(params);

				$.ajax({
					type		: "POST",
					cache		: false,
					url			: "' . BASE_URL . '/libs/seguridad_ajax.php",
					data		: params,
					dataType	: "json",
					error 		: function(data){
						console.log("Error en el ajax");
						console.log(data);
					},
					success		: function(data) {
						// console.log(data);
						if(data.content.longitud && data.content.latitud){
							longitud.val(data.content.longitud);
							latitud.val(data.content.latitud);
							ubicacion.val(nom_destino);
						}
					}
				});
			}

			// Se crea el select de clientes de destino 
			$("#slct_tipo_seguimiento_1").change(function () {
				$("#slct_destino").empty();

				if( $("#slct_tipo_seguimiento_1").val() == "Llegada Destino" ){
					params={
						accion 	: "slct_clientes_destino",
						id 		: $("#id_agrupamiento").val()
					}
					// console.log(params);

					$.ajax({
						type		: "POST",
						cache		: false,
						url			: "' . BASE_URL . '/libs/seguridad_ajax.php",
						data		: params,
						dataType	: "json",
						error 		: function(data){
							console.log("Error en el ajax");
							console.log(data);
							},
						success		: function(data) {
							// console.log(data);
							$("#slct_destino").append( data.content );

							$(".slct_clientes_destino").change(function(){
								buscarCoordenadas($(this));
							});
						}
					});
				}
			});

			// Se gestiona los saguimientos
			$("#btn_gestiona_seguimiento").click(function () {
				var msg_error = "";
				var flag_click = false;
				if(!flag_click){
					flag_click = true;

					// Se toman los datos a validar
					var id = $("#id").val();
					var id_agrupamiento = $("#id_agrupamiento").val();
					var latitud = $("#latitud").val();
					var longitud = $("#longitud").val();
					var ubicacion = $("#ubicacion").val();
					var tipo_seguimiento_ruta = $("#slct_tipo_seguimiento_1").val();
					var slct_solicitud = "";
					var id_destino = "";
					var velocidad = $("#velocidad").val();

					// se verifica si hay imagenes adjuntos
					if($(\'input[name=url_seguimiento]\').val()){
						var url_seguimiento= document.getElementById(\'url_seguimiento\').files;
						for( var i=0; i < url_seguimiento.length; i++ ){
							var extension = url_seguimiento[i].name.split(".");
							// Se valida el tipo de archivo
							if( validaFormatoArchivo("jpg,jpeg,png,gif,bmp,JPG,JPEG,PNG,GIF,BMP", extension[ extension.length - 1 ]) == 0 ){
								msg_error+= "<p>Formato de una o varias imagenes adjuntas no es válido como entregable para esta actividad.</p>";
								break;
							}
							// Se valida el tamaño del archivo 
							if( $(\'input[name=url_seguimiento]\')[0].files[0].size > 2000000 ){
								msg_error+= "<p>El tamaño del archivo es demasiado grande para subirlo al servidor, por favor use un archivo de menos de 2Mb de tamaño.</p>";
								break;
							}
						}
					}else{
						msg_error+= "<p>Debe adjuntar imágenes para continuar esta Actividad.</p>";
					}
					if( !latitud || !longitud ){
						msg_error+= "<p>Para continuar debe establecer la ubicación del seguimiento en el mapa.</p>";
					}
					if( !ubicacion ){
						msg_error+= "<p>Para continuar debe diligenciar el campo <strong>Ubicación</strong>.</p>";
