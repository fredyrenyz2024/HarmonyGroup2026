				msg_error += "<p>Debe diligenciar el campo <strong>Cliente</strong> para poder registrar .</p>";
			}
			if (!$("#a_permanencia").val()) {
				msg_error += "<p>Debe diligenciar el campo <strong>Permanente?</strong> para poder registrar .</p>";
			}
			if ($("#a_permanencia").val()) {
				if ($("#a_permanencia").val() == '0') {
					if (!$("#a_henvio").val()) {
						msg_error += "<p>Debe diligenciar el campo <strong>Hora envío</strong> para poder registrar .</p>";
					}
					if (!$("#a_finicio").val()) {
						msg_error += "<p>Debe diligenciar el campo <strong>Fecha inicio</strong> para poder registrar .</p>";
					}
					if (!$("#a_ffinal").val()) {
						msg_error += "<p>Debe diligenciar el campo <strong>Fecha final</strong> para poder registrar .</p>";
					}
				}
			}
			if (!msg_error) {
				Registrar_Hora();
			} else {
				$("#msg_crearhora").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-close"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
				$("#crear_hora").animate({
					scrollTop: 0
				}, 600);
			}
		});

		$("#btn_actualizar").click(function() {
			var msg_error = '';
			if (!$("#ecliente").val()) {
				msg_error += "<p>Debe diligenciar el campo <strong>Cliente</strong> para poder actualizar .</p>";
			}
			if (!$("#epermanence").val()) {
				msg_error += "<p>Debe diligenciar el campo <strong>Permanencia</strong> para poder actualizar .</p>";
			}
			if ($("#epermanence").val()) {
				if ($("#epermanence").val() == '0') {
					if (!$("#einicio").val()) {
						msg_error += "<p>Debe diligenciar el campo <strong>Fecha inicio</strong> para poder actualizar .</p>";
					}
					if (!$("#efinal").val()) {
						msg_error += "<p>Debe diligenciar el campo <strong>Fecha final</strong> para poder actualizar .</p>";
					}
					if (!$("#ehoraenvio").val()) {
						msg_error += "<p>Debe diligenciar el campo <strong>Hora envío</strong> para poder actualizar .</p>";
					}
					if ($("#ehoraenvio").val() == '00:00:00') {
						msg_error += "<p>Debe diligenciar el campo <strong>Hora envío</strong>con una hora diferente a 00:00 para poder actualizar .</p>";
					}
				}
			}
			if (!msg_error) {
				Actualiza_hora();
			} else {
				$("#msg_edicion").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-close"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
				$("#editarhoracliente").animate({
					scrollTop: 0
				}, 600);
			}
		});

	});
	var url = $("#id_url_ajax").val() + "libs/grupo_ajax.php";

	function clientes_select() {
		var dato = {
			action: 'consultar_cliente'
		};
		$("#a_cliente").html('');
		$("#a_cliente").html('<option value="">Seleccione</option>');
		$.ajax({
			url: url,
			type: 'POST',
			data: dato,
			dataType: 'json',
			success: function(data) {
				if (data) {
					data.result.forEach(function(element, index) {
						$("#a_cliente").append('<option value="' + element.id + '">' + element.nombre + '</option>');
					});
				}
			},
			error: function(jqXHR, textStatus, errorThrown) {
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			}
		});
	}

	function clientes_hora() {
		var datop = {
			action: 'consultar_cliente_tabla'
		};
		$("#cliente").html('<option value="">Seleccione</option>');
		$.ajax({
			url: url,
			type: 'POST',
			data: datop,
			dataType: 'json',
			success: function(data) {
				if (data) {
					data.result.forEach(function(element, index) {
						$("#cliente").append('<option value="' + element.id + '">' + element.nombre + ' / ' + element.documento + '</option>');
					});
				}
			},
			error: function(jqXHR, textStatus, errorThrown) {
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			}
		});
	}

	function Registrar_Hora() {
		var cliente = $("#a_cliente").val();
		var hora = $("#a_henvio").val();
		var fi = $("#a_finicio").val();
		var ff = $("#a_ffinal").val();
		var per = $("#a_permanencia").val();
		registro = {
			cliente: cliente,
			hora: hora,
			fi: fi,
			ff: ff,
			per: per,
			action: 'Registrohora_envio_correo'
		};

		$.ajax({
			url: url1,
			type: 'POST',
			data: registro,
			dataType: 'json',
			success: function(data) {
				alert('Registro Datos Existosamente!!!');
				location.reload();
			},
			error: function(jqXHR, textStatus, errorThrown) {
				console.log('error');
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			}
		});
	}

	function Actualiza_hora() {
		var cliente = $("#ecliente").val();
		var fini = $("#einicio").val();
		var ffin = $("#efinal").val();
		var perma = $("#epermanence").val();
		var horae = $("#ehoraenvio").val();
		var idtb = $("#eidtb").val();

		var update = {
			cliente: cliente,
			fini: fini,
			ffin: ffin,
			perma: perma,
			horae: horae,
			idtb: idtb,
			action: 'Actualiza_horaenvio'
		};

		$.ajax({
			url: url1,
			type: 'POST',
			data: update,
			dataType: 'json',
			success: function(data) {
				alert('Datos Actualizados Existosamente!!!');
				location.reload();
			},
			error: function(jqXHR, textStatus, errorThrown) {
				console.log('error');
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			}
		});
	}

	function HoraCliente() { //TABLA
		var cliente = $("#cliente").val();
		if (cliente == '') {
			alert('Por favor seleccione un cliente de la lista');
			$("#body_esconder").html('');
		} else {
			var search = {
				cliente_hora: cliente,
				action: 'buscar_hora_cliente'
			};
			$("#body_esconder").html('');
			$.ajax({
				url: url1,
				type: 'POST',
				data: search,
				dataType: 'json',
				success: function(data) {
					var cont = 0;
					data.result.forEach(function(element, index) {
						cont++;
						var idtb = element.id; //tabla de horas de envio
						var p;
						var col_status;
						var btn_ver = '';
						var btn_editar = '';
						//Botones

						btn_ver = '<button type="button" class="btn btn-secondary btn btn-sm mdi mdi-eye" id="btn_ver' + cont + '"  data-toggle="modal" data-target="#verhoracliente"  data-placement="top"  title="Ver Datos" data-id="' + idtb + '"></button>';

						btn_editar = '<button type="button" class="btn btn-secondary btn btn-sm mdi mdi-edit" id="btn_editar' + cont + '"  data-toggle="modal" data-target="#editarhoracliente"  data-placement="top"  title="Editar Datos" data-id="' + idtb + '"></button>';

						if (element.permanencia == 1) {
							p = 'Si';
						}
						if (element.permanencia == 0) {
							p = 'NO';
						}
						col_status =
							'<td class="text-success">' +
							'<center>' +
							'<span class="mdi mdi-dot-circle icon"  data-toggle="tooltip" title="Activo"></span>' +
							'</center>' +
							'</td>';
						$("#body_esconder").append('<tr>' +
							col_status +
							'<td>' + element.nombre + '</td>' +
							'<td>' + p + '</td>' +
							'<td>(' + element.fecha_inicio + ') (' + element.fecha_final + ')</td>' +
							'<td>' +
							btn_ver + '&nbsp;' +
							btn_editar +
							'</td>' +
							'</tr>');
						//boton ver
						$("#btn_ver" + cont + "").click(function() {
							var id = $(this).attr('data-id');
							var buscar = {
								id: id,
								action: 'ver_horacliente'
							};
							$.ajax({
								url: url1,
								type: 'POST',
								data: buscar,
								dataType: 'json',
								success: function(data) {
									if (data) {
										var per;
										if (data.result[0].permanencia == 1) {
											per = 'Si';
										}
										if (data.result[0].permanencia == 0) {
											per = 'No';
										}
										$("#vcliente").val(data.result[0].nombre);
										$("#vinicio").val(data.result[0].fecha_inicio);
										$("#vfinal").val(data.result[0].fecha_final);
										$("#vpermanencia").val(per);
										$("#vhoraenvio").val(data.result[0].hora_envio);

										$("#vuser").val(data.result[0].usuario);
										$("#vfecha").val(data.result[0].fecha);
										$("#vhora").val(data.result[0].hora);
									}
								},
								error: function(jqXHR, textStatus, errorThrown) {
									console.log('no trajo datos de cliente');
									console.log(jqXHR);
									console.log(textStatus);
									console.log(errorThrown);
								}
							});
						});
						//boton de consulta para formulario de edición
						$("#btn_editar" + cont + "").click(function() {
							var id = $(this).attr('data-id'); //
							$("#eidtb").val(id);
							var buscar = {
								id: id,
								action: 'edita_horacliente'
							};
							$.ajax({
								url: url1,
								type: 'POST',
								data: buscar,
								dataType: 'json',
								success: function(data) {
									if (data) {
										$("#ecliente").html('');
										data.result[0].clientene.forEach(function(element, index) {
											var tmpSelected = "";
											if (element.selected) {
												tmpSelected = "selected";
											}
											$("#ecliente").
											append('<option ' + tmpSelected + ' value="' + element.id + '">' + element.nombre + '</option>');
										});
										if (data.result[0].permanencia == 1) {
											p = 'Si';
											$("#epermanence").html('<option value="1">Si</option>' +
												'<option value="0">No</option>');

											//bloquear los campos
											$("#ehoraenvio").prop('disabled', true);
											$("#einicio").prop('disabled', true);
											$("#efinal").prop('disabled', true);
										} else {
											$("#epermanence").html('<option value="0">No</option>' +
												'<option value="1">Si</option>');
											$("#ehoraenvio").prop('disabled', false);
											$("#einicio").prop('disabled', false);
											$("#efinal").prop('disabled', false);

										}
										$("#ehoraenvio").val(data.result[0].hora_envio);
										$("#einicio").val(data.result[0].fecha_inicio);
										$("#efinal").val(data.result[0].fecha_final);
									}
								},
								error: function(jqXHR, textStatus, errorThrown) {
									console.log('no trajo datos de cliente');
									console.log(jqXHR);
									console.log(textStatus);
									console.log(errorThrown);
								}
							});
						});
					});

				},
				error: function(jqXHR, textStatus, errorThrown) {
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				}
			});
		}
	}
</script>