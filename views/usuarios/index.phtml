					funct_msg_loading(".nexos-messages");
				},
				error: function(jqXHR, textStatus, errorThrown) {
					$(".nexos-messages").html('');
					msg_error += "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function(data, textStatus, jqXHR) {
					// console.log(data);
					if (data) {
						result = data;
					}

				},
			});
			$.ajaxSetup({
				async: true
			});
			$(".nexos-messages").html('');
			if (msg_error) {
				funct_msg_error(".nexos_messages_popup", msg_error);
			} else {
				return result;
			}
		} catch (error) {
			console.log(error);
		}
	}
