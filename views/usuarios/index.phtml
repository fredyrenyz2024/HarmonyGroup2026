	function cargarSlctPerfiles_sm(tipo_perfil, name, id) {
		var param = {
			action: "select_perfil_sm",
			tipo_perfil: tipo_perfil,
			name: name,
			id: id
		}
		var result = consultaJquery(param);
		return result["content"];
	}

	function cargarSlctClientes_sm(name, id) {
		var param = {
			action: "select_clientes_sm",
			name: name,
			id: id
		}
		var result = consultaJquery(param);
		return result["content"];
	}

	function cargarSlctBodegas_sm(name, id) {
		var param = {
			action: "select_bodegas_sm",
			name: name,
			id: id
		}
		var result = consultaJquery(param);
		return result["content"];
	}

	function ejecutaJquery(params) {
		var msg_error = "";
		try {
			// console.log(params);
			$.ajaxSetup({
				async: false
			});
			$.ajax({
				url: $("#id_url_ajax").val() + "libs/usuarios_ajax.php",
				type: 'POST',
				data: params,
				dataType: 'json',
				cache: false,
				beforeSend: function(jqXHR, settings) {
					funct_msg_loading(".nexos-messages");
				},
				error: function(jqXHR, textStatus, errorThrown) {
					$(".nexos-messages").html('');
					msg_error += "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function(data, textStatus, jqXHR) {
					// console.log(data);
					$(".nexos-messages").html('');
					if (data.error) {
						msg_error += data.error;
					}
				},
			});
			$.ajaxSetup({
				async: true
			});
			if (msg_error) {
				funct_msg_error(".nexos_messages_popup", msg_error);
			}
			if (!msg_error) {
				funct_msg_success(".nexos_messages_popup");
				setTimeout(function() {
					location.reload(false);
				}, 800);
			}
		} catch (error) {
			console.log(error);
		}
	}

	function consultaJquery(params) {
		// alert('CREAR USUARIO');
		var result;
		var msg_error = "";
		var msg_content = "";
		$(".nexos_messages_popup").html('');
		try {
			// console.log(params);
			$.ajaxSetup({
				async: false
			});
			$.ajax({
				url: $("#id_url_ajax").val() + "libs/usuarios_ajax.php",
				type: 'POST',
				data: params,
				dataType: 'json',
				cache: false,
