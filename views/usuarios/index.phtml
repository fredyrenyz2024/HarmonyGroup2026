<script type="text/javascript">
	$(document).ready(function() {
		$("#btn_crear").click(function() {
			// alert('crear usuario');
			$(".nexos_messages_popup").empty();
			var msg_error = "";
			var tipo_perfil = $("#slct_tipo_perfil_").val();
			var id_perfil = $("#slct_id_perfil").val();
			var nom_perfil = $("#slct_id_perfil option:selected").text();
			var user_log = $("#user_log").val();
			var nom_usuario = $("#nom_usuario").val();
			var email = $("#email").val();
			var id_cliente = $("#id_cliente").val();
			var id_bodega = null;
			var autor = $("#session_user").data('id_usuario');

			if (!tipo_perfil) {
				msg_error += '<p>Debe seleccionar un <strong>Tipo Perfil</strong> para crear el usuario.</p>';
			} else {
				if (!id_perfil) {
					msg_error += '<p>Debe seleccionar un <strong>Perfil</strong> para crear el usuario.</p>';
				}
				switch (tipo_perfil) {
					case 'CLIENTES':
						id_cliente = $("#slct_id_cliente").val();
						if (!id_cliente) {
							msg_error += '<p>Debe seleccionar un <strong>Cliente</strong> para crear el usuario.</p>';
						}
						break;

					case 'BODEGAS':
						id_bodega = $("#slct_id_bodega").val();
						if (!id_bodega) {
							msg_error += '<p>Debe seleccionar un <strong>Bodega</strong> para crear el usuario.</p>';
						}
						break;
				}
			}
			if (!user_log) {
				msg_error += '<p>Debe diligenciar el campo <strong>Documento</strong> para crear el usuario.</p>';
			}
			if (!nom_usuario) {
				msg_error += '<p>Debe diligenciar el campo <strong>Nombre</strong> para crear el usuario.</p>';
			}
			if (!email) {
				msg_error += '<p>Debe diligenciar el campo <strong>Email</strong> para crear el usuario.</p>';
			}
			if ($(".check_avatar:checked").length == 0) {
				msg_error += '<p>Debe seleccionar un <strong>Avatar</strong> para crear el usuario.</p>';
			}

			if (!msg_error) {
				// alert('registro de usuario');
				var param = {
					action: "crea_usuario",
					id_perfil: id_perfil,
					nom_perfil: nom_perfil,
					user_log: user_log,
					nom_usuario: nom_usuario,
					email: email,
					id_cliente: id_cliente,
					id_bodega: id_bodega,
					url_avatar: $(".check_avatar:checked").val(),
					autor: autor
				}
				var result = consultaJquery(param);
				if (result.mail.error) {
					msg_error += result.mail.error;
				}

			}
			if (msg_error) {
				funct_msg_error(".nexos_messages_popup", msg_error);

			}
			if (!msg_error) {

				$(this).hide();
				funct_msg_success(".nexos_messages_popup", result.content);
				setTimeout(function() {
					location.reload(false);
				}, 800);
			}
		});

		$("#btn_editar").click(function() {
			$(".nexos_messages_popup").empty();
			var msg_error = "";
			var tipo_perfil = $("#slct_e_tipo_perfil_").val();
			var id_perfil = $("#slct_e_id_perfil").val();
			var user_log = $("#e_user_log").val();
			var nom_usuario = $("#e_nom_usuario").val();
			var email = $("#e_email").val();
			var id_cliente = $("#e_id_cliente").val();
			var id_bodega = null;

			if (!tipo_perfil) {
				msg_error += '<p>Debe seleccionar un <strong>Tipo Perfil</strong> para editar el usuario.</p>';
			} else {
				if (!id_perfil) {
					msg_error += '<p>Debe seleccionar un <strong>Perfil</strong> para editar el usuario.</p>';
				}
				switch (tipo_perfil) {
					case 'CLIENTES':
