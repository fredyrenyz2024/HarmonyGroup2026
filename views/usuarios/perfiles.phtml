				// alert(nombre);
				// alert(tipo);
				$("#perfil").val(perfil);
				$("#name_perfil").val(nombre);
				$("#tipo_perfil").val(tipo);

				//cargar submenus y cargar modulos
				var dato1={
					action:'traer submenus'
				};
				
					$("#submenu").select2({
						  width:'100%'
					});

					$.ajax({
						url:"http://localhost/mvcLuisMiguel/libs/submenus_ajax.php",
			 			type:'POST',
			 			data:dato1,
			 			dataType:'json',
			 			success: function(data){
			 				// console.log(data);
			 				// alert('trajjo submenu');
