			 				});

			 			},
			 			error: function(jqXHR, textStatus, errorThrown){
			 				// alert('no trajo submenu');
			 				console.log(jqXHR);
							console.log(textStatus);
							console.log(errorThrown);
			 			}

 					});	

 				var dato2={
 					action:'traer_modulo'
 				};

 				$("#elmodulo").select2({
						  width:'100%'
					});
 				$.ajax({
						url:"http://localhost/mvcLuisMiguel/libs/submenus_ajax.php",
			 			type:'POST',
			 			data:dato2,
			 			dataType:'json',
