	function ejecutaJquery(params){
		var msg_error = "";
		try{
			// console.log(params);
			$.ajaxSetup({async: false});
			$.ajax({
				url: $("#id_url_ajax").val() + "libs/usuarios_ajax.php",
				type: 'POST',
				data: params,
				dataType: 'json',
				cache: false,
				beforeSend : function(jqXHR, settings){
					funct_msg_loading(".nexos-messages");
				},
				error: function (jqXHR, textStatus, errorThrown){
					msg_error+= "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function (data, textStatus, jqXHR){
					// console.log(data);
					if (data.error) { msg_error+= data.error; }
				}, 
			});
			$(".nexos-messages").html('');
			if (msg_error) { funct_msg_error(".nexos_messages_popup", msg_error); }
			if (!msg_error) {
				funct_msg_success(".nexos_messages_popup");
				setTimeout(function() { location.reload(false);  }, 800);
			}
			$.ajaxSetup({async: true});
		}catch(error){
			console.log(error);
		}
	}

	function consultaJquery(params){
		var msg_error = "";
		var msg_content = "";
		$(".nexos_messages_popup").html('');
		try{
			// console.log(params);
			$.ajaxSetup({async: false});
			$.ajax({
				url: $("#id_url_ajax").val() + "libs/usuarios_ajax.php",
				type: 'POST',
				data: params,
				dataType: 'json',
				cache: false,
				beforeSend : function(jqXHR, settings){
					funct_msg_loading(".nexos-messages");
				},
				error: function (jqXHR, textStatus, errorThrown){
					msg_error+= "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function (data, textStatus, jqXHR){
					// console.log(data);
					if (data.error) { msg_error+= data.error; } 
					if (data.content) { msg_content+= data.content; }
				}, 
			});
			$(".nexos-messages").html('');
			if (msg_error) { funct_msg_error(".nexos_messages_popup", msg_error); }
			else {
				if (msg_content) { return msg_content; }
			}
			$.ajaxSetup({async: true});
		}catch(error){
			console.log(error);
		}
	}

	function verificaPermisos(id_menu){
		var color = "default";
		$("#perfil_" + id_menu).find(".check_solo").each(function(){
			var id_submenu = $(this).val();
			if ( $(this).is(":checked") ) {
				color = "success";
				$("#check_adicionar_" + id_submenu).removeAttr("disabled");
				$("#check_editar_" + id_submenu).removeAttr("disabled");
				$("#check_eliminar_" + id_submenu).removeAttr("disabled");
			} else {
				$("#check_adicionar_" + id_submenu).prop("checked",false).attr("disabled","disabled");
				$("#check_editar_" + id_submenu).prop("checked",false).attr("disabled","disabled");
				$("#check_eliminar_" + id_submenu).prop("checked",false).attr("disabled","disabled");
			}
		});
		$("#perfil_" + id_menu).attr("class", "panel panel-default panel-border-color panel-border-color-" + color);
	}
