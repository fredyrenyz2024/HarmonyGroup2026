<script type="text/javascript">

	$(document).ready(function(){
		$("#btn_crear").click(function(){
			var msg_error = "";
			var nombre = $("#nombre").val();
			var tipo_perfil = $("#slct_tipo_perfil_").val();
			if (!tipo_perfil) { msg_error+= '<p>Debe seleccionar un <strong>Tipo Perfil</strong> para crear el perfil.</p>'; }
			if (!nombre) { msg_error+= '<p>Debe diligenciar el campo <strong>Nombre</strong> para crear el perfil.</p>'; }

			if (!msg_error) {
				var param = {
					action: "crea_perfil",
					id: $("#id_edita").val(),
					nombre_perfil: nombre,
					tipo_perfil: tipo_perfil
				}
				ejecutaJquery(param);
			}
			if (msg_error) { funct_msg_error(".nexos_messages_popup", msg_error); }
		});

		$("#btn_editar").click(function(){
			var msg_error = "";
			var nombre = $("#e_nombre").val();
			var tipo_perfil = $("#slct_e_tipo_perfil_").val();
			if (!tipo_perfil) { msg_error+= '<p>Debe seleccionar un <strong>Tipo Perfil</strong> para editar el perfil.</p>'; }
			if (!nombre) { msg_error+= '<p>Debe diligenciar el campo <strong>Nombre</strong> para editar el perfil.</p>'; }

			if (!msg_error) {
				var param = {
					action: "edita_perfil",
					id: $("#id_edita").val(),
					nombre_perfil: nombre,
					tipo_perfil: tipo_perfil
				}
				ejecutaJquery(param);
			}
			if (msg_error) { funct_msg_error(".nexos_messages_popup", msg_error); }
		});

		$("#btn_inactivar").click(function(){
			var param = {
				action: "inactiva_perfil",
				id: $("#id_inactiva").val()
			}
			ejecutaJquery(param);
		});

		$("#btn_activar").click(function(){
			var param = {
				action: "activa_perfil",
				id: $("#id_activa").val()
			}
			ejecutaJquery(param);
		});
	});

