<script type="text/javascript">
	$(document).ready(function(){
		$("#btn_editar_facturacion").click(function(){
			// console.log("Entro en función del btn_editar_facturacion");
			$("#nexos_messages_popup_instruccion").empty();
			var msg_error = "";

			var num_factura = $("#factura").val();
			var fecha_factura = $("#fecha_factura").val();
			var fecha_vencimiento = $("#fecha_vencimiento").val();
			var file_factura = $("#file_factura").val();

			if (file_factura) {
				if (!num_factura) {
					msg_error+= "<p>Debe diligenciar el campo <strong># Factura</strong> para registrar la factura del cliente.</p>";
				}
				var adjunto = $("#file_factura")[0].files[0];
				// Se valida el peso del archivo
				if ( adjunto.size < $("#max_file_size").val() ) {
					// Se valida el tipo de archivo
					var extension = adjunto.name.split(".");
					var formato_archivo = "pdf,PDF,zip,ZIP,rar,RAR,doc,DOC,docx,DOCX,jpg,jpeg,png,gif,bmp,tif,JPG,JPEG,PNG,GIF,BMP,TIF,xls,XLS,xlsx,XLSX,ppt,PPT,pptx,PPTX,pps,PPS,ppsx,PPSX,ods,ODS";
					if( validaFormatoArchivo( formato_archivo , extension[ extension.length - 1 ]) == 0 ){
						msg_error+= "<p>Formato del archivo del campo <strong>Factura Recibida</strong> no es válido para poder crear el sobrecosto.</p>";
						msg_error+= "<p>Formatos válidos: <strong>" + formato_archivo + "</strong>.</p>";
					}
				} else {
					msg_error+= "<p>El archivo del campo <strong>Adjunto Factura</strong> es muy pesado para subirlo al servidor. El peso máximo del archivo debe ser menor de <strong>" + ($("#max_file_size").val() / 1000000 ) + "MB</strong>.</p>";
				}
			}

			if (fecha_factura > fecha_vencimiento) {
				msg_error+= "<p>La <strong>Fecha Factura</strong> no puede ser mayor que la <strong>Fecha Vencimiento</strong> para registrar la factura del cliente.</p>";
			}

			if (!msg_error) {
				var params = new FormData( $("#form_instruccion")[0]);
				$.ajax({
					url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=gestionar_factura_cliente",
					type: 'POST',
					contentType: false,
					data: params,
					cache: false,
					dataType: 'json',
					processData:false,
					beforeSend	: function(jqXHR, settings){
						$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
					},
					error: function (jqXHR, textStatus, errorThrown){
						$(".nexos-messages").html('');
						msg_error+= "<p>" + jqXHR.responseText + "</p>";
						console.log(jqXHR);
						console.log(textStatus);
						console.log(errorThrown);
					},
					success: function (data, textStatus, jqXHR){
						$(".nexos-messages").html('');
						// console.log(data);
						if (data.gestiona_actividad) {
							console.log("Se debe gestionar la actividad");
							$(".actividades").each(function(){
								var params = {
									id : $(this).data("id_actividad") + ",",
									orden : $(this).data("orden"),
									fecha_hora_inicio : $(this).data("fecha_hora_inicio"),
									id_importacion : $(this).data("id_importacion"),
									bloque : $(this).data("bloque"),
									grupo : $(this).data("grupo"),
									simultaneo : $(this).data("simultaneo"),
									tipo_actividad : $(this).data("tipo_actividad"),
									costo_real : $(this).data("costo_real"),
									respuesta : $(this).data("respuesta")
								}
								// console.log(params);
								actualizaActividad(params);
							});
						}
					}
				});
				if (!msg_error) {
					$("#nexos_messages_popup_instruccion").html('<div role="alert" class="alert alert-success alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Proceso terminado! </strong>Se ha creado el registro con éxito.</div></div>');
					$("#ver_facturacion").animate({ scrollTop: 0 }, 600);
					setTimeout(function() { location.reload(false); }, 800);
				}
				if (msg_error) {
					$("#nexos_messages_popup_instruccion").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
					$("#ver_facturacion").animate({ scrollTop: 0 }, 600);
				}
			}
			if (msg_error) {
				$("#nexos_messages_popup_instruccion").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
				$("#ver_facturacion").animate({ scrollTop: 0 }, 600);
			}
		});
	});

	function verFormEditaFactura(id){
		// console.log("Entro en función verFormEditaFactura");
		$("#nexos_messages_popup_instruccion").empty();
		$("#ver_facturacion_title").empty();
		$("#contenidoeditafacturacion").empty();
		var msg_error = "";

		var params = {
			id: id,
		}

		$.ajaxSetup({async: false});
		$.ajax({
			url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=form_editar_factura",
			type: 'POST',
			data: params,
			cache: false,
			dataType: 'json',
			beforeSend	: function(jqXHR, settings){
				$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
			},
			error: function (jqXHR, textStatus, errorThrown){
				$(".nexos-messages").html('');
				msg_error+= "<p>" + jqXHR.responseText + "</p>";
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			},
			success: function (data, textStatus, jqXHR){
				$(".nexos-messages").html('');
				// console.log(data);
				if (!msg_error) {
					$("#nexos_messages_popup_instruccion").html("");
					if (data.content) {
						$("#ver_facturacion_title").html(data.content.title);
						$("#contenidoeditafacturacion").html(data.content.content);
						$("#proforma_print").hide();
						App.formElements();
					}
				}
			}
		});
		$.ajaxSetup({async: true});
		if (msg_error) {
			$("#nexos_messages_popup_instruccion").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
			$("#ver_facturacion").animate({ scrollTop: 0 }, 600);
		}
	}

	function actualizaActividad(params){
		// console.log(params);
		var msg_error = "";

		// Se actualizan las actividades del proyecto
		$.ajax({
			type		: "POST",
			cache		: false,
			url 		: $("#id_url_ajax").val() + "libs/gestion_actividades.php?tabla=cmx_importacion_actividades&proyecto=importacion",
			data		: params,
			beforeSend	: function(jqXHR, settings){
						$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
			},
			error		: function(data) {
						console.log(data);
						$(".nexos_messages_popup_instruccion").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Proceso terminado!</strong> Error en la creación del registro.</div></div>');
			},
			success		: function(data) {
						// console.log(data);
			}
		});
	}

	function imprimirProforma(){
		// console.log("Entro en función imprimirProforma");
		$("#proforma_print").printThis({
			importStyle: "block",
			header: $("#proforma_print").html(),
		});
	}

</script>
