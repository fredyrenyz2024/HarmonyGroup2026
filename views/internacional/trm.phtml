<script type="text/javascript">
	$(document).ready(function() {
		$("#form_crea_trm").click(function() {
			$("#content_popup_trm").empty();

			$.ajax({
				url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=agregar_trm",
				type: 'POST',
				cache: false,
				dataType: 'json',
				beforeSend: function(jqXHR, settings) {
					funct_msg_loading(".nexos-messages");
				},
				error: function(jqXHR, textStatus, errorThrown) {
					$(".nexos-messages").html('');
					msg_error += "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function(data, textStatus, jqXHR) {
					// console.log(data);
					$("#nexos_messages_popup_trm").empty();
					$("#content_popup_trm").html(data.content);
					$(".nexos-messages").empty();

					$("#slct_monedas_").change(function() {
						validaTrm($("#slct_monedas_").val(), $("#fecha").val());
					});

					$("#fecha").change(function() {
						validaTrm($("#slct_monedas_").val(), $("#fecha").val());
					});

					App.formElements();
				}
			});
		});

		$("#btn_crea_trm").click(function() {
			$("#nexos_messages_popup_trm").empty();

			var msg_error = "";

			// Se valida contenido del formulario
			var id_moneda = $("#slct_monedas_").val();
			if (!id_moneda) {
				msg_error += '<p>Debe seleccionar una <strong>Moneda</strong> para Crear el TRM.</p>';
			}
			var fecha = $("#fecha").val();
			if (!fecha) {
				msg_error += '<p>Debe seleccionar una <strong>Fecha</strong> para Crear el TRM.</p>';
			}
			var valor = $("#valor").val();
			if (!valor) {
				msg_error += '<p>Debe diligenciar el campo <strong>Tasa Representativa</strong> para Crear el TRM.</p>';
			}

			if (!msg_error) {
				// Se actualiza la informacion en la base de datos 
				var params = {
					id_moneda: id_moneda,
					fecha: fecha,
					valor: valor
				}
				// console.log(params);

				$.ajax({
					url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=crea_trm",
					type: 'POST',
					data: params,
					cache: false,
					dataType: 'json',
					beforeSend: function(jqXHR, settings) {
						funct_msg_loading(".nexos-messages");
					},
					success: function(data, textStatus, jqXHR) {
						console.log(data);
						$(".nexos-messages").empty();
						funct_msg_success("#nexos_messages_popup_trm");
						$("#crea_trm").animate({
							scrollTop: 0
						}, 600);
						setTimeout(function() {
							location.reload(false);
						}, 800);
					}
				});
			}

			if (msg_error) {
				funct_msg_error("#nexos_messages_popup_trm", msg_error);
			}
		});

		$("#btn_edita_trm").click(function() {
			$("#nexos_messages_edita_trm_content").empty();

			var msg_error = "";

			// Se valida contenido del formulario
			var valor = $("#valor").val();
			if (!valor) {
				msg_error += '<p>Debe diligenciar el campo <strong>Tasa Representativa</strong> para poder editar el TRM.</p>';
			}

			if (!msg_error) {
				// Se actualiza la informacion en la base de datos 
				var params = {
					id: $("#id").val(),
					valor: $("#valor").val()
				}
				// console.log(params);

				$.ajax({
					url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=edita_trm",
					type: 'POST',
					data: params,
					cache: false,
					dataType: 'json',
					beforeSend: function(jqXHR, settings) {
						funct_msg_loading(".nexos-messages");
					},
					success: function(data, textStatus, jqXHR) {
						// console.log(data);
						$(".nexos-messages").empty();
						funct_msg_success("#nexos_messages_edita_trm_content", `<p>Se ha modificado el registro con éxito.</p>`);
						$("#edita_trm").animate({
							scrollTop: 0
						}, 600);
						setTimeout(function() {
							location.reload(false);
						}, 800);
					}
				});
			}

			if (msg_error) {
				funct_msg_error("#nexos_messages_edita_trm_content", msg_error);
			}
		});
	});

	function validaTrm(moneda, fecha) {
		// Se pregunta si los campos de fecha y moneda están diligenciados
		if (moneda && fecha) {
			$("#nexos_messages_popup_trm").empty();

			// Se actualiza la informacion en la base de datos 
			var params = {
				moneda: moneda,
				fecha: fecha
			}
			// console.log(params);

			$.ajax({
				url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=valida_trm",
				type: 'POST',
				data: params,
				cache: false,
				dataType: 'json',
				beforeSend: function(jqXHR, settings) {
					funct_msg_loading(".nexos-messages");
				},
				error: function(jqXHR, textStatus, errorThrown) {
					$(".nexos-messages").html('');
				},
				success: function(data, textStatus, jqXHR) {
					// console.log(data);
					msg_error = "";
					$(".nexos-messages").empty();

					$("#valor").removeAttr("readonly");
					if (data.flag_trm) {
						$("#valor").val("").attr("readonly", "readonly");
						msg_error = '<p>El TRM de la moneda <strong>' + data.trm.nom_moneda + ' (' + data.trm.codigo + ')</strong> para la fecha <strong>' + data.trm.fecha + '</strong> seleccionado ya está asignado por valor de <strong>$' + getSeparadorMiles_1(data.trm.valor) + '</strong>.</p>';
					}

					if (msg_error) {
						funct_msg_error("#nexos_messages_popup_trm", msg_error);
					}
				}
			});
		}
	}

	function editaTrm(id, nom_moneda, codigo, valor, fecha) {
		$("#nexos_messages_edita_trm_content").empty();
		$("#edita_trm_title").empty();
		$("#edita_trm_content").empty();

		// Se actualiza la informacion en la base de datos 
		var params = {
			id: id,
			nom_moneda: nom_moneda,
			codigo: codigo,
			valor: valor,
			fecha: fecha
		}
		// console.log(params);

		$.ajax({
			url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=form_edita_trm",
			type: 'POST',
			data: params,
			cache: false,
			dataType: 'json',
			beforeSend: function(jqXHR, settings) {
				funct_msg_loading(".nexos-messages");
			},
			error: function(jqXHR, textStatus, errorThrown) {
				$(".nexos-messages").html('');
			},
			success: function(data, textStatus, jqXHR) {
				// console.log(data);
				$(".nexos-messages").html('');

				$("#edita_trm_title").html(data.title);
				$("#edita_trm_content").html(data.content);
			}
		});
	}
</script>