					$("#nexos_messages_popup_cotizacion").html("");
					if (data.content) {
						$("#edita_cotizacion_title").html(data.content.title);
						$("#contenidoeditacotizacion").html(data.content.content);
						$(".div_respuesta").css("display", "none");
						$(".div_oferta").css("display", "none");
						$(".info_proyecto").css("display", "none");

						$("#flag_cotizacion").change(function() {
							$("#nexos_messages_popup_cotizacion").html('');
							var select = $(this).attr("id");
							$("#" + select + " option[value='']").attr("selected", false);
							$(".selecciona_cotizacion").attr("disabled", false);
							var msg_error = "";

							if ($(this).val()) {
								switch ($(this).val()) {
									case "0": // Cuando no se aprueba la cotización 
										$(".div_respuesta").removeAttr("style");
										$(".div_oferta").css("display", "none");
										break;

									case "1": // Cuando se aprueba la cotización
										$(".div_respuesta").css("display", "none");

										if ($("#oferta_content").length == 0) {
											msg_error += '<p>No se ha presentado ninguna oferta comercial al cliente para poder aprobar la cotización de los proveedores.</p>';
										}

										var flag_aprueba = false;
										$(".concepto").each(function() {
											var div_concepto = $(this).attr("id");
											var accordeon = $("#" + div_concepto + "_nombre").val();
											// Se pregunta si el concepto tiene cotizaciones registradas
											if ($(".div_" + div_concepto).length > 0) {
												flag_aprueba = true;
												var i = 0;
												$(".div_" + $(this).attr("id")).each(function(e) {
													var check_cotizacion = "check_" + div_concepto + "_" + (e + 1);
													if ($("#" + check_cotizacion).prop("checked")) {
														i++;
													}
												});
												// Se pregunta si el concepto ya tiene alguna cotizacion seleccionada
												if (i == 0) {
													msg_error += '<p>No se ha aprobado ninuguna cotización del concepto <strong>' + accordeon + '</strong>.</p>';
												}
											}
										});

										if (!flag_aprueba) {
											msg_error += '<p>No se ha subido ninguna cotización.</p>';
										}

										if (msg_error) {
											$("#nexos_messages_popup_cotizacion").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
											$("#edita_cotizacion").animate({
												scrollTop: 0
											}, 600);
											$("#" + select + " option[value='']").attr("selected", true);
											$("#" + select).val("");
										}
										if (!msg_error) {
											$(".selecciona_cotizacion").attr("disabled", true);
											$(".div_oferta").removeAttr("style");
										}
										break;
								}
							} else {
								$(".div_respuesta").css("display", "none");
								$(".div_oferta").css("display", "none");
							}
						});

						$("#check_info").change(function() {
							// $(".info_proyecto").toggle(500);
							$(".info_proyecto").css("display", "none");
							if ($(this).prop("checked")) {
								$(".info_proyecto").removeAttr("style");
							}
						});

						App.formElements();
					}
				}
			}
		});
		$.ajaxSetup({
			async: true
		});
		if (msg_error) {
			$("#nexos_messages_popup_cotizacion").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
			$("#edita_cotizacion").animate({
				scrollTop: 0
			}, 600);
		}
	}

