	function flag_cotizacion(clase, id) {
		// console.log("Entro en función flag_cotizacion");
		var id_panel_header = id.replace("check", "div_header");
		var class_panel_header = clase.replace("check", "div_header");
		// Se busca la posición del check en la tabla
		var arrayId = id.split("_");
		var id_cotizacion = arrayId[(arrayId.length - 1)];
	
		// Se verifica si el check queda activo
		var flag_checked = false;
		if ($("#" + id).prop('checked')) {
			flag_checked = true;
		}

		// Se inactivan los checks del grupo de cotizaciones 
		$("." + clase).prop("checked", false);

		var arraydiv = clase.split("_");
		var div_accordeon = "";
		for (var i = 1; i < arraydiv.length; i++) {
			if ((arraydiv.length - 1) == i) {
				div_accordeon += arraydiv[i];
			} else {
				div_accordeon += arraydiv[i] + "_";
			}
		}

		// Se pregunta si el check queda activo o inactivo
		$("." + class_panel_header).attr("class", "panel-heading " + class_panel_header);
		$("#" + div_accordeon).attr("class", "panel panel-default panel-border-color panel-border-color-warning concepto");
		if (flag_checked) {
			$("#" + id_panel_header).attr("class", "panel-heading panel-border-color panel-border-color-success " + class_panel_header);
			$("#" + div_accordeon).attr("class", "panel panel-default panel-border-color panel-border-color-success concepto");
			$("#" + id).prop("checked", true);
		}

		// Se actualiza la informacion en la base de datos 
		var params = {
			id_intr_proyecto: $("#id_intr_proyecto").val(),
			id_concepto: $("#id_concepto_" + div_accordeon).val(),
			id_cotizacion: $("#" + div_accordeon + "_id_" + id_cotizacion).val(),
			flag_checked: flag_checked
		}
		// console.log(params);

		$.ajaxSetup({
			async: false
		});
		$.ajax({
			url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=autoriza_cotizacion",
			type: 'POST',
			data: params,
			cache: false,
