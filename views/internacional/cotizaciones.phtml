								grupo: $("#grupo").val(),
								simultaneo: $("#simultaneo").val(),
								tipo_actividad: $("#tipo_actividad").val(),
								costo_real: $("#costo_real").val(),
								respuesta: $("#cotizacion_respuesta").val(),
								id_intr_proyecto: $("#id_intr_proyecto").val(),
							}
							// console.log(params);
							$.ajaxSetup({
								async: false
							});
							$.ajax({
								url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=cancelar_solicitud",
								type: 'POST',
								data: params,
