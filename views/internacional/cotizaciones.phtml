							if (validaFormatoArchivo(formato_archivo, extension[extension.length - 1]) == 0) {
								msg_error_1 += "<p>Formato del archivo del campo <strong>" + campo + "</strong> de la <strong>" + cotizacion + "</strong> del acordeón <strong>" + accordeon + "</strong> no es válido para poder editar el cliente.</p>";
								msg_error_1 += "<p>Formatos válidos: <strong>" + formato_archivo + "</strong>.</p>";
							}
						} else {
							msg_error_1 += "<p>El archivo del campo <strong>" + campo + "</strong> en la pestaña <strong>" + cotizacion + "</strong> del acordeón <strong>" + accordeon + "</strong> es muy pesado para subirlo al servidor. El peso máximo del archivo debe ser menor de <strong>" + ($("#max_file_size").val() / 1000000) + "MB</strong>.</p>";
						}
					}

					if (id_proveedor || proveedor || valor || id_moneda || url) {
						flag_valida = true;
						if (!msg_error_1) {
							params.push(id);
						} else {
							msg_error += msg_error_1;
						}
					}
				});

				if (!flag_valida) {
					msg_error += "<p>No se diligenció nunguna cotización para agregarla a la solicitud</p>";
				}

				if (!msg_error) {
					// console.log("Se puede diligenciar las cotizacioones");
					for (var i = 0; i < params.length; i++) {
						agregarCotizacion(params[i]);
					}
				}
				if (msg_error) {
					$("#nexos_messages_popup_cotizacion").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
					$("#edita_cotizacion").animate({
						scrollTop: 0
					}, 600);
				}
			}
		});
	});

