						if (!$("#cotizacion_respuesta").val() && $(".div_respuesta").css("display") != "none") {
							msg_error += "<p>Debe diligenciar el campo <strong>Observación</strong> para cancelar la cotización.</p>";
						}

						if (!msg_error) {
							var params = {
								id: $("#id_actividad").val(),
								orden: $("#orden").val(),
								fecha_hora_inicio: $("#fecha_hora_inicio").val(),
								id_importacion: $("#id_importacion").val(),
