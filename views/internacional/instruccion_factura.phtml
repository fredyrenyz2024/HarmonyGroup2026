<script type="text/javascript">
	$(document).ready(function(){
		$("#btn_edita_instruccion").click(function(){
			// console.log("Entro en función del btn_edita_instruccion");
			$("#nexos_messages_popup_instruccion").empty();
			$("#proyectos").val("");
			var msg_error = "";

			// Se recorre los proyectos a facturar
			if ($(".check_instrucciones:checked").length > 0 ) {
				var id_proyectos = "";
				$(".check_instrucciones:checked").each(function(){
					id_proyectos+= $(this).val() + ",";
				});
				$("#proyectos").val(id_proyectos);
			} else {
				msg_error+= "<p>No se ha seleccionado ningún proyecto para generar la instrucción de factura.</p>";
			}

			if (!msg_error) {
				try {
					var params = new FormData( $("#form_instruccion")[0]);
					$.ajax({
						url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=crear_instruccion",
						type: 'POST',
						contentType: false,
						data: params,
						cache: false,
						dataType: 'json',
						processData:false,
						beforeSend	: function(jqXHR, settings){
							$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
						},
						error: function (jqXHR, textStatus, errorThrown){
							$(".nexos-messages").html('');
							msg_error+= "<p>" + jqXHR.responseText + "</p>";
							console.log(jqXHR);
							console.log(textStatus);
							console.log(errorThrown);
						},
						success: function (data, textStatus, jqXHR){
							$(".nexos-messages").html('');
							// console.log(data);
							// Se gestiona la actividad 
							$(".check_instrucciones:checked").each(function(){
								var actividades = $(this).closest(".panel").find(".datos_actividad");
								var params = {
									id : actividades.data("id_actividad") + ",",
									orden : actividades.data("orden"),
									fecha_hora_inicio : actividades.data("fecha_hora_inicio"),
									id_importacion : actividades.data("id_importacion"),
									bloque : actividades.data("bloque"),
									grupo : actividades.data("grupo"),
									simultaneo : actividades.data("simultaneo"),
									tipo_actividad : actividades.data("tipo_actividad"),
									costo_real : actividades.data("costo_real"),
									respuesta : actividades.data("respuesta")
								}
								// console.log(params);
								actualizaActividad(params);
							});
						}
					});
				}
				catch(err) {
					msg_error+= "<p><strong>" + err.message + ".</strong> Por favor intente gestionar la actividad nuevamente.</p>";
				}

				if (!msg_error) {
					$("#nexos_messages_popup_instruccion").html('<div role="alert" class="alert alert-success alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Proceso terminado! </strong>Se ha creado el registro con éxito.</div></div>');
					$("#edita_instruccion").animate({ scrollTop: 0 }, 600);
					setTimeout(function() { location.reload(false); }, 800);
				}
				if (msg_error) {
					$("#nexos_messages_popup_instruccion").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
					$("#edita_instruccion").animate({ scrollTop: 0 }, 600);
				}
			}
			if (msg_error) {
				$("#nexos_messages_popup_instruccion").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
				$("#edita_instruccion").animate({ scrollTop: 0 }, 600);
			}
		});
	});

	function editarInstruccion(id, id_perfil){
		//alert('EDITAR INSTRUCCION');
		// console.log("Entro en función editarInstruccion");
		$("#nexos_messages_popup_instruccion").empty();
		$("#edita_instruccion_title").empty();
		$("#contenidoeditainstruccion").empty();
		var msg_error = "";

		var params = {
			id: id,
			id_perfil: id_perfil
		}
		$.ajaxSetup({async: false});
		$.ajax({
			url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=form_instruccion_factura",
			type: 'POST',
			data: params,
			cache: false,
			dataType: 'json',
			beforeSend	: function(jqXHR, settings){
				$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
			},
			error: function (jqXHR, textStatus, errorThrown){
				$(".nexos-messages").html('');
				msg_error+= "<p>" + jqXHR.responseText + "</p>";
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			},
			success: function (data, textStatus, jqXHR){
				$(".nexos-messages").html('');
				// console.log(data);
				if (!msg_error) {
					$("#nexos_messages_popup_instruccion").html("");
					if (data.content) {
						$("#edita_instruccion_title").html(data.content.title);
						$("#contenidoeditainstruccion").html(data.content.content);
						$(".form_content").hide();
						$(".agenciamiento_visible").hide();
						$("#impresion_content").fadeToggle(300);
						$("#impresion_view_content").hide();

						// Función para visualización del modelo de proforma 
						$("#btn_ver_proforma").click(function(){
							$("encabezado_content").empty();
							$("cuerpo_content").empty();
							$("totales_content").empty();
							$('#impresion_view_content').fadeToggle(300);

							if ( $('#impresion_view_content').is(":visible") ) {
								verModeloProforma();
							}
						});

						// Función de check de selección de proyecto a facturar
						$(".check_instrucciones").click(function(){
							//alert('UNO');
							$("#table_impuestos").html("");
							$("#total_factura").val("");
							$("#total_agenciamiento").val("");
							$("#total_sobrecostos").val("");
							$("#iva_factura").val("");
							$("#total_impuestos_pesos").val("");
							$('#impresion_view_content').fadeOut(300);

							$(this).closest('.panel').find('.form_content').fadeToggle(300);
							if (!$(this).is(":checked")) {
								$(this).closest('.panel').find('.check_agenciamiento').prop("checked",false);
								$(this).closest('.panel').find('.valor_pesos').val( $(this).closest(".panel").find(".valor_pesos_fijo").val() );
								$(this).closest('.panel').find('.valor_agenciamiento').val("");
							}

							if ($(".check_instrucciones:checked").length > 0 ) {
								$("#impresion_content").fadeToggle(300);
								var arrayImpuestos = Array();
								var total_factura = 0;
								var total_agenciamiento = 0;
								var total_iva_agenciamiento = 0;
								var total_impuestos = 0;
								var total_sobrecostos = 0;
								$(".check_instrucciones:checked").each(function(){
									//alert('DOS');
									/***** Se liquida el valor de los impuestos que se hallan generado *****/
									if ($(this).closest(".panel").find(".moneda_impuesto").length > 0) {
										$(this).closest(".panel").find(".moneda_impuesto").each(function(){
											var id_moneda_impuesto = $(this).data("id_moneda_impuesto");
											var moneda_impuesto = $(this).val();
											var valor_impuesto = $(this).data("valor_impuesto");
											var valor_pesos = $(this).data("valor_impuesto_pesos");
											var array = {
												id_moneda : id_moneda_impuesto,
												moneda : moneda_impuesto,
												valor_impuesto : valor_impuesto,
												valor_pesos : valor_pesos
											}
											arrayImpuestos.push(array);
										});
									} 
									/***** Fin - Se liquida el valor de los impuestos que se hallan generado *****/

									/***** Se toma el valor total de los sobre costos *****/
									if ( $(this).closest(".panel").find(".total_sobrecosto").length > 0 ) {
										total_sobrecostos+= parseFloat($(this).closest(".panel").find(".total_sobrecosto").val());
									}
									/***** Fin - Se toma el valor total de los sobre costos *****/

									/***** Se liquida el valor total de la proforma de factura *****/
									total_factura+= parseFloat($(this).closest(".panel").find(".valor_pesos_fijo").val());
									if ( $(this).closest(".panel").find(".check_agenciamiento").is(":checked") ) {
										var valor_proyecto = ( parseFloat($(this).closest(".panel").find(".valor_pesos_fijo").val()) * 0.9 );
										var valor_agenciamiento = parseFloat($(this).closest(".panel").find(".valor_pesos_fijo").val()) - valor_proyecto;
										total_agenciamiento+= valor_agenciamiento;
										var iva_agenciamiento = parseFloat(valor_agenciamiento * 0.19);
										total_iva_agenciamiento+= iva_agenciamiento;

										alert('OK');


									} else {
										var valor_proyecto = parseFloat($(this).closest(".panel").find(".valor_pesos_fijo").val());
									}
									$(this).closest(".panel").find(".valor_pesos").val(valor_proyecto);
									$(this).closest(".panel").find(".valor_agenciamiento").val(valor_agenciamiento);
									/***** Fin - Se liquida el valor total de la proforma de factura *****/
								});

								if (total_agenciamiento == 0) { total_agenciamiento = ""; }
								$("#total_agenciamiento").val(total_agenciamiento);

								if (total_iva_agenciamiento == 0) { total_iva_agenciamiento = ""; }
								$("#iva_factura").val(total_iva_agenciamiento);

								if (arrayImpuestos.length > 0) { tablaImpuestos(arrayImpuestos); }

								if ($("#total_impuestos_pesos").length > 0) {
									if (!$("#total_impuestos_pesos").val()) { $("#total_impuestos_pesos").val("0"); } 
								}

								if (total_impuestos == 0) { total_impuestos = ""; }
								if (total_sobrecostos == 0) { total_sobrecostos = ""; }
								$("#total_sobrecostos").val(total_sobrecostos);

								total_factura = total_factura + parseInt($("#total_impuestos_pesos").val()) + total_sobrecostos;
								$("#total_factura").val(total_factura);
							} else { $("#impresion_content").fadeToggle(300); }
						});

						// Función de check de selección del agenciamiento de un proyecto
						$(".check_agenciamiento").click(function(){
							//alert('TRES');
							$("#total_factura").val("");
							$("#total_agenciamiento").val("");
							$("#iva_factura").val("");
							$('#impresion_view_content').fadeOut(300);
							calcularInstruccion();
						});

						$(".valor_facturar").blur(function(){
							$('#impresion_view_content').fadeOut(300);

							var total_factura = 0;
							var total_sobrecostos = 0;
							$(".check_instrucciones:checked").each(function(){
								total_factura+= parseFloat($(this).closest(".panel").find(".valor_pesos_fijo").val());
								/***** Se toma el valor total de los sobre costos *****/
								if ( $(this).closest(".panel").find(".valor_facturar").length > 0 ) {
									$(this).closest(".panel").find(".valor_facturar").each(function(){
										if ($(this).val()) {
											var valor = $(this).val();
											var valor_sobrecosto = valor.replace(/\./g,"").replace(/\,/g,".");
											total_sobrecostos+= parseFloat(valor_sobrecosto);
										}
									});
								}
								$(this).closest(".panel").find(".total_sobrecosto").val(total_sobrecostos);
								/***** Fin - Se toma el valor total de los sobre costos *****/
							});
							total_factura = total_factura + parseInt($("#total_impuestos_pesos").val()) + total_sobrecostos;
							$("#total_factura").val(total_factura);
							$("#total_sobrecostos").val(total_sobrecostos);
						});

						$(".slct_moneda").change(function(){
							$("#tmp_muestra_ajuste").empty();
							$('#impresion_view_content').fadeOut(300);
							var msg_error = "";
							var element = $(this);
							var new_id_moneda = element.val();
							var new_text_moneda = element.find("option:selected").text();

							var panel = element.closest(".panel");
							let valor_oferta = panel.data("valor_oferta");
							let new_valor_oferta = panel.data("valor_oferta");
							let id_oferta = panel.data("id_oferta");
							let flag_valor_oferta = false;
							if (new_id_moneda != 2) {
								$(".trm_dia_facturacion").each(function(){
									if ($(this).data("id_moneda") == new_id_moneda) {
										new_valor_oferta = valor_oferta * $(this).data("valor_facturacion");
										flag_valor_oferta = true;
										return false;
									} 
								});
								if (!flag_valor_oferta) { msg_error+= '<p>No se encontró una TRM para reliquidar la oferta comercial.</p>'; }
							}

							if (!msg_error) {
								$(".nexos-messages").empty();
								let msg_content = '';
								if (new_id_moneda != "2") {
									msg_content = `
										<h4>El valor de la oferta comercial es de <strong>${getSeparadorMiles_1(valor_oferta)} ${new_text_moneda}</strong></h4>
										<h4>El valor de la oferta comercial en <strong>COP</strong> es de <strong>$${getSeparadorMiles_1(new_valor_oferta)}</strong></h4>
									`;
								} else {
									new_valor_oferta = valor_oferta;
									msg_content = `<h4>El valor de la oferta comercial es de <strong>$${getSeparadorMiles_1(new_valor_oferta)} COP</strong></h4>`;
								}
								$("#tmp_muestra_ajuste").html(`
									<div role="alert" class="alert alert-success alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button>
										<div class="text-center">
											${msg_content}
										</div>
									</div></div>
								`);
								let form = element.closest(".form_content");
								form.find(".valor_pesos_fijo").val(new_valor_oferta);
								// form.find(".valor_pesos_fijo").val(new_valor_oferta);
								if ( form.find(".check_agenciamiento").is(":checked") ) {
									var valor_proyecto = ( parseFloat(form.find(".valor_pesos_fijo").val()) * 0.9 );
									var valor_agenciamiento = parseFloat(form.find(".valor_pesos_fijo").val()) - valor_proyecto;
									form.find(".valor_pesos").val(valor_proyecto);
									form.find(".valor_agenciamiento").val(valor_agenciamiento);
								} 
								else { form.find(".valor_pesos").val(new_valor_oferta); }
								calcularInstruccion();

								let params = {
									id: id_oferta,
									id_moneda: new_id_moneda
								}
								actualizaMonedaOferta(params);
							}
							if (msg_error) {
								$(".nexos-messages").empty();
								$("#tmp_muestra_ajuste").html(`
									<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible">
										<div class="icon">
											<span class="mdi mdi-check"></span>
										</div>
										<div class="message">
											<button type="button" data-dismiss="alert" aria-label="Close" class="close">
												<span aria-hidden="true" class="mdi mdi-close"></span>
											</button>
											<strong>Atención!</strong>${msg_error}
										</div>
									</div>
								`);
							}
						});
					}
				}
			}
		});
		$.ajaxSetup({async: true});
		if (msg_error) {
			$("#nexos_messages_popup_instruccion").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
			$("#edita_instruccion").animate({ scrollTop: 0 }, 600);
		}
	}

