	function verModeloProforma(){
		/***** CONTENIDO DEL ENCABEZADO *****/
		var arrayEncabezado = {
			cliente_nombre : $("#tabla_cliente").data("cliente_nombre"),
			cliente_nit : $("#tabla_cliente").data("cliente_nit"),
			cliente_direccion : $("#tabla_cliente").data("cliente_direccion"),
			cliente_municipio : $("#tabla_cliente").data("cliente_municipio"),
		}
		/***** FIN - CONTENIDO DEL ENCABEZADO *****/

		/***** CONTENIDO DEL CUERPO *****/
		var arrayCuerpo = new Array();
		$(".check_instrucciones:checked").each(function(){
			var arrayProyecto = new Array();
			var id_proyecto = $(this).closest(".panel").data("id_proyecto");

			/***** Se buscan los valores a liquidar el proyecto *****/
			var agenciamiento = false;
			if ( $(this).closest(".panel").find(".check_agenciamiento").is(":checked") ) {
				agenciamiento = true;
			}
			var valor_servicio = $(this).closest(".panel").find(".valor_pesos").val();
			var valor_agenciamiento = $(this).closest(".panel").find(".valor_agenciamiento").val();
			var arrayValores = {
				agenciamiento : agenciamiento,
				valor_servicio : valor_servicio,
				valor_agenciamiento : valor_agenciamiento
			}
			/***** Fin - Se buscan los valores a liquidar el proyecto *****/

			/***** Se buscan los conceptos a mostrar en la factura *****/
			if ($(this).closest(".panel").find(".conceptos").length > 0) {
				// Se hay conceptos seleccionados se adicionan al arreglo
				var arrayConceptos = new Array();
				if ( $(this).closest(".panel").find(".check_concepto:checked").length > 0 ) {
					$(this).closest(".panel").find(".check_concepto:checked").each(function(){
						arrayConceptos.push($(this).data("concepto"));
					});
				}
			}
			/***** Fin - Se buscan los conceptos a mostrar en la factura *****/

			/***** Se buscan la información de los impuestos *****/
			var arrayDatosImpuestos = new Array();
			if ($(this).closest(".panel").find(".impuestos").length > 0) {
				if ( $(this).closest(".panel").find(".impuestos").find(".datos_impuesto").length > 0 ) {
					$(this).closest(".panel").find(".impuestos").find(".datos_impuesto").each(function(){
						var datos_impuestos = {
							id: $(this).val(),
							id_proyecto : id_proyecto,
							valor: $(this).data("valor_pesos"),
							descripcion: $(this).data("descripcion")
						}
						arrayDatosImpuestos.push(datos_impuestos);
					});
				}
			}
			/***** Fin - Se buscan la información de los impuestos *****/

			/***** Se buscan el total por moneda de los impuestos *****/
			var arrayTotalImpuestos = new Array();
			if ($(this).closest(".panel").find(".impuestos").length > 0) {
				if ( $(this).closest(".panel").find(".impuestos").find(".suma_impuestos").length > 0 ) {
					$(this).closest(".panel").find(".impuestos").find(".suma_impuestos").each(function(){
						var datos_impuestos = {
							moneda: $(this).data("moneda"),
							valor: $(this).val()
						}
						arrayTotalImpuestos.push(datos_impuestos);
					});
				}
			}
			/***** Fin - Se buscan el total por moneda de los impuestos *****/

			/***** Se buscan la información de los sobrecostos *****/
			var arrayDatosSobrecostos = new Array();
			if ($(this).closest(".panel").find(".sobrecostos").length > 0) {
				if ( $(this).closest(".panel").find(".sobrecostos").find(".valor_facturar").length > 0 ) {
					$(this).closest(".panel").find(".sobrecostos").find(".valor_facturar").each(function(){
						var valor = $(this).val();
						valor = valor.replace(/\./g,"").replace(/\,/g,".")
						var datos_sobrecosto = {
							id: $(this).data("id"),
							id_proyecto : id_proyecto,
							valor: valor,
							descripcion: $(this).data("descripcion")
						}
						arrayDatosSobrecostos.push(datos_sobrecosto);
					});
				}
			}
			/***** Fin - Se buscan la información de los sobrecostos *****/

			arrayProyecto.push(id_proyecto,arrayConceptos,arrayValores,arrayDatosImpuestos,arrayTotalImpuestos,arrayDatosSobrecostos);
			arrayCuerpo.push(arrayProyecto);
		});
		var cuerpo = arrayCuerpo;
		/***** FIN - CONTENIDO DEL CUERPO *****/

		/***** CONTENIDO DE LOS TOTALES DE LA PROFORMA *****/
		// Contenido de los trm del día 
		var arrayTRM = new Array();
		if ($("#contenidoeditainstruccion").find(".trm_dia_facturacion").length > 0) {
			$("#contenidoeditainstruccion").find(".trm_dia_facturacion").each(function(){
				var datos = {
					moneda: $(this).data("moneda_trm"),
					valor: $(this).data("valor_facturacion")
				}
				arrayTRM.push(datos);
			});
		}

		// Contenido de los totales de la factura 
		var valor_iva = $("#iva_factura").val();
		if (!valor_iva) { valor_iva = 0; }
		var retefuente = 0;
		var valor_total_factura = ( parseFloat($("#total_factura").val()) - parseFloat(retefuente) + parseFloat(valor_iva) );
		var arrayTotales = {
			subtotal : parseInt($("#total_factura").val()),
			retefuente : retefuente,
			valor_iva : valor_iva,
			valor_total_factura : valor_total_factura,
			trm_dia : arrayTRM
		}
		/***** FIN - CONTENIDO DE LOS TOTALES DE LA PROFORMA *****/

		var msg_error = "";
		var params = {
			encabezado : arrayEncabezado,
			cuerpo : cuerpo,
			totales : arrayTotales
		}
		// console.log(params);

		$.ajax({
			url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=ver_formato_proforma",
			type: 'POST',
			data: params,
			cache: false,
			dataType: 'json',
			beforeSend	: function(jqXHR, settings){
				$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
			},
			error: function (jqXHR, textStatus, errorThrown){
				$(".nexos-messages").html('');
				msg_error+= "<p>" + jqXHR.responseText + "</p>";
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			},
			success: function (data, textStatus, jqXHR){
				// console.log(data);
				$(".nexos-messages").html('');
				$("#encabezado_content").html(data.content.encabezado);
				$("#cuerpo_content").html(data.content.cuerpo);
				$("#totales_content").html(data.content.totales);
			}
		});
		if (msg_error) {
			$("#nexos_messages_popup_instruccion").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
			$("#edita_instruccion").animate({ scrollTop: 0 }, 600);
		}
	}

