<script type="text/javascript">
	$(document).ready(function(){
		$("#btn_registrar_pago").click(function(){
			$("#nexos_messages_popup_cartera").empty();
			var msg_error = "";

			var id_facturas = $("#id_facturas");
			var check_factura = $(".check_factura:checked");
			var fecha_pago = $("#fecha_pago");
			var recibo_caja = $("#recibo_caja");
			var valor_pagado = $("#valor_pagado");
			var total_facturas = $("#total_facturas");

			if (check_factura.length == 0) {
				msg_error+= `<p>Debe seleccionar por lo menos una factura para registrar el pago del cliente.</p>`;
			} else {
				if (!fecha_pago.val()) {
					msg_error+= `<p>Debe diligenciar el campo <strong>${fecha_pago.attr("placeholder")}</strong> para registrar el pago del cliente.</p>`;
				}
				if (!recibo_caja.val()) {
					msg_error+= `<p>Debe diligenciar el campo <strong>${recibo_caja.attr("placeholder")}</strong> para registrar el pago del cliente.</p>`;
				}
				if (!valor_pagado.val()) {
					msg_error+= `<p>Debe diligenciar el campo <strong>${valor_pagado.attr("placeholder")}</strong> para registrar el pago del cliente.</p>`;
				}
				var url = $("#recibo_caja_file").val();
				if ( !url ) {
					msg_error+= `<p>Debe diligenciar el campo <strong>Adjunto</strong> para registrar el pago del cliente.</p>`;
				}else{
					var adjunto = $("#recibo_caja_file")[0].files[0];
					// Se valida el peso del archivo
					if ( adjunto.size < $("#max_file_size").val() ) {
						// Se valida el tipo de archivo
						var extension = adjunto.name.split(".");
						var formato_archivo = "pdf,PDF,zip,ZIP,rar,RAR,doc,DOC,docx,DOCX,jpg,jpeg,png,gif,bmp,tif,JPG,JPEG,PNG,GIF,BMP,TIF,xls,XLS,xlsx,XLSX,ppt,PPT,pptx,PPTX,pps,PPS,ppsx,PPSX,ods,ODS";
						if( validaFormatoArchivo( formato_archivo , extension[ extension.length - 1 ]) == 0 ){
							msg_error+= `<p>Formato del archivo del campo <strong>Adjunto</strong> no es válido para registrar el pago del cliente.</p>`;
							msg_error+= `<p>Formatos válidos: <strong>${formato_archivo}</strong>.</p>`;
						}
					} else {
						msg_error+= `<p>El archivo del campo <strong>Adjunto</strong> es muy pesado para subirlo al servidor. El peso máximo del archivo debe ser menor de <strong>${($("#max_file_size").val() / 1000000 )}MB</strong>.</p>`;
					}
				}
			}
			// Se valida el valor a registrar
			if (!msg_error) {
				var valor_pagado_1 = String(valor_pagado.val()).replace(/\./g,'').replace(/\,/g,'.');
				if ( parseFloat(valor_pagado_1) > (parseFloat(total_facturas.val()) * 1.1) ) {
					msg_error+= `<p>El valor a registrar no puede ser mayor del <strong>10%</strong> adicional del total de las facturas.</p>`;
				} else if (parseFloat(valor_pagado_1) < (parseFloat(total_facturas.val()) * 0.9) ) {
					msg_error+= `<p>El valor a registrar no puede ser menor del <strong>90%</strong> del valor total de las facturas.</p>`;
				}
			}

			$.ajaxSetup({async: false});
			if (!msg_error) {
				var params = new FormData();
				params.append('id_facturas', id_facturas.val() );
				params.append('fecha_pago', fecha_pago.val() );
				params.append('recibo_caja', recibo_caja.val() );
				params.append('valor_pagado', valor_pagado_1 );
				params.append('url', $("#recibo_caja_file")[0].files[0] );

				$.ajax({
					url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=pago_cartera",
					type: 'POST',
					data: params,
					dataType: 'json',
					cache: false,
					contentType: false,
					processData:false,
					beforeSend	: function(jqXHR, settings){
						funct_msg_loading(".nexos-messages");
					},
					error: function (jqXHR, textStatus, errorThrown){
						$(".nexos-messages").html('');
						msg_error+= "<p>" + jqXHR.responseText + "</p>";
						console.log(jqXHR);
						console.log(textStatus);
						console.log(errorThrown);
					},
					success: function (data, textStatus, jqXHR){
						$(".nexos-messages").html('');
						// console.log(data);
						if (data.error) { msg_error+= data.error; }
					}
				});
			}
			if (!msg_error) {
				funct_msg_success("#nexos_messages_popup_cartera");
				$("#ver_cartera").animate({ scrollTop: 0 }, 600);
				setTimeout(function() { location.reload(false); }, 800);
			}
			if (msg_error) {
				funct_msg_error("#nexos_messages_popup_cartera", msg_error); 
				$("#ver_cartera").animate({ scrollTop: 0 }, 600);
			}
			$.ajaxSetup({async: true});
		});
	});

	function verRegistrarPago(id){
		$("#nexos_messages_popup_cartera").empty();
		$("#ver_cartera_title").empty();
		$("#contenidocartera").empty();
		var msg_error = "";

		var params = {
			id: id,
		}

		$.ajaxSetup({async: false});
		$.ajax({
			url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=form_pago_cartera",
			type: 'POST',
			data: params,
			cache: false,
			dataType: 'json',
			beforeSend	: function(jqXHR, settings){
				funct_msg_loading(".nexos-messages");
			},
			error: function (jqXHR, textStatus, errorThrown){
				$(".nexos-messages").html('');
				msg_error+= "<p>" + jqXHR.responseText + "</p>";
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			},
			success: function (data, textStatus, jqXHR){
				$(".nexos-messages").html('');
				// console.log(data);
				if (!msg_error) {
					$("#nexos_messages_popup_cartera").empty();
					if (data.content) {
						$("#ver_cartera_title").html(data.content.title);
						$("#contenidocartera").html(data.content.content);
						$("#btn_registrar_pago").show();

						$("#check_todos").change(function(){
							if ($(this).is(":checked")) { $(".check_factura").prop("checked", true); }
							else { $(".check_factura").prop("checked", false); }
							sumaFacturasCliente();
						});

						$(".check_factura").change(function(){
							$("#check_todos").prop("checked", false);
							sumaFacturasCliente();
						});
						App.formElements();
					}
				}
			}
		});
		if (msg_error) {
			funct_msg_error("#nexos_messages_popup_cartera", msg_error); 
			$("#ver_cartera").animate({ scrollTop: 0 }, 600);
		}
		$.ajaxSetup({async: true});
	}

	function sumaFacturasCliente(){
		let total = 0;
		let id_facturas = '';
		var checks = $(".check_factura:checked");
		if (checks.length) {
			checks.each(function(){
				total+= $(this).data("total");
				id_facturas+= `${$(this).data("id_factura")},`;
			})
		}

		var texto_total_facturas;
		var arrayValorFacturas = String(total).split(".");
		if (arrayValorFacturas.length == 1 ) {
			texto_total_facturas = total * 100;
		} else {
			texto_total_facturas = total;
			if (arrayValorFacturas[1].length > 2) {
				var decimal = arrayValorFacturas[1][0] + arrayValorFacturas[1][1];
				texto_total_facturas = arrayValorFacturas[0] + "." + decimal;
			} else if (arrayValorFacturas[1].length < 2) {
				texto_total_facturas = total + "0";
			}
		}
		var valor_facturas = getFormatoNumeroDecimal_value( texto_total_facturas );

		if (total > 0) {
			$("#total_facturas_text").html(`$${valor_facturas}`);
			$("#valor_pagado").val(valor_facturas);
		} else {
			$("#total_facturas_text").html(`$0`);
			$("#valor_pagado").val("");
		}
		$("#id_facturas").val(id_facturas);
		$("#total_facturas").val(total);
	}

	function verDatosCartera(id){
		$("#nexos_messages_popup_cartera").empty();
		$("#ver_factura_title").empty();
		$("#contenidofactura").empty();
		var msg_error = "";

		var params = {
			id: id,
		}

		$.ajaxSetup({async: false});
		$.ajax({
			url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=info_cartera",
			type: 'POST',
			data: params,
			cache: false,
			dataType: 'json',
			beforeSend	: function(jqXHR, settings){
				funct_msg_loading(".nexos-messages");
			},
			error: function (jqXHR, textStatus, errorThrown){
				$(".nexos-messages").html('');
				msg_error+= "<p>" + jqXHR.responseText + "</p>";
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			},
			success: function (data, textStatus, jqXHR){
				$(".nexos-messages").html('');
				// console.log(data);
				if (!msg_error) {
					$("#nexos_messages_popup_cartera").html("");
					if (data.content) {
						$("#ver_factura_title").html(data.content.title);
						$("#contenidofactura").html(data.content.content);
					}
				}
			}
		});
		$.ajaxSetup({async: true});
		if (msg_error) {
			funct_msg_error("#nexos_messages_popup_cartera", msg_error); 
			$("#ver_factura").animate({ scrollTop: 0 }, 600);
		}
	}
</script>
