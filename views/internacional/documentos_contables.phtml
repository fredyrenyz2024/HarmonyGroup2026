<script type="text/javascript">
	$(document).ready(function() {
		$("#btn_edita_cotizacion").click(function() {
			// console.log("Entro en función del btn_edita_cotizacion");
			$("#nexos_messages_popup_cotizacion").empty();
			var flag_sube_factura = false;
			var flag_sube_sobrecosto = false;
			var msg_error = "";
			var arrayFacturas = new Array();

			/***** Validación de campos del formulario de sobrecosto *****/
			if ($("#check_sobrecosto").prop("checked")) {
				var concepto = $("#slct_conceptos_").val();
				var fecha = $("#fecha").val();
				var id_proveedor = $("#slct_proveedores_").val();
				var proveedor = $("#proveedor").val();
				var factura = $("#factura").val();
				var valor = $("#valor").val();
				var id_moneda = $("#slct_monedas_").val();
				var file = $("#file").val();
				var descripcion = $("#descripcion").val();

				// Se valida si se debe validar la información del formulario
				if (concepto || id_proveedor || proveedor || factura || valor || id_moneda || file || descripcion) {
					flag_sube_sobrecosto = true;

					if (!concepto) {
						msg_error += "<p>Debe seleccionar un <strong>Concepto</strong> para crear el sobrecosto.</p>";
					}
					if (!fecha) {
						msg_error += "<p>Debe diligenciar el campo <strong>Fecha</strong> para crear el sobrecosto.</p>";
					}
					if (!id_proveedor) {
						msg_error += "<p>Debe seleccionar un <strong>Proveedor</strong> para crear el sobrecosto.</p>";
					}
					if (!factura) {
						msg_error += "<p>Debe diligenciar el campo <strong># Factura Proveedor</strong> para crear el sobrecosto.</p>";
					}
					if (!valor) {
						msg_error += "<p>Debe diligenciar el campo <strong>Valor</strong> para crear el sobrecosto.</p>";
					}
					if (!id_moneda) {
						msg_error += "<p>Debe seleccionar una <strong>Moneda</strong> para crear el sobrecosto.</p>";
					}

					if (!file) {
						msg_error += "<p>Debe diligenciar seleccionar un <strong>Adjunto Factura</strong> para crear el sobrecosto.</p>";
					} else {
						var adjunto = $("#file")[0].files[0];
						// Se valida el peso del archivo
						if (adjunto.size < $("#max_file_size").val()) {
							// Se valida el tipo de archivo
							var extension = adjunto.name.split(".");
							var formato_archivo = "pdf,PDF,zip,ZIP,rar,RAR,doc,DOC,docx,DOCX,jpg,jpeg,png,gif,bmp,tif,JPG,JPEG,PNG,GIF,BMP,TIF,xls,XLS,xlsx,XLSX,ppt,PPT,pptx,PPTX,pps,PPS,ppsx,PPSX,ods,ODS";
							if (validaFormatoArchivo(formato_archivo, extension[extension.length - 1]) == 0) {
								msg_error += "<p>Formato del archivo del campo <strong>Adjunto Factura</strong> no es válido para poder crear el sobrecosto.</p>";
								msg_error += "<p>Formatos válidos: <strong>" + formato_archivo + "</strong>.</p>";
							}
						} else {
							msg_error += "<p>El archivo del campo <strong>Adjunto Factura</strong> es muy pesado para subirlo al servidor. El peso máximo del archivo debe ser menor de <strong>" + ($("#max_file_size").val() / 1000000) + "MB</strong>.</p>";
						}
					}
					if (!descripcion) {
						msg_error += "<p>Debe diligenciar el campo <strong>Descripción</strong> para crear el sobrecosto.</p>";
					}
				}
			}
			/***** Fin - Validación de campos del formulario de sobrecosto *****/

			/***** Validación de campos del formulario de subir varias facturas por cotización *****/
			$(".proveedor").each(function() {
				var div = $(this).attr("id").split("_");
				var id = div[1];

				var proveedor = $(this).find(".accordion_title").text();

				if ($(this).find("#file_" + id).length > 0) {
					var factura = $("#factura_" + id).val();
					var fecha = $("#fecha_" + id).val();
					var valor = $("#valor_" + id).val();
					var id_moneda = $(this).find("#slct_monedas_").val();
					var adjunto = $(this).find("#file_" + id)[0].files[0];

					if (valor == "0" || valor == 0) {
						valor = "";
					}

					if (factura || valor || id_moneda || adjunto || $(this).find(".check_cotizacion:checked").length > 0) {
						flag_sube_factura = true;
						if (!factura) {
							var campo = $("#factura_" + id).attr("placeholder");
							msg_error += "<p>Debe diligenciar el campo <strong>" + campo + "</strong> para subir la factura del proveedor <strong>" + proveedor + "</strong>.</p>";
						}

						if (!fecha) {
							var campo = $("#fecha_" + id).attr("placeholder");
							msg_error += "<p>Debe diligenciar el campo <strong>" + campo + "</strong> para subir la factura del proveedor <strong>" + proveedor + "</strong>.</p>";
						}

						if (!valor) {
							var campo = $("#valor_" + id).attr("placeholder");
							msg_error += "<p>Debe diligenciar el campo <strong>" + campo + "</strong> para subir la factura del proveedor <strong>" + proveedor + "</strong>.</p>";
						}

						if (!id_moneda) {
							var campo = "Moneda Factura";
							msg_error += "<p>Debe diligenciar el campo <strong>" + campo + "</strong> para subir la factura del proveedor <strong>" + proveedor + "</strong>.</p>";
						}

						var campo = $("#valor_" + id).attr("placeholder");
						if (adjunto) {
							// Se valida el peso del archivo
							if (adjunto.size < $("#max_file_size").val()) {
								// Se valida el tipo de archivo
								var extension = adjunto.name.split(".");
								var formato_archivo = "pdf,PDF,zip,ZIP,rar,RAR,doc,DOC,docx,DOCX,jpg,jpeg,png,gif,bmp,tif,JPG,JPEG,PNG,GIF,BMP,TIF,xls,XLS,xlsx,XLSX,ppt,PPT,pptx,PPTX,pps,PPS,ppsx,PPSX";
								if (validaFormatoArchivo(formato_archivo, extension[extension.length - 1]) == 0) {
									msg_error += "<p>Formato de la factura para el proveedor <strong>" + proveedor + "</strong> no es válido.</p>";
									msg_error += "<p>Formatos válidos: <strong>" + formato_archivo + "</strong>.</p>";
								}
							} else {
								msg_error += "<p>El archivo de la factura para el proveedor <strong>" + proveedor + "</strong> es muy pesado para subirlo al servidor. El peso máximo del archivo debe ser menor de <strong>" + ($("#max_file_size").val() / 1000000) + "MB</strong>.</p>";
							}
						} else {
							msg_error += "<p>Debe seleccionar un <strong>Adjunto Factura</strong> para subir la factura del proveedor <strong>" + proveedor + "</strong>.</p>";
						}

						if ($(this).find(".check_cotizacion:checked").length == 0) {
							msg_error += "<p>Debe seleccionar al menos una <strong>Cotización</strong> para subir la factura del proveedor <strong>" + proveedor + "</strong>.</p>";
						}
					}
				}
			});
			/***** Fin - Validación de campos del formulario de subir varias facturas por cotización *****/

			if (!flag_sube_factura && !flag_sube_sobrecosto) {
				msg_error += '<p>No se seleccionó nungún archivo de factura para subir.</p>';
			}

			if (!msg_error) {
				if (flag_sube_factura) {
					// console.log("Se guarda la información de las facturas de las cotizaciones ya creadas");
					var params = new FormData($("#form_facturas")[0]);

					$.ajax({
						url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=adjunta_factura",
						type: 'POST',
						contentType: false,
						data: params,
						cache: false,
						dataType: 'json',
						processData: false,
						beforeSend: function(jqXHR, settings) {
							$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
						},
						error: function(jqXHR, textStatus, errorThrown) {
							$(".nexos-messages").html('');
							msg_error += "<p>" + jqXHR.responseText + "</p>";
							console.log(jqXHR);
							console.log(textStatus);
							console.log(errorThrown);
						},
						success: function(data, textStatus, jqXHR) {
							$(".nexos-messages").html('');
							// console.log(data);
						}
					});
				}

				if (flag_sube_sobrecosto) {
					// console.log("Se guarda la información de las facturas de los sobrecostos nuevos");
					var params = new FormData($("#form_sobrecostos")[0]);

					$.ajax({
						url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=adjunta_sobrecosto",
						type: 'POST',
						contentType: false,
						data: params,
						cache: false,
						dataType: 'json',
						processData: false,
						beforeSend: function(jqXHR, settings) {
							$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
						},
						error: function(jqXHR, textStatus, errorThrown) {
							$(".nexos-messages").html('');
							msg_error += "<p>" + jqXHR.responseText + "</p>";
							console.log(jqXHR);
							console.log(textStatus);
							console.log(errorThrown);
						},
						success: function(data, textStatus, jqXHR) {
							$(".nexos-messages").html('');
							// console.log(data);
						}
					});
				}

				if (!msg_error) {
					$("#nexos_messages_popup_cotizacion").html('<div role="alert" class="alert alert-success alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Proceso terminado! </strong>Se ha creado el registro con éxito.</div></div>');
					$("#edita_cotizacion").animate({
						scrollTop: 0
					}, 600);
					setTimeout(function() {
						location.reload(false);
					}, 800);
				}
				if (msg_error) {
					$("#nexos_messages_popup_cotizacion").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
					$("#edita_cotizacion").animate({
						scrollTop: 0
					}, 600);
				}
			}
			if (msg_error) {
				$("#nexos_messages_popup_cotizacion").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
				$("#edita_cotizacion").animate({
					scrollTop: 0
				}, 600);
			}
		});
	});

	function editarCotizacion(id) {
		// console.log("Entro en función editarCotizacion");
		$("#nexos_messages_popup_cotizacion").empty();
		$("#edita_cotizacion_title").empty();
		$("#contenidoeditacotizacion").empty();
		var msg_error = "";

		var params = {
			id: id,
		}

		$.ajaxSetup({
			async: false
		});
		$.ajax({
			url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=editar_adjunta_cotizacion",
			type: 'POST',
			data: params,
			cache: false,
			dataType: 'json',
			beforeSend: function(jqXHR, settings) {
				$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
			},
			error: function(jqXHR, textStatus, errorThrown) {
				$(".nexos-messages").html('');
				msg_error += "<p>" + jqXHR.responseText + "</p>";
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			},
			success: function(data, textStatus, jqXHR) {
				$(".nexos-messages").html('');
				// console.log(data);
				if (!msg_error) {
					$("#nexos_messages_popup_cotizacion").html("");
					if (data.content) {
						$("#edita_cotizacion_title").html(data.content.title);
						$("#contenidoeditacotizacion").html(data.content.content);
						$(".info_proyecto").css("display", "none");

						$("#check_info").change(function() {
							$(".info_proyecto").css("display", "none");
							if ($(this).prop("checked")) {
								$(".info_proyecto").removeAttr("style");
							}
						});
					}

					// Se crea funcion para crear el formulario de sobrecosto
					$("#check_sobrecosto").change(function() {
						// console.log("Entro en función de change de check_sobrecosto");
						$("#form_sobrecosto").css("display", "none");
						if ($(this).prop("checked")) {
							$("#form_sobrecosto").css("display", "block");
						}
					});

					$("#slct_conceptos_").change(function() {
						$("#div").val($("#slct_conceptos_ option:selected").text());
						$("#descripcion").val("");
						if ($(this).val() == 11) {
							$("#descripcion").val("Derecho de aduana e IVA arancelario");
						}
					});

					$(".check_cotizacion_todos").change(function() {
						// console.log("Entro en función de change de check_cotizacion_todos");
						if ($(this).prop("checked")) {
							$(this).closest(".panel").find(".check_cotizacion:enabled").prop("checked", true);
						} else {
							$(this).closest(".panel").find(".check_cotizacion:enabled").removeAttr("checked");
						}
					});

					App.formElements();
				}
			}
		});
		$.ajaxSetup({
			async: true
		});
		if (msg_error) {
			$("#nexos_messages_popup_cotizacion").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
			$("#edita_cotizacion").animate({
				scrollTop: 0
			}, 600);
		}
	}

	function actualizaActividad(params) {
		// console.log(params);
		var msg_error = "";

		// Se actualizan las actividades del proyecto
		$.ajax({
			type: "POST",
			cache: false,
			url: $("#id_url_ajax").val() + "libs/gestion_actividades.php?tabla=cmx_importacion_actividades&proyecto=importacion",
			data: params,
			beforeSend: function(jqXHR, settings) {
				$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
			},
			error: function(data) {
				console.log(data);
				$(".nexos_messages_popup_cotizacion").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Proceso terminado!</strong> Error en la creación del registro.</div></div>');
			},
			success: function(data) {
				console.log(data);
			}
		});
	}

	function gestionarActividad(id) {
		// console.log("Entro en función gestionarActividad");
		$("#gestiona_actividad_popup").empty();
		$("#gestiona_actividad_content").empty();

		var msg_error = "";

		var params = {
			id: id,
		}

		$.ajax({
			url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=form_gestiona_actividad_facturas",
			type: 'POST',
			data: params,
			cache: false,
			dataType: 'json',
			beforeSend: function(jqXHR, settings) {
				$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
			},
			error: function(jqXHR, textStatus, errorThrown) {
				$(".nexos-messages").html('');
				msg_error += "<p>" + jqXHR.responseText + "</p>";
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			},
			success: function(data, textStatus, jqXHR) {
				// console.log(data);
				$(".nexos-messages").html('');
				$("#gestiona_actividad_content").html(data.content);

				$("#btn_gestiona_actividad").click(function() {
					actualizaActividad(data.actividad);
					$("#gestiona_actividad_popup").html('<div role="alert" class="alert alert-success alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Proceso terminado! </strong>Se ha creado el registro con éxito.</div></div>');
					$("#edita_cotizacion").animate({
						scrollTop: 0
					}, 600);
					setTimeout(function() {
						location.reload(false);
					}, 800);
				});
			}
		});
		if (msg_error) {
			$("#gestiona_actividad_popup").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
			$("#edita_cotizacion").animate({
				scrollTop: 0
			}, 600);
		}
	}

	function buscaProveedor(element) {
		// console.log("Entro en función buscaProveedor");
		var id = $(element).attr("id");
		$("#proveedor").val($("#" + id + " option:selected").text());
	}
</script>