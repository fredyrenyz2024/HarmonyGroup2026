<script type="text/javascript">
	$(document).ready(function(){
		$("#btn_sube_egreso").click(function(){
			// console.log("Entro en función del btn_sube_egreso");
			$("#nexos_messages_popup_sube_egreso").empty();
			var msg_error = "";

			/***** Validación de campos del formulario de subir la solicitud de egreso *****/
			if ($(".check_facturas:checked").length == 0) {
				msg_error+= "<p>Para poder subir la solicitud de egreso debe seleccionar al menos una <strong>factura</strong>.</p>";
			}
			/***** Fin - Validación de campos del formulario de subir la solicitud de egreso *****/

			if (!msg_error) {
				// console.log("Se guarda la información de las facturas de las cotizaciones ya creadas");
				var params = new FormData( $("#form_egreso")[0] );

				$.ajax({
					url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=adjunta_egreso",
					type: 'POST',
					contentType: false,
					data: params,
					cache: false,
					dataType: 'json',
					processData:false,
					beforeSend	: function(jqXHR, settings){
						$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
					},
					error: function (jqXHR, textStatus, errorThrown){
						$(".nexos-messages").html('');
						msg_error+= "<p>" + jqXHR.responseText + "</p>";
						console.log(jqXHR);
						console.log(textStatus);
						console.log(errorThrown);
					},
					success: function (data, textStatus, jqXHR){
						$(".nexos-messages").html('');
						// console.log(data);

						for (var i = 0; i < data.flag_gestion.length; i++) {
							let array = data.flag_gestion[i];

							// Si no hay egresos pendientes se gestiona la actividad 
							if (array.egresos_pendientes["EGRESOS_PENDIENTES"] == 0 && array.flag_gestiona_subir_facturas) {
								var params = {
									id: array.egresos_pendientes["ID_ACTIVIDAD"] + ",",
									orden: array.egresos_pendientes["orden"],
									fecha_hora_inicio: array.egresos_pendientes["fecha_hora_inicio"],
									id_importacion: array.egresos_pendientes["id_importacion"],
									bloque: array.egresos_pendientes["bloque"],
									grupo: array.egresos_pendientes["grupo"],
									simultaneo: array.egresos_pendientes["EGRESOS_PENDIENTES"],
									tipo_actividad: array.egresos_pendientes["tipo_actividad"],
									costo_real: array.egresos_pendientes["costo_real"],
									respuesta: array.egresos_pendientes["respuesta"],
								}
								// console.log(params);
								actualizaActividad(params);
							} 
						}
					}
				});

				if (!msg_error) {
					$("#nexos_messages_popup_sube_egreso").html('<div role="alert" class="alert alert-success alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Proceso terminado! </strong>Se ha creado el registro con éxito.</div></div>');
					$("#sube_egreso").animate({ scrollTop: 0 }, 600);
					setTimeout(function() { location.reload(false);  }, 800);
				}
				if (msg_error) {
					$("#nexos_messages_popup_sube_egreso").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
					$("#sube_egreso").animate({ scrollTop: 0 }, 600);
				}
			}
			if (msg_error) {
				$("#nexos_messages_popup_sube_egreso").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
				$("#sube_egreso").animate({ scrollTop: 0 }, 600);
			}
		});
	});

	function subirEgreso(id){
		// console.log("Entro en función subirEgreso");
		$("#nexos_messages_popup_sube_egreso").empty();
		$("#sube_egreso_title").empty();
		$("#contenidosubeegreso").empty();
		var msg_error = "";

		var params = {
			id: id,
		}

		$.ajaxSetup({async: false});
		$.ajax({
			url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=form_adjunta_egreso",
			type: 'POST',
			data: params,
			cache: false,
			dataType: 'json',
			beforeSend	: function(jqXHR, settings){
				$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
			},
			error: function (jqXHR, textStatus, errorThrown){
				$(".nexos-messages").html('');
				msg_error+= "<p>" + jqXHR.responseText + "</p>";
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			},
			success: function (data, textStatus, jqXHR){
				// console.log(data);
				$(".nexos-messages").html('');
				if (!msg_error) {
					$("#nexos_messages_popup_sube_egreso").html("");
					if (data.content) {
						$("#sube_egreso_title").html(data.content.title);
						$("#contenidosubeegreso").html(data.content.content);

						$(".check_facturas").click(function(){
							$("#id_facturas").val("");
							var id = $(this).val();
							var proveedor = $("#nom_proveedor" ).text();
							var id_moneda = $(this).data("moneda");
							var id_facturas = "";
							var total_facturas_pesos = 0;

							if ( $(this).prop("checked") ) {
								$(".check_facturas").each(function(){
									if ( !$(this).prop("disabled") ) {
										var id_moneda_1 = $(this).data("moneda");
										if (id_moneda == id_moneda_1) {
											if ($(this).prop("checked")) {
												var factura_pesos = $(this).data("factura_pesos");
												total_facturas_pesos = parseFloat(total_facturas_pesos) + parseFloat(factura_pesos);
												id_facturas+= $(this).val() + ",";
											}
										} else {
											$(this).attr("disabled", true);
										}
									}
								});
							} else {
								if ( $(".check_facturas:checked").length == 0 ) {
									$(".check_facturas").attr("disabled", false);
									$(".check_facturas").each(function(){
										var factura_pesos = $(this).data("factura_pesos");
										if ( factura_pesos > 0 ) {
											$(this).attr("disabled", false);
										}
									});
								} else {
									$(".check_facturas").each(function(){
										if ( $(this).prop("checked") ) {
											id_facturas+= $(this).val() + ",";
											var valor_factura = $(this).data("factura_pesos");
											total_facturas_pesos = parseFloat(total_facturas_pesos) + parseFloat(valor_factura);
										}
									});
								}
							}

							var texto_valor_facturas;
							var arrayValorFacturasPesos = String(total_facturas_pesos).split(".");
							if (arrayValorFacturasPesos.length == 1 ) {
								texto_valor_facturas = total_facturas_pesos * 100;
							} else {
								texto_valor_facturas = total_facturas_pesos;
								if (arrayValorFacturasPesos[1].length > 2) {
									var decimal = arrayValorFacturasPesos[1][0] + arrayValorFacturasPesos[1][1];
									texto_valor_facturas = arrayValorFacturasPesos[0] + "." + decimal;
								} else if (arrayValorFacturasPesos[1].length < 2) {
									texto_valor_facturas = total_facturas_pesos + "0";
								}
							}
							var valor_facturas_pesos = getFormatoNumeroDecimal_value( texto_valor_facturas );

							$("#total_facturas_pesos_text").text("$" + valor_facturas_pesos );
							$("#total_facturas_pesos").val( parseFloat(total_facturas_pesos));
							$("#id_facturas").val(id_facturas);
						});
					}
				}
			}
		});
		$.ajaxSetup({async: true});
		if (msg_error) {
			$("#nexos_messages_popup_sube_egreso").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
			$("#sube_egreso").animate({ scrollTop: 0 }, 600);
		}
	}

	function actualizaActividad(params){
		// console.log(params);
		var msg_error = "";

		// Se actualizan las actividades del proyecto
		$.ajax({
			type		: "POST",
			cache		: false,
			url 		: $("#id_url_ajax").val() + "libs/gestion_actividades.php?tabla=cmx_importacion_actividades&proyecto=importacion",
			data		: params,
			beforeSend	: function(jqXHR, settings){
							$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
			},
			error		: function(data) {
						console.log(data);
						$(".nexos_messages_popup_sube_egreso").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Proceso terminado!</strong> Error en la creación del registro.</div></div>');
			},
			success		: function(data) {
						// console.log(data);
			}
		});
	}
</script>
