<script type="text/javascript">
	var url2 = $("#id_url_ajax").val() + "libs/preestudio2_ajax.php";
	//consultar causalidades 
	$("#estado_i").change(function() {
		// alert('cammbio');
		var estadohabil = $("#estado_i").val();
		var datos = {
			estadohabil: estadohabil,
			action: 'datos_causalidad'
		};
		$("#causalidades").html('');
		$.ajax({
			url: url2,
			type: 'POST',
			data: datos,
			dataType: 'json',
			success: function(data) {
				// console.log('trajo casualidades');
				data.result.forEach(function(element, index) {
					$("#causalidades").append('<option value="' + element.id + '">' + element.respuesta + '</option>');
				});

			},
			error: function(jqXHR, textStatus, errorThrown) {
				console.log('no trajo casualidades');
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			}
		});


	});


	//consultar el vehiculo + referencias laborales
	function consultar_vehiculo(element) {
		var elemento = $(element);
		var id = elemento.data("id");
		var placa = elemento.data("id2");
		//consultar vehiculo
		var vehi = {
			id: id,
			placa: placa,
			action: 'datos_vehiculo'
		};
		$("#table_referencia").html('');
		$.ajax({
			url: url2,
			type: 'POST',
			data: vehi,
			dataType: 'json',
			success: function(data) {
				// console.log('si trajo vehicu');
				// console.log(data);
				if (data.result) {
					$("#placa_v").val(data.result[0].placa_vehiculo);
					$("#trailer_v").val(data.result[0].placa_trailer);
					$("#propi_v").val(data.result[0].nombre_propietario);
					$("#docpropi_v").val(data.result[0].documento_propietario);
					$("#tene_v").val(data.result[0].nombre_tenedor);
					$("#docutene_v").val(data.result[0].documenti_tenedor);
					$("#condu_v").val(data.result[0].nombre_conductor);
					$("#doccondu_v").val(data.result[0].documento_conductor);
					$("#web_v").val(data.result[0].web_satelital);
					$("#usersate_v").val(data.result[0].usuario_satelital);
					$("#clavesate_v").val(data.result[0].clave_satelital);
					$("#fecha_v").val(data.result[0].fecha);
					$("#hora_v").val(data.result[0].hora);
					$("#user_v").val(data.result[0].usuario);
				}

				if (data.result2) {
					data.result2.forEach(function(element, index) {
						$("#table_referencia").append('<tr>' +
							'<td>' + element.nombre_empresa + '</td>' +
							'<td>' + element.fecha_ingreso + '</td>' +
							'<td>' + element.fecha_retiro + '</td>' +
							'<td>' + element.persona_contacto + '</td>' +
							'<td>' + element.celular + '</td>' +
							'<td>' + element.cargo + '</td>' +
							'</tr>');
					});
				}
			},
			error: function(jqXHR, textStatus, errorThrown) {
				console.log('no trajovehic');
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			}
		});
	}

	//estados del vehiculo
	function estado_vehiculo(element) {
		var elemento = $(element);
		var id = elemento.data("id");
		var placa = elemento.data("id2");
		$("#id_e").val(id);
		$("#placa_e").val(placa);
		//consultar estados
		var consulte = {
			id: id,
			placa: placa,
