<script type="text/javascript">
	
$(document).ready(function(){
	$("#estado_estu").change(function(){
		var estado=$("#estado_estu").val();
		if(estado=='Aprobado'){
			$("#proceso").val('Rea_Sol_Seg');
		}
		if(estado=='Pendiente'){
			$("#proceso").val('Pen_Sol_Seg');
		}
		if(estado=='Rechazado'){
			$("#proceso").val('Rec_Sol_Seg');
		}
	});	
});

</script>