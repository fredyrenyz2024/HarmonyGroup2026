																cmc.id
															FROM 
																cmx_material_cliente cmc
															WHERE 
																cmc.codigo = "' . $this->bodegas->limpiaTexto($data[0]) . '"
																' . $_filter_query . ';
														';
														$buscaIdMaterial = $Conect->getConsulta($sql);
														// print_r("<p>Consulta id material</p>");
														// print_r("<pre>");
														// print_r($buscaIdMaterial);
														// print_r("</pre>");

														if ($buscaIdMaterial["rowsNum"] > 0) {
															$id_material = $buscaIdMaterial["rowsData"][0]["id"];
															// campo lote
															if($this->bodegas->limpiaTexto($data[3]) != ""){
																// campo fecha de vencimiento
																$fecha_vencimiento = $this->bodegas->validarFechaDow($this->bodegas->limpiaTexto($data[3]));
																// Campo cantidad
																if($this->bodegas->limpiaTexto($data[4]) != ""){
