																		"id_material" 		=> $id_material, 
																		"delivery" 			=> $this->bodegas->limpiaTexto($data[1]), 
																		"shipment"			=> $this->bodegas->limpiaTexto($data[2]), 
																		"lote" 				=> $this->bodegas->limpiaTexto($data[3]), 
																		"fecha_vencimiento"	=> $fecha_vencimiento, 
																		"cantidad" 			=> $this->bodegas->limpiaTexto($data[4])
																	);
																}
