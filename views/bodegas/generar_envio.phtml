																	$_msg_error.= "<p><strong>Error en fila $_count_row:</strong> La columna \"Cantidad\" esta vacía.</p>";
																}
															}
															else{
																$archivoValido = false;
																$_msg_error.= "<p><strong>Error en fila $_count_row:</strong> La columna \"lote\" esta vacía.</p>";
															}
														} else {
															$archivoValido = false;
															$_msg_error.= "<p><strong>Error en fila $_count_row:</strong> No se encontró registrado el material \"" . $this->bodegas->limpiaTexto($data[0]) . "\" en la lista de materiales.</p>";
