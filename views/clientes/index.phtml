	function form_crea_cliente(ssn_id_cliente, ssn_id_usuario, ssn_id_perfil) {
		$("#contenidocreacliente").html("");
		$("#nexos_messages_popup_crea").html("");
		$("#btn_crea_cliente").css("display", "inline-block");
		var msg_error = "";

		var params = {
			ssn_id_cliente: ssn_id_cliente,
			ssn_id_usuario: ssn_id_usuario,
			ssn_id_perfil: ssn_id_perfil,
		}
		// console.log(params);
		$.ajax({
			url: $("#id_url_ajax").val() + "libs/clientes_ajax.php?action=formCreaCliente",
			type: 'POST',
			data: params,
			cache: false,
