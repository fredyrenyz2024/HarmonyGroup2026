	/***** FUNCIONES DE FORMULARIO DE CONTRATOS *****/
	var id_cliente = "";

	function editarContratoCliente(id, nombre, documento) {
		listaContratos(id, "#table_contratos_content");
		if (id != id_cliente) {
			id_cliente = id;
			$("#form_edita_contrato_cliente").find("#id_cliente").val(id_cliente);
			$("#documento").val(documento);
			$("#edita_contrato_cliente_title").html("Contratos del cliente - " + nombre);
			$("#vehiculo_tarifa").empty();
			$("#form_edita_contrato_cliente").hide();

			$(".condiciones").each(function() {
				$("#" + $(this).attr("id") + "_content").hide();
				$(this).prop("checked", false);
			});

			$(".btn_actualiza_contrato_cliente").click(function() {
				$(".nexos_messages_popup").empty();
				let msg_error = "";
				let formulario = $(this).parents(".edita_contrato");
				let id_contrato = $(this).data("id");
				let cod_contrato = $(this).data("contrato");
				let porcentaje_ganancia = null;

				formulario.find(".porcentaje_ganancia").each(function() {
					if (!$(this).val()) {
						msg_error += `<p>Debe diligenciar el campo <strong>${$(this).attr("placeholder")}</strong> del contrato <strong>${cod_contrato}</strong> para poder modificar el Contrato.</p>`;
					} else {
						porcentaje_ganancia = $(this).val();
					}
				});

				let array_flete_maximo = new Array();
				formulario.find(".valor_flete_maximo").each(function() {
					if (!$(this).val()) {
						msg_error += `<p>Debe diligenciar el campo <strong>${$(this).attr("placeholder")}</strong> del contrato <strong>${cod_contrato}</strong> para poder modificar el Contrato.</p>`;
					} else {
						array_flete_maximo.push({
							id_vehiculo: $(this).data("id"),
							flete_maximo: $(this).val()
						});
					}
				});

				if (!msg_error) {
					let params = {
						id_contrato: id_contrato,
						porcentaje_ganancia: porcentaje_ganancia,
						flete_maximo: array_flete_maximo
					}

					$.ajax({
						url: $("#id_url_ajax").val() + "libs/clientes_ajax.php?action=ajustarContrato",
						type: 'POST',
						data: params,
						dataType: 'json',
						cache: false,
						beforeSend: function(jqXHR, settings) {
							$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
						},
						error: function(jqXHR, textStatus, errorThrown) {
							$(".nexos-messages").html('');
							let msg_error = "<p>" + jqXHR.responseText + "</p>";
							$(".nexos_messages_popup").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-close"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
							$("#edita_contrato_cliente").animate({
								scrollTop: 0
							}, 600);
							console.log(jqXHR);
							console.log(textStatus);
							console.log(errorThrown);
						},
						success: function(data, textStatus, jqXHR) {
							$(".nexos-messages").html('');
							// console.log(data);

							$("#edita_contrato_cliente").animate({
								scrollTop: 0
							}, 600);
							$(".nexos_messages_popup").html('<div role="alert" class="alert alert-success alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Proceso terminado! </strong>Se ha creado el registro con éxito.</div></div>');

							// Se carga de nuevo la lista de contratos
							listaContratos(id, "#table_contratos_content");
							setTimeout(function() {
								$(".nexos_messages_popup").html('');
							}, 2000);
						}
					});
				}

				if (msg_error) {
					$(".nexos_messages_popup").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-close"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
					$("#edita_contrato_cliente").animate({
						scrollTop: 0
					}, 600);
				}
			});
			App.formElements();
		}
	}

	function listaContratos(id, contenedor) {
		$(contenedor).html("");
		params = {
			id: id,
			id_perfil: $("#datos_usuario").data("id_perfil")
		}
		$.ajaxSetup({
			async: false
		});
		$.ajax({
			url: $("#id_url_ajax").val() + "libs/clientes_ajax.php?action=verContratos",
			type: 'POST',
			data: params,
			dataType: 'json',
			cache: false,
			// contentType: false,
			// processData:false,
			beforeSend: function(jqXHR, settings) {
				$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
			},
			error: function(jqXHR, textStatus, errorThrown) {
				$(".nexos-messages").html('');
				let msg_error = "<p>" + jqXHR.responseText + "</p>";
				$(".nexos_messages_popup").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-close"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
				$("#edita_contrato_cliente").animate({
					scrollTop: 0
				}, 600);
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			},
			success: function(data, textStatus, jqXHR) {
				$(".nexos-messages").html('');
				// console.log(data);
				content = data.content;
			}
		});
		$.ajaxSetup({
			async: true
		});
		// Se pinta el resultado en el contenedor
		$(contenedor).html(content);
	}

