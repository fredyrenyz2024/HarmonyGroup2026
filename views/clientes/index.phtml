	function Crear_Cliente_Rndc(documento) {

		const API_URL = "http://127.0.0.1:8000/api/v1/rndc/crear-cliente";
		const API_KEY = "mi_super_api_key_ultra_secreta_123";

		const usuario = $("#nom_user").val();

		const params = {
			tipo: 1,
			documento: documento,
			user: usuario
		};

		$.ajax({
			url: API_URL,
			type: "POST",
			data: JSON.stringify(params),
			contentType: "application/json",
			dataType: "json",

			headers: {
				"X-API-KEY": API_KEY
			},

			beforeSend: function() {
				$(".nexos-messages").html(`
                <div id="clock" class="modal" style="display:block;background-color:rgba(0,0,0,0.5);">
                    <div style="text-align:center;margin-top:10%;background:#fff;padding:30px;border-radius:5px;">
                        <img src="${$("#id_url_ajax").val()}public/img/nexos_loading.gif" height="60">
                        <h3>Solicitud en proceso...</h3>
                        <h4>Por favor, espere unos segundos.</h4>
                    </div>
                </div>
            `);
			},

			success: function(data) {
				$("#nexos_messages_popup_crea").html('');

				// ÉXITO
				if (data.success) {
					$("#nexos_messages_popup_crea").append(`
                    <div class="alert alert-success alert-icon alert-dismissible">
                        <div class="icon"><span class="mdi mdi-check"></span></div>
                        <div class="message">
                            <button type="button" class="close" data-dismiss="alert">
                                <span class="mdi mdi-close"></span>
                            </button>
                            <strong>Proceso exitoso! </strong><br>
                            <b>Acción:</b> ${data.accion} <br>
                            <b>Estado RNDC:</b> ${data.estado} <br>
                            <b>Mensaje:</b> ${data.message}
                        </div>
                    </div>
                `);
				}

				// ERROR
				else {
					$("#nexos_messages_popup_crea").append(`
                    <div class="alert alert-danger alert-icon alert-dismissible">
                        <div class="icon"><span class="mdi mdi-close"></span></div>
                        <div class="message">
                            <button type="button" class="close" data-dismiss="alert">
                                <span class="mdi mdi-close"></span>
                            </button>
                            <strong>Error en el proceso!</strong><br>
                            <b>Mensaje:</b> ${data.message} <br>
                            <b>Detalle:</b> ${data.error ?? 'Sin detalles.'}
                        </div>
                    </div>
                `);
				}

				$("#crea_cliente").animate({
					scrollTop: 0
				}, 600);
			},

			error: function(jqXHR, textStatus, errorThrown) {
				console.log(jqXHR);

				$("#nexos_messages_popup_crea").html(`
                <div class="alert alert-danger alert-icon alert-dismissible">
                    <div class="icon"><span class="mdi mdi-close"></span></div>
                    <div class="message">
                        <button type="button" class="close" data-dismiss="alert">
                            <span class="mdi mdi-close"></span>
                        </button>
                        <strong>Error inesperado!</strong><br>
                        Ocurrió un error en el servidor o la red.
                    </div>
                </div>
            `);
			}
		});
	}

	function crear_dato_oet(documento) {
		clase = 1;
		recurso = 1;
		filtro = 1;
		valor = '&dato_recurso=' + documento;
		var paquete = 'clase_recurso=' + recurso + '&recurso=' + filtro + valor;
		$.post($("#id_url_ajax").val() + 'integrar_oet/Consulta_Recurso_Avansat', paquete, function(data) {
			if (data.status == true || data.status == "true") {
				//
				$("#nexos_messages_popup_info_cliente").append('<div role="alert" class="alert alert-success alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-check"></span></button><strong>Proceso terminado! </strong>Tercero Actualizado Exitosamente - OET.</div></div>');
				$("#edita_info_cliente").animate({
					scrollTop: 0
				}, 600);
				setTimeout(function() {
					location.reload(false);
				}, 900);
			} else if (data.status == false || data.status == "false") {
				//mensajes
				$("#nexos_messages_popup_info_cliente").append('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-close"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Proceso terminado!</strong> No fue actualizado exitosamente  OET ' + data.error + '.</div></div>');
				$("#edita_info_cliente").animate({
					scrollTop: 0
				}, 600);
				setTimeout(function() {
					location.reload(false);
				}, 900);
			}
		}, 'json');
	}

