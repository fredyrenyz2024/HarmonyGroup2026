<script>
	$(document).ready(function() {
		/***** FUNCIONES DEL FORMUALRIO DE CREACION DE REMITENTE - DESTINATARIO *****/
		$("#div_mascara").hide();
		$("#div_complemento").hide();
		$("#slct_id_cliente").change(function() {
			$("#nexos_messages_popup").html("");
			buscarRemitente($("#documento").val(), $("#slct_id_cliente").val(), $("#nombre").val(), $("#slct_municipio_").val());
		});
		$("#documento").focusout(function() {
			if ($("#documento").val()) {
				buscarRemitente($("#documento").val(), $("#slct_id_cliente").val(), $("#nombre").val(), $("#slct_municipio_").val());
				$("#digito_verificacion").val(calcularDigitoVerificacion($("#documento").val()));
			}
		});
		$("#tipo_documento").change(function() {
			$("#primer_apellido").attr("disabled", false);
			$("#segundo_apellido").attr("disabled", false);
			if ($("#tipo_documento").val() == "NIT" || $("#tipo_documento").val() == "Identificación Tributaria Internacional") {
				$("#primer_apellido").val("");
				$("#segundo_apellido").val("");
				$("#primer_apellido").attr("disabled", true);
				$("#segundo_apellido").attr("disabled", true);
			}
			llenaNombreProveedor("nombre", "rndc_nombre", "primer_apellido", "segundo_apellido");
		});
		$("#rndc_nombre").focusout(function() {
			llenaNombreProveedor("nombre", "rndc_nombre", "primer_apellido", "segundo_apellido");
			buscarRemitente($("#documento").val(), $("#slct_id_cliente").val(), $("#nombre").val(), $("#slct_municipio_").val());
		});
		$("#primer_apellido").focusout(function() {
			llenaNombreProveedor("nombre", "rndc_nombre", "primer_apellido", "segundo_apellido");
			buscarRemitente($("#documento").val(), $("#slct_id_cliente").val(), $("#nombre").val(), $("#slct_municipio_").val());
		});
		$("#segundo_apellido").focusout(function() {
			llenaNombreProveedor("nombre", "rndc_nombre", "primer_apellido", "segundo_apellido");
			buscarRemitente($("#documento").val(), $("#slct_id_cliente").val(), $("#nombre").val(), $("#slct_municipio_").val());
		});
		$("#slct_pais_").change(function() {
			var msg_error = '';
			$("#div_depto").html("");
			$("#div_ciudad").html("");

			$("#contacto").removeAttr("maxlength");
			$("#celular").removeAttr("maxlength");
			if ($("#slct_pais_").val() == "COLOMBIA") {
				$("#contacto").attr("maxlength", 7);
				$("#celular").attr("maxlength", 10);
			}
			var params = {
				pais: $("#slct_pais_").val()
			}
			$.ajaxSetup({
				async: false
			});
			$.ajax({
				url: `${$("#id_url_ajax").val()}libs/remitentes_ajax.php?action=buscaDepto`,
				type: 'POST',
				data: params,
				cache: false,
				dataType: 'json',
				beforeSend: function(jqXHR, settings) {
					funct_msg_loading(".nexos-messages");
				},
				error: function(jqXHR, textStatus, errorThrown) {
					msg_error += "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function(data, textStatus, jqXHR) {
					$("#div_depto").html(data.depto);
					$(".nexos-messages").empty();
					$("#slct_depto_").change(function() {
						$("#div_ciudad").html("");
						var params = {
							pais: $("#slct_pais_").val(),
							depto: $("#slct_depto_").val()
						}
						$.ajax({
							url: `${$("#id_url_ajax").val()}libs/remitentes_ajax.php?action=buscaCiudad`,
							type: 'POST',
							data: params,
							cache: false,
							dataType: 'json',
							beforeSend: function(jqXHR, settings) {
								funct_msg_loading(".nexos-messages");
							},
							error: function(jqXHR, textStatus, errorThrown) {
								msg_error += "<p>" + jqXHR.responseText + "</p>";
								console.log(jqXHR);
								console.log(textStatus);
								console.log(errorThrown);
							},
							success: function(data, textStatus, jqXHR) {
								$("#div_ciudad").html(data.municipio);
								$(".nexos-messages").empty();
								$("#slct_municipio_").change(function() {
									var data = null;
									data = new FormData();
									data.append("action", "getRndc_id_municipio");
									data.append("id", $("#slct_municipio_").val());
									$.ajax({
										url: `${$("#id_url_ajax").val()}libs/municipios_ajax.php`,
										type: 'POST',
										data: data,
										cache: data,
										processData: false,
										contentType: false,
										dataType: 'json',
										beforeSend: function(jqXHR, settings) {
											funct_msg_loading(".nexos-messages");
										},
										error: function(jqXHR, textStatus, errorThrown) {
											msg_error += "<p>" + jqXHR.responseText + "</p>";
											console.log(jqXHR);
											console.log(textStatus);
											console.log(errorThrown);
										},
										success: function(data, textStatus, jqXHR) {
											if (!data.error) {


												$("#rndc_id_municipio").val(data.result["municipio"]["rowsData"][0]["rndc_codigo_ciudad"]);
												$("#nexos_messages_popup").html("");
												buscarRemitente($("#documento").val(), $("#slct_id_cliente").val(), $("#nombre").val(), $("#slct_municipio_").val());


											} else {
