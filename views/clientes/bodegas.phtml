	/***** FUNCIONES PARA EL GOOGLE MAPS *****/
	var markers = [];
	var status_ruta = false;

	function initMap(latitud_inicial = 4.7097100, longitud_inicial = -74.0677500, id_mapa = "mapa_ubicacion", zoom = 5) {
		var latitud = parseFloat(latitud_inicial);
		var longitud = parseFloat(longitud_inicial);

		var code = {
			lat: latitud,
			lng: longitud
		};
		var directionsService = new google.maps.DirectionsService;
		var directionsDisplay = new google.maps.DirectionsRenderer;

		var point = new google.maps.LatLng(
			latitud,
			longitud
		);

		var mapa_ubicacion = new google.maps.Map(document.getElementById(id_mapa), {
			zoom: zoom,
			center: code,
			streetViewControl: false,
			mapTypeControl: false,
		});

		clearMarkers();
		addMarkerruta(code, mapa_ubicacion);
		if (id_mapa == "mapa_ubicacion" || id_mapa == "e_mapa_ubicacion") {
			mapa_ubicacion.addListener('click', function(event) {
				var element_latitud = $("#" + id_mapa).closest(".modal-body").find(".latitud");
				var element_longitud = $("#" + id_mapa).closest(".modal-body").find(".longitud");
				element_latitud.val("");
				element_longitud.val("");

				deleteMarkers();
				addMarkerruta(event.latLng, mapa_ubicacion);

				var latitud = markers[0]['position'].lat();
				var longitud = markers[0]['position'].lng();

				element_latitud.val(latitud);
				element_longitud.val(longitud);

				var latlng = new google.maps.LatLng(latitud, longitud);
				geocoder = new google.maps.Geocoder();

				geocoder.geocode({
					"latLng": latlng
				}, function(results, status) {
					let element_codigo_postal = $("#" + id_mapa).closest(".modal-body").find(".codigo_postal");
					element_codigo_postal.val("");
					// console.log(results);
					// console.log(results[0]["address_components"][1]["long_name"]);

					if (results.length > 0) {
						for (var j = 0; j < results[0].address_components.length; j++) {
							for (var k = 0; k < results[0].address_components[j].types.length; k++) {
								if (results[0].address_components[j].types[k] == "postal_code") {
									zipcode = results[0].address_components[j].short_name;
									// console.log(zipcode);
									element_codigo_postal.val(zipcode);
								}
							}
						}
					} else {
						element_codigo_postal.val(0);
					}
				});
			});
		}
	}

	// Deletes all markers in the array by removing references to them.
	function deleteMarkers() {
		clearMarkers();
		markers = [];
	}

	// Removes the markers from the map, but keeps them in the array.
	function clearMarkers() {
		setMapOnAll(null);
	}

	// Sets the map on all markers in the array.
	function setMapOnAll(map) {
		for (var i = 0; i < markers.length; i++) {
			markers[i].setMap(map);
		}
	}

	// Adds a marker to the map and push to the array.
	function addMarkerruta(location, mapa) {
		if (status_ruta == false) {
			var marker = new google.maps.Marker({
				position: location,
				map: mapa
			});
			marker.setTitle("Control");
			markers.push(marker);
		}
	}
