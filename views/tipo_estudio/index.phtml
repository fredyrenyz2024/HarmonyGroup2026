function prueba_editar(element){
	var elemento = $(element);
	var id = elemento.data("id");
	var nombre = elemento.data("id2");
	var estado = elemento.data("id3");
	var requerido = elemento.data("id4");

	$("#e_tipo").val(nombre);
	$("#e_id").val(id);
	if(estado=='1'){
		$("#e_estado").html('<option value="1">activo</option>'+
			'<option value="0">inactivo</option>');
	}
	if(estado=='0'){
		$("#e_estado").html('<option value="0">inactivo</option>'+
			'<option value="1">activo</option>');
	}

	//requerido

	if(requerido=='1'){
		$("#e_requerido").html('<option value="1">Requerido</option>'+
			'<option value="0">No Requerido</option>');
	}

	if(requerido=='0'){
		$("#e_requerido").html('<option value="0">No Requerido</option>'+
			'<option value="1">Requerido</option>');
	}
}

function update(){
	// alert('fhdjfh');
	var id_tb=$("#e_id").val();
	var nom=$("#e_tipo").val();
	var estado=$("#e_estado").val();
	var requerido=$("#e_requerido").val();
	// alert(id_tb);
	// alert(nom);
	datos_editar={
		id:id_tb,
		nom:nom,
		estado:estado,
		requerido:requerido,
		action:'actualizar'
	};

	$.ajax({
	url:"http://localhost/mvcLuisMiguel/libs/tipo_estudio_ajax.php",
 	type:'POST',
 	data:datos_editar,
 	dataType:'json',
 	success: function(data){
 		// console.log('sisi update');
 		alert('Datos Actualizados Exitosamente!!');
 		$("html, body").animate({ scrollTop: 0 }, 600);
		setTimeout(function() { location.reload(false);  }, 800);

 	}, 
 	error: function(jqXHR, textStatus, errorThrown){
 		console.log('error update');
 		console.log(jqXHR);
		console.log(textStatus);
		console.log(errorThrown);
 	}
});
}



</script>