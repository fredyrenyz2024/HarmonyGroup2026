					var map = new google.maps.Map(document.getElementById(\'mapa_ruta_control\'), {
						zoom: 6,
						center: { lat: waypts[0].location.lat, lng: waypts[0].location.lng },
						// disableDefaultUI: true,
					});

					//add map
					directionsDisplay.setMap(map);

					// set the new
					directionsService.route({
						origin: { lat: waypts[0].location.lat, lng: waypts[0].location.lng },
						destination: { lat: waypts[ (waypts.length - 1) ].location.lat, lng: waypts[ (waypts.length - 1) ].location.lng },
						waypoints: wayroute,
						optimizeWaypoints: false,
