      tipovia = $("#di_tipoviae").val();
      di_nomvia = $("#di_nomviae").val();
      di_letra1 = $("#di_letra1e").val();
      di_prefijo1 = $("#di_prefijo1e").val();
      di_letra2 = $("#di_letra2e").val();
      di_cuadrante = $("#di_cuadrantee").val();
      di_num1 = $("#di_num1e").val();
      di_letra3 = $("#di_letra3e").val();
      di_numero2 = $("#di_numero2e").val();
      di_cuadrante2 = $("#di_cuadrantee2").val();
      di_tipovia1 = $("#di_tipovia1e").val();
      di_numero3 = $("#di_numero3e").val();
      var nomenclatura = (tipovia + ' ' + di_nomvia + ' ' + di_letra1 + ' ' + di_prefijo1 + ' ' + di_letra2 + ' ' +
        di_cuadrante + ' ' + di_num1 + ' ' + di_letra3 + ' ' + di_numero2 + ' ' + di_cuadrante2 + ' ' +
        di_tipovia1 +
        ' ' + di_numero3);
      $("#direccion_compuestae").val(nomenclatura);
      $("#e_direccion").val(nomenclatura);
    });
    $("#Complemente").change(function() {
      if ($(this).is(":checked")) {
        $("#e_complemento").show();
      } else {
        $("#e_complemento").hide();
      }
    });
    $("#limpiare").click(function() {
      $("#di_tipoviae").prop('selected', 'false');
      $("#di_nomviae").val('');
      $("#di_letra1e").prop('selected', 'false');
      $("#di_prefijo1e").prop('selected', 'false');
      $("#di_letra2e").prop('selected', 'false');
      $("#di_cuadrantee").prop('selected', 'false');
      $("#di_num1e").val('');
      $("#di_letra3e").prop('selected', 'false');
      $("#di_numero2e").val('');
      $("#di_cuadrantee2").prop('selected', 'false');
      $("#di_tipovia1e").prop('selected', 'false');
      $("#di_numero3e").val('');
      $("#direccion_compuestae").val('');
      $("#e_direccion").val('');
    });
  });

