      $("#di_letra2").attr('selected', 'false');
      $("#di_cuadrante").attr('selected', 'false');
      $("#di_num1").val('');
      $("#di_letra3").attr('selected', 'false');
      $("#di_numero2").val('');
      $("#di_cuadrante2").attr('selected', 'false');
      $("#di_tipovia1").attr('selected', 'false');
      $("#di_numero3").val('');
      $("#direccion_compuesta").val('');
      $("#direccion").val('');
    });

