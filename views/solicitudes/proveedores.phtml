  function cargar_proveedores(a, b, c, d, e, f) {
    var perfil_user = $("#perfil").val();
    // a=tipo proveedor, b=buscar por, c=nombre, d=documento, e=criterio1, f=criterio2
    // alert(b);
    // $('#table1').dataTable().clear();
    var msg_error = '';
    var dato = {
      tipo: a,
      valor: b,
      name: c,
      docu: d,
      param1: e,
      param2: f
    };
    // $("#table1").empty();
    $("#principal_cuerpo").html('');
    $.ajaxSetup({
      async: false
    });
    $.ajax({
      url: $("#id_url_ajax").val() + "libs/lista_proveedores_ajax.php?action=cargar_proveedores",
      type: "POST",
      data: dato,
      cache: false,
      dataType: "json",
      error: function(jqXHR, textStatus, errorThrown) {
        $(".nexos-messages").html('');
        msg_error += "<p>" + jqXHR.responseText + "</p>";
        console.log(jqXHR);
        console.log(textStatus);
        console.log(errorThrown);
      },
      success: function(data) {
        // console.log(data);
        $("#principal_cuerpo").html('');
        if (data.error) {
          msg_error = data.error;
        }
        if (data.sql) {
          $.each(data.sql, function(i, item) {
            var btn_color = "";
            if (item.estado == 'Activo') {
              var btn_color = "nexos-txt-success";
            } else if (item.estado == 'Inactivo') {
              var btn_color = "nexos-txt-danger";
            }

            var msg_rndc = '';
            if (item.rndc_id) {
              msg_rndc = `<strong class="text-success">RNDC</strong>`;
            }

            // Se filtra el contenido del bton de activación o desactivación dependiendo el estado del proveedor
            var btn_estado = "";
            if (item.estado == 'Activo') {
              $palabra = 'Activo';
              btn_estado = `
								<a href="javascript:" onclick="datosinactivarproveedor(${item.numdoc_nexos})" class="cell-detail  hint--top-left" data-hint="Inactivar proveedor">
									<span class="icon mdi mdi-close-circle" data-toggle="modal" data-target="#inactivar_proveedor"></span>
								</a>
							`;
            } else if (item.estado == 'Inactivo') {
              $palabra = 'Inactivo';
              btn_estado = `
								<a href="javascript:" onclick="datosactivarproveedor(${item.numdoc_nexos})"  class="cell-detail  hint--top-left" data-hint="Activar proveedor" >
									<span class="icon mdi mdi-check-circle "  data-toggle="modal" data-target="#activar_proveedor"></span>
								</a>
							`;
            }

            // Se valida el contenido del documento del proveedor
            var documento = item.numero_documento;
            if (item.tipo_documento == "NIT") {
              documento = item.numero_documento + "-" + item.digito_verificacion;
            }

            // Se valida los contactos del proveedor
            var contacto = "";
            if (item.contacto) {
              contacto += `
								<span>Contacto</span>
								<span class="cell-detail-description">${item.contacto}</span>
							`;
            }
            if (item.celular) {
              contacto += `
								<span>Celular</span>
								<span class="cell-detail-description">${item.celular}</span>
							`;
            }
            $("#idproveedor_Editar").val(item.id);
            if (btn_color == 'sucess') {
              $esta = '';
            }
            if (btn_color == 'Danger') {
              $esta = '';
            }

            $btn_financiero = '';
            if (item.actividad == 'Propietario Vehiculo' || item.actividad == 'Poseedor Vehiculo') {
              $btn_financiero =
                `<a href="javascript:" onclick="AgregaFinanciero(${item.numdoc_nexos})" class="cell-detail hint--top-left" data-hint="Agregar Dato Financiero" ><span class="icon mdi mdi-money" data-toggle="modal" data-target="#Agrega_Financiero"></span></a>`;
            }

            btn_edicion = '';
            if (perfil_user != 8 && perfil_user != 9) {
              // let num =
              var numdoc_nexos_encriptado = codificarBase64(item.numdoc_nexos);
              // console.log("Texto encriptado:", decodificarBase64(numdoc_nexos_encriptado));
              btn_edicion =
                `<a href="${$("#id_url_ajax").val()}solicitudes/editar_proveedor/?num_proveedor=${numdoc_nexos_encriptado}&idmenu=${params.get('idmenu')}"  class="cell-detail  hint--top-left" data-hint="Editar proveedor" "><span class="icon mdi mdi-edit"></span></a>`;
              // btn_edicion =
              //   `<a href="javascript:" onclick="editardatosProveedorn0(${item.numdoc_nexos})" class="cell-detail  hint--top-left" data-hint="Editar proveedor" "><span class="icon mdi mdi-edit" data-toggle="modal" data-target="#editar_proveedor"></span></a>`;
            }

            $("#principal_cuerpo").append(`
							<tr>
								<td class="${btn_color}">
									<center><span class="mdi mdi-dot-circle icon"  title="${$palabra}"></span></center>
								</td>
								<td class="cell-detail" >
									<span>${msg_rndc} ${documento}</span>
									<span class="cell-detail-description">${item.tipo_documento}</span>
								</td>
								<td class="cell-detail" >
									<span>${item.nombre} ${item.apellido1}
									${item.apellido2}</span>
								</td>
								<td class="cell-detail" >
									<span>${item.direccion}</span>
									<span class="cell-detail-description">${item.ciudad}</span>
								</td>
								<td class="cell-detail" >
									<span>${contacto}</span>
								</td>
								<td class="cell-detail" >
									<span>${item.actividad}</span>
								</td>
								<td class="actions">
								<!--
									<a href="javascript:" onclick="Agrega_Financiero(${item.numdoc_nexos})" class="cell-detail hint--top-left" data-hint="Agregar Dato Financiero" ><span class="icon mdi mdi-money" data-toggle="modal" data-target="#Agrega_Financiero"></span></a> -->

									<a href="javascript:" onclick="verProveedor(${item.numdoc_nexos})" class="cell-detail hint--top-left" data-hint="consultar" ><span class="icon mdi mdi-eye" data-toggle="modal" data-target="#ver_proveedornuevo"></span></a>

									` + btn_edicion + `

									<a href="javascript:" onclick="historicodatosProveedor(${item.numdoc_nexos})" class="cell-detail  hint--top-left" data-hint="Vehículos que ha tenido  conductor" "><span class="icon mdi mdi-car" data-toggle="modal" data-target="#historico_proveedor"></span></a>
									${$btn_financiero}
									${btn_estado}
								</td>
							</tr>
						`);
          });
          /*	table_content+= `
          						</tbody>
          					</table>
          				</div>
          			</div>
          		</div>

          		</div>
          	`; */
          // $('#table1').dataTable().clear();
          // $(".nexos-content").append(tablita);
          // App.dataTables();
        }
      }
    });
    if (msg_error) {
      funct_msg_error(".nexos-messages", msg_error);
      $("html, body").animate({
        scrollTop: 0
      }, 600);
    }
    $.ajaxSetup({
      async: true
    });

  }



