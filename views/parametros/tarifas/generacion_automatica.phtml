            <div class="help-text">
              Define el % acumulado de viajes que determina las rutas prioritarias. Con un TOP de 80%, solo las rutas que cubran el 80% de los despachos se consideran para actualización (Principio de Pareto).
            </div>

            <div class="top-display">
              <div class="top-value" id="top-display-val">80</div>
              <div class="top-unit">viajes cubiertos por la operación</div>
            </div>

            <input type="range" id="top-slider" min="1" max="100" value="80" oninput="updateSlider(this.value)" style="--pct: 80%">

            <div class="range-labels">
              <span>1 (mín)</span>
              <span>50%</span>
              <span>100 (máx)</span>
            </div>

            <div class="top-presets">
              <button class="preset-btn" onclick="setPreset(50)">50</button>
              <button class="preset-btn" onclick="setPreset(60)">60</button>
              <button class="preset-btn" onclick="setPreset(70)">70</button>
              <button class="preset-btn active" id="preset-80" onclick="setPreset(80)">80</button>
              <button class="preset-btn" onclick="setPreset(90)">90</button>
              <button class="preset-btn" onclick="setPreset(100)">100</button>
            </div>

            <div style="display:flex;gap:8px;margin-top:12px;">
              <input type="number" class="form-control" id="top-input" value="80" min="1" max="100" style="width:80px;" oninput="syncInput(this.value)">
              <button class="btn btn-primary" style="flex:1;justify-content:center;" onclick="guardarParametro()">
                <i class="fas fa-save"></i> Guardar Parámetro
              </button>
            </div>

            <div id="param-status" class="param-status" style="display:none">
              <i class="fas fa-check-circle"></i>
              <span id="param-status-text">Guardado correctamente</span>
            </div>
          </div>

          <!-- Filtros Section -->
          <div class="param-section">
            <div class="param-section-title">
              <i class="fas fa-filter" style="color:var(--navy2)"></i>
              Filtros de Generación
            </div>

            <div class="mb-3">
              <label class="form-label">Fecha Desde</label>
              <input type="date" class="form-control" id="g-desde">
            </div>
            <div class="mb-3">
              <label class="form-label">Fecha Hasta</label>
              <input type="date" class="form-control" id="g-hasta">
            </div>
            <div class="mb-3">
              <label class="form-label">Cliente <small style="font-size:.6rem;color:var(--muted)">(Opcional)</small></label>
              <select class="form-select" id="g-cliente">
                <option value="">Todos los clientes</option>
                <option>Cliente A</option>
                <option>Cliente B</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Zona <small style="font-size:.6rem;color:var(--muted)">(Opcional)</small></label>
              <select class="form-select" id="g-zona">
                <option value="">Todas las zonas</option>
                <option>Zona Centro</option>
                <option>Zona Norte</option>
                <option>Zona Occidente</option>
              </select>
            </div>
          </div>

          <!-- Generate button -->
          <button class="btn-generar" onclick="generarLista()">
            <i class="fas fa-bolt"></i>
            Generar Lista Priorizada
          </button>

        </div>
      </div>
    </div>

    <!-- ══════════ RIGHT ══════════ -->
    <div class="right-panel">

      <!-- Stats -->
      <div class="stats-grid" id="stats-grid">
        <div class="stat-card" onclick="filterByEstado('todas')" title="Ver todas">
          <div class="stat-val" id="st-rutas" style="color:var(--navy)">—</div>
          <div class="stat-label">Rutas Priorizadas</div>
        </div>
        <div class="stat-card" onclick="filterByEstado('SIN_TARIFA')" title="Sin tarifa">
          <div class="stat-val" id="st-sin" style="color:var(--red)">—</div>
          <div class="stat-label">Sin Tarifa</div>
          <div class="stat-sub">Acción urgente</div>
        </div>
        <div class="stat-card" onclick="filterByEstado('VENCIDA')" title="Vencidas">
          <div class="stat-val" id="st-venc" style="color:var(--red)">—</div>
          <div class="stat-label">Vencidas</div>
        </div>
        <div class="stat-card" onclick="filterByEstado('POR_VENCER')" title="Por vencer">
          <div class="stat-val" id="st-porv" style="color:var(--yellow)">—</div>
          <div class="stat-label">Por Vencer</div>
        </div>
        <div class="stat-card" onclick="filterByEstado('VIGENTE')" title="Vigentes">
          <div class="stat-val" id="st-vig" style="color:var(--green)">—</div>
          <div class="stat-label">Vigentes</div>
        </div>
        <div class="stat-card" onclick="filterByEstado('total')" title="Ver total viajes">
          <div class="stat-val" id="st-viajes" style="color:var(--navy)">—</div>
          <div class="stat-label">Total Viajes</div>
        </div>
      </div>

      <!-- Pareto bar -->
      <div class="pareto-card" id="pareto-wrap" style="display:none">
        <div class="pareto-title">
          <span><i class="fas fa-chart-area"></i> Distribución Pareto — Cobertura de Viajes</span>
          <span class="info-tag" id="pareto-info"><i class="fas fa-bolt"></i> TOP 80%</span>
        </div>
        <div class="pareto-bar-wrap" style="height:30px">
          <div class="pareto-fill-top" id="pareto-fill" style="width:80%">
            <span class="pareto-fill-top-label" id="pareto-fill-label">TOP 80% · 8 rutas</span>
          </div>
        </div>
        <div class="pareto-labels">
          <span>0 rutas</span>
          <span id="pareto-rutas-total">10 rutas totales</span>
        </div>
      </div>

      <!-- ── TABLE CARD ── -->
      <div class="table-card">
        <div class="table-header">
          <div class="table-title">
            <i class="fas fa-list-ol"></i>
            Lista Priorizada de Rutas
            <span class="info-tag" id="table-count" style="display:none">
              <i class="fas fa-layer-group"></i> <span id="count-txt">0</span>
            </span>
          </div>
          <div class="table-actions">
            <input type="text" class="filter-input" id="tbl-filter" placeholder="Filtrar..." oninput="filterTable()">
            <button class="btn btn-sm btn-outline" onclick="toggleSelectAll()">
              <i class="fas fa-check-square"></i> Sel. Todo
            </button>
            <!-- <button class="btn btn-sm btn-success" onclick="exportarExcel()"> -->
            <button class="btn btn-sm btn-success" id="exportar_excel_ruta_prioritaria">
              <i class="fas fa-file-excel"></i> Excel
            </button>
          </div>
        </div>

        <div class="table-wrap" id="table-wrap">
          <div class="empty-state">
            <div class="empty-icon"><i class="fas fa-bolt"></i></div>
            <div class="empty-text">Lista no generada</div>
            <div class="empty-sub">Configure el parámetro TOP y presione "Generar Lista Priorizada"</div>
          </div>
        </div>

        <div class="actions-bar" id="actions-bar" style="display:none">
          <button class="btn btn-primary" onclick="actualizarSeleccionadas()">
            <i class="fas fa-sync-alt"></i> Actualizar Seleccionadas
          </button>
          <button class="btn btn-outline" onclick="abrirMasivo()">
            <i class="fas fa-edit"></i> Editar Masivo
          </button>
          <span class="sel-count" id="sel-count">0 seleccionadas</span>
        </div>
      </div>
    </div>
  </div>

</div>

<!-- ════════════════════════════════════════════════════
 MODAL EDICIÓN — Multi-Origen / Multi-Destino / Multi-Recogida / Multi-Entrega
 ════════════════════════════════════════════════════ -->
<div id="modal-editar" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(15,31,61,.5);display:flex;align-items:center;justify-content:center;padding:20px;" onclick="if(event.target===this)cerrarModal()">
  <div style="background:#fff;border-radius:14px;width:100%;max-width:620px;max-height:90vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(15,31,61,.3);">

    <!-- Modal header -->
    <div style="background:linear-gradient(135deg,var(--navy),var(--navy2));padding:16px 20px;display:flex;align-items:center;justify-content:space-between;">
      <div>
        <div style="font-weight:700;color:#fff;font-size:.95rem;display:flex;align-items:center;gap:8px;">
          <i class="fas fa-edit" style="color:var(--accent)"></i>
          <span id="modal-title">Actualizar Tarifa</span>
        </div>
        <div style="font-size:.68rem;color:rgba(255,255,255,.5);margin-top:2px;" id="modal-ruta-info">—</div>
      </div>
      <button onclick="cerrarModal()" style="background:rgba(255,255,255,.1);border:none;color:#fff;width:30px;height:30px;border-radius:7px;cursor:pointer;font-size:.9rem;display:flex;align-items:center;justify-content:center;">✕</button>
    </div>

    <!-- Modal body -->
    <div style="overflow-y:auto;flex:1;padding:20px;">

      <!-- Info ruta -->
      <div id="modal-ruta-card" style="background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:12px 14px;margin-bottom:16px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
        <div>
          <div style="font-size:.6rem;text-transform:uppercase;font-weight:700;color:var(--muted);letter-spacing:.05em">Origen</div>
          <div style="font-weight:700;color:var(--navy);font-size:.85rem" id="m-origen">—</div>
        </div>
        <div style="font-size:1.2rem;color:var(--accent)">→</div>
        <div>
          <div style="font-size:.6rem;text-transform:uppercase;font-weight:700;color:var(--muted);letter-spacing:.05em">Destino</div>
          <div style="font-weight:700;color:var(--navy);font-size:.85rem" id="m-destino">—</div>
        </div>
        <div>
          <div style="font-size:.6rem;text-transform:uppercase;font-weight:700;color:var(--muted);letter-spacing:.05em">Vehículo</div>
          <div style="font-weight:700;color:var(--navy);font-size:.85rem" id="m-vehiculo">—</div>
        </div>
        <div>
          <div style="font-size:.6rem;text-transform:uppercase;font-weight:700;color:var(--muted);letter-spacing:.05em">Viajes</div>
          <div style="font-weight:700;color:var(--navy);font-size:.85rem" id="m-viajes">—</div>
        </div>
        <div>
          <div style="font-size:.6rem;text-transform:uppercase;font-weight:700;color:var(--muted);letter-spacing:.05em">Estado</div>
          <div id="m-estado-badge">—</div>
        </div>
      </div>

      <!-- Referencia SICETAC / Mercado -->
      <div id="modal-refs" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px;">
        <div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:7px;padding:10px 12px;">
          <div style="font-size:.6rem;font-weight:700;text-transform:uppercase;color:#0369a1;margin-bottom:3px">Referencia SICETAC</div>
          <div style="font-size:1rem;font-weight:800;color:#0369a1;font-family:'DM Mono',monospace" id="m-sicetac">N/A</div>
        </div>
        <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:7px;padding:10px 12px;">
          <div style="font-size:.6rem;font-weight:700;text-transform:uppercase;color:#15803d;margin-bottom:3px">Referencia Mercado</div>
          <div style="font-size:1rem;font-weight:800;color:#15803d;font-family:'DM Mono',monospace" id="m-mercado">N/A</div>
        </div>
      </div>

      <!-- ── TARIFA PLENA ── -->
      <div style="background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:14px;margin-bottom:12px;">
        <div style="font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--navy);margin-bottom:10px;display:flex;align-items:center;gap:6px;">
          <i class="fas fa-dollar-sign" style="color:var(--accent)"></i> Tarifa Plena <span style="color:var(--red)">*</span>
        </div>
        <div style="position:relative;">
          <span style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:.72rem;color:var(--muted);font-weight:700;">$</span>
          <input type="number" id="m-plena" class="form-control" min="0" step="1000" placeholder="0" style="padding-left:22px;font-family:'DM Mono',monospace;font-size:.9rem;height:38px;">
        </div>
        <div id="var-plena-info" style="display:none;margin-top:6px;font-size:.67rem;"></div>
      </div>

      <!-- ── COMPONENTES SIMPLES (Multi Recogida + Entrega) ── -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px;">
        <!-- Multi Recogida -->
        <div style="background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:12px;">
          <div style="font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:8px;display:flex;align-items:center;gap:5px;">
            <i class="fas fa-map-marker-alt" style="color:var(--navy2)"></i> Multi Recogida
          </div>
          <div style="position:relative;">
            <span style="position:absolute;left:9px;top:50%;transform:translateY(-50%);font-size:.7rem;color:var(--muted);font-weight:700;">$</span>
            <input type="number" id="m-multi-recogida" class="form-control" min="0" step="1000" value="0" style="padding-left:20px;font-family:'DM Mono',monospace;font-size:.82rem;" placeholder="0">
          </div>
          <div style="font-size:.62rem;color:var(--muted);margin-top:4px">Valor único para múltiples recogidas</div>
        </div>

        <!-- Multi Entrega -->
        <div style="background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:12px;">
          <div style="font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:8px;display:flex;align-items:center;gap:5px;">
            <i class="fas fa-map-pin" style="color:var(--navy2)"></i> Multi Entrega
          </div>
          <div style="position:relative;">
            <span style="position:absolute;left:9px;top:50%;transform:translateY(-50%);font-size:.7rem;color:var(--muted);font-weight:700;">$</span>
            <input type="number" id="m-multi-entrega" class="form-control" min="0" step="1000" value="0" style="padding-left:20px;font-family:'DM Mono',monospace;font-size:.82rem;" placeholder="0">
          </div>
          <div style="font-size:.62rem;color:var(--muted);margin-top:4px">Valor único para múltiples entregas</div>
        </div>
      </div>

      <!-- ── MULTI ORIGEN (detalles por municipio) ── -->
      <div style="background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:14px;margin-bottom:12px;">
        <div style="font-size:.63rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--navy);margin-bottom:10px;display:flex;align-items:center;justify-content:space-between;">
          <span><i class="fas fa-location-arrow" style="color:#0ea5e9"></i> Multi Origen — por Municipio</span>
          <button onclick="addMultiOrigenRow()" style="height:24px;padding:0 10px;background:var(--navy);color:#fff;border:none;border-radius:5px;font-size:.63rem;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:4px;">
            <i class="fas fa-plus"></i> Agregar
          </button>
        </div>
        <div style="font-size:.65rem;color:var(--muted);margin-bottom:8px">Rate 1 = tarifa base desde ese origen · Rate 2 = recargo adicional</div>
        <div id="multi-origen-rows">
          <!-- rows dinámicos -->
        </div>
        <div id="multi-origen-empty" style="text-align:center;padding:10px;font-size:.7rem;color:var(--muted);background:#fff;border-radius:6px;border:1px dashed var(--border)">
          <i class="fas fa-plus-circle" style="margin-right:4px"></i> Agregar municipios de origen con sus tarifas
        </div>
      </div>

      <!-- ── MULTI DESTINO (detalles por municipio) ── -->
      <div style="background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:14px;margin-bottom:12px;">
        <div style="font-size:.63rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--navy);margin-bottom:10px;display:flex;align-items:center;justify-content:space-between;">
          <span><i class="fas fa-map-marked-alt" style="color:#7c3aed"></i> Multi Destino — por Municipio</span>
          <button onclick="addMultiDestinoRow()" style="height:24px;padding:0 10px;background:var(--navy);color:#fff;border:none;border-radius:5px;font-size:.63rem;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:4px;">
            <i class="fas fa-plus"></i> Agregar
          </button>
        </div>
        <div style="font-size:.65rem;color:var(--muted);margin-bottom:8px">Rate 1 = tarifa base hasta ese destino · Rate 2 = recargo adicional</div>
        <div id="multi-destino-rows">
          <!-- rows dinámicos -->
        </div>
        <div id="multi-destino-empty" style="text-align:center;padding:10px;font-size:.7rem;color:var(--muted);background:#fff;border-radius:6px;border:1px dashed var(--border)">
          <i class="fas fa-plus-circle" style="margin-right:4px"></i> Agregar municipios de destino con sus tarifas
        </div>
      </div>

      <!-- Vigencia -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <div>
          <label class="form-label">Año Vigencia</label>
          <input type="number" id="m-anio" class="form-control" min="2024" max="2030" value="2025" disabled>
        </div>
        <div>
          <label class="form-label">Mes Vigencia</label>
          <select id="m-mes" class="form-select" disabled>
            <option value="1">Enero</option>
            <option value="2">Febrero</option>
            <option value="3">Marzo</option>
            <option value="4">Abril</option>
            <option value="5">Mayo</option>
            <option value="6">Junio</option>
            <option value="7">Julio</option>
            <option value="8">Agosto</option>
            <option value="9">Septiembre</option>
            <option value="10">Octubre</option>
            <option value="11">Noviembre</option>
            <option value="12">Diciembre</option>
          </select>
        </div>
      </div>

    </div>

    <!-- Modal footer -->
    <div style="padding:14px 20px;border-top:1px solid var(--border);display:flex;gap:8px;justify-content:flex-end;background:#fafbfc;">
      <button class="btn btn-outline" onclick="cerrarModal()">Cancelar</button>
      <button class="btn btn-primary" onclick="guardarEdicion()">
        <i class="fas fa-save"></i> Guardar Cambios
      </button>
    </div>

  </div>
</div>