        <div class="cex-file-pill" id="cex-file-pill">
          <i class="fas fa-file-excel"></i>
          <span id="cex-file-name">—</span>
          <span class="cex-fp-size" id="cex-file-size"></span>
        </div>

        <!-- Info estructura -->
        <div class="cex-info">
          <strong><i class="fas fa-info-circle me-1"></i>Estructura requerida del archivo:</strong>
          <ul>
            <li><strong>Columna A</strong> — Código RNDC municipio <strong>origen</strong></li>
            <li><strong>Columna B</strong> — Código RNDC municipio <strong>destino</strong></li>
            <li><strong>Columna C</strong> — Código del <strong>tipo de vehículo</strong></li>
          </ul>
          <div style="margin-top:8px">
            La primera fila (encabezado) es ignorada automáticamente.
            El sistema consultará por cada ruta: <strong>región/zona, última tarifa, SICE-TAC, tarifa de mercado, semana, mes y año</strong>.
          </div>
        </div>

      </div>
    </div>

    <!-- Action bar paso 1 -->
    <div class="cex-action-bar">
      <div class="cex-action-info">
        <i class="fas fa-circle-info"></i>
        Selecciona un archivo .xlsx o .xls para continuar
      </div>
      <div class="cex-action-btns">
        <button class="cex-btn cex-btn-primary" id="cex-btn-preview" onclick="cexCalcPreview()">
          <i class="fas fa-search"></i> Calcular preview
        </button>
      </div>
    </div>
  </div>
  <!-- /cex-sec-1 -->

  <!-- ═══════════════ PASO 2: PREVIEW ═══════════════ -->
  <div class="cex-section" id="cex-sec-2">

    <!-- Loading -->
    <div class="cex-loading" id="cex-loading">
      <div class="cex-spin"></div>
      <div style="margin-top:16px;font-size:.85rem;color:var(--c-text-soft)">
        Procesando archivo y consultando tarifas vigentes...
      </div>
    </div>

    <!-- Contenido preview -->
    <div id="cex-preview-content">

      <div class="cex-card">
        <div class="cex-card-header">
          <div class="cex-card-title">
            <i class="fas fa-table"></i> Rutas encontradas — Preview
          </div>
          <!-- Badges resumen -->
          <div class="cex-badges" id="cex-badges" style="margin:0"></div>
        </div>

        <div class="cex-card-body" style="padding:0">
          <div class="cex-table-outer" style="border-radius:0;border:none">
            <div class="cex-table-scroll">
              <table class="cex-table">
                <thead>
                  <tr>
                    <th style="text-align:center; width:36px">#</th>
                    <th>Origen</th>
                    <th>Destino</th>
                    <th>Tipo Vehículo</th>
                    <th>Región / Zona</th>
                    <th style="text-align:right">Últ. Tarifa</th>
                    <th style="text-align:right">SICE-TAC</th>
                    <th style="text-align:right">Tarifa Mercado</th>
                    <th style="text-align:center">Semana</th>
                    <th style="text-align:center">Mes</th>
                    <th style="text-align:center">Año</th>
                    <th style="text-align:center">Estado</th>
                  </tr>
                </thead>
                <tbody id="cex-tbody"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Errores -->
      <div class="cex-err-panel" id="cex-err-panel">
        <div class="cex-err-header">
          <i class="fas fa-exclamation-triangle"></i>
          Filas con error detectadas — serán omitidas en la importación
        </div>
        <div class="cex-err-body" id="cex-err-body"></div>
      </div>

    </div>
    <!-- /cex-preview-content -->

    <!-- Action bar paso 2 -->
    <div class="cex-action-bar" id="cex-bar-2" style="margin-top:16px">
      <div class="cex-action-info">
        <i class="fas fa-eye"></i>
        Revisa las rutas antes de confirmar la importación
      </div>
      <div class="cex-action-btns">
        <button class="cex-btn cex-btn-ghost" onclick="cexIrPaso(1)">
          <i class="fas fa-chevron-left"></i> Volver
        </button>
        <button class="cex-btn cex-btn-outline" onclick="cexExportarPreview()">
          <i class="fas fa-file-excel"></i> Exportar preview
        </button>
        <button class="cex-btn cex-btn-success" id="cex-btn-importar" onclick="cexImportar()">
          <i class="fas fa-check"></i> Confirmar importación
        </button>
      </div>
    </div>
  </div>
  <!-- /cex-sec-2 -->

  <!-- ═══════════════ PASO 3 (IMPORTANDO) ═══════════════ -->
  <div class="cex-section" id="cex-sec-3">
    <div class="cex-card">
      <div class="cex-card-body" style="text-align:center;padding:52px 24px">
        <div class="cex-spin" style="width:48px;height:48px;border-width:4px"></div>
        <div style="margin-top:18px;font-size:.95rem;font-weight:700;color:var(--c-text)">
          Importando rutas...
        </div>
        <div style="margin-top:5px;font-size:.8rem;color:var(--c-text-soft)">
          Guardando registros en el sistema, por favor espera
        </div>
      </div>
    </div>
  </div>
  <!-- /cex-sec-3 -->

  <!-- ═══════════════ PASO 4: RESULTADO ═══════════════ -->
  <div class="cex-section" id="cex-sec-4">
    <div class="cex-card">
      <div class="cex-card-header">
        <div class="cex-card-title">
          <i class="fas fa-check-circle" style="color:var(--c-green)"></i> Proceso completado
        </div>
      </div>
      <div class="cex-card-body">

        <div class="cex-result">
          <div class="cex-result-icon">✅</div>
          <div class="cex-result-title">¡Importación completada!</div>
          <div class="cex-result-sub">Las rutas válidas fueron procesadas y guardadas en el sistema.</div>
        </div>

        <div class="cex-result-cards" id="cex-result-cards"></div>

        <!-- Exportar nota -->
        <div class="cex-export-note">
          <i class="fas fa-file-excel" style="color:var(--c-green)"></i>
          <div>
            Descarga el listado completo con todos los campos del requerimiento:
            <strong>origen, destino, tipo vehículo, región/zona, última tarifa actualizada,
            SICE-TAC, tarifa de mercado, semana, mes y año de actualización.</strong>
          </div>
        </div>

      </div>
    </div>

    <!-- Action bar resultado -->
    <div class="cex-action-bar" style="margin-top:16px">
      <div class="cex-action-info">
        <i class="fas fa-check-circle" style="color:var(--c-green)"></i>
        Proceso finalizado correctamente
      </div>
      <div class="cex-action-btns">
        <button class="cex-btn cex-btn-ghost" onclick="cexReset()">
          <i class="fas fa-redo"></i> Nueva carga
        </button>
        <button class="cex-btn cex-btn-outline" onclick="cexExportarPreview()">
          <i class="fas fa-file-excel"></i> Descargar Excel
        </button>
        <button class="cex-btn cex-btn-primary" onclick="cexFinalizarYListar()">
          <i class="fas fa-list"></i> Ver tarifas importadas
        </button>
      </div>
    </div>
  </div>
  <!-- /cex-sec-4 -->

</div>
<!-- /cex-root -->
