      <div class="stats-row">
        <div class="stat-card">
          <div class="stat-label">Total Rutas</div>
          <div class="stat-val" id="st-rutas">—</div>
        </div>
        <div class="stat-card danger">
          <div class="stat-label">Sin Tarifa</div>
          <div class="stat-val" id="st-sin">—</div>
        </div>
        <div class="stat-card danger">
          <div class="stat-label">Vencidas</div>
          <div class="stat-val" id="st-venc">—</div>
        </div>
        <div class="stat-card warning">
          <div class="stat-label">Por Vencer</div>
          <div class="stat-val" id="st-porv">—</div>
        </div>
        <div class="stat-card success">
          <div class="stat-label">Vigentes</div>
          <div class="stat-val" id="st-vig">—</div>
        </div>
      </div>

      <!-- PARETO BAR -->
      <div class="pareto-wrap" id="pareto-wrap">
        <div class="pareto-label">
          <span><i class="fas fa-chart-bar" style="color:var(--accent);margin-right:4px"></i> Distribución de estado — Rutas Tarifas Venta</span>
          <span id="pareto-rutas-total" style="font-weight:700;color:var(--navy)">—</span>
        </div>
        <div class="pareto-bar">
          <div class="pareto-fill" id="pareto-fill" style="width:0%"></div>
        </div>
        <div style="display:flex;justify-content:space-between;margin-top:6px;font-size:.65rem;color:var(--muted);">
          <span id="pareto-fill-label">—</span>
          <span id="pareto-info" style="font-weight:700;color:var(--accent)">—</span>
        </div>
      </div>

      <!-- INFO VENTAS vs COSTOS -->
      <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:12px 14px;display:flex;gap:10px;align-items:flex-start;">
        <i class="fas fa-info-circle" style="color:var(--accent);margin-top:2px;flex-shrink:0"></i>
        <div style="font-size:.72rem;color:#065f46;line-height:1.5;">
          <strong>Tarifas de VENTAS:</strong> Esta herramienta cruza las rutas frecuentes con
          <code style="background:#d1fae5;padding:1px 4px;border-radius:3px">cmx_tarifas_ventas</code>
          (tarifa al cliente), a diferencia del módulo de Costos que usa
          <code style="background:#d1fae5;padding:1px 4px;border-radius:3px">cmx_flete_nacional</code>.
          Puede filtrar por cliente para ver tarifas específicas por cliente.
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ RESULTADOS ═══ -->
  <div class="results-card">

    <!-- Tabs -->
    <div style="border-bottom:1px solid var(--border);">
      <div class="tab-row">
        <button class="tab-btn active" id="tab-todas" onclick="ventasRP.setTab('todas')">
          Todas <span id="cnt-todas" style="margin-left:4px;font-size:.65rem;opacity:.7"></span>
        </button>
        <button class="tab-btn" id="tab-sin" onclick="ventasRP.setTab('sin')">
          <i class="fas fa-circle" style="color:var(--red);font-size:.5rem"></i> Sin Tarifa
        </button>
        <button class="tab-btn" id="tab-vencida" onclick="ventasRP.setTab('vencida')">
          <i class="fas fa-circle" style="color:var(--red);font-size:.5rem"></i> Vencidas
        </button>
        <button class="tab-btn" id="tab-pv" onclick="ventasRP.setTab('pv')">
          <i class="fas fa-circle" style="color:var(--yellow);font-size:.5rem"></i> Por Vencer
        </button>
        <button class="tab-btn" id="tab-vig" onclick="ventasRP.setTab('vig')">
          <i class="fas fa-circle" style="color:var(--green);font-size:.5rem"></i> Vigentes
        </button>
      </div>
    </div>

    <!-- Header resultados -->
    <div class="results-header">
      <div style="display:flex;align-items:center;gap:8px;">
        <div class="card-header-icon" style="background:rgba(5,150,105,.1);color:var(--accent);width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;">
          <i class="fas fa-route"></i>
        </div>
        <span style="font-weight:700;font-size:.82rem;color:var(--navy)">Rutas Priorizadas — Tarifas de Venta</span>
        <div class="table-count" id="table-count">
          <i class="fas fa-list" style="color:var(--accent)"></i>
          <span id="count-txt">0 rutas</span>
        </div>
      </div>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <input type="text" id="tbl-filter" class="form-control" placeholder="🔍 Filtrar rutas..." style="width:200px;height:32px;font-size:.75rem;">
        <button class="btn btn-outline btn-sm" onclick="ventasRP.exportarExcel()">
          <i class="fas fa-file-excel"></i> Excel
        </button>
      </div>
    </div>

    <!-- Actions bar (selección masiva) -->
    <div class="actions-bar" id="actions-bar">
      <button class="btn btn-primary btn-sm" onclick="ventasRP.actualizarSeleccionadas()">
        <i class="fas fa-sync-alt"></i> Actualizar Seleccionadas
      </button>
      <button class="btn btn-outline btn-sm" onclick="ventasRP.deseleccionarTodo()">
        <i class="fas fa-times"></i> Deseleccionar
      </button>
      <span class="sel-count" id="sel-count">0 seleccionadas</span>
    </div>

    <!-- Tabla -->
    <div id="table-wrap">
      <div class="empty-state">
        <div class="empty-icon"><i class="fas fa-tags"></i></div>
        <div class="empty-text">Configure los filtros y presione <strong>Generar Lista Priorizada</strong> para ver las rutas de ventas que requieren actualización de tarifa.</div>
      </div>
    </div>

  </div>

</div>

<!-- ══════════════════════════════════════════════════
 MODAL EDICIÓN — Tarifa de Venta
 ══════════════════════════════════════════════════ -->
<div id="modal-editar" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(15,31,61,.5);align-items:center;justify-content:center;padding:20px;" onclick="if(event.target===this)ventasRP.cerrarModal()">
  <div style="background:#fff;border-radius:14px;width:100%;max-width:640px;max-height:90vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(15,31,61,.3);">

    <!-- Modal header -->
    <div style="background:linear-gradient(135deg,#0f2b1e,#065f46);padding:16px 20px;display:flex;align-items:center;justify-content:space-between;">
      <div>
        <div style="font-weight:700;color:#fff;font-size:.95rem;display:flex;align-items:center;gap:8px;">
          <i class="fas fa-tags" style="color:var(--accent)"></i>
          <span id="modal-title">Actualizar Tarifa de Venta</span>
        </div>
        <div style="font-size:.68rem;color:rgba(255,255,255,.5);margin-top:2px;" id="modal-ruta-info">—</div>
      </div>
      <button onclick="ventasRP.cerrarModal()" style="background:rgba(255,255,255,.1);border:none;color:#fff;width:30px;height:30px;border-radius:7px;cursor:pointer;font-size:.9rem;display:flex;align-items:center;justify-content:center;">✕</button>
    </div>

    <!-- Modal body -->
    <div style="overflow-y:auto;flex:1;padding:20px;">

      <!-- Info ruta -->
      <div id="modal-ruta-card" style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:12px 14px;margin-bottom:16px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
        <div>
          <div style="font-size:.6rem;text-transform:uppercase;font-weight:700;color:var(--muted);letter-spacing:.05em">Origen</div>
          <div style="font-weight:700;color:var(--navy);font-size:.85rem" id="m-origen">—</div>
        </div>
        <div style="font-size:1.2rem;color:var(--accent)">→</div>
        <div>
          <div style="font-size:.6rem;text-transform:uppercase;font-weight:700;color:var(--muted);letter-spacing:.05em">Destino</div>
          <div style="font-weight:700;color:var(--navy);font-size:.85rem" id="m-destino">—</div>
        </div>
        <div>
          <div style="font-size:.6rem;text-transform:uppercase;font-weight:700;color:var(--muted);letter-spacing:.05em">Vehículo</div>
          <div style="font-weight:700;color:var(--navy);font-size:.85rem" id="m-vehiculo">—</div>
        </div>
        <div>
          <div style="font-size:.6rem;text-transform:uppercase;font-weight:700;color:var(--muted);letter-spacing:.05em">Viajes</div>
          <div style="font-weight:700;color:var(--navy);font-size:.85rem" id="m-viajes">—</div>
        </div>
        <div>
          <div style="font-size:.6rem;text-transform:uppercase;font-weight:700;color:var(--muted);letter-spacing:.05em">Estado</div>
          <div id="m-estado-badge">—</div>
        </div>
      </div>

      <!-- Referencia SICETAC / Mercado -->
      <div id="modal-refs" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px;">
        <div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:7px;padding:10px 12px;">
          <div style="font-size:.6rem;font-weight:700;text-transform:uppercase;color:#0369a1;margin-bottom:3px">Referencia SICETAC</div>
          <div style="font-size:1rem;font-weight:800;color:#0369a1;font-family:'DM Mono',monospace" id="m-sicetac">N/A</div>
        </div>
        <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:7px;padding:10px 12px;">
          <div style="font-size:.6rem;font-weight:700;text-transform:uppercase;color:#15803d;margin-bottom:3px">Referencia Mercado</div>
          <div style="font-size:1rem;font-weight:800;color:#15803d;font-family:'DM Mono',monospace" id="m-mercado">N/A</div>
        </div>
      </div>

      <!-- Cliente (solo ventas) -->
      <div style="background:#f0fdf4;border:1px solid #a7f3d0;border-radius:8px;padding:12px 14px;margin-bottom:12px;display:flex;align-items:center;gap:10px;">
        <i class="fas fa-user-tie" style="color:var(--accent);font-size:.9rem"></i>
        <div style="flex:1;">
          <div style="font-size:.62rem;font-weight:700;text-transform:uppercase;color:var(--muted)">Tarifa de Venta para Cliente</div>
          <div style="font-size:.8rem;color:var(--navy);font-weight:600;margin-top:2px">
            <span id="m-cliente-label">General (aplica a todos)</span>
          </div>
        </div>
        <input type="hidden" id="m-cliente-id" value="">
      </div>

      <!-- Tarifa Plena -->
      <div style="background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:14px;margin-bottom:12px;">
        <div style="font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--navy);margin-bottom:10px;display:flex;align-items:center;gap:6px;">
          <i class="fas fa-dollar-sign" style="color:var(--accent)"></i> Tarifa Plena Venta <span style="color:var(--red)">*</span>
        </div>
        <div style="position:relative;">
          <span style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:.72rem;color:var(--muted);font-weight:700;">$</span>
          <input type="number" id="m-plena" class="form-control" min="0" step="1000" placeholder="0" style="padding-left:22px;font-family:'DM Mono',monospace;font-size:.9rem;height:38px;">
        </div>
        <div id="var-plena-info" style="display:none;margin-top:6px;font-size:.67rem;"></div>
      </div>

      <!-- Componentes Simples -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px;">
        <div style="background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:12px;">
          <div style="font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:8px;display:flex;align-items:center;gap:5px;">
            <i class="fas fa-map-marker-alt" style="color:var(--navy2)"></i> Multi Recogida
          </div>
          <div style="position:relative;">
            <span style="position:absolute;left:9px;top:50%;transform:translateY(-50%);font-size:.7rem;color:var(--muted);font-weight:700;">$</span>
            <input type="number" id="m-multi-recogida" class="form-control" min="0" step="1000" value="0" style="padding-left:20px;font-family:'DM Mono',monospace;font-size:.82rem;" placeholder="0">
          </div>
          <div style="font-size:.62rem;color:var(--muted);margin-top:4px">Valor único para múltiples recogidas</div>
        </div>
        <div style="background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:12px;">
          <div style="font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:8px;display:flex;align-items:center;gap:5px;">
            <i class="fas fa-map-pin" style="color:var(--navy2)"></i> Multi Entrega
          </div>
          <div style="position:relative;">
            <span style="position:absolute;left:9px;top:50%;transform:translateY(-50%);font-size:.7rem;color:var(--muted);font-weight:700;">$</span>
            <input type="number" id="m-multi-entrega" class="form-control" min="0" step="1000" value="0" style="padding-left:20px;font-family:'DM Mono',monospace;font-size:.82rem;" placeholder="0">
          </div>
          <div style="font-size:.62rem;color:var(--muted);margin-top:4px">Valor único para múltiples entregas</div>
        </div>
      </div>

      <!-- Multi Origen -->
      <div style="background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:14px;margin-bottom:12px;">
        <div style="font-size:.63rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--navy);margin-bottom:10px;display:flex;align-items:center;justify-content:space-between;">
          <span><i class="fas fa-location-arrow" style="color:#0ea5e9"></i> Multi Origen — por Municipio</span>
          <button onclick="ventasRP.addMultiOrigenRow()" style="height:24px;padding:0 10px;background:var(--navy);color:#fff;border:none;border-radius:5px;font-size:.63rem;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:4px;">
            <i class="fas fa-plus"></i> Agregar
          </button>
        </div>
        <div style="font-size:.65rem;color:var(--muted);margin-bottom:8px">Rate 1 = tarifa base desde ese origen · Rate 2 = recargo adicional</div>
        <div id="multi-origen-rows"></div>
        <div id="multi-origen-empty" style="text-align:center;padding:10px;font-size:.7rem;color:var(--muted);background:#fff;border-radius:6px;border:1px dashed var(--border)">
          <i class="fas fa-plus-circle" style="margin-right:4px"></i> Agregar municipios de origen con sus tarifas
        </div>
      </div>

      <!-- Multi Destino -->
      <div style="background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:14px;margin-bottom:12px;">
        <div style="font-size:.63rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--navy);margin-bottom:10px;display:flex;align-items:center;justify-content:space-between;">
          <span><i class="fas fa-map-marked-alt" style="color:#7c3aed"></i> Multi Destino — por Municipio</span>
          <button onclick="ventasRP.addMultiDestinoRow()" style="height:24px;padding:0 10px;background:var(--navy);color:#fff;border:none;border-radius:5px;font-size:.63rem;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:4px;">
            <i class="fas fa-plus"></i> Agregar
          </button>
        </div>
        <div style="font-size:.65rem;color:var(--muted);margin-bottom:8px">Rate 1 = tarifa base hasta ese destino · Rate 2 = recargo adicional</div>
        <div id="multi-destino-rows"></div>
        <div id="multi-destino-empty" style="text-align:center;padding:10px;font-size:.7rem;color:var(--muted);background:#fff;border-radius:6px;border:1px dashed var(--border)">
          <i class="fas fa-plus-circle" style="margin-right:4px"></i> Agregar municipios de destino con sus tarifas
        </div>
      </div>

      <!-- Vigencia -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <div>
          <label class="form-label">Año Vigencia</label>
          <input type="number" id="m-anio" class="form-control" min="2024" max="2030" value="2025" disabled>
        </div>
        <div>
          <label class="form-label">Mes Vigencia</label>
          <select id="m-mes" class="form-select" disabled>
            <option value="1">Enero</option>
            <option value="2">Febrero</option>
            <option value="3">Marzo</option>
            <option value="4">Abril</option>
            <option value="5">Mayo</option>
            <option value="6">Junio</option>
            <option value="7">Julio</option>
            <option value="8">Agosto</option>
            <option value="9">Septiembre</option>
            <option value="10">Octubre</option>
            <option value="11">Noviembre</option>
            <option value="12">Diciembre</option>
          </select>
        </div>
      </div>

    </div>

    <!-- Modal footer -->
    <div style="padding:14px 20px;border-top:1px solid var(--border);display:flex;gap:8px;justify-content:flex-end;background:#f0fdf4;">
      <button class="btn btn-outline" onclick="ventasRP.cerrarModal()">Cancelar</button>
      <button class="btn btn-primary" onclick="ventasRP.guardarEdicion()">
        <i class="fas fa-save"></i> Guardar Tarifa de Venta
      </button>
    </div>

  </div>
</div>