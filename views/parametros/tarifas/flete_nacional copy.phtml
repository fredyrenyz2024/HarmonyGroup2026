            font-size: .88rem;
            font-weight: 700;
            cursor: pointer;
            transition: background .2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .im-btn-finalizar:hover {
            background: var(--im-navy);
        }

        .im-btn-otro {
            padding: 10px;
            background: transparent;
            color: var(--im-gray);
            border: 1px solid var(--im-border);
            border-radius: 8px;
            font-size: .85rem;
            font-weight: 600;
            cursor: pointer;
            transition: all .2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .im-btn-otro:hover {
            background: var(--im-light);
            color: var(--im-navy);
        }

        /* ── WARNING ── */
        .im-warn {
            background: #fffbeb;
            border: 1px solid #fde68a;
            border-left: 4px solid var(--im-orange);
            border-radius: 7px;
            padding: 10px 12px;
            font-size: .78rem;
            color: #92400e;
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-top: 14px;
        }
    </style>

    <!-- ── HEADER ── -->
    <div class="im-header">
        <div class="im-header-left">
            <div class="im-header-icon"><i class="fas fa-file-excel"></i></div>
            <div>
                <p class="im-header-title">Importación Masiva — Tarifas de Costo</p>
                <p class="im-header-sub">Carga de plantilla Excel · Hasta 3 hojas simultáneas</p>
            </div>
        </div>
        <button class="im-close-btn" data-bs-dismiss="offcanvas" title="Cerrar">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <!-- Instrucciones y descarga de plantilla -->
    <div class="card border-0 bg-light mb-4">
        <div class="card-body py-3">
            <h6 class="fw-bold mb-2">
                <i class="fas fa-info-circle text-primary me-2"></i>
                Instrucciones
            </h6>
            <ol class="mb-2 ps-3 small">
                <li>Descarga la plantilla Excel y completa los datos.</li>
                <li>La hoja <strong>archivo</strong> contiene una tarifa por fila.</li>
                <li>Las hojas <strong>multiorigen</strong> y <strong>multidestino</strong>
                    usan la columna <strong>fila_ref</strong> para vincular
                    sus municipios con la tarifa correspondiente de la hoja <em>archivo</em>.</li>
                <li>Las tarifas que superen el umbral de variación configurado
                    se enviarán a <em>Pendiente de Aprobación</em> automáticamente;
                    la tarifa anterior permanece activa.</li>
            </ol>
            <button class="btn btn-sm btn-outline-success"
                onclick="descargarPlantillaMasivo()">
                <i class="fas fa-download me-1"></i>
                Descargar plantilla (.xlsx)
            </button>
        </div>
    </div>

    <!-- ── BODY ── -->
    <div class="im-body" id="im-body-wrap">

        <!-- ======================================================
             SECCIÓN 1: UPLOAD
             ====================================================== -->
        <div id="im-upload-section">

            <!-- Drop zone -->
            <div class="im-dropzone" id="im-dropzone" onclick="document.getElementById('archivo_excel_costos').click()">
                <div class="im-dropzone-icon"><i class="fas fa-cloud-upload-alt"></i></div>
                <div class="im-dropzone-title">Arrastra tu archivo aquí o haz clic para seleccionar</div>
                <div class="im-dropzone-sub" style="margin-top:8px;">
                    <span class="im-dropzone-badge">.xlsx</span>
                    <span class="im-dropzone-badge">.xls</span>
                </div>
            </div>
            <input type="file" id="archivo_excel_costos" accept=".xlsx,.xls" onchange="imOnFileSelected(this)">

            <!-- Archivo seleccionado -->
            <div class="im-file-selected" id="im-file-preview">
                <div class="im-file-icon"><i class="fas fa-file-excel"></i></div>
                <div>
                    <div class="im-file-name" id="im-file-name">—</div>
                    <div class="im-file-size" id="im-file-size">—</div>
                </div>
                <button class="im-file-clear" onclick="imLimpiarArchivo()" title="Quitar archivo">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Estructura esperada del Excel -->
            <div class="im-sheets-info">
                <div class="im-sheets-info-header">
                    <i class="fas fa-table"></i> Estructura del archivo Excel
                </div>
                <div class="im-sheet-row">
                    <span class="im-sheet-tab green">archivo</span>
                    <div>
                        <div class="im-sheet-desc">Tarifa principal por ruta y vehículo</div>
                        <div class="im-sheet-cols">Columnas: Origen · Destino · Tipo vehículo · Plena · Multi-Recogida · Multi-Entrega</div>
                    </div>
                </div>
                <div class="im-sheet-row">
                    <span class="im-sheet-tab amber">multiorigen</span>
                    <div>
                        <div class="im-sheet-desc">Detalles de Multi-Origen por municipio</div>
                        <div class="im-sheet-cols">Columnas: N° Fila (ref.) · Municipio ID · Rate 1 · Rate 2</div>
                    </div>
                </div>
                <div class="im-sheet-row">
                    <span class="im-sheet-tab purple">multidestino</span>
                    <div>
                        <div class="im-sheet-desc">Detalles de Multi-Destino por municipio</div>
                        <div class="im-sheet-cols">Columnas: N° Fila (ref.) · Municipio ID · Rate 1 · Rate 2</div>
                    </div>
                </div>
            </div>

            <!-- Advertencia -->
            <div class="im-warn">
                <i class="fas fa-exclamation-triangle" style="flex-shrink:0; margin-top:1px;"></i>
                <span>Las tarifas que superen el umbral de variación permitido quedarán <strong>INACTIVAS</strong> y entrarán a la bandeja de aprobación. Las demás se activarán automáticamente.</span>
            </div>

            <!-- Botón iniciar -->
            <button class="im-btn-import" id="im-btn-start" onclick="importarTarifasMasivo()" disabled>
                <i class="fas fa-cloud-upload-alt"></i>
                Iniciar Importación
            </button>

        </div>

        <!-- ======================================================
             SECCIÓN 2: PROGRESO
             ====================================================== -->
        <div id="im-progress-section" style="display:none;">

            <div class="im-prog-header">
                <div class="im-spinner-wrap">
                    <div class="im-spinner-ring"></div>
                    <div class="im-spinner-pct" id="im-pct-label">0%</div>
                </div>
                <div class="im-prog-title" id="im-prog-title">Procesando archivo...</div>
                <div class="im-prog-sub" id="im-prog-sub">Por favor espera, esto puede tomar unos minutos</div>
            </div>

            <div class="im-progress-track">
                <div class="im-progress-fill" id="im-progress-fill"></div>
            </div>
            <div style="display:flex; justify-content:space-between; font-size:.72rem; color:var(--im-gray); margin-bottom:14px;">
                <span>0%</span><span id="im-pct-right">0%</span>
            </div>

            <!-- Pasos del proceso -->
            <div class="im-steps" id="im-steps-list">
                <div class="im-step" id="step-convirtiendo">
                    <div class="im-step-dot"><i class="fas fa-sync-alt"></i></div>
                    <span>Convirtiendo fórmulas Excel a valores</span>
                </div>
                <div class="im-step" id="step-archivo">
                    <div class="im-step-dot">1</div>
                    <span>Procesando hoja <strong>archivo</strong> — rutas y tarifas base</span>
                </div>
                <div class="im-step" id="step-multiorigen">
                    <div class="im-step-dot">2</div>
                    <span>Procesando hoja <strong>multiorigen</strong></span>
                </div>
                <div class="im-step" id="step-multidestino">
                    <div class="im-step-dot">3</div>
                    <span>Procesando hoja <strong>multidestino</strong></span>
                </div>
                <div class="im-step" id="step-variaciones">
                    <div class="im-step-dot"><i class="fas fa-chart-line"></i></div>
                    <span>Evaluando variaciones y reglas de aprobación</span>
                </div>
                <div class="im-step" id="step-finalizando">
                    <div class="im-step-dot"><i class="fas fa-check"></i></div>
                    <span>Finalizando y actualizando lista de tarifas</span>
                </div>
            </div>

            <div class="im-warn" style="margin-top:16px;">
                <i class="fas fa-lock" style="flex-shrink:0; margin-top:1px;"></i>
                <span>No cierres esta ventana hasta que el proceso finalice.</span>
            </div>

        </div>

        <!-- ======================================================
             SECCIÓN 3: RESULTADO
             ====================================================== -->
        <div id="im-result-section" style="display:none;">

            <!-- Hero resultado -->
            <div class="im-result-hero">
                <div class="im-result-icon" id="im-result-icon">✅</div>
                <div class="im-result-title" id="im-result-title">¡Importación completada!</div>
                <div class="im-result-sub" id="im-result-sub">Todas las filas fueron procesadas</div>
            </div>

            <!-- Resumen en cards -->
            <div class="im-summary-grid" id="im-summary-grid">
                <div class="im-summary-card">
                    <div class="im-summary-card-icon ic-activas"><i class="fas fa-check-circle"></i></div>
                    <div>
                        <div class="im-summary-num" id="sum-activas">0</div>
                        <div class="im-summary-label">Activadas</div>
                    </div>
                </div>
                <div class="im-summary-card">
                    <div class="im-summary-card-icon ic-pendientes"><i class="fas fa-hourglass-half"></i></div>
                    <div>
                        <div class="im-summary-num" id="sum-pendientes">0</div>
                        <div class="im-summary-label">A bandeja aprobación</div>
                    </div>
                </div>
                <div class="im-summary-card">
                    <div class="im-summary-card-icon ic-saltadas"><i class="fas fa-forward"></i></div>
                    <div>
                        <div class="im-summary-num" id="sum-saltadas">0</div>
                        <div class="im-summary-label">Saltadas (pend. previa)</div>
                    </div>
                </div>
                <div class="im-summary-card">
                    <div class="im-summary-card-icon ic-errores"><i class="fas fa-times-circle"></i></div>
                    <div>
                        <div class="im-summary-num" id="sum-errores">0</div>
                        <div class="im-summary-label">Con error</div>
                    </div>
                </div>
            </div>

            <!-- Detalle pendientes de aprobación -->
            <div class="im-detail-section" id="im-block-pendientes" style="display:none;">
                <button class="im-detail-toggle" onclick="imToggleDetalle('pendientes')">
                    <span>
                        <i class="fas fa-hourglass-half me-2" style="color:#d97706;"></i>
                        Tarifas enviadas a bandeja de aprobación
                    </span>
                    <span class="badge-count" id="badge-pendientes"
                        style="background:#fef3c7; color:#854d0e;">0</span>
                </button>
                <div class="im-detail-body" id="detail-pendientes"></div>
            </div>

            <!-- Detalle errores -->
            <div class="im-detail-section" id="im-block-errores" style="display:none;">
                <button class="im-detail-toggle" onclick="imToggleDetalle('errores')">
                    <span>
                        <i class="fas fa-exclamation-circle me-2" style="color:#dc2626;"></i>
                        Filas con error
                    </span>
                    <span class="badge-count" id="badge-errores"
                        style="background:#fee2e2; color:#991b1b;">0</span>
                </button>
                <div class="im-detail-body" id="detail-errores"></div>
            </div>

            <!-- Botones -->
            <div class="im-result-footer">
                <button class="im-btn-finalizar" onclick="imCerrar()">
                    <i class="fas fa-check"></i> Finalizar y ver tarifas
                </button>
                <button class="im-btn-otro" onclick="imReset()">
                    <i class="fas fa-redo"></i> Importar otro archivo
                </button>
            </div>

        </div>
    </div>
    <!-- /im-body -->
</div>
<!-- /offcanvas -->