        <!-- {{-- Filtro Cliente (solo visible en ventas) --}} -->
        <div class="col-12 col-md-4 filtro-cliente" id="filtro-cliente-wrap">
          <label class="f-label" for="sel-cliente">
            <i class="ti ti-building me-1"></i>
            Cliente
          </label>
          <select id="sel-cliente" onchange="ExportarTarifas.setFiltro('cliente_id', this.value)">
            <!-- <option value="">— Todos los clientes —</option> -->
          </select>
        </div>

        <!-- {{-- Filtro Tipo de Vehículo --}} -->
        <div class="col-12 col-md-4">
          <label class="f-label" for="sel-vehiculo">
            <i class="ti ti-truck me-1"></i>
            Configuración de Vehículo
          </label>
          <select class="f-control" id="sel-vehiculo" onchange="ExportarTarifas.setFiltro('tipo_vehiculo', this.value)">
            <option value="">— Todos los vehículos —</option>
            <option value="NHR_2">NHR — Sencillo &gt;2500 Kg</option>
            <option value="2">Sencillo &gt;10500 Kg</option>
            <option value="2_7_8">Sencillo 7500-8000 Kg</option>
            <option value="2_8_9">Sencillo 8001-9000 Kg</option>
            <option value="2_9_105">Sencillo 9001-10500 Kg</option>
            <option value="2S2">Tractomula 2+2 ejes</option>
            <option value="2S3">Tractomula 2+3 ejes</option>
            <option value="3">Dobletroque 3 ejes</option>
            <option value="3S2">Tractomula 3+2 ejes</option>
            <option value="3S3">Tractomula 3+3 ejes</option>
            <option value="V2">Volqueta 2 ejes</option>
            <option value="V3">Volqueta 3 ejes</option>
            <option value="V4">Volqueta 4 ejes</option>
          </select>
        </div>
      </div>

      <!-- {{-- FILA 2: Origen, Destino, Estado --}} -->
      <div class="row g-3 mb-3">
        <div class="col-12 col-md-4">
          <label class="f-label" for="sel-origen">
            <i class="ti ti-map-pin me-1"></i>
            Origen (Municipio)
          </label>
          <select class="f-control" id="sel-origen-exportar" onchange="ExportarTarifas.setFiltro('origen', this.value)">
            <option value="">— Todos los orígenes —</option>
          </select>
        </div>
        <div class="col-12 col-md-4">
          <label class="f-label" for="sel-destino">
            <i class="ti ti-map-pin-2 me-1"></i>
            Destino (Municipio)
          </label>
          <select class="f-control" id="sel-destino-exportar" onchange="ExportarTarifas.setFiltro('destino', this.value)">
            <option value="">— Todos los destinos —</option>
          </select>
        </div>
        <div class="col-12 col-md-4">
          <label class="f-label" for="sel-estado">
            <i class="ti ti-circle-dot me-1"></i>
            Estado de Tarifa
          </label>
          <select class="f-control" id="sel-estado" onchange="ExportarTarifas.setFiltro('estado_tarifa', this.value)">
            <option value="">— Todos los estados —</option>
            <option value="Activa">Activa</option>
            <option value="Inactiva">Inactiva</option>
          </select>
        </div>
      </div>

      <!-- {{-- SEPARADOR: Filtros avanzados --}} -->
      <div class="filter-divider"><span>Filtros Avanzados</span></div>

      <!-- {{-- TOGGLE DE FILTROS AVANZADOS --}} -->
      <div class="d-flex align-items-center justify-content-between mb-2">
        <button class="toggle-advanced" id="btn-toggle-advanced"
          onclick="ExportarTarifas.toggleAdvanced()" type="button">
          <i class="ti ti-chevron-down ti-icon"></i>
          Mostrar más filtros
        </button>
        <div class="d-flex gap-2">
          <button class="btn-clear" onclick="ExportarTarifas.limpiarFiltros()" type="button">
            <i class="ti ti-x"></i> Limpiar
          </button>
          <button class="btn-search" id="btn-consultar"
            onclick="ExportarTarifas.consultar()" type="button">
            <i class="ti ti-search"></i> Consultar
          </button>
        </div>
      </div>

      <!-- {{-- FILTROS AVANZADOS (colapsables) --}} -->
      <div class="advanced-filters" id="advanced-filters-panel">

        <div class="row g-3 mb-3">

          <!-- {{-- Filtro de Zona --}} -->
          <div class="col-12 col-md-3">
            <label class="f-label" for="sel-zona">
              <i class="ti ti-world me-1"></i>
              Zona
            </label>
            <select class="f-control" id="sel-zona" onchange="ExportarTarifas.setFiltro('zona_id', this.value)">
              <option value="">— Todas las zonas —</option>
            </select>
          </div>

          <!-- {{-- Filtro Estado de Aprobación --}} -->
          <div class="col-12 col-md-3">
            <label class="f-label" for="sel-aprobacion">
              <i class="ti ti-checks me-1"></i>
              Estado de Aprobación
            </label>
            <select class="f-control" id="sel-aprobacion"
              onchange="ExportarTarifas.setFiltro('estado_aprobacion', this.value)">
              <option value="">— Todos —</option>
              <option value="Aprobado">Aprobado</option>
              <option value="Pendiente Aprobacion">Pendiente Aprobación</option>
              <option value="Rechazado">Rechazado</option>
            </select>
          </div>

          <!-- {{-- Filtro Estado de Vigencia --}} -->
          <div class="col-12 col-md-3">
            <label class="f-label" for="sel-vigencia">
              <i class="ti ti-calendar-check me-1"></i>
              Vigencia de Tarifa
            </label>
            <select class="f-control" id="sel-vigencia"
              onchange="ExportarTarifas.setFiltro('estado_vigencia', this.value)">
              <option value="">— Todas —</option>
              <option value="Vigente">Vigente</option>
              <option value="Por Vencer">Por Vencer</option>
              <option value="Vencida">Vencida</option>
            </select>
          </div>

          <!-- {{-- Año de Vigencia --}} -->
          <div class="col-12 col-md-3">
            <label class="f-label" for="inp-vigencia-anio">
              <i class="ti ti-calendar me-1"></i>
              Año de Vigencia
            </label>
            <select class="f-control" id="inp-vigencia-anio"
              onchange="ExportarTarifas.setFiltro('vigencia', this.value)">
              <option value="">— Todos los años —</option>
            </select>
          </div>
        </div>

        <div class="row g-3 mb-3">

          <!-- {{-- Rango de Fechas: Desde --}} -->
          <div class="col-12 col-md-3">
            <label class="f-label" for="inp-fecha-desde">
              <i class="ti ti-calendar-event me-1"></i>
              Fecha Desde
            </label>
            <input type="date" class="f-control" id="inp-fecha-desde"
              onchange="ExportarTarifas.setFiltro('fecha_desde', this.value)" />
          </div>

          <!-- {{-- Rango de Fechas: Hasta --}} -->
          <div class="col-12 col-md-3">
            <label class="f-label" for="inp-fecha-hasta">
              <i class="ti ti-calendar-event me-1"></i>
              Fecha Hasta
            </label>
            <input type="date" class="f-control" id="inp-fecha-hasta"
              onchange="ExportarTarifas.setFiltro('fecha_hasta', this.value)" />
          </div>

          <!-- {{-- Semana Desde --}} -->
          <div class="col-12 col-md-3">
            <label class="f-label" for="inp-semana-desde">
              <i class="ti ti-clock me-1"></i>
              Semana Desde
            </label>
            <input type="number" class="f-control" id="inp-semana-desde"
              min="1" max="53" placeholder="Ej: 1"
              onchange="ExportarTarifas.setFiltro('semana_desde', this.value)" />
          </div>

          <!-- {{-- Semana Hasta --}} -->
          <div class="col-12 col-md-3">
            <label class="f-label" for="inp-semana-hasta">
              <i class="ti ti-clock me-1"></i>
              Semana Hasta
            </label>
            <input type="number" class="f-control" id="inp-semana-hasta"
              min="1" max="53" placeholder="Ej: 52"
              onchange="ExportarTarifas.setFiltro('semana_hasta', this.value)" />
          </div>
        </div>

        <div class="row g-3">

          <!-- {{-- Mes Desde --}} -->
          <div class="col-12 col-md-3">
            <label class="f-label" for="inp-mes-desde">
              <i class="ti ti-calendar-month me-1"></i>
              Mes Desde
            </label>
            <select class="f-control" id="inp-mes-desde"
              onchange="ExportarTarifas.setFiltro('mes_desde', this.value)">
              <option value="">— Seleccionar —</option>
              <option value="1">Enero</option>
              <option value="2">Febrero</option>
              <option value="3">Marzo</option>
              <option value="4">Abril</option>
              <option value="5">Mayo</option>
              <option value="6">Junio</option>
              <option value="7">Julio</option>
              <option value="8">Agosto</option>
              <option value="9">Septiembre</option>
              <option value="10">Octubre</option>
              <option value="11">Noviembre</option>
              <option value="12">Diciembre</option>
            </select>
          </div>

          <!-- {{-- Mes Hasta --}} -->
          <div class="col-12 col-md-3">
            <label class="f-label" for="inp-mes-hasta">
              <i class="ti ti-calendar-month me-1"></i>
              Mes Hasta
            </label>
            <select class="f-control" id="inp-mes-hasta"
              onchange="ExportarTarifas.setFiltro('mes_hasta', this.value)">
              <option value="">— Seleccionar —</option>
              <option value="1">Enero</option>
              <option value="2">Febrero</option>
              <option value="3">Marzo</option>
              <option value="4">Abril</option>
              <option value="5">Mayo</option>
              <option value="6">Junio</option>
              <option value="7">Julio</option>
              <option value="8">Agosto</option>
              <option value="9">Septiembre</option>
              <option value="10">Octubre</option>
              <option value="11">Noviembre</option>
              <option value="12">Diciembre</option>
            </select>
          </div>

        </div>
      </div>

      <!-- {{-- CHIPS DE FILTROS ACTIVOS --}} -->
      <div class="active-filters" id="chips-filtros-activos"></div>

    </div>
  </div>

  <!-- {{-- ══════════════════════════════════════════════════════
         CARD DE TABLA DE RESULTADOS
    ══════════════════════════════════════════════════════ --}} -->
  <div class="table-card">
    <div class="table-card-header">
      <div class="tc-title">
        <i class="ti ti-table"></i>
        <span>Resultados</span>
        <span id="badge-count" class="badge-status bs-approved ms-1" style="display:none;"></span>
      </div>
      <div class="tc-actions">
        <!-- {{-- Búsqueda rápida en tabla --}} -->
        <div class="search-wrap">
          <i class="ti ti-search"></i>
          <input type="text" class="search-inline" id="buscar-tabla"
            placeholder="Buscar en tabla…"
            oninput="ExportarTarifas.filtrarTablaLocal(this.value)" />
        </div>
        <!-- {{-- Refrescar --}} -->
        <button class="btn-refresh" title="Refrescar"
          onclick="ExportarTarifas.consultar()" type="button">
          <i class="ti ti-refresh"></i>
        </button>
        <!-- {{-- Exportar a Excel --}} -->
        <button class="btn-export" id="btn-exportar" onclick="ExportarTarifas.exportarExcel()" type="button">
          <i class="ti ti-file-spreadsheet"></i> Exportar Excel
        </button>
      </div>
    </div>

    <!-- {{-- TABLA --}} -->
    <div class="table-wrap">
      <table class="data-table" id="tabla-tarifas">
        <thead>
          <tr>
            <th>#</th>
            <th>Origen</th>
            <th>Destino</th>
            <th>Tipo Vehículo</th>
            <th>Región / Zona</th>
            <th>Última Tarifa</th>
            <th>Tarifa SICE-TAC</th>
            <th>Tarifa Mercado</th>
            <th>Semana</th>
            <th>Mes</th>
            <th>Año (Vigencia)</th>
            <th>Estado</th>
            <th>Aprobación</th>
            <th>Vigencia</th>
          </tr>
        </thead>
        <tbody id="tbody-tarifas">
          <!-- {{-- Estado inicial: invitar a consultar --}} -->
          <tr>
            <td colspan="14">
              <div class="empty-state">
                <div class="es-icon"><i class="ti ti-file-search"></i></div>
                <div class="es-title">Sin datos cargados</div>
                <div class="es-sub">Aplica los filtros deseados y presiona <strong>Consultar</strong> para cargar resultados.</div>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- {{-- PAGINATION BAR --}} -->
    <div class="pagination-bar" id="pagination-bar" style="display:none;">
      <div class="pag-info" id="pag-info-text">
        Mostrando <strong>0</strong> registros
      </div>
      <div style="font-size:.75rem; color:var(--slate-400);">
        <i class="ti ti-info-circle me-1"></i>
        Use el botón <strong>Exportar Excel</strong> para descargar todos los datos.
      </div>
    </div>
  </div>
</div>