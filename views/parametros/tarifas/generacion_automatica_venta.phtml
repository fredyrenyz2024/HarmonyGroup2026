          <div>
            <label class="form-label">Fecha Hasta</label>
            <input type="date" id="g-hasta" class="form-control">
          </div>
          <div>
            <label class="form-label">Cliente</label>
            <select id="g-cliente" class="form-select">
              <option value="">Todos los clientes</option>
            </select>
          </div>
          <div>
            <label class="form-label">Zona</label>
            <select id="g-zona" class="form-select">
              <option value="">Todas las zonas</option>
            </select>
          </div>
          <button class="btn btn-primary" style="width:100%;margin-top:2px;" onclick="ventasRP.generarLista()">
            <i class="fas fa-bolt"></i> Generar Lista Priorizada
          </button>
        </div>
      </div>

    </div><!-- /sidebar -->

    <!-- ── COLUMNA PRINCIPAL ── -->
    <div class="vta-main">

      <!-- STATS — 6 tarjetas -->
      <div class="vta-stats">
        <div class="vta-stat">
          <div class="vta-stat-label">Rutas Priorizadas</div>
          <div class="vta-stat-val" id="st-rutas">—</div>
        </div>
        <div class="vta-stat danger">
          <div class="vta-stat-label">Sin Tarifa</div>
          <div class="vta-stat-val" id="st-sin">—</div>
          <div style="font-size:.58rem;color:var(--red);margin-top:2px;">Acción urgente</div>
        </div>
        <div class="vta-stat danger">
          <div class="vta-stat-label">Vencidas</div>
          <div class="vta-stat-val" id="st-venc">—</div>
        </div>
        <div class="vta-stat warning">
          <div class="vta-stat-label">Por Vencer</div>
          <div class="vta-stat-val" id="st-porv">—</div>
        </div>
        <div class="vta-stat success">
          <div class="vta-stat-label">Vigentes</div>
          <div class="vta-stat-val" id="st-vig">—</div>
        </div>
        <div class="vta-stat">
          <div class="vta-stat-label">Total Viajes</div>
          <div class="vta-stat-val" id="st-viajes">—</div>
        </div>
      </div>

      <!-- PARETO BAR -->
      <div class="vta-pareto" id="pareto-wrap">
        <div class="vta-pareto-label">
          <span><i class="fas fa-chart-bar" style="color:var(--accent);margin-right:4px"></i> Lista Priorizada de Rutas — Ventas</span>
          <span id="pareto-rutas-total" style="font-weight:700;color:var(--navy)">—</span>
        </div>
        <div class="vta-pareto-bar">
          <div class="vta-pareto-fill" id="pareto-fill" style="width:0%"></div>
        </div>
        <div style="display:flex;justify-content:space-between;margin-top:5px;font-size:.63rem;color:var(--muted);">
          <span id="pareto-fill-label">—</span>
          <span id="pareto-info" style="font-weight:700;color:var(--accent)">—</span>
        </div>
      </div>

      <!-- TABLA RESULTADOS -->
      <div class="vta-results">

        <!-- Tabs -->
        <div style="border-bottom:1px solid var(--border);">
          <div class="vta-tab-row">
            <button class="vta-tab-btn active" id="tab-todas" onclick="ventasRP.setTab('todas')">Todas <span id="cnt-todas" style="font-size:.62rem;opacity:.7"></span></button>
            <button class="vta-tab-btn" id="tab-sin" onclick="ventasRP.setTab('sin')"><i class="fas fa-circle" style="color:var(--red);font-size:.45rem"></i> Sin Tarifa</button>
            <button class="vta-tab-btn" id="tab-vencida" onclick="ventasRP.setTab('vencida')"><i class="fas fa-circle" style="color:var(--red);font-size:.45rem"></i> Vencidas</button>
            <button class="vta-tab-btn" id="tab-pv" onclick="ventasRP.setTab('pv')"><i class="fas fa-circle" style="color:var(--yellow);font-size:.45rem"></i> Por Vencer</button>
            <button class="vta-tab-btn" id="tab-vig" onclick="ventasRP.setTab('vig')"><i class="fas fa-circle" style="color:var(--green);font-size:.45rem"></i> Vigentes</button>
          </div>
        </div>

        <!-- Header resultados -->
        <div class="vta-results-header">
          <div style="display:flex;align-items:center;gap:8px;">
            <i class="fas fa-route" style="color:var(--accent)"></i>
            <span style="font-weight:700;font-size:.8rem;color:var(--navy)">Lista Priorizada de Rutas</span>
            <div class="vta-table-count" id="table-count">
              <i class="fas fa-list" style="color:var(--accent)"></i>
              <span id="count-txt">0 rutas</span>
            </div>
          </div>
          <div style="display:flex;gap:7px;align-items:center;">
            <input type="text" id="tbl-filter" class="form-control" placeholder="🔍 Filtrar..." style="width:190px;height:30px;font-size:.73rem;">
            <button class="btn btn-outline btn-sm" style="height:30px;" onclick="ventasRP.exportarExcel()">
              <i class="fas fa-file-excel" style="color:var(--green)"></i> Excel
            </button>
            <button class="btn btn-outline btn-sm" id="btn-sel-todo" style="height:30px;" onclick="ventasRP.toggleSelTodo()">
              <i class="fas fa-check-square"></i> Sel. Todo
            </button>
          </div>
        </div>

        <!-- Actions bar masivo -->
        <div class="vta-actions-bar" id="actions-bar">
          <button class="btn btn-primary btn-sm" onclick="ventasRP.actualizarSeleccionadas()">
            <i class="fas fa-sync-alt"></i> Actualizar Seleccionadas
          </button>
          <button class="btn btn-outline btn-sm" onclick="ventasRP.deseleccionarTodo()">
            <i class="fas fa-times"></i> Deseleccionar
          </button>
          <span style="font-size:.7rem;color:var(--muted)" id="sel-count">0 seleccionadas</span>
        </div>

        <!-- Tabla wrap -->
        <div id="vta-table-wrap">
          <div class="vta-empty">
            <div class="vta-empty-icon"><i class="fas fa-bolt"></i></div>
            <div class="vta-empty-text">Lista no generada<br><small>Configure el parámetro TOP y presione "Generar Lista Priorizada"</small></div>
          </div>
        </div>

      </div><!-- /vta-results -->

    </div><!-- /vta-main -->

  </div><!-- /vta-layout -->

</div>

<!-- ══════════════════════════════════════════════════
 MODAL EDICIÓN — Tarifa de Venta
 Solo editar valores existentes. Sin botón Agregar.
 Multi Origen / Destino: solo se muestran los detalles
 que ya tiene la tarifa — solo editable rate_1 y rate_2.
 ══════════════════════════════════════════════════ -->
<div id="modal-editar" style="display:none;position:fixed;inset:0;z-index:2000;background:rgba(15,31,61,.5);align-items:center;justify-content:center;padding:20px;" onclick="if(event.target===this)ventasRP.cerrarModal()">
  <div style="background:#fff;border-radius:14px;width:100%;max-width:600px;max-height:90vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(15,31,61,.3);font-family:'DM Sans',sans-serif;">

    <!-- Header modal -->
    <div style="background:linear-gradient(135deg,#0f2b1e,#065f46);padding:15px 19px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;">
      <div>
        <div style="font-weight:700;color:#fff;font-size:.92rem;display:flex;align-items:center;gap:8px;">
          <i class="fas fa-tags" style="color:#10b981"></i>
          <span id="modal-title">Actualizar Tarifa de Venta</span>
        </div>
        <div style="font-size:.65rem;color:rgba(255,255,255,.5);margin-top:2px" id="modal-ruta-info">—</div>
      </div>
      <button onclick="ventasRP.cerrarModal()" style="background:rgba(255,255,255,.12);border:none;color:#fff;width:28px;height:28px;border-radius:6px;cursor:pointer;font-size:.85rem;display:flex;align-items:center;justify-content:center;">✕</button>
    </div>

    <!-- Body modal -->
    <div style="overflow-y:auto;flex:1;padding:18px;">

      <!-- Info ruta -->
      <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:11px 13px;margin-bottom:14px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
        <div>
          <div style="font-size:.58rem;text-transform:uppercase;font-weight:700;color:var(--muted)">Origen</div>
          <div style="font-weight:700;color:var(--navy);font-size:.82rem" id="m-origen">—</div>
        </div>
        <div style="font-size:1.1rem;color:#059669">→</div>
        <div>
          <div style="font-size:.58rem;text-transform:uppercase;font-weight:700;color:var(--muted)">Destino</div>
          <div style="font-weight:700;color:var(--navy);font-size:.82rem" id="m-destino">—</div>
        </div>
        <div>
          <div style="font-size:.58rem;text-transform:uppercase;font-weight:700;color:var(--muted)">Vehículo</div>
          <div style="font-weight:700;color:var(--navy);font-size:.82rem" id="m-vehiculo">—</div>
        </div>
        <div>
          <div style="font-size:.58rem;text-transform:uppercase;font-weight:700;color:var(--muted)">Viajes</div>
          <div style="font-weight:700;color:var(--navy);font-size:.82rem" id="m-viajes">—</div>
        </div>
        <div id="m-estado-badge">—</div>
      </div>

      <!-- Cliente -->
      <div style="background:#f0fdf4;border:1px solid #a7f3d0;border-radius:7px;padding:9px 13px;margin-bottom:12px;display:flex;align-items:center;gap:9px;">
        <i class="fas fa-user-tie" style="color:#059669;font-size:.85rem;flex-shrink:0"></i>
        <div>
          <div style="font-size:.6rem;font-weight:700;text-transform:uppercase;color:var(--muted)">Tarifa para Cliente</div>
          <div style="font-size:.78rem;color:var(--navy);font-weight:600;margin-top:1px"><span id="m-cliente-label">General</span></div>
        </div>
        <input type="hidden" id="m-cliente-id" value="">
      </div>

      <!-- Tarifa Plena -->
      <div style="background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:13px;margin-bottom:11px;">
        <div style="font-size:.63rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--navy);margin-bottom:9px;display:flex;align-items:center;gap:5px;">
          <i class="fas fa-dollar-sign" style="color:#059669"></i> Tarifa Plena Venta <span style="color:var(--red)">*</span>
        </div>
        <div style="position:relative;">
          <span style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:.7rem;color:var(--muted);font-weight:700;">$</span>
          <input type="number" id="m-plena" class="form-control" min="0" step="1000" placeholder="0" style="padding-left:22px;font-family:'DM Mono',monospace;font-size:.88rem;height:36px;">
        </div>
      </div>

      <!-- Multi Recogida + Entrega -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:11px;">
        <div style="background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:11px;">
          <div style="font-size:.6rem;font-weight:700;text-transform:uppercase;color:var(--muted);margin-bottom:7px;">
            <i class="fas fa-map-marker-alt" style="color:var(--navy2)"></i> Multi Recogida
          </div>
          <div style="position:relative;">
            <span style="position:absolute;left:8px;top:50%;transform:translateY(-50%);font-size:.68rem;color:var(--muted);font-weight:700;">$</span>
            <input type="number" id="m-multi-recogida" class="form-control" min="0" step="1000" value="0" style="padding-left:19px;font-family:'DM Mono',monospace;font-size:.8rem;" placeholder="0">
          </div>
        </div>
        <div style="background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:11px;">
          <div style="font-size:.6rem;font-weight:700;text-transform:uppercase;color:var(--muted);margin-bottom:7px;">
            <i class="fas fa-map-pin" style="color:var(--navy2)"></i> Multi Entrega
          </div>
          <div style="position:relative;">
            <span style="position:absolute;left:8px;top:50%;transform:translateY(-50%);font-size:.68rem;color:var(--muted);font-weight:700;">$</span>
            <input type="number" id="m-multi-entrega" class="form-control" min="0" step="1000" value="0" style="padding-left:19px;font-family:'DM Mono',monospace;font-size:.8rem;" placeholder="0">
          </div>
        </div>
      </div>

      <!-- Multi Origen — SOLO LECTURA de municipio, editable rate_1/rate_2 -->
      <div id="section-multi-origen" style="display:none;background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:13px;margin-bottom:11px;">
        <div style="font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--navy);margin-bottom:3px;display:flex;align-items:center;gap:5px;">
          <i class="fas fa-location-arrow" style="color:#0ea5e9"></i> Multi Origen — por Municipio
        </div>
        <div style="font-size:.62rem;color:var(--muted);margin-bottom:8px">Rate 1 = tarifa base · Rate 2 = recargo adicional</div>
        <!-- Cabecera columnas -->
        <div style="display:grid;grid-template-columns:1fr 90px 90px;gap:6px;margin-bottom:4px;padding:0 4px;">
          <div style="font-size:.58rem;font-weight:700;color:var(--muted);text-transform:uppercase">Municipio</div>
          <div style="font-size:.58rem;font-weight:700;color:var(--muted);text-transform:uppercase;text-align:center">Rate 1</div>
          <div style="font-size:.58rem;font-weight:700;color:var(--muted);text-transform:uppercase;text-align:center">Rate 2</div>
        </div>
        <div id="multi-origen-rows"></div>
      </div>

      <!-- Multi Destino — SOLO LECTURA de municipio, editable rate_1/rate_2 -->
      <div id="section-multi-destino" style="display:none;background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:13px;margin-bottom:11px;">
        <div style="font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--navy);margin-bottom:3px;display:flex;align-items:center;gap:5px;">
          <i class="fas fa-map-marked-alt" style="color:#7c3aed"></i> Multi Destino — por Municipio
        </div>
        <div style="font-size:.62rem;color:var(--muted);margin-bottom:8px">Rate 1 = tarifa base · Rate 2 = recargo adicional</div>
        <div style="display:grid;grid-template-columns:1fr 90px 90px;gap:6px;margin-bottom:4px;padding:0 4px;">
          <div style="font-size:.58rem;font-weight:700;color:var(--muted);text-transform:uppercase">Municipio</div>
          <div style="font-size:.58rem;font-weight:700;color:var(--muted);text-transform:uppercase;text-align:center">Rate 1</div>
          <div style="font-size:.58rem;font-weight:700;color:var(--muted);text-transform:uppercase;text-align:center">Rate 2</div>
        </div>
        <div id="multi-destino-rows"></div>
      </div>

      <!-- Vigencia -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:9px;">
        <div>
          <label class="form-label">Fecha Inicio Vigencia</label>
          <input type="date" id="m-fecha-inicio" class="form-control">
        </div>
        <div>
          <label class="form-label">Fecha Fin Vigencia</label>
          <input type="date" id="m-fecha-fin" class="form-control">
        </div>
      </div>

    </div>

    <!-- Footer modal -->
    <div style="padding:12px 18px;border-top:1px solid var(--border);display:flex;gap:7px;justify-content:flex-end;background:#f0fdf4;flex-shrink:0;">
      <button class="btn btn-outline" onclick="ventasRP.cerrarModal()">Cancelar</button>
      <button class="btn btn-primary" onclick="ventasRP.guardarEdicion()">
        <i class="fas fa-save"></i> Guardar Tarifa de Venta
      </button>
    </div>

  </div>
</div>