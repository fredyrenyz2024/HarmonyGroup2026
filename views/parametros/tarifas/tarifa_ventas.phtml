<div class="container-fluid py-3">
    <style>
        /* ============================================================
           VARIABLES DE DISEÑO
           Paleta: Azul marino industrial + ámbar de acento
        ============================================================ */
        :root {
            --navy: #0f1f3d;
            --navy-mid: #1a3260;
            --blue: #1a5ce5;
            --blue-soft: #dbeafe;
            --amber: #f59e0b;
            --amber-soft: #fef3c7;
            --green: #10b981;
            --green-soft: #d1fae5;
            --red: #ef4444;
            --red-soft: #fee2e2;
            --orange: #f97316;
            --orange-soft: #ffedd5;
            --slate-50: #f8fafc;
            --slate-100: #f1f5f9;
            --slate-200: #e2e8f0;
            --slate-400: #94a3b8;
            --slate-600: #475569;
            --slate-800: #1e293b;
            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 16px;
            --shadow-sm: 0 1px 3px rgba(0, 0, 0, .08), 0 1px 2px rgba(0, 0, 0, .06);
            --shadow-md: 0 4px 12px rgba(0, 0, 0, .10), 0 2px 4px rgba(0, 0, 0, .06);
            --shadow-lg: 0 10px 25px rgba(0, 0, 0, .12), 0 4px 8px rgba(0, 0, 0, .06);
        }

        /* * {
            box-sizing: border-box;
        }

        body {
            font-family: 'IBM Plex Sans', sans-serif;
            background: var(--slate-100);
            padding: 24px;
            color: var(--slate-800);
        } */

        /* ── PAGE HEADER ────────────────────────────── */
        .page-header {
            background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 100%);
            border-radius: var(--radius-lg);
            padding: 20px 28px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: var(--shadow-md);
            position: relative;
            overflow: hidden;
        }

        .page-header::before {
            content: '';
            position: absolute;
            top: -40px;
            right: -40px;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .04);
        }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -30px;
            right: 120px;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: rgba(26, 92, 229, .15);
        }

        .ph-icon {
            width: 52px;
            height: 52px;
            background: rgba(245, 158, 11, .15);
            border: 2px solid rgba(245, 158, 11, .35);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: var(--amber);
            flex-shrink: 0;
        }

        .ph-title {
            color: #fff;
            font-size: 1.2rem;
            font-weight: 700;
            letter-spacing: -.3px;
            margin: 0;
        }

        .ph-sub {
            color: rgba(255, 255, 255, .55);
            font-size: .78rem;
            margin-top: 2px;
        }

        .ph-badge {
            background: var(--amber);
            color: var(--navy);
            font-weight: 700;
            font-size: .78rem;
            padding: 6px 14px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
            z-index: 1;
        }

        /* ── KPI CARDS ──────────────────────────────── */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        @media (max-width: 768px) {
            .kpi-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .kpi-card {
            background: #fff;
            border-radius: var(--radius-md);
            padding: 16px 18px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--slate-200);
            display: flex;
            align-items: center;
            gap: 14px;
            cursor: pointer;
            transition: box-shadow .2s, transform .2s, border-color .2s;
            position: relative;
            overflow: hidden;
        }

        .kpi-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            border-radius: var(--radius-sm) 0 0 var(--radius-sm);
        }

        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .kpi-card.active {
            border-color: currentColor;
            box-shadow: var(--shadow-md);
        }

        .kpi-card.c-green::before {
            background: var(--green);
        }

        .kpi-card.c-amber::before {
            background: var(--amber);
        }

        .kpi-card.c-red::before {
            background: var(--red);
        }

        .kpi-card.c-slate::before {
            background: var(--slate-400);
        }

        .kpi-icon {
            width: 40px;
            height: 40px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .kpi-card.c-green .kpi-icon {
            background: var(--green-soft);
            color: var(--green);
        }

        .kpi-card.c-amber .kpi-icon {
            background: var(--amber-soft);
            color: #d97706;
        }

        .kpi-card.c-red .kpi-icon {
            background: var(--red-soft);
            color: var(--red);
        }

        .kpi-card.c-slate .kpi-icon {
            background: var(--slate-100);
            color: var(--slate-600);
        }

        .kpi-num {
            font-size: 1.7rem;
            font-weight: 700;
            line-height: 1;
            font-family: 'IBM Plex Mono', monospace;
        }

        .kpi-card.c-green .kpi-num {
            color: var(--green);
        }

        .kpi-card.c-amber .kpi-num {
            color: #d97706;
        }

        .kpi-card.c-red .kpi-num {
            color: var(--red);
        }

        .kpi-card.c-slate .kpi-num {
            color: var(--slate-600);
        }

        .kpi-label {
            font-size: .72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: var(--slate-400);
            margin-top: 3px;
        }

        /* ── FILTER CARD ────────────────────────────── */
        .filter-card {
            background: #fff;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--slate-200);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .filter-card-header {
            background: var(--slate-50);
            border-bottom: 1px solid var(--slate-200);
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .filter-card-header .fc-title {
            font-size: .78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--slate-600);
        }

        .filter-card-header i {
            color: var(--blue);
            font-size: .9rem;
        }

        .filter-card-body {
            padding: 18px 20px;
        }

        /* Labels y controles */
        .f-label {
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: var(--slate-600);
            margin-bottom: 5px;
            display: block;
        }

        .f-control {
            width: 100%;
            height: 34px;
            padding: 0 10px;
            border: 1.5px solid var(--slate-200);
            border-radius: var(--radius-sm);
            font-size: .82rem;
            font-family: 'IBM Plex Sans', sans-serif;
            color: var(--slate-800);
            background: #fff;
            transition: border-color .15s, box-shadow .15s;
            outline: none;
        }

        .f-control:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px rgba(26, 92, 229, .12);
        }

        .f-control::placeholder {
            color: var(--slate-400);
        }

        select.f-control {
            cursor: pointer;
        }

        /* Separador de sección dentro de filtros */
        .filter-divider {
            height: 1px;
            background: var(--slate-200);
            margin: 14px 0;
            position: relative;
        }

        .filter-divider span {
            position: absolute;
            top: -9px;
            left: 10px;
            background: #fff;
            padding: 0 8px;
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--slate-400);
        }

        /* Botones de acción */
        .btn-search {
            height: 34px;
            padding: 0 20px;
            background: var(--blue);
            color: #fff;
            border: none;
            border-radius: var(--radius-sm);
            font-size: .82rem;
            font-weight: 600;
            font-family: 'IBM Plex Sans', sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 7px;
            transition: background .15s, box-shadow .15s;
            white-space: nowrap;
        }

        .btn-search:hover {
            background: #1449c4;
            box-shadow: 0 2px 8px rgba(26, 92, 229, .3);
        }

        .btn-clear {
            height: 34px;
            padding: 0 16px;
            background: #fff;
            color: var(--slate-600);
            border: 1.5px solid var(--slate-200);
            border-radius: var(--radius-sm);
            font-size: .82rem;
            font-weight: 600;
            font-family: 'IBM Plex Sans', sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 7px;
            transition: all .15s;
            white-space: nowrap;
        }

        .btn-clear:hover {
            border-color: var(--slate-400);
            color: var(--slate-800);
        }

        .btn-add {
            height: 34px;
            padding: 0 16px;
            background: var(--navy);
            color: #fff;
            border: none;
            border-radius: var(--radius-sm);
            font-size: .82rem;
            font-weight: 600;
            font-family: 'IBM Plex Sans', sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 7px;
            transition: background .15s;
            white-space: nowrap;
        }

        .btn-add:hover {
            background: var(--navy-mid);
        }

        .btn-import {
            height: 34px;
            padding: 0 16px;
            background: #fff;
            color: var(--green);
            border: 1.5px solid var(--green);
            border-radius: var(--radius-sm);
            font-size: .82rem;
            font-weight: 600;
            font-family: 'IBM Plex Sans', sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 7px;
            transition: all .15s;
            white-space: nowrap;
        }

        .btn-import:hover {
            background: var(--green-soft);
        }

        /* Toggle de filtros avanzados */
        .toggle-advanced {
            font-size: .76rem;
            font-weight: 600;
            color: var(--blue);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 5px;
            border: none;
            background: none;
            padding: 0;
            font-family: 'IBM Plex Sans', sans-serif;
            transition: color .15s;
        }

        .toggle-advanced:hover {
            color: #1449c4;
        }

        .toggle-advanced .ti-icon {
            transition: transform .2s;
        }

        .toggle-advanced.open .ti-icon {
            transform: rotate(180deg);
        }

        .advanced-filters {
            display: none;
            animation: fadeIn .2s ease;
        }

        .advanced-filters.show {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Chip de filtro activo */
        .active-filters {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 12px;
        }

        .filter-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: var(--blue-soft);
            color: var(--navy-mid);
            font-size: .72rem;
            font-weight: 600;
            padding: 3px 10px 3px 8px;
            border-radius: 20px;
        }

        .filter-chip button {
            background: none;
            border: none;
            padding: 0;
            color: var(--navy-mid);
            cursor: pointer;
            line-height: 1;
            font-size: .8rem;
            display: flex;
            align-items: center;
        }

        /* ── TABLE CARD ─────────────────────────────── */
        .table-card {
            background: #fff;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--slate-200);
            overflow: hidden;
        }

        .table-card-header {
            padding: 14px 20px;
            border-bottom: 1px solid var(--slate-200);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .tc-title {
            font-size: .8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--slate-600);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .tc-title i {
            color: var(--blue);
        }

        .tc-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .search-inline {
            height: 32px;
            padding: 0 10px 0 32px;
            border: 1.5px solid var(--slate-200);
            border-radius: var(--radius-sm);
            font-size: .8rem;
            font-family: 'IBM Plex Sans', sans-serif;
            outline: none;
            position: relative;
            transition: border-color .15s;
            width: 200px;
        }

        .search-inline:focus {
            border-color: var(--blue);
        }

        .search-wrap {
            position: relative;
        }

        .search-wrap i {
            position: absolute;
            left: 9px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--slate-400);
            font-size: .8rem;
            pointer-events: none;
        }

        .btn-refresh {
            width: 32px;
            height: 32px;
            border: 1.5px solid var(--slate-200);
            border-radius: var(--radius-sm);
            background: #fff;
            color: var(--slate-600);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .15s;
        }

        .btn-refresh:hover {
            border-color: var(--blue);
            color: var(--blue);
        }

        .table-wrap {
            overflow-x: auto;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: .8rem;
        }

        .data-table thead th {
            background: var(--navy);
            color: rgba(255, 255, 255, .85);
            font-weight: 600;
            font-size: .7rem;
            text-transform: uppercase;
            letter-spacing: .05em;
            padding: 10px 14px;
            white-space: nowrap;
            border: none;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        .data-table thead th:first-child {
            border-radius: 0;
        }

        .data-table tbody tr {
            border-bottom: 1px solid var(--slate-100);
            transition: background .1s;
        }

        .data-table tbody tr:hover {
            background: var(--slate-50);
        }

        .data-table tbody td {
            padding: 10px 14px;
            color: var(--slate-800);
            white-space: nowrap;
            vertical-align: middle;
        }

        /* Empty state */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }

        .empty-state .es-icon {
            font-size: 2.8rem;
            color: var(--slate-200);
            margin-bottom: 16px;
        }

        .empty-state .es-title {
            font-weight: 700;
            color: var(--slate-600);
            font-size: .95rem;
            margin-bottom: 6px;
        }

        .empty-state .es-sub {
            font-size: .8rem;
            color: var(--slate-400);
        }

        /* Badges de estado */
        .badge-status {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 20px;
            font-size: .68rem;
            font-weight: 700;
            letter-spacing: .02em;
        }

        .bs-active {
            background: var(--green-soft);
            color: #065f46;
        }

        .bs-inactive {
            background: var(--slate-100);
            color: var(--slate-600);
        }

        .bs-pending {
            background: var(--amber-soft);
            color: #92400e;
        }

        .bs-expired {
            background: var(--red-soft);
            color: #991b1b;
        }

        /* Acciones de tabla */
        .action-btn {
            width: 28px;
            height: 28px;
            border-radius: var(--radius-sm);
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: .8rem;
            transition: all .15s;
        }

        .ab-view {
            background: var(--blue-soft);
            color: var(--blue);
        }

        .ab-edit {
            background: var(--amber-soft);
            color: #d97706;
        }

        .ab-del {
            background: var(--red-soft);
            color: var(--red);
        }

        .action-btn:hover {
            filter: brightness(.9);
            transform: scale(1.08);
        }

        /* Pagination */
        .pagination-bar {
            padding: 12px 20px;
            border-top: 1px solid var(--slate-200);
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: .78rem;
            color: var(--slate-400);
        }

        .pag-info strong {
            color: var(--slate-800);
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .kpi-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        /* --- ESTILOS DEL OFFCANVAS --- */
        .offcanvas-center {
            /* Centrado y flotante */
            bottom: auto !important;
            top: 50% !important;
            left: 50% !important;
            transform: translate(-50%, -50%) !important;

            width: 90% !important;
            /* Ajuste responsive */
            max-width: 1000px;
            height: 800px !important;
            max-height: 95vh;
            border-radius: 12px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
            border: none;
            overflow: hidden;
            /* Para el border-radius */
        }

        .offcanvas-header-custom {
            background-color: #f8fbff;
            border-bottom: 1px solid #e3e8ef;
            height: 70px;
            /* Altura fija para el listón */
            padding: 0;
            /* Padding manejado internamente */
            position: relative;
        }

        /* --- EL LISTÓN (RIBBON) --- */
        .ribbon-box {
            position: relative;
            background-color: #1a73e8;
            /* Azul Corporativo */
            color: white;
            width: 50px;
            height: 70px;
            /* Mismo alto que el header */
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin-left: 20px;
            box-shadow: 0 4px 6px rgba(26, 115, 232, 0.2);
        }

        /* El recorte triangular inferior del listón */
        .ribbon-box::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            border-left: 25px solid transparent;
            /* Mitad del ancho */
            border-right: 25px solid transparent;
            border-bottom: 15px solid #f8fbff;
            /* Color de fondo del header */
        }

        /* --- TEXTOS Y BADGES --- */
        .text-primary-custom {
            color: #1a73e8;
            font-size: 1.1rem;
            letter-spacing: -0.5px;
        }

        .badge-custom-light {
            background-color: #e8f0fe;
            color: #1a73e8;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 600;
            border: 1px solid rgba(26, 115, 232, 0.1);
        }

        .badge-custom-dark {
            background-color: #5f6368;
            color: white;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* --- PRO TABS (TU SELECCIÓN CSS MEJORADA) --- */
        .custom-tabs-container-venta {
            margin-top: 1.5rem;
        }

        .nav-tabs-custom {
            border-bottom: 2px solid #e9ecef;
            display: flex;
            gap: 15px;
            /* Más espacio entre tabs */
            padding-left: 10px;
        }

        .nav-tabs-custom .nav-link {
            border: none;
            background: transparent;
            color: #6c757d;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 12px 10px;
            position: relative;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-tabs-custom .nav-link:hover {
            color: #1a73e8;
        }

        .nav-tabs-custom .nav-link.active {
            color: #1a73e8 !important;
            background: transparent;
        }

        /* Indicador de pestaña activa (Línea inferior) */
        .nav-tabs-custom .nav-link.active::after {
            content: "";
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 3px;
            background-color: #1a73e8;
            border-radius: 3px 3px 0 0;
            box-shadow: 0 -2px 5px rgba(26, 115, 232, 0.1);
        }

        .custom-tab-content {
            background-color: #ffffff;
            /* Eliminamos bordes para un look más limpio */
            padding-top: 20px;
            min-height: 150px;
        }

        .chart-container {
            position: relative;
            height: 200px;
            width: 100%;
        }

        /* --- FORMULARIOS --- */
        .form-label-sm {
            font-size: 0.75rem;
            font-weight: 600;
            color: #495057;
            margin-bottom: 0.25rem;
        }

        .req {
            color: #dc3545;
        }

        .btn-save {
            background-color: #1a73e8;
            border-color: #1a73e8;
            font-weight: 500;
            padding: 8px 24px;
        }

        .btn-save:hover {
            background-color: #1557b0;
        }

        /* Asegura que el contenedor de TomSelect use todo el espacio disponible */
        .ts-wrapper {
            width: 100% !important;
        }

        /* Ajusta la altura para que coincida con los inputs de Bootstrap */
        .ts-control {
            min-height: 31px !important;
            /* Altura para form-control-sm */
            padding: 0.25rem 0.5rem !important;
            display: flex;
            align-items: center;
        }

