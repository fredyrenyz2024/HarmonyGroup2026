                <div class="im-v-dropzone-title">Arrastra tu archivo aquí o haz clic para seleccionar</div>
                <div class="im-v-dropzone-sub" style="margin-top:8px;">
                    <span class="im-v-dropzone-badge">.xlsx</span>
                    <span class="im-v-dropzone-badge">.xls</span>
                </div>
            </div>
            <input type="file" id="archivo_excel_ventas" accept=".xlsx,.xls"
                onchange="imvOnFileSelected(this)">

            <!-- Archivo seleccionado -->
            <div class="im-v-file-selected" id="imv-file-preview">
                <div class="im-v-file-icon"><i class="fas fa-file-excel"></i></div>
                <div>
                    <div class="im-v-file-name" id="imv-file-name">—</div>
                    <div class="im-v-file-size" id="imv-file-size">—</div>
                </div>
                <button class="im-v-file-clear" onclick="imvLimpiarArchivo()" title="Quitar archivo">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Estructura esperada del Excel -->
            <div class="im-v-sheets-info">
                <div class="im-v-sheets-info-header">
                    <i class="fas fa-table"></i> Estructura del archivo Excel
                </div>
                <div class="im-v-sheet-row">
                    <span class="im-v-sheet-tab green">archivo</span>
                    <div>
                        <div class="im-v-sheet-desc">Tarifa principal por cliente, ruta y vehículo</div>
                        <div class="im-v-sheet-cols">Columnas: Cliente · Origen · Destino · Tipo vehículo · Tarifa · Fecha Inicio · Fecha Fin · Config. Extra · Multi-Recogida · Multi-Entrega · Codigo</div>
                    </div>
                </div>
                <div class="im-v-sheet-row">
                    <span class="im-v-sheet-tab amber">multiorigen</span>
                    <div>
                        <div class="im-v-sheet-desc">Detalles de Multi-Origen por municipio</div>
                        <div class="im-v-sheet-cols">Columnas: Codigo (ref.) · Municipio · TarifaAdicional 1 · TarifaAdicional 2</div>
                    </div>
                </div>
                <div class="im-v-sheet-row">
                    <span class="im-v-sheet-tab purple">multidestino</span>
                    <div>
                        <div class="im-v-sheet-desc">Detalles de Multi-Destino por municipio</div>
                        <div class="im-v-sheet-cols">Columnas: Codigo (ref.) · Municipio · TarifaAdicional 1 · TarifaAdicional 2</div>
                    </div>
                </div>
            </div>

            <!-- Advertencia -->
            <div class="im-v-warn">
                <i class="fas fa-exclamation-triangle" style="flex-shrink:0; margin-top:1px;"></i>
                <span>Las tarifas que superen el umbral de variación permitido quedarán <strong>INACTIVAS</strong> y entrarán a la bandeja de aprobación. Las demás se activarán automáticamente.</span>
            </div>

            <!-- Botón iniciar -->
            <button class="im-v-btn-import" id="imv-btn-start"
                onclick="importarTarifasVentasMasivo()" disabled>
                <i class="fas fa-cloud-upload-alt"></i>
                Iniciar Importación
            </button>

        </div>

        <!-- ======================================================
             SECCIÓN 2: PROGRESO
             ====================================================== -->
        <div id="imv-progress-section" style="display:none;">

            <div class="im-v-prog-header">
                <div class="im-v-spinner-wrap">
                    <div class="im-v-spinner-ring"></div>
                    <div class="im-v-spinner-pct" id="imv-pct-label">0%</div>
                </div>
                <div class="im-v-prog-title" id="imv-prog-title">Procesando archivo...</div>
                <div class="im-v-prog-sub" id="imv-prog-sub">Por favor espera, esto puede tomar unos minutos</div>
            </div>

            <div class="im-v-progress-track">
                <div class="im-v-progress-fill" id="imv-progress-fill"></div>
            </div>
            <div style="display:flex; justify-content:space-between; font-size:.72rem; color:var(--im-gray); margin-bottom:14px;">
                <span>0%</span><span id="imv-pct-right">0%</span>
            </div>

            <!-- Pasos del proceso -->
            <div class="im-v-steps" id="imv-steps-list">
                <div class="im-v-step" id="imv-step-archivo">
                    <div class="im-v-step-dot">1</div>
                    <span>Procesando hoja <strong>archivo</strong> — clientes, rutas y tarifas base</span>
                </div>
                <div class="im-v-step" id="imv-step-multiorigen">
                    <div class="im-v-step-dot">2</div>
                    <span>Procesando hoja <strong>multiorigen</strong></span>
                </div>
                <div class="im-v-step" id="imv-step-multidestino">
                    <div class="im-v-step-dot">3</div>
                    <span>Procesando hoja <strong>multidestino</strong></span>
                </div>
                <div class="im-v-step" id="imv-step-variaciones">
                    <div class="im-v-step-dot"><i class="fas fa-chart-line"></i></div>
                    <span>Evaluando variaciones y reglas de aprobación</span>
                </div>
                <div class="im-v-step" id="imv-step-finalizando">
                    <div class="im-v-step-dot"><i class="fas fa-check"></i></div>
                    <span>Finalizando y actualizando lista de tarifas</span>
                </div>
            </div>

            <div class="im-v-warn" style="margin-top:16px;">
                <i class="fas fa-lock" style="flex-shrink:0; margin-top:1px;"></i>
                <span>No cierres esta ventana hasta que el proceso finalice.</span>
            </div>

        </div>

        <!-- ======================================================
             SECCIÓN 3: RESULTADO
             ====================================================== -->
        <div id="imv-result-section" style="display:none;">

            <!-- Hero resultado -->
            <div class="im-v-result-hero">
                <div class="im-v-result-icon" id="imv-result-icon">✅</div>
                <div class="im-v-result-title" id="imv-result-title">¡Importación completada!</div>
                <div class="im-v-result-sub" id="imv-result-sub">Todas las filas fueron procesadas</div>
            </div>

            <!-- Resumen en cards -->
            <div class="im-v-summary-grid" id="imv-summary-grid">
                <div class="im-v-summary-card">
                    <div class="im-v-summary-card-icon iv-ic-activas"><i class="fas fa-check-circle"></i></div>
                    <div>
                        <div class="im-v-summary-num" id="imv-sum-activas">0</div>
                        <div class="im-v-summary-label">Activadas</div>
                    </div>
                </div>
                <div class="im-v-summary-card">
                    <div class="im-v-summary-card-icon iv-ic-pendientes"><i class="fas fa-hourglass-half"></i></div>
                    <div>
                        <div class="im-v-summary-num" id="imv-sum-pendientes">0</div>
                        <div class="im-v-summary-label">A bandeja aprobación</div>
                    </div>
                </div>
                <div class="im-v-summary-card">
                    <div class="im-v-summary-card-icon iv-ic-saltadas"><i class="fas fa-forward"></i></div>
                    <div>
                        <div class="im-v-summary-num" id="imv-sum-saltadas">0</div>
                        <div class="im-v-summary-label">Saltadas (pend. previa)</div>
                    </div>
                </div>
                <div class="im-v-summary-card">
                    <div class="im-v-summary-card-icon iv-ic-errores"><i class="fas fa-times-circle"></i></div>
                    <div>
                        <div class="im-v-summary-num" id="imv-sum-errores">0</div>
                        <div class="im-v-summary-label">Con error</div>
                    </div>
                </div>
            </div>

            <!-- Detalle pendientes de aprobación -->
            <div class="im-v-detail-section" id="imv-block-pendientes" style="display:none;">
                <button class="im-v-detail-toggle" onclick="imvToggleDetalle('pendientes')">
                    <span>
                        <i class="fas fa-hourglass-half me-2" style="color:#d97706;"></i>
                        Tarifas enviadas a bandeja de aprobación
                    </span>
                    <span class="badge-count" id="imv-badge-pendientes"
                        style="background:#fef3c7; color:#854d0e;">0</span>
                </button>
                <div class="im-v-detail-body" id="imv-detail-pendientes"></div>
            </div>

            <!-- Detalle errores -->
            <div class="im-v-detail-section" id="imv-block-errores" style="display:none;">
                <button class="im-v-detail-toggle" onclick="imvToggleDetalle('errores')">
                    <span>
                        <i class="fas fa-exclamation-circle me-2" style="color:#dc2626;"></i>
                        Filas con error
                    </span>
                    <span class="badge-count" id="imv-badge-errores"
                        style="background:#fee2e2; color:#991b1b;">0</span>
                </button>
                <div class="im-v-detail-body" id="imv-detail-errores"></div>
            </div>

            <!-- Botones -->
            <div class="im-v-result-footer">
                <button class="im-v-btn-finalizar" onclick="imvCerrar()">
                    <i class="fas fa-check"></i> Finalizar y ver tarifas
                </button>
                <button class="im-v-btn-otro" onclick="imvReset()">
                    <i class="fas fa-redo"></i> Importar otro archivo
                </button>
            </div>

        </div>
    </div>
    <!-- /im-v-body -->
</div>
<!-- /offcanvas importacion masiva ventas -->



