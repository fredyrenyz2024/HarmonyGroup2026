    <style>
        /* ── Variables ─────────────────────────────────────── */
        :root {
            --tc-navy: #0f1f3d;
            --tc-navy-mid: #1a3260;
            --tc-blue: #1a5ce5;
            --tc-blue-soft: #dbeafe;
            --tc-amber: #f59e0b;
            --tc-amber-soft: #fef3c7;
            --tc-green: #10b981;
            --tc-green-soft: #d1fae5;
            --tc-red: #ef4444;
            --tc-red-soft: #fee2e2;
            --tc-slate-50: #f8fafc;
            --tc-slate-100: #f1f5f9;
            --tc-slate-200: #e2e8f0;
            --tc-slate-400: #94a3b8;
            --tc-slate-600: #475569;
            --tc-slate-800: #1e293b;
            --tc-radius-sm: 6px;
            --tc-radius-md: 10px;
            --tc-radius-lg: 16px;
            --tc-shadow-sm: 0 1px 3px rgba(0, 0, 0, .08), 0 1px 2px rgba(0, 0, 0, .06);
            --tc-shadow-md: 0 4px 12px rgba(0, 0, 0, .10), 0 2px 4px rgba(0, 0, 0, .06);
        }

        /* ── Page Header ──────────────────────────────────── */
        .tc-page-header {
            background: linear-gradient(135deg, var(--tc-navy) 0%, var(--tc-navy-mid) 100%);
            border-radius: var(--tc-radius-lg);
            padding: 20px 28px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: var(--tc-shadow-md);
            position: relative;
            overflow: hidden;
        }

        .tc-page-header::before {
            content: '';
            position: absolute;
            top: -40px;
            right: -40px;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .04);
        }

        .tc-page-header::after {
            content: '';
            position: absolute;
            bottom: -30px;
            right: 120px;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: rgba(26, 92, 229, .15);
        }

        .tc-ph-icon {
            width: 52px;
            height: 52px;
            background: rgba(16, 185, 129, .15);
            border: 2px solid rgba(16, 185, 129, .35);
            border-radius: var(--tc-radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: #34d399;
            flex-shrink: 0;
        }

        .tc-ph-title {
            color: #fff;
            font-size: 1.2rem;
            font-weight: 700;
            letter-spacing: -.3px;
            margin: 0;
        }

        .tc-ph-sub {
            color: rgba(255, 255, 255, .55);
            font-size: .78rem;
            margin-top: 2px;
        }

        /* ── KPI Grid ─────────────────────────────────────── */
        .tc-kpi-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        @media (max-width: 1024px) {
            .tc-kpi-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 640px) {
            .tc-kpi-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .tc-kpi-card {
            background: #fff;
            border-radius: var(--tc-radius-md);
            padding: 14px 16px;
            box-shadow: var(--tc-shadow-sm);
            border: 1px solid var(--tc-slate-200);
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            transition: box-shadow .2s, transform .2s, border-color .2s;
            position: relative;
            overflow: hidden;
        }

        .tc-kpi-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            border-radius: var(--tc-radius-sm) 0 0 var(--tc-radius-sm);
        }

        .tc-kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--tc-shadow-md);
        }

        .tc-kpi-card.active {
            box-shadow: var(--tc-shadow-md);
        }

        .tc-kpi-card.c-green::before {
            background: var(--tc-green);
        }

        .tc-kpi-card.c-amber::before {
            background: var(--tc-amber);
        }

        .tc-kpi-card.c-red::before {
            background: var(--tc-red);
        }

        .tc-kpi-card.c-blue::before {
            background: var(--tc-blue);
        }

        .tc-kpi-card.c-slate::before {
            background: var(--tc-slate-400);
        }

        .tc-kpi-icon {
            width: 38px;
            height: 38px;
            border-radius: var(--tc-radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .tc-kpi-card.c-green .tc-kpi-icon {
            background: var(--tc-green-soft);
            color: var(--tc-green);
        }

        .tc-kpi-card.c-amber .tc-kpi-icon {
            background: var(--tc-amber-soft);
            color: #d97706;
        }

        .tc-kpi-card.c-red .tc-kpi-icon {
            background: var(--tc-red-soft);
            color: var(--tc-red);
        }

        .tc-kpi-card.c-blue .tc-kpi-icon {
            background: var(--tc-blue-soft);
            color: var(--tc-blue);
        }

        .tc-kpi-card.c-slate .tc-kpi-icon {
            background: var(--tc-slate-100);
            color: var(--tc-slate-600);
        }

        .tc-kpi-num {
            font-size: 1.55rem;
            font-weight: 700;
            line-height: 1;
            font-variant-numeric: tabular-nums;
        }

        .tc-kpi-card.c-green .tc-kpi-num {
            color: var(--tc-green);
        }

        .tc-kpi-card.c-amber .tc-kpi-num {
            color: #d97706;
        }

        .tc-kpi-card.c-red .tc-kpi-num {
            color: var(--tc-red);
        }

        .tc-kpi-card.c-blue .tc-kpi-num {
            color: var(--tc-blue);
        }

        .tc-kpi-card.c-slate .tc-kpi-num {
            color: var(--tc-slate-600);
        }

        .tc-kpi-label {
            font-size: .68rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: var(--tc-slate-400);
            margin-top: 3px;
        }

        /* ── Filter Card ──────────────────────────────────── */
        .tc-filter-card {
            background: #fff;
            border-radius: var(--tc-radius-lg);
            box-shadow: var(--tc-shadow-sm);
            border: 1px solid var(--tc-slate-200);
            margin-bottom: 20px;
            overflow: hidden;
        }

