            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--tc-slate-600);
        }

        .tc-filter-body {
            padding: 18px 20px;
        }

        /* Labels y controles */
        .tc-f-label {
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: var(--tc-slate-600);
            margin-bottom: 5px;
            display: block;
        }

        .tc-f-control {
            width: 100%;
            height: 34px;
            padding: 0 10px;
            border: 1.5px solid var(--tc-slate-200);
            border-radius: var(--tc-radius-sm);
