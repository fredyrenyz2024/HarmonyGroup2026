            color: var(--tc-slate-800);
            background: #fff;
            transition: border-color .15s, box-shadow .15s;
            outline: none;
        }

        .tc-f-control:focus {
            border-color: var(--tc-blue);
            box-shadow: 0 0 0 3px rgba(26, 92, 229, .12);
        }

        .tc-f-control::placeholder {
            color: var(--tc-slate-400);
        }

        select.tc-f-control {
            cursor: pointer;
        }

        /* Separador de sección */
        .tc-divider {
            height: 1px;
            background: var(--tc-slate-200);
            margin: 14px 0;
            position: relative;
        }

        .tc-divider span {
            position: absolute;
            top: -9px;
            left: 10px;
            background: #fff;
            padding: 0 8px;
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--tc-slate-400);
        }

        /* Botones */
        .tc-btn-search {
            height: 34px;
            padding: 0 20px;
            background: var(--tc-blue);
