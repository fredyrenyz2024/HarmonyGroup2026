                <div class="card-body py-3">
                    <h6 class="fw-bold mb-2">
                        <i class="fas fa-terminal me-2 text-secondary"></i>
                        Registro de pasos
                    </h6>
                    <div id="im-progress-log"
                        style="font-size:0.82rem; max-height:200px; overflow-y:auto; font-family: monospace;">
                    </div>
                </div>
            </div>

            <div class="alert alert-warning mt-3 py-2">
                <i class="fas fa-exclamation-triangle me-2"></i>
                No cierres esta ventana hasta que finalice el proceso.
            </div>
        </div>

        <!-- ══════════════════════════════════════════════
             PASO 4 — Resultados
        ══════════════════════════════════════════════ -->
        <div id="im-step-result" style="display:none;">

            <!-- Ícono de estado -->
            <div class="text-center mb-4">
                <i id="im-result-icon"
                    class="fas fa-check-circle text-success"
                    style="font-size:4.5rem;"></i>
                <h5 id="im-result-title" class="mt-3 fw-bold">Importación completada</h5>
            </div>

            <!-- Tarjetas de resumen numérico -->
            <div class="row g-3 mb-4" id="im-result-cards">
                <div class="col-6">
                    <div class="card border-0 bg-primary bg-opacity-10 text-center py-3">
                        <div class="fs-3 fw-bold text-primary" id="im-res-total">0</div>
                        <div class="small text-muted">Filas procesadas</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 bg-success bg-opacity-10 text-center py-3">
                        <div class="fs-3 fw-bold text-success" id="im-res-activadas">0</div>
                        <div class="small text-muted">Tarifas activadas</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 bg-warning bg-opacity-10 text-center py-3">
                        <div class="fs-3 fw-bold text-warning" id="im-res-pendientes">0</div>
                        <div class="small text-muted">Enviadas a aprobación</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 bg-danger bg-opacity-10 text-center py-3">
                        <div class="fs-3 fw-bold text-danger" id="im-res-fallidas">0</div>
                        <div class="small text-muted">Con error</div>
                    </div>
                </div>
            </div>

            <!-- Mensaje contextual -->
            <div id="im-result-msg" class="alert mb-4 py-2"></div>

            <!-- Lista de errores (si los hay) -->
            <div id="im-result-errores-wrap" style="display:none;" class="mb-4">
                <div class="card border-danger">
                    <div class="card-header bg-danger bg-opacity-10 py-2">
                        <strong class="text-danger">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            Errores detectados
                        </strong>
                    </div>
                    <div class="card-body py-2 p-0">
                        <ul id="im-result-errores-list"
                            class="list-group list-group-flush mb-0"
                            style="max-height:180px;overflow-y:auto;font-size:0.82rem;">
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Aviso de aprobación pendiente -->
            <div id="im-result-aprob-aviso" class="alert alert-warning py-2 mb-4" style="display:none;">
                <i class="fas fa-hourglass-half me-2"></i>
                <strong>Algunas tarifas quedaron en espera de aprobación.</strong>
                Las tarifas anteriores permanecen activas hasta que sean aprobadas.
                Revísalas en el módulo de <strong>Aprobación de Tarifas</strong>.
            </div>

            <!-- Acciones finales -->
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary flex-grow-1"
                    onclick="im_resetear()">
                    <i class="fas fa-redo me-1"></i> Importar otro archivo
                </button>
                <button class="btn btn-primary flex-grow-1"
                    onclick="im_cerrar()">
                    <i class="fas fa-check me-1"></i> Finalizar
                </button>
            </div>
        </div>

    </div><!-- /.offcanvas-body -->
</div>
<!-- /.offcanvas -->


