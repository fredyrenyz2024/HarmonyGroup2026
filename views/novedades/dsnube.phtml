<button id="btn-restrasmite" class="btn btn-primary btn-sm">Transmitir Remesas</button>
<button id="btn-restrasmite-manifiesto" class="btn btn-primary btn-sm">Transmitir Manifiesto</button>
<br>
<br>
<br>
<div id="mensaje"></div>

<script>
    document.addEventListener('DOMContentLoaded', async e => {
        document.addEventListener('click', async e => {

            if (e.target.matches(`#btn-restrasmite`)) {
                try {
                    let formData = new FormData();
                    formData.append("Remesa", 'si');
                    formData.append("Manifiesto", 'no');

                    let response = await fetch($('#id_url_ajax').val() + 'integrar_oet/Conexion_Dsnube', {
                        method: "POST",
                        body: formData
                    });

                    let data = await response.json();
                    console.log("Respuesta:", data);

                    const mensajeDiv = document.getElementById('mensaje');

                    if (data.result === 'ok') {
                        mensajeDiv.innerHTML = `<div class="alert alert-success">${data.message}</div>`;
                    } else {
                        mensajeDiv.innerHTML = `<div class="alert alert-danger">${data.message}</div>`;
                    }

                    // Ocultar mensaje luego de 3 segundos
                    setTimeout(() => {
                        mensajeDiv.innerHTML = '';
                    }, 3000);

                } catch (error) {
                    console.error("Error al conectar con el backend:", error);
                    document.getElementById("mensaje").innerHTML = `<div class="alert alert-warning">⚠️ Error inesperado en la conexión.</div>`;

                    // Ocultar mensaje luego de 3 segundos
                    setTimeout(() => {
                        document.getElementById("mensaje").innerHTML = '';
                    }, 3000);
                }
            }

            if (e.target.matches(`#btn-restrasmite-manifiesto`)) {
                try {
                    let formData = new FormData();
                    formData.append("Manifiesto", 'si');
                    formData.append("Remesa", 'no');

                    let response = await fetch($('#id_url_ajax').val() + 'integrar_oet/Conexion_Dsnube', {
                        method: "POST",
                        body: formData
                    });

                    let data = await response.json();
                    console.log("Respuesta:", data);

                    const mensajeDiv = document.getElementById('mensaje');

                    if (data.result === 'ok') {
                        mensajeDiv.innerHTML = `<div class="alert alert-success">${data.message}</div>`;
                    } else {
                        mensajeDiv.innerHTML = `<div class="alert alert-danger">${data.message}</div>`;
                    }

                    // Ocultar mensaje luego de 3 segundos
                    setTimeout(() => {
                        mensajeDiv.innerHTML = '';
                    }, 3000);

                } catch (error) {
                    console.error("Error al conectar con el backend:", error);
                    document.getElementById("mensaje").innerHTML = `<div class="alert alert-warning">⚠️ Error inesperado en la conexión.</div>`;

                    // Ocultar mensaje luego de 3 segundos
                    setTimeout(() => {
                        document.getElementById("mensaje").innerHTML = '';
                    }, 3000);
                }
            }

        });
    });
</script>