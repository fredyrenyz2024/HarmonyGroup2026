        <div class="np-card-header">
          <i class="fas fa-table"></i> Vista previa del archivo
          <span class="ms-auto badge bg-primary" id="np-badge-filas">0 filas</span>
        </div>
        <div class="np-card-body p-0">
          <div class="np-preview-wrap">
            <table id="np_previewTable"></table>
          </div>
        </div>
      </div>

      <!-- Botones de acción -->
      <div class="d-flex gap-2 justify-content-end mb-3">
        <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"
          id="np-btn-cancelar">
          <i class="fas fa-times"></i> Cancelar
        </button>
        <button class="np-btn-import" id="np-btn-importar"
          style="width:auto; padding:9px 28px; margin:0;">
          <i class="fas fa-cloud-upload-alt"></i> Importar Pedidos
        </button>
      </div>
    </div><!-- /np-preview-section -->

    <!-- SECCIÓN 3: Progreso -->
    <div id="np-progress-section" style="display:none;">
      <div class="np-card">
        <div class="np-card-body">
          <div class="np-prog-header">
            <div class="np-spinner-wrap">
              <div class="np-spinner-ring"></div>
              <div class="np-spinner-pct" id="np-pct-label">0%</div>
            </div>
            <div class="np-prog-title">Procesando pedidos...</div>
            <div class="np-prog-sub">Por favor espera, no cierres esta ventana</div>
          </div>
          <div class="np-progress-track">
            <div class="np-progress-fill" id="np-progress-fill"></div>
          </div>
          <div class="d-flex justify-content-between" style="font-size:.72rem;color:var(--im-gray);">
            <span>0%</span><span id="np-pct-right">0%</span>
          </div>
        </div>
      </div>
    </div><!-- /np-progress-section -->

    <!-- SECCIÓN 4: Resultado -->
    <div id="np-result-section" style="display:none;">
      <div class="np-card">
        <div class="np-card-body">
          <div class="np-result-hero">
            <div class="np-result-icon" id="np-result-icon">✅</div>
            <div class="np-result-title" id="np-result-title">¡Importación completada!</div>
            <div class="np-result-sub" id="np-result-sub">Todas las filas fueron procesadas</div>
          </div>

          <div class="np-summary-grid">
            <div class="np-summary-card">
              <div class="np-summary-icon ic-ok"><i class="fas fa-check-circle"></i></div>
              <div>
                <div class="np-summary-num" id="np-sum-ok">0</div>
                <div class="np-summary-label">Pedidos insertados</div>
              </div>
            </div>
            <div class="np-summary-card">
              <div class="np-summary-icon ic-err"><i class="fas fa-times-circle"></i></div>
              <div>
                <div class="np-summary-num" id="np-sum-err">0</div>
                <div class="np-summary-label">Filas con error</div>
              </div>
            </div>
          </div>

          <!-- Detalle errores -->
          <div class="np-detail-section" id="np-block-errores" style="display:none;">
            <button class="np-detail-toggle" onclick="npToggleDetalle('errores')">
              <span><i class="fas fa-exclamation-circle me-2" style="color:#dc2626;"></i>Filas con error</span>
              <span class="badge-count" id="np-badge-errores"
                style="background:#fee2e2;color:#991b1b;">0</span>
            </button>
            <div class="np-detail-body" id="np-detail-errores"></div>
          </div>

          <div class="np-result-footer">
            <button class="np-btn-finalizar" onclick="npReset()">
              <i class="fas fa-redo"></i> Importar otro archivo
            </button>
            <button class="np-btn-otro" onclick="location.reload()">
              <i class="fas fa-check"></i> Finalizar
            </button>
          </div>
        </div>
      </div>
    </div><!-- /np-result-section -->

  </div><!-- /np-bloque-masivo -->


  <!-- ══ PASO 2-B: CREAR PEDIDO INDIVIDUAL ═════════════ -->
  <div id="crear_pedido" style="display:none;">
    <div class="np-card">
      <div class="np-card-header"><i class="fas fa-plus-circle"></i> Datos del pedido</div>
      <div class="np-card-body">
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <label class="np-label">Cliente <span class="req">*</span></label>
            <select class="np-control" name="clientes" id="slct_clientes_" style="height:auto;"></select>
          </div>
        </div>
        <hr class="my-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="np-label mb-0">Datos de la mercancía</span>
          <a href="#!" id="agregar_fila" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1">
            <i class="fas fa-plus"></i> Agregar
          </a>
        </div>
        <ul class="nav nav-underline fs-9 flex-nowrap p-1" id="bloque_header" role="tablist"
          style="overflow-x:auto;"></ul>
        <div class="tab-content mt-3" id="bloques_mercamcia"></div>
      </div>
    </div>

    <div class="d-flex gap-2 justify-content-end mb-3">
      <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"
        id="btn-cancelar-pedido">
        <i class="fas fa-times"></i> Cancelar
      </button>
      <button class="np-btn-import" id="btn_guardar_pedido"
        style="width:auto;padding:9px 28px;margin:0;">
        <i class="fas fa-save"></i> Guardar Pedido
      </button>
    </div>
  </div><!-- /crear_pedido -->

</div><!-- /container-fluid -->