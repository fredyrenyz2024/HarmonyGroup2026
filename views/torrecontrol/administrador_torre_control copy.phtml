      /* ══ SECONDARY PANEL ══ */
      .oc-sec-panel {
        background: #f8fafc;
        border: 1px solid var(--bc);
        border-top: 2px solid #0891b2;
        border-radius: 0 0 10px 10px;
        overflow: hidden;
        transition: max-height .4s cubic-bezier(.4, 0, .2, 1), opacity .3s;
        max-height: 0;
        opacity: 0;
        box-shadow: 0 4px 10px rgba(0, 0, 0, .05);
      }

      .oc-sec-panel.open {
        max-height: 2000px;
        opacity: 1;
      }

      .oc-sec-inner {
        padding: 1.25rem;
      }

      .oc-sec-title {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #0891b2;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .oc-sec-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--bc);
      }

      /* micro steps */
      .oc-micro {
        display: flex;
        border: 1px solid var(--bc);
        border-radius: 7px;
        overflow: hidden;
        margin-bottom: .9rem;
      }

      .oc-micro-step {
        flex: 1;
        padding: 5px 3px;
        text-align: center;
        font-size: 9px;
        font-weight: 600;
        border-right: 1px solid var(--bc);
        background: #f8fafc;
        color: #94a3b8;
      }

      .oc-micro-step:last-child {
        border-right: none;
      }

      .oc-ms-done {
        background: rgba(3, 105, 161, .07);
        color: #0369a1;
      }

      .oc-ms-active {
        background: rgba(234, 88, 12, .08);
        color: #ea580c;
      }

      .oc-ms-risk {
        background: rgba(220, 38, 38, .07);
        color: #dc2626;
      }

      /* sub-timeline */
      .oc-sub-tl {
        position: relative;
        padding-left: 24px;
      }

      .oc-sub-tl::before {
        content: '';
        position: absolute;
        left: 8px;
        top: 8px;
        bottom: 8px;
        width: 2px;
        background: linear-gradient(to bottom, #0891b2, #e2e8f0);
      }

      .oc-sub-item {
        position: relative;
        padding: 8px 0;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        border-bottom: 1px solid rgba(226, 232, 240, .6);
      }

      .oc-sub-item:last-child {
        border-bottom: none;
      }

      .oc-sub-node {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 2px solid var(--bc);
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 8px;
        flex-shrink: 0;
        position: absolute;
        left: -24px;
        top: 11px;
      }

      .oc-sub-node.done {
        border-color: #0369a1;
        color: #0369a1;
        background: rgba(3, 105, 161, .06);
      }

      .oc-sub-node.active {
        border-color: #ea580c;
        color: #ea580c;
        background: rgba(234, 88, 12, .06);
        animation: oc-glow-orange 2s infinite;
      }

      .oc-sub-node.pending {
        border-color: #cbd5e1;
        color: #94a3b8;
      }

      .oc-sub-node.risk {
        border-color: #dc2626;
        color: #dc2626;
        background: rgba(220, 38, 38, .06);
      }

      .oc-sub-label {
        font-size: 11px;
        font-weight: 600;
        color: #0f172a;
      }

      .oc-sub-meta {
        font-size: 10px;
        color: #475569;
        margin-top: 2px;
      }

      .oc-sub-time {
