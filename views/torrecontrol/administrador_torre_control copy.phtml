        border-radius: 9px;
        font-weight: 600;
      }

      .oc-sub-badge-done {
        background: rgba(3, 105, 161, .08);
        color: #0369a1;
      }

      .oc-sub-badge-active {
        background: rgba(234, 88, 12, .08);
        color: #ea580c;
      }

      .oc-sub-badge-pending {
        background: rgba(148, 163, 184, .12);
        color: #94a3b8;
      }

      /* table */
      .oc-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
      }

      .oc-table thead th {
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #94a3b8;
        border-bottom: 1px solid var(--bc);
        padding: 5px 10px;
        text-align: left;
        background: #f1f5f9;
      }

      .oc-table tbody tr {
        border-bottom: 1px solid var(--bc);
