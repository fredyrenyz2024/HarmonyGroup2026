<form id="form-nueva-plantilla" class="row g-3 mb-2">

  <!-- ── Fila superior: Proveedor / Modalidad / Nombre ──── -->
  <div class="col-12 col-sm-4">
    <label class="form-label fw-semibold mb-1">Proveedor <span class="req">*</span></label>
    <select class="form-select form-select-sm select2" id="slt_Proveedores" style="width:100%;"></select>
  </div>

  <div class="col-12 col-sm-4">
    <label class="form-label fw-semibold mb-1">Modalidad <span class="req">*</span></label>
    <select class="form-select form-select-sm select2" id="slt_Modalidad" style="width:100%;">
      <option value="" disabled selected>Seleccione</option>
      <option value="CARGA SECA">Carga Seca</option>
      <option value="CARGA LIQUIDA">Carga Líquida</option>
      <option value="IMPORTACION">Importación</option>
      <option value="EXPORTACION">Exportación</option>
      <option value="NACIONAL">Nacional</option>
    </select>
  </div>

  <div class="col-12 col-sm-4">
    <label class="form-label fw-semibold mb-1">Nombre Plantilla <span class="req">*</span></label>
    <input type="text" class="form-control form-control-sm" id="nombre_plantilla"
      placeholder="Ej: Plantilla Carga Seca Norte">
  </div>

  <!-- ── Cuerpo: Parámetros + Preview ─────────────────── -->
  <div class="col-12">
    <div class="row g-3">

      <!-- Izquierda: Acordeón de trazabilidad + Visualizadores -->
      <div class="col-12 col-lg-9">

        <!-- Parámetros de trazabilidad -->
        <div class="tc-card">
          <div class="tc-header">
            <i data-feather="sliders" style="width:15px;height:15px;vertical-align:-2px;"></i>
            Parámetros de trazabilidad
          </div>
          <div class="tc-card-body p-0">
            <div id="accordionExample">
              <!-- Generado por JS → Listar_tipos_trazabilidad() -->
              <div class="text-center text-muted p-4">
                <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                Cargando parámetros…
              </div>
            </div>
          </div>
        </div>

        <!-- Visualizadores de actividades -->
        <div class="tc-card mt-3">
          <div class="tc-header">
            <i data-feather="eye" style="width:15px;height:15px;vertical-align:-2px;"></i>
            Visualización de actividades
          </div>
          <div class="tc-card-body">
            <table class="table table-sm table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th style="width:40px">#</th>
                  <th>Usuario visualizador</th>
                  <th>Actividades que puede ver</th>
                  <th style="width:90px">
                    <button class="btn btn-subtle-success btn-sm px-2 py-0" type="button" id="btn-agregar-fila">
                      <span class="uil uil-plus-circle"></span> Agregar
                    </button>
                  </th>
                </tr>
              </thead>
              <tbody id="tbody_visualizadores"></tbody>
            </table>
          </div>
        </div>

      </div><!-- /col izquierda -->

      <!-- Derecha: Preview de orden -->
      <div class="col-12 col-lg-3">
        <div class="tc-card h-100">
          <div class="tc-header">
            <i data-feather="list" style="width:15px;height:15px;vertical-align:-2px;"></i>
            Orden de actividades
          </div>
          <div class="tc-card-body" style="max-height:520px;overflow-y:auto;padding:6px;">
            <div id="secondaryList"></div>
          </div>
          <div class="px-3 py-2 border-top">
            <small id="posicion" class="fw-bold text-muted"></small>
          </div>
        </div>
      </div>

    </div><!-- /row interna -->
  </div>

</form><!-- /form principal -->

<!-- ── Botón guardar ─────────────────────────────────────── -->
<div class="btn-save-sticky">
  <div class="d-flex justify-content-end pe-1">
