      <span data-feather="save" style="width:14px;height:14px;vertical-align:-2px;"></span>
      Crear Plantilla
    </button>
  </div>
</div>


<!-- ═══════════════════════════════════════════════════════════
     TEMPLATE OCULTO: fila de actividad dentro de un acordeón
     Se clona por JS cada vez que se carga un detalle de parámetro.
     ═══════════════════════════════════════════════════════════ -->
<template id="tpl-actividad-row">
  <!--
    Variables a reemplazar al clonar (JS):
      {{ID}}       → element.id  (id de la opción de actividad)
      {{NOMBRE}}   → element.nombre_opcion
      {{POSICION}} → contador actual
  -->
  <div class="actividad-row row trazabilidad_detalle_{{ID}} g-1 align-items-center">

    <!-- Checkbox + etiqueta -->
    <div class="col-12 col-md-4 d-flex align-items-center gap-1">
      <div class="form-check form-switch mb-0">
        <input class="form-check-input chk_detalle" type="checkbox"
          id="chk_detalle{{ID}}" name="chk_detalle[]"
          value="{{ID}}" data-idvalor="{{ID}}" data-idposicion="">
        <label class="form-check-label fw-semibold" for="chk_detalle{{ID}}">{{NOMBRE}}</label>
      </div>
    </div>

    <!-- ── Tipo operación: CARGUE / DESCARGUE ── NUEVO ────── -->
    <div class="col-6 col-md-2" id="tipo_op_wrap{{ID}}" style="display:none;">
      <div class="d-flex gap-1 align-items-center flex-wrap">
        <div class="form-check mb-0">
          <input class="form-check-input tipo_operacion" type="radio" name="tipo_operacion_{{ID}}" id="rdo_cargue{{ID}}" value="CARGUE" data-idactividad="{{ID}}">
          <label class="form-check-label" for="rdo_cargue{{ID}}">
            <span class="badge-cargue">↑ Cargue</span>
          </label>
        </div>
        <div class="form-check mb-0">
          <input class="form-check-input tipo_operacion" type="radio" name="tipo_operacion_{{ID}}" id="rdo_descargue{{ID}}" value="DESCARGUE" data-idactividad="{{ID}}">
          <label class="form-check-label" for="rdo_descargue{{ID}}">
            <span class="badge-descargue">↓ Descargue</span>
          </label>
        </div>
      </div>
    </div>

    <!-- Usuario responsable -->
    <div class="col-6 col-md-3" id="form_asignacion{{ID}}" style="display:none;">
      <select class="form-select form-select-sm slt_usuario_responsable select2" name="slt_usuario_responsable[]" id="slt_usuario_responsable{{ID}}" style="width:100%;"></select>
    </div>

    <!-- Criterio de cálculo + valor + medida -->
    <div class="col-12 col-md-3" id="form_calculo{{ID}}" style="display:none;">
      <div class="d-flex gap-1">
        <select class="form-select form-select-sm select_detalle" id="select_detalle{{ID}}" name="select_detalle[]" data-ElementId="{{ID}}" style="min-width:120px;" disabled>
          <option value="">Fecha Cálculo</option>
          <!-- <option value="1">Fecha Inicial</option>
          <option value="2">Fecha Actividad dependiente</option>
          <option value="3">Fecha de ejecución</option> -->
          <option value="4">Actividad dependiente</option>
        </select>
        <input type="number" class="form-control form-control-sm input_valor" id="input_valor{{ID}}" name="input_valor[]" placeholder="Valor" style="width:65px;" min="0" disabled>

        <select class="form-select form-select-sm select_medida_tiempo"
          id="select_medida_tiempo{{ID}}" name="select_medida_tiempo[]"
          style="width:85px;" disabled>
          <option value="">Medida</option>
          <option value="1">Minutos</option>
          <option value="2">Horas</option>
          <option value="3">Días</option>
        </select>
      </div>
    </div>

    <!-- Dependencia + Costo sugerido -->
    <div class="col-12 col-md-12" id="form_dependencia{{ID}}" style="display:none;">
      <div class="d-flex gap-1 flex-wrap mt-1">
        <select class="form-select form-select-sm select_depende_ select2"
          id="select_depende_{{ID}}" name="select_depende_[]"
          style="min-width:180px;" disabled>
          <option value="">Actividad dependiente</option>
        </select>
        <input type="number" class="form-control form-control-sm costo_sugerido"
          id="costo_sugerido{{ID}}" name="costo_sugerido[]"
          placeholder="Costo sugerido $" step="0.01" min="0"
          style="max-width:140px;" disabled>
        <div id="puesto_id{{ID}}" style="display:none;"></div>
      </div>
    </div>

  </div><!-- /actividad-row -->
</template>


<!-- ═══════════════════════════════════════════════════════════
     TEMPLATE OCULTO: fila de visualizador en la tabla
     ═══════════════════════════════════════════════════════════ -->
