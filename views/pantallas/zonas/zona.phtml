<!-- ═══════════════════════════════════════════════════════════
     OFFCANVAS DERECHO — Crear / Editar Zona
     ═══════════════════════════════════════════════════════════ -->
<div class="offcanvas offcanvas-end" style="width:820px"
  id="offcanvasRight" tabindex="-1"
  aria-labelledby="offcanvasRightLabel">

  <div class="offcanvas-header border-bottom"
    style="background:#f8f9fa">
    <h6 class="offcanvas-title fw-bold d-flex align-items-center gap-2"
      id="offcanvasRightLabel">
      <i class="fas fa-map-marked-alt" style="color:#7c3aed"></i>
      Nueva zona de despacho
    </h6>
    <button class="btn-close" type="button"
      data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
  </div>

  <div class="offcanvas-body" style="overflow-y:auto">

    <!-- Mensaje de error/éxito inline -->
    <div class="sms mb-2"></div>

    <!-- ID oculto para edición -->
    <input type="hidden" id="zona_edit_id" value="">

    <!-- ── Datos básicos ── -->
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header py-2 fw-bold"
        style="font-size:.8rem;background:#f3e8ff;color:#7c3aed;border-bottom:1px solid #ddd6fe">
        <i class="fas fa-info-circle me-1"></i> Información de la Zona
      </div>
      <div class="card-body pb-2">
        <div class="row g-2">

          <div class="col-8">
            <label class="form-label fw-semibold mb-1" style="font-size:.76rem">
              Nombre de la Zona <span class="text-danger">*</span>
            </label>
            <input type="text" id="nombre_zona"
              class="form-control form-control-sm"
              placeholder="Ej: Zona Norte, Zona Caribe..."
              oninput="this.value = this.value.toUpperCase()">
          </div>

          <div class="col-4">
            <label class="form-label fw-semibold mb-1" style="font-size:.76rem">Estado</label>
            <select class="form-select form-select-sm" id="estado_zona">
              <option value="Activo">Activo</option>
              <option value="Inactivo">Inactivo</option>
            </select>
          </div>

          <div class="col-4">
            <label class="form-label fw-semibold mb-1" style="font-size:.76rem">Fecha</label>
            <input type="date" id="fecha"
              class="form-control form-control-sm"
              value="<?= date('Y-m-d') ?>" disabled>
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold mb-1" style="font-size:.76rem">Descripción</label>
            <textarea id="descripcion"
              class="form-control form-control-sm"
              rows="2"
              placeholder="Describe brevemente el alcance geográfico de la zona..."
              oninput="this.value = this.value.toUpperCase()"></textarea>
          </div>

        </div>
      </div>
    </div>

    <!-- ── Municipios ── -->
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header py-2 fw-bold d-flex align-items-center gap-2"
        style="font-size:.8rem;background:#f3e8ff;color:#7c3aed;border-bottom:1px solid #ddd6fe">
        <i class="fas fa-map-pin"></i>
        Municipios de la Zona
        <span id="mun_contador"
          class="badge rounded-pill ms-auto"
          style="background:#7c3aed;font-size:.68rem">0</span>
      </div>
      <div class="card-body pb-2">

        <!-- Buscador -->
        <div class="position-relative mb-2">
          <i class="fas fa-search position-absolute"
            style="left:10px;top:50%;transform:translateY(-50%);color:#888;font-size:.78rem;pointer-events:none"></i>
          <input type="text" id="buscar_municipio"
            class="form-control form-control-sm ps-4"
            placeholder="Buscar municipio por nombre o departamento..."
            autocomplete="off"
            oninput="_zdBuscarMun(this.value)">
          <!-- Dropdown resultados -->
          <div id="drop_municipios"
            class="dropdown-menu w-100 shadow-sm"
            style="display:none;max-height:200px;overflow-y:auto;font-size:.8rem">
          </div>
        </div>

        <!-- Tags de municipios agregados -->
        <div id="tags_municipios"
          class="border border-dashed rounded p-2"
          style="min-height:40px;background:#fafafa;border-color:#ddd6fe!important">
          <span class="text-muted" style="font-size:.75rem">
            Agrega municipios desde el buscador
          </span>
        </div>

      </div>
    </div>

  </div><!-- /offcanvas-body -->

  <!-- ── Footer con botones ── -->
  <div class="offcanvas-footer d-flex justify-content-between align-items-center
              px-3 py-2 border-top"
    style="background:#f8f9fa">
    <div class="d-flex gap-2">
      <button class="btn btn-outline-secondary btn-sm"
        type="button"
        data-bs-dismiss="offcanvas">
        <i class="fas fa-times me-1"></i>Cancelar
      </button>
      <button class="btn btn-outline-danger btn-sm"
        type="button"
        id="btn_inactivar_zona"
        style="display:none"
        onclick="_zdToggleEstado(document.getElementById('zona_edit_id').value,'Activo')">
        <i class="fas fa-ban me-1"></i>Inactivar
      </button>
    </div>
    <button class="btn btn-primary btn-sm"
      type="button"
      id="btn_guardar_zona"
      onclick="_zdGuardarZona()">
      <i class="fas fa-save me-1"></i>Guardar
    </button>
  </div>

</div><!-- /offcanvasRight -->

