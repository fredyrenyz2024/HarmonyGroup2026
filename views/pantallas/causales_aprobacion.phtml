     OFFCANVAS — Crear / Editar Causal
====================================================== -->
<div class="offcanvas offcanvas-end offcanvas-center"
  id="offcanvasImporteMasivo"
  tabindex="-1"
  aria-labelledby="offcanvasImporteMasivoLabel"
  data-bs-backdrop="true">

  <!-- Header -->
  <div class="offcanvas-header ca-offcanvas-header">
    <div class="d-flex align-items-center w-100 h-100 gap-3">
      <div class="ca-ribbon">
        <i class="bi bi-tags-fill"></i>
      </div>
      <div>
        <h5 class="ca-offcanvas-title" id="offcanvasImporteMasivoLabel">Nueva Causal</h5>
        <div class="ca-offcanvas-sub" id="ca-offcanvas-sub">Completa los campos requeridos</div>
      </div>
      <button type="button"
        class="btn-close btn-close-white ms-auto me-3"
        data-bs-dismiss="offcanvas"
        aria-label="Cerrar">
      </button>
    </div>
  </div>

  <!-- Body -->
  <div class="offcanvas-body p-4">

    <!-- Hidden: ID para edición -->
    <input type="hidden" id="parametro-id-edit" value="">

    <!-- ── Tipo de Causal (pills) ──────────────────────── -->
    <div class="mb-3">
      <label class="ca-form-label">
        Tipo de Causal <span class="req">*</span>
      </label>
      <div class="ca-tipo-pills" id="ca-tipo-pills-container">

        <div class="ca-tipo-pill" data-value="VENTA" onclick="seleccionarTipoCausal('VENTA', this)">
          <span class="pill-icon">🧾</span>
          <span class="pill-label">Venta</span>
        </div>

        <div class="ca-tipo-pill" data-value="COSTO" onclick="seleccionarTipoCausal('COSTO', this)">
          <span class="pill-icon">🚛</span>
          <span class="pill-label">Costo</span>
        </div>

        <div class="ca-tipo-pill" data-value="AMBOS" onclick="seleccionarTipoCausal('AMBOS', this)">
          <span class="pill-icon">🔀</span>
          <span class="pill-label">Ambos</span>
        </div>

      </div>
      <!-- Input oculto que recibe el valor seleccionado -->
      <input type="hidden" id="tipo-causal" value="">
    </div>

    <div class="ca-form-divider"><span>Datos de la causal</span></div>

    <!-- ── Nombre ──────────────────────────────────────── -->
    <div class="mb-3">
      <label class="ca-form-label" for="nombre-parametro">
        Nombre de la causal <span class="req">*</span>
      </label>
      <input type="text"
        id="nombre-parametro"
        class="ca-form-control"
        placeholder="Ej: ALZA DE COMBUSTIBLE"
        oninput="this.value = this.value.toUpperCase();">
    </div>

    <!-- ── Estado ──────────────────────────────────────── -->
    <div class="mb-4">
      <label class="ca-form-label" for="estado-parametro">
        Estado <span class="req">*</span>
      </label>
      <select id="estado-parametro" class="ca-form-control">
        <option value="Activo">Activo</option>
        <option value="Inactivo">Inactivo</option>
      </select>
    </div>

    <!-- ── Botones ─────────────────────────────────────── -->
    <div class="d-flex gap-2 justify-content-end">
      <button class="ca-btn-cancel" type="button" data-bs-dismiss="offcanvas">
        <i class="bi bi-x-lg"></i> Cancelar
      </button>
      <button class="ca-btn-save" id="btn-accion-parametro" type="button">
        <i class="bi bi-floppy-fill"></i>
        <span id="btn-accion-texto">Guardar</span>
      </button>
    </div>

  </div><!-- /.offcanvas-body -->
</div><!-- /#offcanvasImporteMasivo -->