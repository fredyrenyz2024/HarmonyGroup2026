  function cotizacion_aprobada() {
    // alert('hi');
    // $("#esconder").show();
    var doc = $("#cotice").val();
    var fecha_i = $("#fecha_inicial").val();
    var fecha_f = $("#fecha_final").val();
    var datos = {
      doc: doc,
      fecha_inicia: fecha_i,
      fecha_final: fecha_f,
      action: 'consulte_aprobacion'
    };
    $("#body_esconder").html('');
    $.ajax({
      url: $('#id_url_ajax').val() + "serviciocliente/Consultar_Aprobacion",
      // url: $('#id_url_ajax').val() + "libs/servicio_cliente_ajax.php",
      type: 'POST',
      data: datos,
      dataType: 'json',
      success: function(data) {
        // console.log(data);
        contador_solicitud(fecha_i, fecha_f);
        cuente = 0;
        cont = 0;
        data.forEach(function(element, index) {
          cuente++;
          cont++;
          // console.log(element);
          var idsolicitud = element.soliid;
          var id_solicitudservicio, fecha_servicio;
          if (element.soliid != null) {
            id_solicitudservicio = element.soliid;
          } else {
            id_solicitudservicio = '';
          }
          if (element.fecha != null) {
            fecha_servicio = element.fecha + ' - ' + element.hora;
          } else {
            fecha_servicio = '';
          }

          var num = element.n_cotizacion;
          var origen = element.origen;
          var destino = element.destino;
          var peso = element.peso_neto_kg;
          var veh = element.tipo_vehiculo;
          var cliente = element.nombre_cliente;
          var flete = element.flete;
          var parejita = element.parejaod;
          var carga = element.tipo_carga;
          var trans = element.tipo_transporte;
          var estado_soli = element.idpareja_origen_destino;
          var palabra = '';
          var color = '';
          if (estado_soli == null) {
            palabra = 'Pendiente';
            color = 'primary';
            // document.getElementById("palabra").style.color="red";
          } else {
            if (element.estado == 'Cancelada') {
              palabra = 'Cancelada';
              color = 'danger';
            } else {
              palabra = 'Realizada';
              color = 'success';
            }
            // document.getElementById("palabra").style.color="blue";
          }

          estado_dos = '';
          if (element.estado_secundario != null) {
            estado_dos = '(' + element.estado_secundario + ')';
          }

          var boton_ver = '';
          var btn_cancelar = '';
          var btn_edita_tarifa = ''; //EDICION POR LA SUBASTA
