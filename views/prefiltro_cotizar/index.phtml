          if (element.estado == 'En_subasta' && element.estado_secundario == 'pendiente_aprobacion_sac' || element.estado_secundario == 'aprueba_flete_sac' || element.estado_secundario == 'no_aprueba_ge') {
            btn_edita_tarifa = '<button type="button" class="btn btn-warning btn-xs" id="btn_etarifa' + cont + '"  data-toggle="modal" data-target="#consulta_sub"  data-placement="top"  title="Verificación de la tarifa" data-id="' + num + '" data-id2="' + idsolicitud + '"  ><i class="fas fa-money-bill-wave"></i></button>';
          }
          if (element.estado == 'Pendiente' && element.estado !== 'Cancelada') {
            btn_cancelar = '<button type="button"  class="btn btn-danger btn-sm" id="btn_cancela' + cont + '" data-toggle="modal" data-target="#cancela_solicitud"  data-id="' + idsolicitud + '" data-id2="' + parejita + '"   data-placement="top" title="Cancelar solicitud" ><i class="fas fa-window-close"></i></button>';
          }
          var boton = '';
          if (estado_soli == null) {
            boton = '';
            //pendiente
            /*boton='<button type="button"  class="btn btn-secondary btn btn-sm mdi mdi-plus" id="btn_modal'+cont+'" data-toggle="modal"data-target="#exampleModal"  data-id="'+num+'" data-id2="'+origen+'" data-id3="'+destino+'" data-id4="'+peso+'" data-id5="'+veh+'" data-id6="'+cliente+'"  data-id7="'+flete+'" data-id9="'+carga+'" data-id10="'+trans+'"  data-placement="top" title="Solicitud pendiente" > </button>';*/
