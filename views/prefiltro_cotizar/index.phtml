  function contador_solicitud(fecha_i, fecha_f) {
    var dato_conteo = {
      fecha_inicia: fecha_i,
      fecha_final: fecha_f,
      // action: 'cantidad_solicitud'
    };
    $.ajax({
      url: $('#id_url_ajax').val() + "serviciocliente/Cantidad_Solicitudes",
      // url: $('#id_url_ajax').val() + "libs/servicio_cliente_ajax.php",
      type: 'POST',
      data: dato_conteo,
      dataType: 'json',
      success: function(data) {
        $("#bdge_ss").html(0);
        if (data) {
          $("#bdge_ss").html(data.cantidad);
        } else {
          $("#bdge_ss").html(0);
        }
      },
      error: function(jqXHR, textStatus, errorThrown) {
        console.log('');
        console.log(jqXHR);
        console.log(textStatus);
        console.log(errorThrown);
      }
    });
  }
