			// Columna Origen
			$table_orden_compra .= '
					<td class="cell-detail">
						<span>' . $value["cs_proveedor"] . '</span>
						<span class="cell-detail-description">Enviado: ' . $value["cs_fecha_envio_a_proveedor"] . '</span>
					</td>
				';
			// Columna Destino
			$table_orden_compra .= '
					<td class="cell-detail">
