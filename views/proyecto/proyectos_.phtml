						<span class="cell-detail-description">Llegada al almacén - ' . $value["cs_llegada_prometida_a_almacen"] . '</span>
					</td>
				';

			// se asigna la columna de acciones
			$table_orden_compra .= $col_action;

			$table_orden_compra .= '</tr>';
		}
	}

	$table_orden_compra .= '
							</tbody>
						</table>
