<script type="text/javascript">
	//AJAX PARA EL ICONO ELIMINAR
	$(document).ready(function(){ //alistar el documento
        

		$(".Btn-CambiaEstado").click(function(){ //revisá que el botón allá sido clickeado
			$(".msg_error_cambiar").empty();
			let msg_error = "";//poner el mensaje de error que visualizara el usuario, 
			let form = $(this).closest(".form_cambiar");//buscar hacia fuera()el id del formulario

			let params = { //parámetros para traer los valores de campos del formulario
				action: 'cambiarEstado',//un nombre que de se le da
				id: form.find(".id").val(),//campos a encontrar dentro del formulario
				estado: form.find(".estado").val()
			}
			console.log(params);

			$.ajaxSetup({async: false});//configuración
			$.ajax({
				url: $("#id_url_ajax").val() + "libs/prueba_ajax.php",//archivo donde se va a  ejecutar las sentencia
				type: 'POST',//metodo post o get
				data: params,//parametros a enviar a el otro archivo 
				cache: false,
				dataType: 'json',//tipo de dato
				beforeSend	: function(jqXHR, settings){//funcion para manejar los errores, no tocar
					funct_msg_loading(".nexos-messages");
				},
				error: function (jqXHR, textStatus, errorThrown){//mensajes de error
					$(".nexos-messages").html('');
					msg_error+= "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function (data, textStatus, jqXHR){//mensajes de exito
					console.log(data);
					if (data.error) { msg_error+= data.error; }
				}
			});
			$.ajaxSetup({async: true});

			if (!msg_error) { //mensaje de exito, 
				funct_msg_success(".msg_error_cambiar", `Se ha actualizado la prueba con éxito.`);
				$(".modal").animate({ scrollTop: 0 }, 600);
				setTimeout(function() { location.reload(false); }, 800);
			}
			if (msg_error) {//mensajes error 
				funct_msg_error(".msg_error_cambiar", msg_error); //funcion creada en layout, mensaje al boton eliminar
				$(".modal").animate({ scrollTop: 0 }, 600);//barra desplazamiento para el modal 
			}
		});


		$("#btn_crear_prueba").click(function(){
			$(".nexos_messages_popup").empty();
			console.log('alerta ');
			let msg_error = "";
			var descri = $("#ladescri").val();

			if (!descri) {
				msg_error+= '<p>Debe ingresar una <strong>descripción</strong> para crear la prueba.</p>';
			} 
 

			if (!msg_error) {
				var param = {
					action: "crea_prueba",
					descri_prueba:descri 
				}
				var result = consultaJquery(param);
				if (result.error) { msg_error+= result.error; }
			}
			if (msg_error) { 
				funct_msg_error(".nexos_messages_popup", msg_error); 
			}
			if (!msg_error) { 
				$(this).hide();
				funct_msg_success(".nexos_messages_popup", result.content);
				setTimeout(function() { location.reload(false);  }, 800);
			}
		});



	});
	//flsg popup sirve para retener la información dentro del modal si ocurre alguna eventualidad
	function prueba_editar(element){
		var elemento = $(element);
		var id = elemento.data("id")
		if($("#flag_popup").val() != id ){
			$("#editar_title").empty();
			$("#content_editar").empty();
			$("#msg_editar").empty();


			let msg_error = "";//poner el mensaje de error que visualizara el usuario, 

			if (msg_error) {
				funct_msg_error("#msg_editar", msg_error); //funcion creada en layout, mensaje al boton editar
				$("#editar_prueba").animate({ scrollTop: 0 }, 600);//barra desplazamiento para el modal 
			}
		}
		$("#flag_popup").val(id);// campo oculto
	}

	function eliminar(element){
		var elemento = $(element);
		var eliminar = $("#eliminar");//id del modal 
		eliminar.find("#id_eliminar").val(elemento.data("id"));//id_eliminar=id del campo oculto, id=valor que se esta enviando osea el id de la tabla. 
		//cambiar el estado a inactivo 

	}

    function activar(element){

     var elemento = $(element);
     var active = $("#activar");
     active.find("#id_activar").val(elemento.data("id"));

    }

/*-------------------------------------------------------------------------------*/


	function consultaJquery(params){
		var result;
		var msg_error = "";
		var msg_content = "";
		$(".nexos_messages_popup").html('');
		try{
			// console.log(params);
			$.ajaxSetup({async: false});
			$.ajax({
				//id_url_ajax esta en config y trae la parte complementaria de libs...
				url: $("#id_url_ajax").val() + "libs/prueba_ajax.php",
				type: 'POST',
				data: params,
				dataType: 'json',
				cache: false,
				beforeSend : function(jqXHR, settings){
					funct_msg_loading(".nexos-messages");
				},
				error: function (jqXHR, textStatus, errorThrown){
					$(".nexos-messages").html('');
					msg_error+= "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function (data, textStatus, jqXHR){
					// console.log(data);
					if (data) { result = data; }
				},
			});
			$.ajaxSetup({async: true});
			$(".nexos-messages").html('');
			if (msg_error) { funct_msg_error(".nexos_messages_popup", msg_error); }
			else { return result; }
		}catch(error){
			console.log(error);
		}
	}

</script>

