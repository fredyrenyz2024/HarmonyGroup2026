<script type="text/javascript">
	var url =$("#id_url_ajax").val() + 
		  "libs/gerencia_ajax.php";
	function sttaus(element){
	var elemento = $(element);
	var codini = elemento.data("id");
	var idplan = elemento.data("id2");
	var id_manifiesto= elemento.data("id3");
	$("#codis").val(codini);
	// alert(codini);
	// alert(idplan);
	var st={
		codini:codini,
		action:'status_iruta'
	};
	$("#body_status").html('');
		$.ajax({
		url:url,
		type:'POST',
		data:st,
		dataType:'json',
		success: function(data){
		console.log('trajo los estados');
			data.result.forEach(function(element,index){
				$("#body_status").append('<tr>'+
				'<td>'+element.estado+'</td>'+
				'<td>'+element.fecha+'</td>'+
				'<td>'+element.hora+'</td>'+
				'<td>'+element.usuario+'</td>'
				+'</tr>');
			});
		},
		error:function(jqXHR, textStatus, errorThrown){
			console.log('no trajo los estados');
			console.log(jqXHR);
			console.log(textStatus);
			console.log(errorThrown);
		}
	});

	var segui={
		idmani:id_manifiesto,
		action:'consultar_seguimientos'
	};
	$("#body_segui").html('');
		$.ajax({
		url:url,
		type:'POST',
		data:segui,
		dataType:'json',
		success: function(data){
		console.log('trajo los estados');
			if(data.result!=null){
				data.result.forEach(function(element,index){
				$("#body_segui").append('<tr>'+
				'<td>'+element.tipo_contacto+'</td>'+
				'<td>'+element.tipo_seguimiento+'</td>'+
				'<td>'+element.lugar+'</td>'+
				'<td>'+element.tipo_proceso+'</td>'+
				'<td>'+element.observacion+'</td>'
				+'</tr>');
			});
			}
			if(data.result==null){
				$("#msg_seguimiento").html('<p>No tiene ningún seguimiento creado</p>');
			}
			
		},
		error:function(jqXHR, textStatus, errorThrown){
			console.log('no trajo los estados');
			console.log(jqXHR);
			console.log(textStatus);
			console.log(errorThrown);
		}
	});

	//dibujar linea de puntos de control	

}

</script>