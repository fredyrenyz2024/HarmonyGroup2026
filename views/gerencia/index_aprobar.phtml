	//consultar datos de flete sugerido por operaciones
	function aprobar_flete(element) {
		var elemento = $(element);
		var id = elemento.data("id"); //ncotizacion
		var idtb_propuesto = elemento.data("id2"); //idfletesub
		var id_subasta = elemento.data("id3");
		$("#id_tb_propuesto").val(idtb_propuesto);
		$("#id_subasta").val(id_subasta);
		var dato = {
			id: id,
			idtb_propuesto: idtb_propuesto,
			action: 'traer_datos_aprobacion'
		};
		$.ajax({
			url: $("#id_url_ajax").val() + "libs/gerencia_ajax.php",
			type: 'POST',
			data: dato,
			dataType: 'json',
			success: function(data) {
				if (data) {
					$("#ocotizacion").val(id);
					$("#ocliente").val(data.result[0].nombre_cliente);
					$("#omercancia").val(data.result[0].tipo_mercancia);
