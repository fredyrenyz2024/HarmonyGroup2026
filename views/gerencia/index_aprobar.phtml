	//guardar
	function guardar_aprobacion() {

		var cot = $("#flag_poput").val();
		var usuario_aprobacion = $("#nom_aprueba").val();
		var select = $("#razon").val();
		var nota = $("#nota").val();
		var estado = $("#stado").val();
		var flag_poput = $("#flag_poput").val();
		var usuario = $("#nom_aprueba").val();

		var total = $("#atotal_cotizacion").val();
		var flete = $("#a_total_flete").val();
		var tarifa = $("#atotal_tarifa").val();
		var rentabilidad = $("#atotal_rentabilidad").val();
		var utilidad = $("#atotal_utilidad").val();

		if (select == '' || estado == '') {
			alert('Por favor seleccione la acción que desea hacer sobre la cotización');
		} else {
			var guardar = {
				select: select,
				nota: nota,
				estado: estado,
				cotizacion: flag_poput,
				usuario: usuario,
				total: total,
				flete: flete,
				tarifa: tarifa,
				rentabilidad: rentabilidad,
				utilidad: utilidad,
				action: 'guardar_apro_cotizacion'
			};

			$.ajax({
				url: $("#id_url_ajax").val() + "libs/gerencia_ajax.php",
