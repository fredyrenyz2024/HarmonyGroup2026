	//hacer el recalculo del cambio de valor
	$("#ofletenew").change(function() {
		var fl = $("#ofletenew").val();
		var tf = $("#otarifanew").val();
		//var ut=$("#outilidadnew").val();
		//var ren=$("#orentabilidadnew").val();
		//utilidad
		var resta = (parseFloat(tf) - parseFloat(fl));
		var calculo = (parseFloat(resta) / parseFloat(tf));
		var res = (parseFloat(calculo) * 100);
		res = res.toFixed(2);
		$("#outilidadnew").val(res);
		//rentabilidad
		var rent = (parseFloat(tf) - parseFloat(fl));
		$("#orentabilidadnew").val(rent);
	});

	//consultar datos de la tarifa ajustada por servicio al cliente
	function aprobar_tarifa(element) {
		var elemento = $(element);
		var id = elemento.data("id"); //ncotizacion
		var idtb_propuesto = elemento.data("id2"); //idfletesub
		var id_subasta = elemento.data("id3");
