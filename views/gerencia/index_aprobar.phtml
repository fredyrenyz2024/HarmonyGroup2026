					$("#otarifanew").val(data.result[0].total_tarifa);
					$("#fletepropunew").val(data.result[0].flete_propuesto);
					$("#fletesugepunew").val(data.result[0].flete_sugerido);
					//calculos utilidad
					var fl = data.result[0].flete_propuesto;
					var tf = data.result[0].total_tarifa;
					var resta = (parseFloat(tf) - parseFloat(fl));
					var calculo = (parseFloat(resta) / parseFloat(tf));
					var res = (parseFloat(calculo) * 100);
					res = res.toFixed(2);
					$("#fleteutil").val(res);
					//rentabilidad
					var rent = (parseFloat(tf) - parseFloat(fl));
					$("#fleterenta").val(rent);
				}
			},
