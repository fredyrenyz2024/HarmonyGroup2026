											});
								}
								if(data.result3!=null){
									data.result3.forEach(function(element,index){
										$("#tbestadod").append('<tr>'+
										'<td>'+element.estado+'</td>'+
										'<td>'+element.fecha+'</td>'+
										'<td>'+element.hora+'</td>'+
										'<td>'+element.usuario+'</td>'+
										'</tr>');
									});
								}
							},
							error:function(jqXHR, textStatus, errorThrown){
								alert('No consulto');
									console.log(jqXHR);
									console.log(textStatus);
									console.log(errorThrown);
							}
						});
					});

					$("#btn_estado"+cont+"").click(function(){
						var codini=$(this).attr('data-id');
						var servi=$(this).attr('data-id2');
						var orden=$(this).attr('data-id3');
						var fechao=$(this).attr('data-id4');
						var placa=$(this).attr('data-id5');
						var condu=$(this).attr('data-id6');
						var numcondu=$(this).attr('data-id7');
						var cliente=$(this).attr('data-id8');
						var mani=$(this).attr('data-id9');
						var fmani=$(this).attr('data-id10');
