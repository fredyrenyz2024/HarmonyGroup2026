<style>
    /* ── Variables ─────────────────────────────────────── */
    :root {
        --im-navy: #0f1f3d;
        --im-blue: #1a5ce5;
        --im-green: #10b981;
        --im-red: #ef4444;
        --im-amber: #f59e0b;
        --im-gray: #64748b;
        --im-light: #f1f5f9;
        --im-white: #ffffff;
        --im-border: #e2e8f0;
        --im-radius: 10px;
        --im-shadow: 0 1px 3px rgba(0, 0, 0, .08);
    }

    /* ── Header tipo flete_nacional ─────────────────────── */
    .np-header {
        background: linear-gradient(135deg, #0f1f3d 0%, #1a3260 100%);
        border-radius: 16px;
        padding: 20px 28px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 4px 12px rgba(0, 0, 0, .10);
        position: relative;
        overflow: hidden;
    }

    .np-header::before {
        content: '';
        position: absolute;
        top: -40px;
        right: -40px;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: rgba(255, 255, 255, .04);
    }

    .np-header-icon {
        width: 52px;
        height: 52px;
        background: rgba(16, 185, 129, .15);
        border: 2px solid rgba(16, 185, 129, .35);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #34d399;
        flex-shrink: 0;
    }

    .np-header-title {
        color: #fff;
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0;
    }

    .np-header-sub {
        color: rgba(255, 255, 255, .55);
        font-size: .78rem;
        margin-top: 2px;
    }

    /* ── Card de paso ────────────────────────────────────── */
    .np-card {
        background: #fff;
        border: 1px solid var(--im-border);
        border-radius: var(--im-radius);
        box-shadow: var(--im-shadow);
        margin-bottom: 16px;
        overflow: hidden;
    }

    .np-card-header {
        background: var(--im-light);
        border-bottom: 1px solid var(--im-border);
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--im-navy);
    }

    .np-card-header i {
        color: var(--im-blue);
    }

    .np-card-body {
        padding: 18px 20px;
    }

    /* ── Label estilo ────────────────────────────────────── */
    .np-label {
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: var(--im-gray);
        margin-bottom: 5px;
        display: block;
    }

    .np-label .req {
        color: var(--im-red);
    }

    /* ── Select / Input estilo ───────────────────────────── */
    .np-control {
        width: 100%;
        height: 36px;
        padding: 0 10px;
        border: 1.5px solid var(--im-border);
        border-radius: 6px;
        font-size: .83rem;
        color: var(--im-navy);
        background: #fff;
        transition: border-color .15s, box-shadow .15s;
        outline: none;
    }

    .np-control:focus {
        border-color: var(--im-blue);
        box-shadow: 0 0 0 3px rgba(26, 92, 229, .12);
    }

    .np-control.is-invalid {
        border-color: var(--im-red);
    }

    /* ── Dropzone ────────────────────────────────────────── */
    .np-dropzone {
        border: 2px dashed var(--im-border);
        border-radius: var(--im-radius);
        background: #fff;
        padding: 28px 20px;
        text-align: center;
        cursor: pointer;
        transition: border-color .25s, background .25s;
    }

    .np-dropzone:hover,
    .np-dropzone.dragover {
        border-color: var(--im-blue);
        background: #eff6ff;
    }

    .np-dropzone-icon {
        font-size: 2.2rem;
        color: var(--im-blue);
        margin-bottom: 8px;
        opacity: .75;
    }

    .np-dropzone-title {
        font-size: .9rem;
        font-weight: 700;
        color: var(--im-navy);
    }

    .np-dropzone-sub {
        font-size: .76rem;
        color: var(--im-gray);
        margin-top: 4px;
    }

    .np-dropzone-badge {
        display: inline-block;
        background: var(--im-light);
        color: var(--im-blue);
        border: 1px solid var(--im-border);
        padding: 3px 9px;
        border-radius: 4px;
        font-size: .7rem;
        font-weight: 600;
        margin: 2px;
    }

    #np_archivo_excel {
        display: none;
    }

    /* ── Archivo seleccionado ────────────────────────────── */
    .np-file-selected {
        display: none;
        align-items: center;
        gap: 12px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 8px;
        padding: 12px 14px;
        margin-top: 12px;
    }

    .np-file-selected.show {
        display: flex;
    }

    .np-file-icon {
        font-size: 1.5rem;
        color: #16a34a;
        flex-shrink: 0;
    }

    .np-file-name {
        font-size: .85rem;
        font-weight: 600;
        color: var(--im-navy);
        word-break: break-all;
    }

    .np-file-size {
        font-size: .72rem;
        color: var(--im-gray);
    }

    .np-file-clear {
        margin-left: auto;
        background: none;
        border: none;
        color: var(--im-red);
        cursor: pointer;
        font-size: .95rem;
        padding: 4px 6px;
        border-radius: 4px;
        transition: background .15s;
    }

    .np-file-clear:hover {
        background: #fee2e2;
    }

    /* ── Estructura del Excel ────────────────────────────── */
    .np-cols-info {
        background: #fff;
        border: 1px solid var(--im-border);
        border-radius: var(--im-radius);
        overflow: hidden;
        margin-top: 14px;
    }

    .np-cols-header {
        background: var(--im-light);
        border-bottom: 1px solid var(--im-border);
        padding: 9px 14px;
        font-size: .74rem;
        font-weight: 700;
        color: var(--im-blue);
        text-transform: uppercase;
        letter-spacing: .4px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .np-cols-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
        gap: 0;
    }

    .np-col-item {
        padding: 7px 12px;
        border-right: 1px solid var(--im-border);
        border-bottom: 1px solid var(--im-border);
        font-size: .72rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .np-col-num {
        min-width: 20px;
        height: 20px;
        background: var(--im-blue);
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .62rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .np-col-name {
        color: var(--im-navy);
        font-weight: 600;
    }

    /* ── Preview table ───────────────────────────────────── */
    .np-preview-wrap {
        overflow-x: auto;
        border-radius: 8px;
        border: 1px solid var(--im-border);
        max-height: 320px;
        overflow-y: auto;
    }

    .np-preview-wrap::-webkit-scrollbar {
        width: 5px;
        height: 5px;
    }

    .np-preview-wrap::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }

    #np_previewTable {
        width: 100%;
        border-collapse: collapse;
        font-size: .72rem;
    }

    #np_previewTable thead th {
        background: #0f1f3d;
        color: #fff;
        padding: 7px 10px;
        text-align: center;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 1;
        font-size: .68rem;
        font-weight: 600;
        letter-spacing: .04em;
    }

    #np_previewTable tbody tr {
        transition: background .1s;
    }

    #np_previewTable tbody tr:nth-child(even) {
        background: #f8fafc;
    }

    #np_previewTable tbody tr:hover {
        background: #eff6ff;
    }

    #np_previewTable tbody td {
        padding: 5px 8px;
        border-bottom: 1px solid var(--im-border);
        white-space: nowrap;
        color: var(--im-navy);
    }

    .np-badge-fila {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        background: var(--im-light);
        color: var(--im-gray);
        border-radius: 50%;
        font-size: .65rem;
        font-weight: 700;
    }

    .btn-del-row {
        background: none;
        border: none;
        color: var(--im-red);
        padding: 2px 6px;
        border-radius: 4px;
        cursor: pointer;
        font-size: .8rem;
        transition: background .15s;
    }

    .btn-del-row:hover {
        background: #fee2e2;
    }

    /* ── Advertencia ─────────────────────────────────────── */
    .np-warn {
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: .76rem;
        color: #92400e;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin-top: 14px;
    }

    /* ── Botón importar ──────────────────────────────────── */
    .np-btn-import {
        width: 100%;
        padding: 12px;
        background: linear-gradient(135deg, #0f1f3d 0%, #1a5ce5 100%);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: .9rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: opacity .2s, transform .1s;
        margin-top: 14px;
    }

    .np-btn-import:hover:not(:disabled) {
        opacity: .9;
        transform: translateY(-1px);
    }

    .np-btn-import:disabled {
        opacity: .5;
        cursor: not-allowed;
    }

    /* ── Sección progreso ────────────────────────────────── */
    .np-prog-header {
        text-align: center;
        padding: 20px 0 16px;
    }

    .np-spinner-wrap {
        position: relative;
        width: 72px;
        height: 72px;
        margin: 0 auto 14px;
    }

    .np-spinner-ring {
        width: 72px;
        height: 72px;
        border: 5px solid var(--im-light);
        border-top-color: var(--im-blue);
        border-radius: 50%;
        animation: np-spin 1s linear infinite;
    }

    @keyframes np-spin {
        to {
            transform: rotate(360deg);
        }
    }

    .np-spinner-pct {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .85rem;
        font-weight: 800;
        color: var(--im-navy);
    }

    .np-prog-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--im-navy);
    }

    .np-prog-sub {
        font-size: .82rem;
        color: var(--im-gray);
        margin-top: 3px;
    }

    .np-progress-track {
        background: var(--im-light);
        border-radius: 8px;
        height: 10px;
        overflow: hidden;
        margin: 14px 0 6px;
    }

    .np-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--im-blue) 0%, #3b82f6 100%);
        border-radius: 8px;
        transition: width .6s ease;
        width: 0%;
    }

    /* ── Sección resultado ───────────────────────────────── */
    .np-result-hero {
        text-align: center;
        padding: 20px 0 14px;
    }

    .np-result-icon {
        font-size: 4rem;
        margin-bottom: 10px;
    }

    .np-result-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--im-navy);
    }

    .np-result-sub {
        font-size: .82rem;
        color: var(--im-gray);
        margin-top: 4px;
    }

    .np-summary-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin: 16px 0;
    }

    .np-summary-card {
        background: #fff;
        border: 1px solid var(--im-border);
        border-radius: 9px;
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: var(--im-shadow);
    }

    .np-summary-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .95rem;
        flex-shrink: 0;
    }

    .ic-ok {
        background: #dcfce7;
        color: #16a34a;
    }

    .ic-err {
        background: #fee2e2;
        color: var(--im-red);
    }

    .np-summary-num {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--im-navy);
        line-height: 1;
    }

    .np-summary-label {
        font-size: .7rem;
        color: var(--im-gray);
        margin-top: 1px;
    }

    .np-detail-section {
        background: #fff;
        border: 1px solid var(--im-border);
        border-radius: var(--im-radius);
        overflow: hidden;
        margin-bottom: 10px;
    }

    .np-detail-toggle {
        width: 100%;
        background: none;
        border: none;
        padding: 11px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: .8rem;
        font-weight: 700;
        color: var(--im-navy);
        cursor: pointer;
        transition: background .15s;
    }

    .np-detail-toggle:hover {
        background: var(--im-light);
    }

    .np-detail-toggle .badge-count {
        padding: 3px 9px;
        border-radius: 12px;
        font-size: .7rem;
        font-weight: 700;
    }

    .np-detail-body {
        display: none;
        border-top: 1px solid var(--im-border);
        max-height: 220px;
        overflow-y: auto;
    }

    .np-detail-body.open {
        display: block;
    }

    .np-detail-row {
        padding: 8px 14px;
        border-bottom: 1px solid var(--im-border);
        font-size: .76rem;
        color: var(--im-navy);
    }

    .np-detail-row:last-child {
        border-bottom: none;
    }

    .np-result-footer {
        display: flex;
        gap: 10px;
        margin-top: 14px;
    }

    .np-btn-finalizar {
        flex: 1;
        padding: 10px;
        border: none;
        border-radius: 8px;
        background: var(--im-blue);
        color: #fff;
        font-size: .85rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: opacity .2s;
    }

    .np-btn-finalizar:hover {
        opacity: .88;
    }

    .np-btn-otro {
        flex: 1;
        padding: 10px;
        border: 1.5px solid var(--im-border);
        border-radius: 8px;
        background: #fff;
        color: var(--im-navy);
        font-size: .85rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: background .15s;
    }

    .np-btn-otro:hover {
        background: var(--im-light);
    }
</style>
<style>
    /* ============================================================
                        VARIABLES DE DISEÑO — Torre de Control / Administrador Pedidos
                        ============================================================ */
    :root {
        --navy: #0f1f3d;
        --navy-mid: #1a3260;
        --blue: #1a5ce5;
        --blue-soft: #dbeafe;
        --amber: #f59e0b;
        --amber-soft: #fef3c7;
        --green: #10b981;
        --green-soft: #d1fae5;
        --red: #ef4444;
        --red-soft: #fee2e2;
        --orange: #f97316;
        --orange-soft: #ffedd5;
        --cyan: #06b6d4;
        --cyan-soft: #cffafe;
        --purple: #8b5cf6;
        --purple-soft: #ede9fe;
        --slate-50: #f8fafc;
        --slate-100: #f1f5f9;
        --slate-200: #e2e8f0;
        --slate-400: #94a3b8;
        --slate-600: #475569;
        --slate-800: #1e293b;
        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 16px;
        --shadow-sm: 0 1px 3px rgba(0, 0, 0, .08), 0 1px 2px rgba(0, 0, 0, .06);
        --shadow-md: 0 4px 12px rgba(0, 0, 0, .10), 0 2px 4px rgba(0, 0, 0, .06);
        --shadow-lg: 0 10px 25px rgba(0, 0, 0, .12), 0 4px 8px rgba(0, 0, 0, .06);
    }

    /* ── PAGE HEADER ───────────────────────────────────── */
    .page-header {
        background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 100%);
        border-radius: var(--radius-lg);
        padding: 20px 28px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: var(--shadow-md);
        position: relative;
        overflow: hidden;
    }

    .page-header::before {
        content: '';
        position: absolute;
        top: -40px;
        right: -40px;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: rgba(255, 255, 255, .04);
    }

    .page-header::after {
        content: '';
        position: absolute;
        bottom: -30px;
        right: 120px;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: rgba(26, 92, 229, .15);
    }

    .ph-icon {
        width: 52px;
        height: 52px;
        background: rgba(245, 158, 11, .15);
        border: 2px solid rgba(245, 158, 11, .35);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--amber);
        flex-shrink: 0;
    }

    .ph-title {
        color: #fff;
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: -.3px;
        margin: 0;
    }

    .ph-sub {
        color: rgba(255, 255, 255, .55);
        font-size: .78rem;
        margin-top: 2px;
    }

    /* ── KPI CARDS ─────────────────────────────────────── */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 12px;
        margin-bottom: 20px;
    }

    @media (max-width: 1024px) {
        .kpi-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (max-width: 640px) {
        .kpi-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .kpi-card {
        background: #fff;
        border-radius: var(--radius-md);
        padding: 16px 18px;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--slate-200);
        display: flex;
        align-items: center;
        gap: 14px;
        cursor: pointer;
        transition: box-shadow .2s, transform .2s, border-color .2s;
        position: relative;
        overflow: hidden;
        user-select: none;
    }

    .kpi-card::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    }

    .kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .kpi-card.active {
        border-color: currentColor;
        box-shadow: var(--shadow-md);
    }

    .kpi-card.c-green::before {
        background: var(--green);
    }

    .kpi-card.c-amber::before {
        background: var(--amber);
    }

    .kpi-card.c-red::before {
        background: var(--red);
    }

    .kpi-card.c-slate::before {
        background: var(--slate-400);
    }

    .kpi-card.c-cyan::before {
        background: var(--cyan);
    }

    .kpi-card.c-purple::before {
        background: var(--purple);
    }

    .kpi-card.c-orange::before {
        background: var(--orange);
    }

    .kpi-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .kpi-card.c-green .kpi-icon {
        background: var(--green-soft);
        color: var(--green);
    }

    .kpi-card.c-amber .kpi-icon {
        background: var(--amber-soft);
        color: #d97706;
    }

    .kpi-card.c-red .kpi-icon {
        background: var(--red-soft);
        color: var(--red);
    }

    .kpi-card.c-slate .kpi-icon {
        background: var(--slate-100);
        color: var(--slate-600);
    }

    .kpi-card.c-cyan .kpi-icon {
        background: var(--cyan-soft);
        color: var(--cyan);
    }

    .kpi-card.c-purple .kpi-icon {
        background: var(--purple-soft);
        color: var(--purple);
    }

    .kpi-card.c-orange .kpi-icon {
        background: var(--orange-soft);
        color: var(--orange);
    }

    .kpi-num {
        font-size: 1.7rem;
        font-weight: 700;
        line-height: 1;
        font-family: 'IBM Plex Mono', monospace;
    }

    .kpi-card.c-green .kpi-num {
        color: var(--green);
    }

    .kpi-card.c-amber .kpi-num {
        color: #d97706;
    }

    .kpi-card.c-red .kpi-num {
        color: var(--red);
    }

    .kpi-card.c-slate .kpi-num {
        color: var(--slate-600);
    }

    .kpi-card.c-cyan .kpi-num {
        color: var(--cyan);
    }

    .kpi-card.c-purple .kpi-num {
