				url: $("#id_url_ajax").val() + "libs/municipios_ajax.php",
				type: 'POST',
				data: params,
				cache: false,
				dataType: 'json',
				beforeSend	: function(jqXHR, settings){
					funct_msg_loading(".nexos-messages");
				},
				error: function (jqXHR, textStatus, errorThrown){
					$(".nexos-messages").html('');
					msg_error+= "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function (data, textStatus, jqXHR){
					$(".nexos-messages").html('');
					// console.log(data);
					if (data.municipio) {
						msg_error+= `<p>El municipio <strong>${municipio.val().toUpperCase()}</strong> del Estado | Departamento | Región <strong>${depto.val().toUpperCase()}</strong> y del país <strong>${pais.val().toUpperCase()}</strong> ya existe.</p>`;
						$("#btn_crea_municipio").hide();
					}
					if (data.error) { msg_error+= data.error }
				}
			});
			$.ajaxSetup({async: true});
		} 
		if (msg_error) { funct_msg_error("#popup_message", msg_error); }
	}




</script>