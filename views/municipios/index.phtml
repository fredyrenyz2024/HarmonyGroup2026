	function creaPais(){
		// console.log("Entro en función creaPais");
		$("#popup_content").empty();
		$("#btn_crea_pais").show();
		$("#btn_crea_depto").hide();
		$("#btn_crea_municipio").hide();
		$("#popup_message").empty();
		$("#popup_title").html("Crear País");
		var msg_error= '';

		$("#popup_content").html(`
			<div class="col-xs-12 col-sm-2 col-md-4"></div>
			<div class="col-xs-12 col-sm-8 col-md-4">
				<label class="control-label">(*) País:</label>
				<input type="text" class="form-control input-sm" name="pais" id="pais" placeholder="País">
			</div>
			<div class="col-xs-12 col-sm-2 col-md-4"></div>
		`);

		$("#pais").blur(function(){
			$("#popup_message").empty();
			$("#btn_crea_pais").show();
			if ($(this).val()) {
				let msg_error = '';
				var params = {
					action: "buscar_pais",
					pais: $(this).val().toUpperCase()
				}
				$.ajaxSetup({async: false});
				$.ajax({
					url: $("#id_url_ajax").val() + "libs/municipios_ajax.php",
					type: 'POST',
					data: params,
					cache: false,
					dataType: 'json',
					beforeSend	: function(jqXHR, settings){
						funct_msg_loading(".nexos-messages");
					},
					error: function (jqXHR, textStatus, errorThrown){
						$(".nexos-messages").html('');
						msg_error+= "<p>" + jqXHR.responseText + "</p>";
						console.log(jqXHR);
						console.log(textStatus);
						console.log(errorThrown);
					},
					success: function (data, textStatus, jqXHR){
						$(".nexos-messages").html('');
						// console.log(data);
						if (!data.error) {
							if (data.result) { 
								msg_error+= `<p>El pais <strong>${data.pais}</strong> ya se encuentra creado.</p>`; 
								$("#btn_crea_pais").hide();
							} 
						} 
						else { msg_error+= `<p>${data.error}</p>`; }
					}
				});
				if (msg_error) { funct_msg_error("#popup_message", msg_error); }
				$.ajaxSetup({async: true});
			}
		});
		if (msg_error) { funct_msg_error("#popup_message", msg_error); }
	}

