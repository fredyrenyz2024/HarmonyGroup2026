<script type="text/javascript">
	$(document).ready(function () {
		$("#tools_editar").hide();

		// Script para la muestra del botón de edición de las instrucciones
		$(".check_proyectos").change(function () {
			$("#tools_editar").hide();
			var _class = $(this).attr("class");
			let id_cliente = $(this).data("id_cliente");
			if ($("." + _class + ":checked").length > 0) {
				$("#tools_editar").show();
				$("." + _class).each(function () {
					if ($(this).data("id_cliente") != id_cliente) {
						$(this).removeAttr("checked").attr("disabled", true);
					}
				});
			} else {
				$("." + _class).removeAttr("disabled");
			}
		});

		var flag_id_proyectos;

		$("#btn_tools_editar").click(function () {
			var msg_error = "";

			let proyectos = $(".check_proyectos:checked");
			let id_proyectos = "";
			let grupos = new Array();
			let numero_importacion = new Array();
			let importacion = new Array();
			proyectos.each(function () {
				var element = $(this);
				grupos[element.val()] = element.data("grupo");
				numero_importacion[element.val()] = element.data("numero_importacion");
				importacion[element.val()] = element.data("importacion");
				id_proyectos += element.val() + ",";
			});

			if (flag_id_proyectos != id_proyectos) {
				flag_id_proyectos = id_proyectos;
				$("#editar_title").empty();
				$(".nexos_messages_popup").empty();
				$("#contenidoeditar").empty();

				// Se pinta la información de cada uno de los proyectos seleccionados
				let params = {
					id: id_proyectos,
					grupos: grupos,
					numero_importacion: numero_importacion,
					importacion: importacion,
				}
				// console.log(params);

				$.ajaxSetup({
					async: false
				});
				$.ajax({
					url: $("#id_url_ajax").val() + "libs/importaciones.php?action=form_instrucciones_factura",
					type: 'POST',
					data: params,
					cache: false,
					dataType: 'json',
					beforeSend: function (jqXHR, settings) {
						$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
					},
					error: function (jqXHR, textStatus, errorThrown) {
						$(".nexos-messages").html('');
						msg_error += "<p>" + jqXHR.responseText + "</p>";
						console.log(jqXHR);
						console.log(textStatus);
						console.log(errorThrown);
					},
					success: function (data, textStatus, jqXHR) {
						// console.log(data);
						$(".nexos-messages").empty();
						$("#editar_title").html(`Generar Instrucción de Factura`);

						if (!data.error) {
							$("#contenidoeditar").html(data.content);

							$("#accordion_proyectos").find(".data_proyecto").hide();
							$(".mostrar_proyecto").click(function () {
								mostrar_proyecto($(this));
							});

							cargaProveedores();

						} else {
							msg_error += data.error;
						}
					}
				});
				$.ajaxSetup({
					async: true
				});
				if (msg_error) {
					$(".nexos_messages_popup").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
					$("#editar").animate({
						scrollTop: 0
					}, 600);
				}

			}
		});

		$("#btn_editar").click(function () {
			// console.log("Entro en click de btn_editar");
			$(".nexos_messages_popup").empty();
			var msg_error = "";
			var form = $("#form_instruccion");
			var form_instruccion = form.find(".servicio_row");
			var _flag_gestiona = false;
			var id_servicio_adicional = "";
			var id_proyectos = $(this).parents("#editar").find("#accordion_proyectos").data("id_proyectos");
			var params = new FormData();

			// Se valida el contenido de los formularios 
			form_instruccion.each(function () {
				let form_content = $(this);
				let url_costo = form_content.find(".url_costo");
				let nombre_servicio = form_content.find(".nombre_servicio").text();
				let proveedor_servicio = form_content.find("#proveedor_servicio");
				let id_proveedor_servicio = form_content.find(".id_proveedor_servicio");
				let id_tramo = form_content.find("#slct_tramo");
				let id = form_content.data("id");
				let id_proyecto = form_content.data("id_proyecto");

				if (!proveedor_servicio.val()) {
					msg_error += `<p>Debe diligenciar el campo <strong>${proveedor_servicio.attr("placeholder")}</strong> del servicio adicional <strong>${nombre_servicio}</strong> del proyecto <strong>${form_content.data("importacion")}</strong> para poder editar la instrucción de factura.</p>`;
				}
				if (url_costo.val()) {
					let adjunto = url_costo[0].files[0];
					// Se valida el peso del archivo
					if (adjunto.size < $("#max_file_size").val()) {
						// Se valida el tipo de archivo
						var extension = adjunto.name.split(".");
						var formato_archivo = "pdf,PDF,zip,ZIP,rar,RAR,doc,DOC,docx,DOCX,jpg,jpeg,png,gif,bmp,tif,JPG,JPEG,PNG,GIF,BMP,TIF,xls,XLS,xlsx,XLSX,ppt,PPT,pptx,PPTX,pps,PPS,ppsx,PPSX";
						if (validaFormatoArchivo(formato_archivo, extension[extension.length - 1]) == 0) {
							valido = false;
							msg_error += `<p>Formato del archivo del campo <strong>${url_costo.attr("placeholder")}</strong> del servicio adicional <strong>${nombre_servicio}</strong> del proyecto <strong>${form_content.data("importacion")}</strong> no es válido para poder editar la instrucción de factura.</p>`;
							msg_error += `<p>Formatos válidos: <strong>${formato_archivo.replace(/,/g, ", ")}</strong>.</p>`;
						}
					} else {
						msg_error += `<p>El archivo del campo <strong>${url_costo.attr("placeholder")}</strong> del servicio adicional <strong>${nombre_servicio}</strong> del proyecto <strong>${form_content.data("importacion")}</strong> es muy pesado para subirlo al servidor. El peso máximo del archivo debe ser menor de <strong>${($("#max_file_size").val() / 1000000)}MB</strong>.</p>`;
					}
				} else {
					msg_error += `<p>Debe diligenciar el campo <strong>${url_costo.attr("placeholder")}</strong> del servicio adicional <strong>${nombre_servicio}</strong> del proyecto <strong>${form_content.data("importacion")}</strong> para poder editar la instrucción de factura.</p>`;
				}

				// Se genera los parámetros a enviar 
				id_servicio_adicional += id + ",";
				params.append('id_servicio_adicional_' + id, id);
				params.append('id_proveedor_servicio_' + id, id_proveedor_servicio.val());
				params.append('url_costo_' + id, url_costo[0].files[0]);
				params.append('id_tramo_' + id, id_tramo.val());
				params.append('numero_importacion_' + id, form_content.data("numero_importacion"));
				params.append('grupo_' + id, form_content.data("grupo"));
				params.append('grupo_proyecto_' + id_proyecto, form_content.data("grupo"));
				params.append('id_tramo_' + id, id_tramo.val());
				// Se valida si se cobra el servicio al cliente 
				params.append('sobrecosto_' + id, 0);
				if (form_content.find(".check_sobrecosto").is(":checked")) {
					params.append('sobrecosto_' + id, true);
				}
			});

			// Se valida los proyectos que no tienen servicios adicionales registrados
			if (form.find(".sin_adicionales").length > 0) {
				form.find(".sin_adicionales").each(function () {
					let id_proyecto = $(this).data("id_proyecto");
					let grupo = $(this).data("grupo");
					params.append('grupo_proyecto_' + id_proyecto, grupo);
				});
			}

			if (!msg_error) {
				params.append('id_proyectos', id_proyectos);
				params.append('id_usuario', $(this).data("id_usuario"));
				if (id_servicio_adicional) {
					params.append('id_servicio_adicional', id_servicio_adicional);
				}

				$.ajaxSetup({
					async: false
				});
				$.ajax({
					url: $("#id_url_ajax").val() + "libs/importaciones.php?action=generar_instruccion_factura",
					type: 'POST',
					contentType: false,
					data: params,
					cache: false,
					dataType: 'json',
					processData: false,
					beforeSend: function (jqXHR, settings) {
						$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
					},
					error: function (jqXHR, textStatus, errorThrown) {
						$(".nexos-messages").html('');
						msg_error += "<p>" + jqXHR.responseText + "</p>";
						console.log(jqXHR);
						console.log(textStatus);
						console.log(errorThrown);
					},
					success: function (data, textStatus, jqXHR) {
						$(".nexos-messages").html('');
						// console.log(data);
						if (!data.error) {
							if (data.actividades) {
								gestionarActividades(data.actividades);
							}
						} else {
							msg_error += data.error;
						}
					}
				});
				$.ajaxSetup({
					async: true
				});
			}
			if (!msg_error) {
				$(".nexos_messages_popup").html('<div role="alert" class="alert alert-success alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Proceso terminado! </strong>Se ha creado el registro con éxito.</div></div>');
				$("#editar").animate({
					scrollTop: 0
				}, 600);
				setTimeout(function () {
					location.reload(false);
				}, 800);
			}
			if (msg_error) {
				$(".nexos_messages_popup").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
				$("#editar").animate({
					scrollTop: 0
				}, 600);
			}
		});
	});

	function gestionarActividades(actividades) {
		actividades.forEach(function (element, index) {
			actualizaActividad(element);
		});
	}

	function actualizaActividad(params) {
		// Se actualizan las actividades del proyecto
		$.ajax({
			type: "POST",
			cache: false,
			url: $("#id_url_ajax").val() + "libs/gestion_actividades.php?tabla=cmx_importacion_actividades&proyecto=importaciones",
			data: params,
			beforeSend: function (jqXHR, settings) {
				$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
			},
			error: function (data) {
				console.log(data);
				$("#nexos_messages_popup_crea_pago").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Proceso terminado!</strong> Error en el registro.</div></div>');
			},
			success: function (data) {
				console.log(data);
			}
		});
	}

	var flag_id;

	function verInstruccion(id, importacion, numero_importacion, grupo) {
		if (flag_id != id) {
			flag_id = id;
			var msg_error = "";

			$("#ver_title").empty();
			$(".nexos_messages_popup").empty();
			$("#contenidover").empty();

			var params = {
				id: id,
				grupo: grupo
			}
			$.ajaxSetup({
				async: false
			});
			$.ajax({
				url: $("#id_url_ajax").val() + "libs/importaciones.php?action=ver_proyecto_instruccion",
				type: 'POST',
				data: params,
				cache: false,
				dataType: 'json',
				beforeSend: function (jqXHR, settings) {
					$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
				},
				error: function (jqXHR, textStatus, errorThrown) {
					$(".nexos-messages").html('');
					msg_error += "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function (data, textStatus, jqXHR) {
					// console.log(data);
					$(".nexos-messages").empty();
					$("#ver_title").html(`Información Proyecto ${importacion} <small>${numero_importacion} (${grupo})</small>`);

					if (!data.error) {
						$("#contenidover").html(data.content);
					} else {
						msg_error += data.error;
					}
				}
			});
			$.ajaxSetup({
				async: true
			});
			if (msg_error) {
				$(".nexos_messages_popup").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
				$("#ver").animate({
					scrollTop: 0
				}, 600);
			}
		}
	}

	function mostrar_proyecto(element) {
		var data_proyecto = element.parents(".datos_proyecto").find(".data_proyecto");
		var servicios = element.parents(".datos_proyecto").find(".data_servicios");

		data_proyecto.fadeToggle("fast", function () {
			if ($(this).is(":visible")) {
				let alto = 0;
				servicios.each(function () {
					alto += $(this).height();
				});
				let traslado = alto + $(this).offset().top;
				data_proyecto.parents("#editar").animate({
					scrollTop: traslado
				}, 600)
			}
		});
	}

	// Funciones para cargar los proveedores
	var url = $("#id_url_ajax").val() + "libs/solicitudes_ajax.php";

	function cargaProveedores() {
		// Se crea la función para adicionar los proveedores de los servicios especiales 
		if ($(".tt-input").length > 0) {
			let proveedores = cargarProveedores();
			let servicio_proveedores = [];
			proveedores.content.forEach(function (element, index) {
				servicio_proveedores.push(element.nombre);
			});

			$(".tt-input").each(function () {
				let id = $(this).data("id");
				let element_id = $(this).attr("id");
				let id_elemet_proveedor = "id_proveedor_servicio_" + id;
				let caja_id = "caja_proveedor_servicio_" + id;

				$('#' + caja_id + ' .typeahead').typeahead({
					minLength: 1
				}, {
					name: 'states',
					source: substringMatcher(servicio_proveedores),
				});
				$.ajaxSetup({
					async: false
				});
				$('#' + caja_id).bind('typeahead:selected', function (obj, datum, name) {
					var params = {
						accion: 'obtenerdatosproveedor',
						numero_documento: datum.split(" - ")[0]
					};
					$.post(url, params, function (data) {
						// console.log(data);
						if (data.success) {
							$("#" + id_elemet_proveedor).val(data.content.id);
						}
					}, 'json');
				});
				$.ajaxSetup({
					async: true
				});
				$("#" + element_id).focusout(function () {
					// console.log($.inArray($("#" + element_id).val(), servicio_proveedores));
					if ($.inArray($("#" + element_id).val(), servicio_proveedores) == (-1)) {
						$("#" + id_elemet_proveedor).val("");
					}
				});
			});
		}
	}

	function cargarProveedores() {
		var result;
		var params = {
			accion: 'cargarprovedores',
		};
		$.ajaxSetup({
			async: false
		});
		$.post(url, params, function (data) {
			result = data;
		}, 'json');
		return result;
		$.ajaxSetup({
			async: true
		});
	}

	var substringMatcher = function (strs) {
		return function findMatches(q, cb) {
			var matches, substringRegex;
			// an array that will be populated with substring matches
			matches = [];

			// regex used to determine if a string contains the substring `q`
			substrRegex = new RegExp(q, 'i');

			// iterate through the pool of strings and for any string that
			// contains the substring `q`, add it to the `matches` array
			$.each(strs, function (i, str) {
				if (substrRegex.test(str)) {
					matches.push(str);
				}
			});
			cb(matches);
		};
	};
	// Fin - Funciones para cargar los proveedores
</script>