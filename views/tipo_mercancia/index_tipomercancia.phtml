	function crear_mercancia(){
		var msg_error = "";
		if(!$("#tipo").val()){
			msg_error+= "<p>Debe diligenciar el campo <strong> Nombre para Nexos Cargo </strong> para poder crear la Mercancía.</p>";
		}
		if(!$("#codigo_rndc").val()){
			msg_error+= "<p>Debe diligenciar el campo <strong>Código RNDC</strong> para poder crear la Mercancía.</p>";
		}
		if(!$("#capitulo").val()){
			msg_error+= "<p>Debe diligenciar el campo <strong>Capitulo</strong> para poder crear la Mercancía.</p>";
		}
		if(!$("#naturaleza").val()){
			msg_error+= "<p>Debe diligenciar el campo <strong>Naturaleza</strong> para poder crear la Mercancía.</p>";
		}
		if(!$("#estado").val()){
			msg_error+= "<p>Debe diligenciar el campo <strong>Estado</strong> para poder crear la Mercancía.</p>";
		}
		if(!$("#producto").val()){
			msg_error+= "<p>Debe diligenciar el campo <strong>Producto</strong> para poder crear la Mercancía.</p>";
		}
		if($("#tipo").val().length > 60){
			msg_error+= "<p>El campo <strong>Nombre para Nexos Cargo</strong>recibe máximo 60 carácteres.</p>";
		}
		if(!msg_error){
		 creartipo();
		}else{
			$("#nexos_messages_popup").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-close"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
			$("#crea_mercancia").animate({ scrollTop: 0 }, 600);
		}
	}

