			name='Carga normal';
		}
		if(natur=='CP'){
			name='Carga peligrosa';
		}
		if(natur=='DP'){
			name='Desechos peligroso';
		}
		$("#name_naturaleza").val(name);
		$("#naturaleza").val(natur);
		$("#codigo_rndc").val(idrndc);
		$("#capitulo").val(cap);
		$("#producto").val(producto);
		$("#id_tb_productos").val(id_tb_producto);
		$("#id_capitulo").val(cod_capitulo);
