	}
	if(!$("#eid_rndc").val()){
		msg_error+= "<p>Debe diligenciar el campo <strong>Código RNDC</strong> para poder actualizar la Mercancía.</p>";
	}
	if(!$("#e_natur").val()){
		msg_error+= "<p>Debe diligenciar el campo <strong>Naturaleza</strong> para poder actualizar la Mercancía.</p>";	
	}
	if(!$("#e_estado").val()){
		msg_error+= "<p>Debe diligenciar el campo <strong>Estado</strong> para poder actualizar la Mercancía.</p>";
	}
	if($("#e_tipo").val().length > 60){
		msg_error+= "<p>El campo <strong>Nombre para Nexos</strong> recibe máximo 60 carácteres.</p>";	
	}
	if(!msg_error){
		datos_editar={
		id:id_tb,
		nom:nom,
		estado:estado,
		action:'actualizar'
		};
		$.ajax({
			url:"http://localhost/mvcLuisMiguel/libs/tipo_mercancia_parametros_ajax.php",
		 	type:'POST',
		 	data:datos_editar,
		 	dataType:'json',
		 	success: function(data){
		 		// console.log('sisi update');
