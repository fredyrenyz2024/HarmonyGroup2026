		msg_error+= "<p>Debe diligenciar el campo <strong>Nombre para Nexos</strong> para poder actualizar la Mercancía.</p>";
	}
	if(!$("#e_nombre2").val()){
		msg_error+= "<p>Debe diligenciar el campo <strong>Nombre Ministerio</strong> para poder actualizar la Mercancía.</p>";
	}
	if(!$("#e_capitulo").val()){
