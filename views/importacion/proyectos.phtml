<script type="text/javascript">
	// Funciones de eliminación de proyecto
	function eliminar_proyecto(element) {
		$(".msg_error_danger").empty();
		var id = $(element).data("id");
		var formulario = $("#eliminar");
		formulario.find("#id").val("");
		formulario.find("#id").val(id);

		formulario.find("#btn_eliminar").click(function () {
			var msg_error = '';
			let params = {
				tabla: "cmx_importacion_proyecto",
				id: formulario.find("#id").val(),
				estado: formulario.find("#estado").val()
			};

			$.ajaxSetup({ async: false });
			$.ajax({
				url: $("#id_url_ajax").val() + "libs/editar_ajax.php",
				type: 'POST',
				data: params,
				cache: false,
				dataType: 'json',
				beforeSend: function (jqXHR, settings) {
					funct_msg_loading(".nexos-messages");
				},
				error: function (jqXHR, textStatus, errorThrown) {
					$(".nexos-messages").html('');
					msg_error += "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function (data, textStatus, jqXHR) {
					// console.log(data);
					if (data.error) { msg_error += data.error; }
				}
			});
			$(".nexos-messages").empty();
			if (!msg_error) {
				funct_msg_success(".msg_error_danger");
				$("#eliminar").animate({ scrollTop: 0 }, 600);
				setTimeout(function () { location.reload(false); }, 800);
			}
			if (msg_error) {
				funct_msg_error(".msg_error_danger", msg_error);
				$("#eliminar").animate({ scrollTop: 0 }, 600);
			}
			$.ajaxSetup({ async: true });
		});
	}

	// Funciones de habilitación de proyecto
	function habilitar_proyecto(element) {
		$(".msg_error_success").empty();
		var id = $(element).data("id");
		var formulario = $("#habilitar");
		formulario.find("#id").val("");
		formulario.find("#id").val(id);

		formulario.find("#btn_habilitar").click(function () {
			var msg_error = '';
			let params = {
				tabla: "cmx_importacion_proyecto",
				id: formulario.find("#id").val(),
				estado: formulario.find("#estado").val()
			};

			$.ajaxSetup({ async: false });
			$.ajax({
				url: $("#id_url_ajax").val() + "libs/editar_ajax.php",
				type: 'POST',
				data: params,
				cache: false,
				dataType: 'json',
				beforeSend: function (jqXHR, settings) {
					funct_msg_loading(".nexos-messages");
				},
				error: function (jqXHR, textStatus, errorThrown) {
					$(".nexos-messages").html('');
					msg_error += "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function (data, textStatus, jqXHR) {
					// console.log(data);
					if (data.error) { msg_error += data.error; }
				}
			});
			$(".nexos-messages").empty();
			if (!msg_error) {
				funct_msg_success(".msg_error_success");
				$("#eliminar").animate({ scrollTop: 0 }, 600);
				setTimeout(function () { location.reload(false); }, 800);
			}
			if (msg_error) {
				funct_msg_error(".msg_error_success", msg_error);
				$("#eliminar").animate({ scrollTop: 0 }, 600);
			}
			$.ajaxSetup({ async: true });
		});
	}
</script>