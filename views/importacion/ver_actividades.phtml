<script type="text/javascript">
	/***** FUNCIONES DE CARGA DE FORMULARIO DE COSTOS *****/
	$("#slct_servicio_adicional").change(function () {
		$("#nexos_messages_costos").empty();
		$("#contenidoadicionarcosto").empty();
		let content = "";
		$(this).find("option:selected").each(function () {
			let id = $(this).val();
			let text = $(this).text();
			content += `
				<div class="form-group col-xs-12 col-sm-12 col-md-12">
					<div class="col-xs-12 col-sm-12 col-md-12"><strong>${text}</strong></div>
					<div class="col-xs-2 col-sm-2 col-md-2">
						<label><small class="text-muted">Se cobra al cliente</small></label>
						<div class="be-checkbox">
							<input class="check_sobrecosto" id="sobrecosto_${id}" type="checkbox">
							<label for="sobrecosto_${id}"></label>
						</div>
					</div>
					<div class="col-xs-6 col-sm-3 col-md-3">
						<label>(*) Valor de venta:</label>
						<input type="text" id="e_valor_venta_servicio_${id}" placeholder="Valor de venta" class="form-control input-xs" onload="getFormatoNumeroDecimal(this)" onkeyup="getFormatoNumeroDecimal(this)" onchange="getFormatoNumeroDecimal(this)" data-title="Valor de venta">
					</div>
					<div class="col-xs-6 col-sm-3 col-md-3">
						<label>(*) Valor de compra:</label>
						<input type="text" id="e_valor_compra_servicio_${id}" placeholder="Valor de compra" class="form-control input-xs" onload="getFormatoNumeroDecimal(this)" onkeyup="getFormatoNumeroDecimal(this)" onchange="getFormatoNumeroDecimal(this)" data-title="Valor de compra">
					</div>
					<div class="col-xs-12 col-sm-4 col-md-4">
						<label>(*) Proveedor:</label>
						<div id="e_caja_proveedor_servicio_${id}">
							<span class="twitter-typeahead" style="position: relative; display: inline-block;">
								<input type="text" class="typeahead form-control input-xs tt-input" placeholder="Proveedor" id="e_proveedor_servicio_${id}" autocomplete="off" spellcheck="false" dir="auto" style="position: relative; vertical-align: top; background-color: transparent;" data-id="${id}">
								<pre aria-hidden="true" style="position: absolute; visibility: hidden; white-space: pre; font-family: Roboto, Arial, sans-serif; font-size: 12px; font-style: normal; font-variant: normal; font-weight: 400; word-spacing: 0px; letter-spacing: 0px; text-indent: 0px; text-rendering: auto; text-transform: none;"></pre>
								<div class="tt-menu" style="position: absolute; top: 100%; left: 0px; z-index: 100; display: none;">
									<div class="tt-dataset tt-dataset-states"></div>
								</div>
							</span>
						</div>
						<input type="hidden" id="e_id_proveedor_servicio_${id}" data-title="Proveedor">
					</div>
				</div>
			`;
		});
		$("#contenidoadicionarcosto").html(content);
		cargaProveedores();
	});

	var url = $("#id_url_ajax").val() + "libs/solicitudes_ajax.php";

	function cargaProveedores() {
		// Se crea la función para adicionar los proveedores de los servicios especiales 
		if ($(".tt-input").length > 0) {
			let proveedores = cargarProveedores();
			let servicio_proveedores = [];
			proveedores.content.forEach(function (element, index) {
				servicio_proveedores.push(element.nombre);
			});

			$(".tt-input").each(function () {
				let id = $(this).data("id");
				let element_id = $(this).attr("id");
				let id_elemet_proveedor = "e_id_proveedor_servicio_" + id;
				let caja_id = "e_caja_proveedor_servicio_" + id;

				$('#' + caja_id + ' .typeahead').typeahead({
					minLength: 1
				}, {
					name: 'states',
					source: substringMatcher(servicio_proveedores),
				});
				$.ajaxSetup({
					async: false
				});
				$('#' + caja_id).bind('typeahead:selected', function (obj, datum, name) {
					var params = {
						accion: 'obtenerdatosproveedor',
						numero_documento: datum.split(" - ")[0]
					};
					$.post(url, params, function (data) {
						// console.log(data);
						if (data.success) {
							$("#" + id_elemet_proveedor).val(data.content.id);
						}
					}, 'json');
				});
				$.ajaxSetup({
					async: true
				});
				$("#" + element_id).focusout(function () {
					// console.log($.inArray($("#" + element_id).val(), servicio_proveedores));
					if ($.inArray($("#" + element_id).val(), servicio_proveedores) == (-1)) {
						$("#" + id_elemet_proveedor).val("");
					}
				});
			});
		}
	}

	function cargarProveedores() {
		var result;
		var params = {
			accion: 'cargarprovedores',
		};
		$.ajaxSetup({
			async: false
		});
		$.post(url, params, function (data) {
			result = data;
		}, 'json');
		return result;
		$.ajaxSetup({
			async: true
		});
	}

	var substringMatcher = function (strs) {
		return function findMatches(q, cb) {
			var matches, substringRegex;
			// an array that will be populated with substring matches
			matches = [];

			// regex used to determine if a string contains the substring `q`
			substrRegex = new RegExp(q, 'i');

			// iterate through the pool of strings and for any string that
			// contains the substring `q`, add it to the `matches` array
			$.each(strs, function (i, str) {
				if (substrRegex.test(str)) {
					matches.push(str);
				}
			});
			cb(matches);
		};
	};
	/***** FIN - FUNCIONES DE CARGA DE FORMULARIO DE COSTOS *****/

	/***** FUNCIONES DE ADICIÓN DE COSTOS DEL PROYECTO *****/
	$("#btn_adicionar_costo").click(function () {
		$("#nexos_messages_costos").empty();
		var msg_error = "";

		var id_solicitud = $(this).data("id_solicitud");
		let options = $("#slct_servicio_adicional").find("option:selected");
		if (options.length > 0) {
			var costos = new Array();
			options.each(function () {
				let id = $(this).val();
				let text = $(this).text();
				let valor_venta = $("#e_valor_venta_servicio_" + id);
				let valor_compra = $("#e_valor_compra_servicio_" + id);
				let id_proveedor = $("#e_id_proveedor_servicio_" + id);

				if (!valor_venta.val()) {
					msg_error +=
						`<p>Debe diligenciar el campo <strong>${valor_venta.attr("placeholder")}</strong> del servico <strong>${text}</strong> para generar el costo.</p>`;
				}
				if (!valor_compra.val()) {
					msg_error +=
						`<p>Debe diligenciar el campo <strong>${valor_compra.attr("placeholder")}</strong> del servico <strong>${text}</strong> para generar el costo.</p>`;
				}
				if (!id_proveedor.val()) {
					msg_error +=
						`<p>Debe diligenciar el campo <strong>${id_proveedor.data("title")}</strong> del servico <strong>${text}</strong> para generar el costo.</p>`;
				}
				let sobrecosto = 0;
				if ($("#sobrecosto_" + id).is(":checked")) {
					sobrecosto = 1;
				}

				let array = {
					id_servicio: id,
					valor_venta: valor_venta.val(),
					valor_compra: valor_compra.val(),
					id_proveedor: id_proveedor.val(),
					sobrecosto: sobrecosto
				};
				costos.push(array);
			});
		} else {
			msg_error += `<p>Debe seleccionar <strong>Servicios Adicionales</strong> para generar el costo.</p>`;
		}

		if (!msg_error) {
			let params = {
				accion: 'crea_costo',
				id_solicitud: id_solicitud,
				cmx_servicio_adicional: costos,
			}
			// console.log(params);

			$.ajaxSetup({
				async: false
			});
			$.ajax({
				url: url,
				type: 'POST',
				data: params,
				cache: false,
				dataType: 'json',
				beforeSend: function (jqXHR, settings) {
					$(".nexos-messages").html(
						'<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' +
						$("#id_url_ajax").val() +
						'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>'
					);
				},
				error: function (jqXHR, textStatus, errorThrown) {
					$("#nexos_messages_costos").html('');
					msg_error += "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function (data, textStatus, jqXHR) {
					// console.log(data);
					$("#nexos_messages_costos").html(
						'<div role="alert" class="alert alert-success alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Proceso terminado! </strong>Se ha creado el registro con éxito.</div></div>'
					);
					$("#adicionar_costo").animate({
						scrollTop: 0
					}, 600);
					setTimeout(function () {
						location.reload(false);
					}, 800);
				}
			});
			$.ajaxSetup({
				async: true
			});
		}
		if (msg_error) {
			$("#nexos_messages_costos").html(
				'<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' +
				msg_error + '</div></div>');
			$("#adicionar_costo").animate({
				scrollTop: 0
			}, 600);
		}
	});
	/***** FIN - FUNCIONES DE ADICIÓN DE COSTOS DEL PROYECTO *****/

	/***** FUNCIONES DE LA ACTIVIDAD TIPO intr_oferta_comercial *****/
	// Funcion que calcula el valor en pesos de la oferta comercial 
	$(".oferta-comercial").change(function () {
		$("#msg_trm_oferta").empty();
		var msg_error = "";
		var content = "";
		let data = $(this).parents(".modal-body").find(".oferta-comercial");
		let flag = true;
		let array = new Array();
		data.each(function () {
			if (!$(this).val()) {
				flag = false;
			}
			let value = $(this).val();
			let campo = $(this).data("campo");
			array.push({
				value: value,
				campo: campo
			});
		});

		if (flag) {
			let params = {
				data: array
			}
			// console.log(params);

			$.ajaxSetup({
				async: false
			});
			$.ajax({
				url: $("#id_url_ajax").val() + "libs/internacional_ajax.php?action=buscar_trm",
				type: 'POST',
				data: params,
				cache: false,
				dataType: 'json',
				beforeSend: function (jqXHR, settings) {
					$(".nexos-messages").html(
						`<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="${$("#id_url_ajax").val()}public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>`
					);
				},
				error: function (jqXHR, textStatus, errorThrown) {
					$("#msg_trm_oferta").empty();
					msg_error += "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function (data, textStatus, jqXHR) {
					// console.log(data);
					$(".nexos-messages").empty();
					if (!data.error) {
						content = data.content;
					} else {
						msg_error += data.error;
					}
				}
			});

			if (msg_error) {
				$(".nexos-messages").empty();
				$("#msg_trm_oferta").html(
					`<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error! </strong>${msg_error}</div></div>`
				);
			}
			if (!msg_error) {
				$("#msg_trm_oferta").html(
					`<div role="alert" class="alert alert-success alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button>${content}</div></div>`
				);
			}
			$.ajaxSetup({
				async: true
			});
		}
	});
	/***** FIN - FUNCIONES DE LA ACTIVIDAD TIPO intr_oferta_comercial *****/
