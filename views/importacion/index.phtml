function buscaClientes(tipo_proyecto) {
  let params = {
    tipo_proyecto: tipo_proyecto
  };
  // console.log(params);

  var url = $("#id_url_ajax").val() + "libs/buscar.php";
  $.ajax({
    type: "POST",
    url: url,
    data: params,
    dataType: "html",
    beforeSend: function() {
      $(".nexos-messages").html(
        '<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' +
        $("#id_url_ajax").val() +
        'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>'
      );
    },
    error: function() {
      console.log("Error");
    },
    success: function(data) {
      // console.log(data);
      // Se pinta el contenido en el formulario 
      $("#div_clientes").html(data);

      $("#slct_id_cliente").change(function() {
        let params = {
          id_cliente: $("#slct_id_cliente").val()
        };
        // console.log(params);

        switch (tipo_proyecto) {
          case 'NACIONAL':
            $("#div_slct_contrato").empty();

            var url = $("#id_url_ajax").val() + "libs/buscar_proyectos.php?action=crea_html_select_contrato";
            $.ajax({
              type: "POST",
              url: url,
              data: params,
              dataType: "json",
              beforeSend: function() {
                $(".nexos-messages").html(
                  '<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' +
                  $("#id_url_ajax").val() +
                  'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>'
                );
              },
              error: function(jqXHR, textStatus, errorThrown) {
                console.log(jqXHR);
                console.log(textStatus);
                console.log(errorThrown);
              },
              success: function(data) {
                var html_content = "<label>(*) Contrato:</label>";
                html_content += data.content;
                $(".nexos-messages").html("");
                $("#div_slct_contrato").empty();
                $("#div_slct_contrato").append(html_content);
                $("#div_contrato").fadeOut("fast");
              }
            });
            break;

          case 'INTERNACIONAL':
            // console.log("Entro en - " + tipo_proyecto);
            $("#div_btn_tramos").empty();
            $("#form_tramo_1").empty();

            var url = $("#id_url_ajax").val() + "libs/buscar_proyectos.php?action=crea_html_content_tramos";
            $.ajax({
              type: "POST",
              url: url,
              data: params,
              dataType: "json",
              beforeSend: function() {
                $(".nexos-messages").html(
                  '<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' +
                  $("#id_url_ajax").val() +
                  'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>'
                );
              },
              error: function(jqXHR, textStatus, errorThrown) {
                console.log(jqXHR);
                console.log(textStatus);
                console.log(errorThrown);
              },
              success: function(data) {
                // console.log(data);
                $(".nexos-messages").html("");
                $("#div_btn_tramos").empty();
                $("#div_tramos").empty();
                $("#div_btn_tramos").append(data.result["botones"]);
                $("#form_tramo_1").append(data.result["form_tramos"]);

                // Programación del botón de agregar tramo de la solicitud
                $('#btn_agrega_tramo').click(function() {
                  num = $('.tramo_clon').length;
                  var newNum = new Number(num + 1);

                  // create the new element via clone(), and manipulate it's ID using newNum value
                  var newElem = $('#form_tramo_' + num).clone().attr('id', 'form_tramo_' + newNum);

                  newElem.children('#div_tipo_tramo_' + num).attr('id', 'div_tipo_tramo_' + newNum);
                  newElem.children('#div_tramo_' + num).attr('id', 'div_tramo_' + newNum);

                  // manipulate the name/id values of the input inside the new element
                  newElem.find('#div_tipo_tramo_' + newNum + ' #slct_tipo_tramo_' + num).attr('id',
                    'slct_tipo_tramo_' + newNum).attr('name', 'tipo_tramo_' + newNum);
                  newElem.find('#div_tramo_' + newNum + ' #slct_remitente_destinatario_' + num)
                    .attr('id', 'slct_remitente_destinatario_' + newNum).attr('name', 'rem_dest_' +
                      newNum);

                  // insert the new element after the last "duplicatable" input field
                  $('#form_tramo_' + num).after(newElem);

                  // // enable the "remove" button
                  $('#btn_quita_tramo').removeAttr("disabled");

                  // business rule: you can only add 5 names
                  if (newNum == 20)
                    $('#btn_agrega_tramo').attr('disabled', 'disabled');
                });

                // Programación del botón de quitar tramo
                $('#btn_quita_tramo').click(function() {
                  num = $('.tramo_clon').length;

                  $('#form_tramo_' + num).remove();

                  // enable the "add" button
                  $('#btn_agrega_tramo').removeAttr("disabled");

                  // if only one element remains, disable the "remove" button
                  if (num - 1 == 1) {
                    $('#btn_quita_tramo').attr('disabled', 'disabled');
                  }
                });
              }
            });
            break;

          default:
            console.log("Error en la selección de tipo de proyecto");
            break;
        }
      });
    }
  });
}

