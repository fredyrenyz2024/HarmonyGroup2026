$("#slct_tipo_operacion_").change(function() {
  $("#div_clientes").empty();
  $("#form_tramo_1").empty();

  // Se filtra vista de los campos de material y solicitud de urbano y se buscan los clientes correspondientes al tipo de operación
  var flag_vista;
  // Se filtra si el proyecto es nacional o internacional
  switch ($("#slct_tipo_operacion_").val()) {
    case 'IMPORTACION':
      flag_vista = "INTERNACIONAL";
      break;
    case 'EXPORTACION':
      flag_vista = "INTERNACIONAL";
      break;
    case 'NACIONAL_AEREO':
      flag_vista = "INTERNACIONAL";
      break;

    case 'NACIONAL':
      flag_vista = "NACIONAL";
      break;

    case 'URBANO':
      flag_vista = "NACIONAL";
      break;
  }

  switch (flag_vista) {
    case 'INTERNACIONAL':
      // Se filtra la vista de materiales y solicitud de urbano
      $(".nacional").hide();
      $(".internacional").show();
      $("#slct_rndc_material_").val('');
      $("#solicita_urbano").attr('checked', false);
      break;

    case 'NACIONAL':
      // Se filtra la vista de materiales y solicitud de urbano
      $(".nacional").show();
      $(".internacional").hide();
      break;
  }

  if ($("#slct_tipo_operacion_").val()) {
    buscaClientes(flag_vista);
    formDatosInternacional(flag_vista);
  }

  // Se hace filtro para ajustar las plantilla de actividades a seleccionar 
  let solicita_urbano = 0;
  if ($("#solicita_urbano").is(':checked')) {
    solicita_urbano = 1;
  }
  selectPlantillas($("#slct_tipo_operacion_").val(), solicita_urbano);
});

var num = 1;
$("#slct_tipo_cargas_").change(function() {
  var id_tipo_carga = $("#slct_tipo_cargas_").val();

  $(".div_contenedor").hide();
  if (id_tipo_carga == 1) {
    $(".div_contenedor").show();
    $(".div_devolucion").hide();
    $('#btn_quita').attr('disabled', 'disabled');
    App.formElements();
  } else {
    // Se reinicia el contenido de los contenedores
    $("#devolucion_1").attr("checked", false);
    num = $('.contenedor_clon').length;
    if (num > 1) {
      for (var i = 2; i <= num; i++) {
        $('#form_contenedor_' + i).remove();
      }
    }
    $('#btn_agrega').removeAttr("disabled");
    $('#btn_quita').attr('disabled', 'disabled');
  }
});

// Programación del botón de agregar contenedor
$('#btn_agrega').click(function() {
  num = $('.contenedor_clon').length;
  var newNum = new Number(num + 1);

  // create the new element via clone(), and manipulate it's ID using newNum value
  var newElem = $('#form_contenedor_' + num).clone().attr('id', 'form_contenedor_' + newNum);

  newElem.children('#div_tipo_contenedor_' + num).attr('id', 'div_tipo_contenedor_' + newNum);
  newElem.children('#div_contenedor_' + num).attr('id', 'div_contenedor_' + newNum);
  newElem.children('#div_devolucion_' + num).attr('id', 'div_devolucion_' + newNum);
  newElem.children('#div_devolucion_' + num).attr('id', 'label_devolucion_' + newNum);
  newElem.children('#div_comodato_' + num).attr('id', 'div_comodato_' + newNum);
  newElem.children('#div_fecha_comodato_' + num).attr('id', 'div_fecha_comodato_' + newNum);
  newElem.children('#div_devolucion_contenedor_' + num).attr('id', 'div_devolucion_contenedor_' + newNum);

  // manipulate the name/id values of the input inside the new element
  newElem.find('#div_contenedor_' + newNum + ' #contenedor_' + num).attr('id', 'contenedor_' + newNum).attr('name',
    'contenedor_' + newNum);
  newElem.find('#div_tipo_contenedor_' + newNum + ' #slct_tipo_contenedor_' + num).attr('id',
    'slct_tipo_contenedor_' + newNum).attr('name', 'tipo_contenedor_' + newNum);
  newElem.find('#div_devolucion_' + newNum + ' #devolucion_' + num).attr('id', 'devolucion_' + newNum).attr('name',
    'devolucion_' + newNum).attr("checked", false).parents(".contenedor_clon").find(".div_devolucion").hide();
  newElem.find('#div_devolucion_' + newNum + ' #label_devolucion_' + num).attr('id', 'label_devolucion_' + newNum)
    .attr('for', 'devolucion_' + newNum);
  newElem.find('#div_devolucion_contenedor_' + newNum + ' #devolucion_contenedor_' + num).attr('id',
    'devolucion_contenedor_' + newNum).attr('name', 'devolucion_contenedor_' + newNum);
  newElem.find('#div_fecha_comodato_' + newNum + ' #fecha_comodato_' + num).attr('id', 'fecha_comodato_' + newNum)
    .attr('name', 'fecha_comodato_' + newNum);
  newElem.find('#div_comodato_' + newNum + ' #url_comodato_' + num).attr('id', 'url_comodato_' + newNum).attr(
    'name', 'url_comodato_' + newNum);
  newElem.find('#div_comodato_' + newNum + ' #lbl_comodato_' + num).attr('id', 'lbl_comodato_' + newNum).attr('for',
    'url_comodato_' + newNum);

  // insert the new element after the last "duplicatable" input field
  $('#form_contenedor_' + num).after(newElem);

  // // enable the "remove" button
  $('#btn_quita').removeAttr("disabled");

  // business rule: you can only add 5 names
  if (newNum == 2)
    $('#btn_agrega').attr('disabled', 'disabled');
  App.formElements();
});

// Programación del botón de quitar contenedor
$('#btn_quita').click(function() {
  num = $('.contenedor_clon').length;

  $('#form_contenedor_' + num).remove();

  // enable the "add" button
  $('#btn_agrega').removeAttr("disabled");

  // if only one element remains, disable the "remove" button
  if (num - 1 == 1) {
    $('#btn_quita').attr('disabled', 'disabled');
  }
});

