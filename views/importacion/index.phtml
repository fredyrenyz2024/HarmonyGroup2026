$("#div_contrato").hide();
$(".condiciones").click(function() {
  $("#" + $(this).attr("id") + "_content").slideToggle("fast");
});
$("#inicio_contrato").change(function() {
  var fecha = new Date($(this).val());
  var day = fecha.getDate() + 1;
  var month = fecha.getMonth() + 1;
  var year = fecha.getFullYear() + 1;

  if (day.toString().length == 1) {
    day = "0" + day;
  }

  if (month.toString().length == 1) {
    month = "0" + month;
  }

  var fecha_fin = year + "-" + month + "-" + day;
  $("#fin_contrato").val(fecha_fin)
});

function muestraFormContrato() {
  $("#div_contrato").fadeOut("fast");
  if ($("#slct_contrato_").val() == "otro") {
    $("#div_contrato").fadeIn("fast");
  }

  $(".condiciones").each(function() {
    $("#" + $(this).attr("id") + "_content").hide();
    $(this).prop("checked", false);
  });
  App.formElements();
}

// Funciones de eliminación de proyecto
function eliminar_proyecto(element) {
  $(".msg_error_danger").empty();
  var id = $(element).data("id");
  // console.log("🚀 ~ eliminar_proyecto ~ id:", id)
  var formulario = $("#eliminar");
  formulario.find("#id").val("");
  formulario.find("#id").val(id);

  formulario.find("#btn_eliminar").click(function() {
    var msg_error = '';
    let params = {
      tabla: "cmx_importacion_proyecto",
      id: formulario.find("#id").val(),
      estado: formulario.find("#estado").val()
    };
    // console.log("🚀 ~ formulario.find ~ params:", params)
    $.ajaxSetup({
      async: false
    });
    $.ajax({
      url: $("#id_url_ajax").val() + "libs/editar_ajax.php",
      type: 'POST',
      data: params,
      cache: false,
      dataType: 'json',
      beforeSend: function(jqXHR, settings) {
        funct_msg_loading(".nexos-messages");
      },
      error: function(jqXHR, textStatus, errorThrown) {
        $(".nexos-messages").html('');
        msg_error += "<p>" + jqXHR.responseText + "</p>";
        console.log(jqXHR);
        console.log(textStatus);
        console.log(errorThrown);
      },
      success: function(data, textStatus, jqXHR) {
        // console.log(data);
        if (data.error) {
          msg_error += data.error;
        }
      }
    });
    $(".nexos-messages").empty();
    if (!msg_error) {
      funct_msg_success(".msg_error_danger");
      $("#eliminar").animate({
        scrollTop: 0
      }, 600);
      setTimeout(function() {
        location.reload(false);
      }, 800);
    }
    if (msg_error) {
      funct_msg_error(".msg_error_danger", msg_error);
      $("#eliminar").animate({
        scrollTop: 0
      }, 600);
    }
    $.ajaxSetup({
      async: true
    });
  });
}

