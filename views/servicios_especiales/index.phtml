	var id_content;
	function form_edita(id, nombre, tipo_servicio){
		var form_content = $("#form_edita");
		if (id_content != id) {
			id_content = id;
			form_content.find("#id").val(id);
			form_content.find("#nom_servicios_especial").val(nombre);
			form_content.find("#slct_tipo_operacion_").val(tipo_servicio);
		}
	}

	/***** Funciones de administración de cuentas contables de los servicios adicionales *****/
	$(".mostrar_form").click(function(){
		$("#form_content").fadeToggle("fast");
		$("#btn_edita_cuentas").fadeToggle("fast");
	});

	var _flag_content
	function form_edita_cuentas(id, nombre, tipo_servicio){
		if ( _flag_content != id) {
			_flag_content = id;
			$(".msg_panel_content").empty();
			$("#edita_cuentas_title").html(`Editar Cuentas Contables - ${nombre} <small>(${tipo_servicio})</small>`);
			$("#form_edita_cuentas")[0].reset();
			$("#form_content").fadeOut("fast");
			$("#btn_edita_cuentas").fadeOut("fast");
			$("#edita_cuentas_content").empty();
			cargarFormularioCuentas();
			verCuentas(id);
		}
	}

	function cargarFormularioCuentas(){
		var msg_error = "";
		$.ajaxSetup({async: false});
		$.ajax({
			url: $("#id_url_ajax").val() + "libs/servicios_especiales_ajax.php?action=cargarFormularioCuentas",
			type: 'POST',
			cache: false,
			dataType: 'json',
			beforeSend	: function(jqXHR, settings){
				$(".msg_content").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
			},
			error: function (jqXHR, textStatus, errorThrown){
