				console.log(textStatus);
				console.log(errorThrown);
			},
			success: function (data, textStatus, jqXHR){
				// console.log(data);
				if (!data.error) {
					$("#edita_cuentas_content").html(data.content);

					$(".btn_action").click(function(){
