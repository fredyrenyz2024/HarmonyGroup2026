<script type="text/javascript">
	$(document).ready(function(){
		$("#btn_crea").click(function(){
			$(".msg_content").empty();
			let form_crea = $("#form_crea");
			var msg_error = "";

			// Se filtra el contenido del formulario
			var nombre = form_crea.find("#nom_servicios_especial").val();
			var tipo_servicio = form_crea.find("#slct_tipo_operacion_").val();

			if (!nombre) {
				msg_error+= '<p>Debe diligenciar el campo <strong>Nombre</strong> para crear el servicio.</p>';
			}
			if (!tipo_servicio) {
				msg_error+= '<p>Debe seleccionar un <strong>Tipo Servicio</strong> para crear el servicio.</p>';
			}

			if (!msg_error) {
				var params = form_crea.serialize();
				$.ajax({
					type		: "POST",
					cache		: false,
					url			: $("#id_url_ajax").val() + "libs/insertar.php?tabla=cmx_contabilidad_conceptos",
					data		: params,
					beforeSend	: function(jqXHR, settings){
						$("#crear").hide();
						$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
					},
					success		: function(data) {
						// console.log(data);
						$(".nexos-messages").empty();
						$("#crear").show();
						$(".msg_content").html('<div role="alert" class="alert alert-success alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Proceso terminado! </strong>Se ha creado el registro con éxito.</div></div>');
						$("#crear").animate({ scrollTop: 0 }, 600);
						setTimeout(function(){ location.reload(false); }, 800);
					}
				});
			}
			if (msg_error) {
				$(".msg_content").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-close"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
				$("#crear").animate({ scrollTop: 0 }, 600);
			}
		});

		$("#btn_edita").click(function(){
			$(".msg_content").empty();
			let form_edita = $("#form_edita");
			var msg_error = "";

			// Se filtra el contenido del formulario
			var nombre = form_edita.find("#nom_servicios_especial").val();
			var tipo_servicio = form_edita.find("#slct_tipo_operacion_").val();

			if (!nombre) {
				msg_error+= '<p>Debe diligenciar el campo <strong>Nombre</strong> para crear el servicio.</p>';
			}
			if (!tipo_servicio) {
				msg_error+= '<p>Debe seleccionar un <strong>Tipo Servicio</strong> para crear el servicio.</p>';
			}

			if (!msg_error) {
				var params = form_edita.serialize();
				// console.log(params);

				$.ajaxSetup({async: false});
				$.ajax({
					url: $("#id_url_ajax").val() + "libs/servicios_especiales_ajax.php?action=editarServicio",
					type: 'POST',
					data: params,
					cache: false,
					dataType: 'json',
					beforeSend	: function(jqXHR, settings){
						$(".nexos-messages").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
					},
					error: function (jqXHR, textStatus, errorThrown){
						msg_error+= "<p>" + jqXHR.responseText + "</p>";
						console.log(jqXHR);
						console.log(textStatus);
						console.log(errorThrown);
					},
					success: function (data, textStatus, jqXHR){
						// console.log(data);
						$(".nexos-messages").empty();
						if (!data.error) {
							$("#editar").show();
							$(".msg_content").html('<div role="alert" class="alert alert-success alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-check"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Proceso terminado! </strong>Se ha editado el registro con éxito.</div></div>');
							$("#editar").animate({ scrollTop: 0 }, 600);
							setTimeout(function(){ location.reload(false); }, 800);
						} else {
							msg_error+= data.error;
						}
					}
				});
				$.ajaxSetup({async: true});
			}
			if (msg_error) {
				$(".msg_content").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-close"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
				$("#crear").animate({ scrollTop: 0 }, 600);
			}
		});

		$("#btn_edita_cuentas").click(function(){
			msg_error = "";
			$(".msg_panel_content").empty();

			var agencia = $("#slct_agencia_");
			var tipo_documento = $("#slct_tipo_documento_");
			var tipo_persona = $("#slct_tipo_persona_");
			var tipo_cuenta = $("#slct_tipo_cuenta_");
			var numero_cuenta = $("#numero_cuenta");
			var nombre_cuenta = $("#nombre_cuenta");

			/***** Se valida la información del formulario *****/
			if (!tipo_documento.val()) {
				msg_error+= `<p>Debe seleccionar un <strong>Tipo Documento</strong> para poder crear la cuenta.</p>`;
			}
			if (!tipo_persona.val()) {
				msg_error+= `<p>Debe seleccionar un <strong>Tipo Persona</strong> para poder crear la cuenta.</p>`;
			}
			if (!tipo_cuenta.val()) {
				msg_error+= `<p>Debe seleccionar un <strong>Naturaleza</strong> para poder crear la cuenta.</p>`;
			}
			if (!numero_cuenta.val()) {
				msg_error+= `<p>Debe diligenciar el campo <strong>${numero_cuenta.attr("placeholder")}</strong> para poder crear la cuenta.</p>`;
			} else if ( numero_cuenta.val().length != numero_cuenta.attr("maxlength") ) {
				msg_error+= `<p>El campo <strong>${numero_cuenta.attr("placeholder")}</strong> debe ser de <strong>${numero_cuenta.attr("maxlength")}</strong> dígitos para poder crear la cuenta.</p>`;
			} else if ( !Number.isInteger( parseInt( numero_cuenta.val() ) ) ) {
				msg_error+= `<p>El campo <strong>${numero_cuenta.attr("placeholder")}</strong> solo debe contener números para poder crear la cuenta.</p>`;
			} else {
				let numero = parseInt(numero_cuenta.val());
				if ( String(numero).length != numero_cuenta.attr("maxlength") ) {
					msg_error+= `<p>El campo <strong>${numero_cuenta.attr("placeholder")}</strong> solo debe contener números para poder crear la cuenta.</p>`;
				}
			} 

			if (!nombre_cuenta.val()) {
				msg_error+= `<p>Debe diligenciar el campo <strong>${nombre_cuenta.attr("placeholder")}</strong> para poder crear la cuenta.</p>`;
			}
			/***** Fin - Se valida la información del formulario *****/

			if (!msg_error) {
				let params = {
					id : _flag_content,
					agencia: agencia.val(),
					tipo_documento : tipo_documento.val(),
					tipo_persona : tipo_persona.val(),
					tipo_cuenta : tipo_cuenta.val(),
					numero_cuenta : numero_cuenta.val(),
					nombre_cuenta : nombre_cuenta.val(),
				};
				// console.log(params);

				$.ajaxSetup({async: false});
				$.ajax({
					url: $("#id_url_ajax").val() + "libs/servicios_especiales_ajax.php?action=crearCuentaContable",
					type: 'POST',
					data: params,
					cache: false,
					dataType: 'json',
					beforeSend	: function(jqXHR, settings){
						$(".msg_content").html('<div id="clock" role="modal" class="modal" style="display: block; background-color: rgba(0,0,0,0.5););"><div style="text-align: center; margin-top: 10%; background-color: #fff; padding: 30px; min-width: 20%; max-width: 60%; border-radius: 5px; border: 1px solid rgba(0,0,0,0.8); margin: 10% auto;"><img src="' + $("#id_url_ajax").val() + 'public/img/nexos_loading.gif" height="60" width="60"><h3>Solicitud en proceso...</h3><h4>Por favor, espere unos segundos.</h4></div></div>');
					},
					error: function (jqXHR, textStatus, errorThrown){
						$("#nexos_messages_costos").html('');
