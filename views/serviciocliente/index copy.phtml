	//eliminar el puntos de entrega que ya existe

	function delete_punto(btn, id) {

		var e = $(".identi").size();

		if (e == 1 && $("#mcantidad_orden").val() != 0) {

			alert('No puede eliminar este bloque');

		} else {

			var codigo = $("#idp" + id + "").val();

			var elimine = {

				codigo: codigo,

				action: 'elininar_puntoentrega'

			};

			$.ajax({

				url: $("#id_url_ajax").val() + "libs/servicio_cliente_ajax.php",

				type: "POST",

				data: elimine,

				dataType: 'json',

				success: function(data) {

					event.preventDefault();

					$('.tr' + id).remove();

					$(this).closest('tr').remove();

				},

				error: function(jqXHR, textStatus, errorThrown) {

					alert('No elimino punto entrega');

					console.log(jqXHR);

					console.log(textStatus);

					console.log(errorThrown);

				}

			});

		}

	}


