	//VALIDAR LA FECHA A CAMBIAR CONTRA LA FECHA DE LA SUBASTA

	function Valida_Subasta() {

		var estado = $("#estado_solicitud").val();

		var numsolicitud = $("#solicitud_servicio").val();

		var dato = {

			estado: estado,

			numsolicitud: numsolicitud,

			action: 'validar_solser_subasta'

		};



		$.ajax({
			url: $("#id_url_ajax").val() + "libs/servicio_cliente_ajax.php",
			type: 'POST',
			data: dato,
			dataType: 'json',
			success: function(data) {
				if (data.result != null) {
					var fecha_subasta = data.result[0].fecha_finaliza + ' ' + data.result[0].hora_finaliza;
					var e = $("#mcantidad_orden").val(); //cant. trae
					var f = $(".identi").val(); //cant. queda
					var i;
					if (f > 0) {
						for (i = 1; i <= e; i++) {
							if (typeof $("#XZ" + i).val() !== 'undefined') {
								if ($("#ppun" + i + "").val() == 'punto recogida') {
									var fecha_cambiar = $("#pfec" + i + "").val() + ' ' +
										$("#ephora" + i + "").val();

									if (fecha_cambiar.valueOf() <
										fecha_subasta.valueOf()) {
										alert('Fecha es menor a la fecha de subasta, no puede cambiar datos');
									} else if (fecha_cambiar.valueOf() > fecha_subasta.valueOf()) {
										alert('La fecha a cambiar es mayor a la subasta, puede actualizar datos');
										Editar_Puntoentrega();

									} else if (fecha_cambiar.valueOf() === fecha_subasta.valueOf()) {

										alert('L fecha a cambiar es igual a la de la subasta no es necesario cambiarlas');

									}
								}
							}
						}
					}
				}
			},
			error: function(jqXHR, textStatus, errorThrown) {
				console.log('no trajo subasta');
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			}
		});
	}



