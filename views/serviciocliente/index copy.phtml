	function nutilidad(elemen, id) {

		$("#ntarifa" + id).val(parseFloat($("#ntarifa" + id).val(), 100).toFixed(2).replace(/(\d)(?=(\d{3})+\.)/g, "$1,")

			.toString());

		var valor = ($("#ntarifa" + id).val()).replace(/,/g, "");

		//utilidad

		var calculo, resta, util, res;

		var acu = 0;

		var variable = 0;

		var f = ($("#nflete" + id).val()).replace(/,/g, "");

		resta = (parseFloat(valor) - parseFloat(f));

		calculo = (parseFloat(resta) / parseFloat(valor));

		res = (parseFloat(calculo) * 100);

		res = res.toFixed(2);

		$("#nutil" + id).val(res);

		$("#nutil" + id).val(parseFloat($("#nutil" + id).val(), 100).toFixed(2).replace(/(\d)(?=(\d{3})+\.)/g, "$1,")

			.toString());

		//rentabilidad

		var rent = (parseFloat(valor) - parseFloat(f));

		$("#nrent" + id).val(rent);

		$("#nrent" + id).val(parseFloat($("#nrent" + id).val(), 100).toFixed(2).replace(/(\d)(?=(\d{3})+\.)/g, "$1,")

			.toString());

		//RECALCULA TOTALES

		recalcula_totales();

	}

	function recalcula_totales() {

		var resum = 0;

		let retari = 0;

		let reutil = 0;

		let rerenta = 0;

		//especiales

		let costoes = 0;

		let taries = 0;

		let utiles = 0;

		let rentaes = 0;



		$(".nfletemer").each(function(index) {

			var valorfle = ($(this).val()).replace(/,/g, "");

			resum = (parseFloat(resum) + parseFloat(valorfle));

			//alert('TOTflete'+resum);

			$("#eno_Tservicio_fle").val(resum);

		});

		$(".ntarifamer").each(function(index) {

			var valortarifa = ($(this).val()).replace(/,/g, "");

			retari = (parseFloat(retari) + parseFloat(valortarifa));

			//alert('TOTtari'+retari);

			$("#eno_Tservicio_transporte").val(retari);

		});

		$(".nutilidad").each(function(index) {

			var valorutil = ($(this).val()).replace(/,/g, "");

			reutil = (parseFloat(reutil) + parseFloat(valorutil));

			//alert('TOTuti'+reutil);

			//$("#eno_Tservicio_uti").val(rerenta);

			$("#eno_Tservicio_ren").val(reutil);

		});

		$(".nrenta").each(function(index) {

			var valorrenta = ($(this).val()).replace(/,/g, "");

			rerenta = (parseFloat(rerenta) + parseFloat(valorrenta));

			//alert('TOTren'+rerenta);

			//$("#eno_Tservicio_ren").val(reutil);

			$("#eno_Tservicio_uti").val(rerenta);

		});

		//total cotizaciones

		var tarimer = ($("#eno_Tservicio_transporte").val()).replace(/,/g, "");

		var tariespe = ($("#eno_Tservicio_especial").val()).replace(/,/g, "");

		var sumatot = (parseFloat(tarimer) + parseFloat(tariespe));

		$("#eno_totalcotizacion").val(sumatot);

		//formatear numeros

		$('#eno_Tservicio_fle').val(parseFloat($('#eno_Tservicio_fle').val(), 100).toFixed(2).replace(/(\d)(?=(\d{3})+\.)/g,

			"$1,").toString());

		$('#eno_Tservicio_transporte').val(parseFloat($('#eno_Tservicio_transporte').val(), 100).toFixed(2).replace(

			/(\d)(?=(\d{3})+\.)/g, "$1,").toString());

		$('#eno_Tservicio_uti').val(parseFloat($('#eno_Tservicio_uti').val(), 100).toFixed(2).replace(/(\d)(?=(\d{3})+\.)/g,

			"$1,").toString());

		$('#eno_Tservicio_ren').val(parseFloat($('#eno_Tservicio_ren').val(), 100).toFixed(2).replace(/(\d)(?=(\d{3})+\.)/g,

			"$1,").toString());

		$('#eno_totalcotizacion').val(parseFloat($('#eno_totalcotizacion').val(), 100).toFixed(2).replace(

			/(\d)(?=(\d{3})+\.)/g, "$1,").toString());

	}
