	function btn_no_editar_estado() {
		//llenar el select
		var n_cotizacion = $("#no_flag_popup").val();
		var estado = {
			num_cotizacion: n_cotizacion,
			action: 'traer_estado'
		};

		$.ajax({
			url: $("#id_url_ajax").val() + "libs/servicio_cliente_ajax.php",
			type: 'POST',
			data: estado,
			dataType: 'json',
			success: function(data) {
				console.log('si trajo el estado');
				console.log(data);
				if (data) {
					//traer el perfil y validar
					var perfil = $("#elperfil").val();
					//quitar el readonly y poner las combinaciones
					$("#eno_estado").removeAttr("readonly");
					var estado = data.result[0].estado;
					var autoriza = data.result[0].estado_autorizado;
					if (estado == 'F1') {
						var name = 'F1-Realizada';
						$("#eno_estado").html('<option value="F2">F2-Entregada</option>' +
							'<option value="F5">F5-Cancelada</option>');
						document.getElementById("estado_actual").innerHTML = name;
					}

					if (estado == 'F3') {
						var name = 'F3-Ganada';
						$("#eno_estado").html(
							'<option value="F4">F4-Perdida</option>' +
							'<option value="F5">F5-Cancelada</option>');
						document.getElementById("estado_actual").innerHTML = name;
					}

					if (estado == 'F2') {
						var name = 'F2-Entregada';
						$("#eno_estado").html(
							'<option value="F3">F3-Ganada</option>' +
							'<option value="F4">F4-Perdida</option>' +
							'<option value="F5">F5-Cancelada</option>');
						document.getElementById("estado_actual").innerHTML = name;
					}

					if (estado == 'F4') {
						var name = 'F4-Perdida';
						$("#eno_estado").html(
							'<option value="F3">F3-Ganada</option>' +
							'<option value="F5">F5-Cancelada</option>');
						document.getElementById("estado_actual").innerHTML = name;
					}

					if (estado == 'F5') {
						var name = 'F5-Cancelada';
						$("#eno_estado").html(
							'<option value="F1">F1-Realizada</option>');
						document.getElementById("estado_actual").innerHTML = name;
					}

					if (estado == 'F6' && autoriza == 'No autorizado') {
						var name = 'F6-Rechazada';
						$("#eno_estado").html(
							'<option value="F1">F1-Realizada</option>' + '<option value="F5">F5-Cancelada</option>');
						document.getElementById("estado_actual").innerHTML = name;
					}
				}
			},
			error: function(jqXHR, textStatus, errorThrown) {
				console.log('no trajo el estado');
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			}
		});
	}

