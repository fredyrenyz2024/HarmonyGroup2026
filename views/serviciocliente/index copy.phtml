	function Elimina_Destinatario(id, conteo, remi) {
		let confirma = window.confirm("¿Desea eliminar el Destinatario " + conteo + " Remitente " + remi + "?");
		if (confirma == true) {
			event.preventDefault();
			$('#collapse' + conteo + remi).remove();
			$('.collapse' + conteo + remi).remove();
			$(this).closest('collapse').remove();
		}
	}

