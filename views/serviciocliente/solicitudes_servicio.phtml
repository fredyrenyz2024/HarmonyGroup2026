<div class="container mt-5">
  <h2 class="mb-4">Datos del Cliente</h2>
  <form>
    <div class="row mb-3">
      <div class="col-md-4">
        <label for="nombre" class="form-label">Nombre</label>
        <input type="text" class="form-control" id="nombre">
      </div>
      <div class="col-md-4">
        <label for="ubicacion" class="form-label">Ubicación</label>
        <input type="text" class="form-control" id="ubicacion">
      </div>
      <div class="col-md-4">
        <label for="telefono" class="form-label">Teléfono</label>
        <input type="text" class="form-control" id="telefono">
      </div>
    </div>
    <div class="row mb-3">
      <div class="col-md-4">
        <label for="correo" class="form-label">Correo</label>
        <input type="email" class="form-control" id="correo">
      </div>
      <div class="col-md-4">
        <label for="tipoDocumento" class="form-label">Tipo de Documento</label>
        <select class="form-select" id="tipoDocumento">
          <option selected>Seleccione...</option>
          <option value="1">Cédula</option>
          <option value="2">Pasaporte</option>
          <option value="3">Otro</option>
        </select>
      </div>
      <div class="col-md-4">
        <label for="ordenCotizacion" class="form-label">Orden de Cotización</label>
        <input type="text" class="form-control" id="ordenCotizacion">
      </div>
    </div>
    <div class="row mb-3">
      <div class="col-md-4">
        <label for="nivel" class="form-label">Ociso 1. Nivel</label>
        <input type="text" class="form-control" id="nivel">
      </div>
      <div class="col-md-4">
        <label for="fechaVerdad" class="form-label">Fecha Verdad</label>
        <input type="date" class="form-control" id="fechaVerdad">
      </div>
      <div class="col-md-4">
        <label for="pertenencia" class="form-label">Pertenencia/Como 2%</label>
        <input type="text" class="form-control" id="pertenencia">
      </div>
    </div>

    <h2 class="mt-5 mb-4">Servicios Especiales</h2>
    <div class="row mb-3">
      <div class="col-md-3">
        <label for="tipoServicio" class="form-label">Tipo Servicio</label>
        <select class="form-select" id="tipoServicio">
          <option selected>Seleccione una opción</option>
          <option value="1">Opción 1</option>
          <option value="2">Opción 2</option>
        </select>
      </div>
      <div class="col-md-2">
        <label for="cantidad" class="form-label">Cantidad</label>
        <input type="number" class="form-control" id="cantidad">
      </div>
      <div class="col-md-2">
        <label for="costoUnitario" class="form-label">Costo Unitario</label>
        <input type="text" class="form-control" id="costoUnitario">
      </div>
      <div class="col-md-2">
        <label for="tarifaUnitaria" class="form-label">Tarifa Unitaria</label>
        <input type="text" class="form-control" id="tarifaUnitaria">
      </div>
      <div class="col-md-2">
        <label for="utilidad" class="form-label">Utilidad</label>
        <input type="text" class="form-control" id="utilidad">
      </div>
    </div>
    <div class="row mb-3">
      <div class="col-md-3">
        <label for="calculoCosto" class="form-label">Calculo Costo</label>
        <input type="text" class="form-control" id="calculoCosto">
      </div>
      <div class="col-md-3">
        <label for="calculoTarifa" class="form-label">Calculo Tarifa</label>
        <input type="text" class="form-control" id="calculoTarifa">
      </div>
      <div class="col-md-3">
        <label for="costoRentabilidad" class="form-label">Costo Rentabilidad%</label>
        <input type="text" class="form-control" id="costoRentabilidad">
      </div>
    </div>

    <h2 class="mt-5 mb-4">Costo del Servicio</h2>
    <div class="row mb-3">
      <div class="col-md-3">
        <label for="valorFlete" class="form-label">Valor Total Costo Flete</label>
        <input type="text" class="form-control" id="valorFlete">
      </div>
      <div class="col-md-3">
        <label for="valorTarifa" class="form-label">Valor Total Tarifa Venta</label>
        <input type="text" class="form-control" id="valorTarifa">
      </div>
      <div class="col-md-3">
        <label for="rentabilidad" class="form-label">Valor Total Rentabilidad %</label>
        <input type="text" class="form-control" id="rentabilidad">
      </div>
      <div class="col-md-3">
        <label for="utilidadTotal" class="form-label">Valor Total Utilidad</label>
        <input type="text" class="form-control" id="utilidadTotal">
      </div>
    </div>

    <h2 class="mt-5 mb-4">Servicios Especiales</h2>
    <div class="row mb-3">
      <div class="col-md-3">
        <label for="valorCosto" class="form-label">Valor Total Costo</label>
        <input type="text" class="form-control" id="valorCosto">
      </div>
      <div class="col-md-3">
        <label for="valorTarifaEspecial" class="form-label">Valor Total Tarifa</label>
        <input type="text" class="form-control" id="valorTarifaEspecial">
      </div>
      <div class="col-md-3">
        <label for="rentabilidadEspecial" class="form-label">Valor Total Rentabilidad %</label>
        <input type="text" class="form-control" id="rentabilidadEspecial">
      </div>
    </div>

    <div class="row mb-3">
      <div class="col-md-6">
        <label for="valorCotizacion" class="form-label">Valor Total Cotización</label>
        <input type="text" class="form-control" id="valorCotizacion" value="0,00" readonly>
      </div>
      <div class="col-md-6">
        <label for="datosAdicionales" class="form-label">Datos Adicionales</label>
        <textarea class="form-control" id="datosAdicionales" rows="3"></textarea>
      </div>
    </div>

    <div class="row mb-3">
      <div class="col-md-6">
        <label for="elaboradoPor" class="form-label">Elaborado por</label>
        <input type="text" class="form-control" id="elaboradoPor" value="Lucas" readonly>
      </div>
      <div class="col-md-6">
        <label for="autorizadoPor" class="form-label">Autorizado por</label>
        <input type="text" class="form-control" id="autorizadoPor">
      </div>
    </div>

    <button type="submit" class="btn btn-primary">Enviar Cotización</button>
  </form>
</div>


