					<input type="text" class="form-control input-sm" name="metodo" id="metodo" placeholder="Método">
				</div>
				<div class="form-group col-xs-12 col-sm-12 col-md-12">
					<label>(*) Título</label>
					<input type="text" class="form-control input-sm" name="titulo" id="titulo" placeholder="Título">
				</div>
				<div class="form-group col-xs-12 col-sm-12 col-md-12 text-right">
					<button id="btn_crea_submenu" type="button" class="btn btn-success md-close">Guardar</button>
				</div>
			</form>
			<div class="row"></div>
		`;

		// Se pinta el contenido de los acordeones 
		$.ajaxSetup({async: false});
		let params = {
			action: 'buscar_submenus',
			id
		}
		$.ajax({
			url: $("#id_url_ajax").val() + "libs/modulos_ajax.php",
			type: 'POST',
			data: params,
			cache: false,
			dataType: 'json',
			beforeSend	: function(jqXHR, settings){
				funct_msg_loading(".nexos-messages");
			},
			error: function (jqXHR, textStatus, errorThrown){
				$(".nexos-messages").empty();
				msg_error+= "<p>" + jqXHR.responseText + "</p>";
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			},
			success: function (data, textStatus, jqXHR){
				$(".nexos-messages").empty();
				if (data.error) { msg_error+= data.error; }
				if (data.result) { submenus = data.result; }
			}
		});

		if (!msg_error) {
			if (submenus.general) {
				let accordion_panel = '';
				submenus.general.forEach(function(element, index){
					let panel_color = 'danger';
					let checked = '';
					if (element.estado == 1) { 
						panel_color = 'success'; 
						checked = 'checked';
					}
					// Se pinta la lista de Líneas de negocio disponibles para el submenú
					let lineas_negocio = `
						<div role="alert" class="alert alert-warning alert-icon alert-icon-border alert-dismissible">
							<div class="icon">
								<span class="mdi mdi-close"></span>
							</div>
							<div class="message">
								<strong>Atención!</strong>
								<p>No se ha registrado líneas de negocip para asignar al submenú <strong>${element.titulo}</strong>.</p>
							</div>
						</div>
					`;

					if (submenus.lineas_negocio[element.id]) {
						let linea_content = '';
						let id_menu = element.id;
						submenus.lineas_negocio[element.id].forEach(function(element, index){
							let checked = '';
							if (element.CUANTOS > 0) { checked = 'checked'; }
							linea_content+= `
								<tr>
									<td>
										<div class="be-checkbox">
											<center>
												<input type="checkbox" class="check_lineas" id="check_${element.id}" value="${element.id}" ${checked}>
												<label for="check_${element.id}"></label>
											</center>
										</div>
									</td>
									<td class="cell-detail">
										<span>${element.nombre}</span>
										<span class="cell-detail-description">${element.descripcion}</span>
									</td>
								</tr>
							`;
						});
						lineas_negocio = `
							<table class="table table-hover">
								<thead>
									<tr class="fila_modulo">
										<th class="col-xs-2 col-sm-2 col-md-2">
											<div class="be-checkbox">
												<center>
													<input type="checkbox" class="check_all_lineas" id="check_all_lineas_${element.id}" value="${element.id}">
													<label for="check_all_lineas_${element.id}"></label>
												</center>
											</div>
										</th>
										<th>Líneas de Negocio</th>
									</tr>
								</thead>
								<tbody>${linea_content}</tbody>
							</table>
						`;
					}

					let slct_cambia_menu = '';
					if (submenus.menus) {
						let _slct_options = '';
						submenus.menus.forEach(function(element, index){
							_slct_options+= `<option value="${element.id}" data-orden="${element.CUANTOS}">(${element.orden}) ${element.nom_menu}</option>`;
						});
						slct_cambia_menu = `
							<label class="col-xs-12 col-sm-6 col-sm-3 control-label">Cambiar menú:</label>
							<div class="col-xs-12 col-sm-6 col-md-9 text-right">
								<select class="form-control input-xs cambiar_menu" data-id_submenu="${element.id}" data-id_menu="${element.id_menu}" data-orden="${element.orden}">
									<option disabled selected>Seleccione</option>
									${_slct_options}
								<select>
							</div>
						`;
					}

					accordion_panel+= `
						<div class="panel panel-default panel-border-color panel-border-color-${panel_color}" id="submenu_${element.id}" data-id="${element.id}">
							<div class="panel-heading">
								<div class="tools">
									<div class="be-checkbox">
										<input type="checkbox" class="check_submenus" id="check_submenu_${element.id}" onclick="cambiar_estado_submenu(this, '${id}', '${nombre}')" value="${element.id}" ${checked}>
										<label for="check_submenu_${element.id}"></label>
									</div>
								</div>
								<h4 class="panel-title">
									<a data-toggle="collapse" data-parent="#accordion1" href="#accordion_${element.id}" class="collapsed" aria-expanded="false"><i class="icon mdi mdi-chevron-down"></i> <strong class="orden">${element.orden}</strong> ${element.titulo}
										<span class="panel-subtitle"></span>
									</a>
								</h4>
							</div>
							<div id="accordion_${element.id}" class="panel-collapse collapse" aria-expanded="false" style="height: 0px;">
								<div class="panel-body">
									<div class="form-group col-xs-12 col-sm-8 col-md-8">${slct_cambia_menu}</div>
									<div class="form-group col-xs-12 col-sm-4 col-md-4 be-checkbox text-right">
										<input type="checkbox" name="check_submenu_e" id="check_submenu_e">
										<label for="check_submenu_e">Editar submenú</label>
									</div>
									<form class="form_edita_submenu">
										<div class="form-group col-xs-12 col-sm-6 col-md-6">
											<label>(*) Menú (carpeta de la vista)</label>
											<input type="text" class="form-control input-sm menu" placeholder="Menú" value="${element.menu}">
										</div>
										<div class="form-group col-xs-12 col-sm-6 col-md-6">
											<label>(*) Método (nombre del archivo en la vista, sin extensión)</label>
											<input type="text" class="form-control input-sm metodo"  placeholder="Método" value="${element.metodo}">
										</div>
										<div class="form-group col-xs-12 col-sm-12 col-md-12">
											<label>(*) Título</label>
											<input type="text" class="form-control input-sm titulo" placeholder="Título" value="${element.titulo}">
										</div>
										<div class="form-group col-xs-12 col-sm-12 col-md-12 text-right">
											<button type="button" class="btn btn-success md-close btn_edita_submenu" data-id="${element.id}">Guardar</button>
										</div>
									</form>
									<div class="row"></div>
									${lineas_negocio}
								</div>
							</div>
						</div>
					`;
				});
				accordion = `
					<h4>Submenús de ${nombre}</h4>
					<div id="accordion1" class="panel-group accordion">
						${accordion_panel}
					</div>
				`;
			}
		}
		if (msg_error) {
			funct_msg_error("#nexos_messages_submenu", msg_error); 
			$("#cambia_estado").animate({ scrollTop: 0 }, 600);
		}
		$.ajaxSetup({async: true});

		let content = form_crear + accordion;

		$("#submenu_content").html(content);

		/***** Funciones para crear el submenú *****/
		$("#form_crea_submenu").hide();
		$("#check_submenu").change(function(){
			$("#form_crea_submenu").fadeToggle("slow");
		});

		// Función para crear el submenú
		$("#btn_crea_submenu").click(function(){
			$("#nexos_messages_submenu").empty();
			let msg_error = '';
			let form = $(this).closest("#form_crea_submenu");
			let orden = $("#accordion1").find(".panel").length + 1

			$.ajaxSetup({async: false});
			form.find(".form-control").each(function(){
				if(!$(this).val()){
					msg_error+= `<p>Debe diligenciar el campo <strong>${$(this).attr("placeholder")}</strong> para poder crear el submenú.</p>`;
				}
			});
			if(!msg_error){
				let params = {
					action: "crear_submenu",
					id_menu: $("#id_menu").val(),
					menu: form.find("#menu").val(),
					metodo: form.find("#metodo").val(),
					titulo: form.find("#titulo").val(),
					orden
				};
				$.ajax({
					url: $("#id_url_ajax").val() + "libs/modulos_ajax.php",
					type: 'POST',
					data: params,
					cache: false,
					dataType: 'json',
					beforeSend	: function(jqXHR, settings){
						funct_msg_loading(".nexos-messages");
					},
					error: function (jqXHR, textStatus, errorThrown){
						$(".nexos-messages").empty();
						msg_error+= "<p>" + jqXHR.responseText + "</p>";
						console.log(jqXHR);
						console.log(textStatus);
						console.log(errorThrown);
					},
					success: function (data, textStatus, jqXHR){
						$(".nexos-messages").empty();
						// console.log(data);
					}
				});
			}
			if (!msg_error) {
				cargarDatosSubmenu(id, nombre);
				funct_msg_success("#nexos_messages_submenu", `<p>Se ha creado el registro con éxito.</p>`); 
				$("#submenu").animate({ scrollTop: 0 }, 600);

				$("#nexos_messages_submenu").delay(1500).fadeOut(1000, function(){
					$("#nexos_messages_submenu").empty();
					$("#nexos_messages_submenu").show();
				});
			}
			if (msg_error) {
				funct_msg_error("#nexos_messages_submenu", msg_error); 
				$("#submenu").animate({ scrollTop: 0 }, 600);
			}
			$.ajaxSetup({async: true});
		});
		/***** Fin - Funciones para crear el submenú *****/

		/***** Funciones para editar el submenú *****/
		$(".form_edita_submenu").hide();
		$("#check_submenu_e").change(function(){
			$(".form_edita_submenu").fadeToggle("slow");
		});

		// Función para editar el submenú
		$(".btn_edita_submenu").click(function(){
			$("#nexos_messages_submenu").empty();
			let msg_error = '';
			let form = $(this).closest(".form_edita_submenu");

			$.ajaxSetup({async: false});
			form.find(".form-control").each(function(){
				if(!$(this).val()){
					msg_error+= `<p>Debe diligenciar el campo <strong>${$(this).attr("placeholder")}</strong> para poder editar el submenú.</p>`;
				}
			});
			if(!msg_error){
				let params = {
					action: "editar_submenu",
					id: $(this).data("id"),
					menu: form.find(".menu").val(),
					metodo: form.find(".metodo").val(),
					titulo: form.find(".titulo").val(),
				};
				$.ajax({
					url: $("#id_url_ajax").val() + "libs/modulos_ajax.php",
					type: 'POST',
					data: params,
					cache: false,
					dataType: 'json',
					beforeSend	: function(jqXHR, settings){
						funct_msg_loading(".nexos-messages");
					},
					error: function (jqXHR, textStatus, errorThrown){
						$(".nexos-messages").empty();
						msg_error+= "<p>" + jqXHR.responseText + "</p>";
						console.log(jqXHR);
						console.log(textStatus);
						console.log(errorThrown);
					},
					success: function (data, textStatus, jqXHR){
						$(".nexos-messages").empty();
						// console.log(data);
					}
				});
			}
			if (!msg_error) {
				cargarDatosSubmenu(id, nombre);
				funct_msg_success("#nexos_messages_submenu", `<p>Se ha ediatdo el registro con éxito.</p>`); 
				$("#submenu").animate({ scrollTop: 0 }, 600);

				$("#nexos_messages_submenu").delay(1500).fadeOut(1000, function(){
					$("#nexos_messages_submenu").empty();
					$("#nexos_messages_submenu").show();
				});
			}
			if (msg_error) {
				funct_msg_error("#nexos_messages_submenu", msg_error); 
				$("#submenu").animate({ scrollTop: 0 }, 600);
			}
			$.ajaxSetup({async: true});
		});
		/***** Fin - Funciones para editar el submenú *****/

		/***** Funciones para el ordenamiento del submenú de forma arrastrable *****/
		var fixHelperModified = function(e, div) {
			var $originals = div.children();
			var $helper = div.clone();
			$helper.children().each(function(index) {
				$(this).width($originals.eq(index).width())
			});
			return $helper;
		},
		updateIndex = function(e, ui) {
			let msg_error = '';
			let array = new Array();
			$('div.panel', ui.item.parent()).each(function (i) {
				array.push({
					id: $(this).data("id"),
					orden: (i + 1)
				});
				$(this).find(".orden").text(i + 1);
			});

			$.ajaxSetup({async: false});
			var params = {
				action: "ordenar_submenu",
				array,
			};
			$.ajax({
				url: $("#id_url_ajax").val() + "libs/modulos_ajax.php",
				type: 'POST',
				data: params,
				cache: false,
				dataType: 'json',
				beforeSend	: function(jqXHR, settings){
					funct_msg_loading(".nexos-messages");
				},
				error: function (jqXHR, textStatus, errorThrown){
					$(".nexos-messages").empty();
					msg_error+= "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function (data, textStatus, jqXHR){
					$(".nexos-messages").empty();
					// console.log(data);
					if (data.error) { msg_error+= data.error; }
				}
			});
			if (msg_error) {
				funct_msg_error("#nexos_messages_submenu", msg_error); 
				$("#submenu").animate({ scrollTop: 0 }, 600);
			}
			$.ajaxSetup({async: false});
		};

		$("#accordion1").sortable({
			helper: fixHelperModified,
			stop: updateIndex
		}).disableSelection();
		/***** Fin - Funciones para el ordenamiento del submenú de forma arrastrable *****/

		/***** Funciones para el asignamineto de las lineas de negoscio al submenú *****/
		// Función para modificar el submenu de forma general del submenú
		$(".check_all_lineas").click(function(){
			let id_submenu = $(this).val();
			let array = new Array();
			let lineas_negocio = $(this).parents(".table").find(".check_lineas");
			if ( $(this).is(":checked") ) { 
				lineas_negocio.prop("checked", true); 
				lineas_negocio.each(function(){
					array.push({ id_modulo: $(this).val() });
				});
			} 
			else { lineas_negocio.prop("checked", false); }
			asigna_modulo(id_submenu, array);
		});

		// Función para modificar el submenu de forma individual 
		$(".check_lineas").change(function(){
			let id_submenu = $(this).parents(".table").find(".check_all_lineas").val();
			let array = new Array();
			let lineas_negocio = $(this).parents(".table").find(".check_lineas");

			lineas_negocio.each(function(){
				if ( $(this).is(":checked") ) {
					array.push({ id_modulo: $(this).val() });
				}
			});
			asigna_modulo(id_submenu, array);
		});

		function asigna_modulo(id_submenu, array){
			let msg_error = '';
			$.ajaxSetup({async: false});
			let params = {
				action: 'asigna_modulo',
				id_submenu,
				array,
				id_usuario: $("#data_user").data("id")
			}
			$.ajax({
				url: $("#id_url_ajax").val() + "libs/modulos_ajax.php",
				type: 'POST',
				data: params,
				cache: false,
				dataType: 'json',
				beforeSend	: function(jqXHR, settings){
					funct_msg_loading(".nexos-messages");
				},
				error: function (jqXHR, textStatus, errorThrown){
					$(".nexos-messages").empty();
					msg_error+= "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function (data, textStatus, jqXHR){
					$(".nexos-messages").empty();
					// console.log(data);
					if(data.error) { msg_error+= data.error }
				}
			});
			if (!msg_error) {
				funct_msg_success("#nexos_messages_submenu", `<p>Se ha actualizado el registro con éxito.</p>`); 
				$("#submenu").animate({ scrollTop: 0 }, 600);

				$("#nexos_messages_submenu").delay(1500).fadeOut(1000, function(){
					$("#nexos_messages_submenu").empty();
					$("#nexos_messages_submenu").show();
				});
			}
			if (msg_error) {
				funct_msg_error("#nexos_messages_submenu", msg_error); 
				$("#submenu").animate({ scrollTop: 0 }, 600);
			}
			$.ajaxSetup({async: true});
		}
		/***** Fin - Funciones para el asignamineto de las lineas de negoscio al submenú *****/

		/***** Funciones para cambis de menu al súbmenu *****/
		$(".cambiar_menu").change(function(){
			let msg_error = '';
			let params = {
				action: 'cambiar_menu',
				id_submenu: $(this).data("id_submenu"),
				id_menu: $(this).val(),
				orden: $(this).find("option:selected").data("orden"),
				id_menu_otros: $(this).data("id_menu"),
				orden_otros: $(this).data("orden")
			}
			$.ajaxSetup({async: false});
			$.ajax({
				url: $("#id_url_ajax").val() + "libs/modulos_ajax.php",
				type: 'POST',
				data: params,
				cache: false,
				dataType: 'json',
				beforeSend	: function(jqXHR, settings){
					funct_msg_loading(".nexos-messages");
				},
				error: function (jqXHR, textStatus, errorThrown){
					$(".nexos-messages").empty();
					msg_error+= "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function (data, textStatus, jqXHR){
					$(".nexos-messages").empty();
					// console.log(data);
					if(data.error) { msg_error+= data.error }
				}
			});
			if (!msg_error) {
				cargarDatosSubmenu(id, nombre);
				funct_msg_success("#nexos_messages_submenu", `<p>Se ha actualizado el registro con éxito.</p>`); 
				$("#submenu").animate({ scrollTop: 0 }, 600);

				$("#nexos_messages_submenu").delay(1500).fadeOut(1000, function(){
					$("#nexos_messages_submenu").empty();
					$("#nexos_messages_submenu").show();
				});
			}
			if (msg_error) {
				funct_msg_error("#nexos_messages_submenu", msg_error); 
				$("#submenu").animate({ scrollTop: 0 }, 600);
			}
			$.ajaxSetup({async: true});
		});
		/***** Fin - Funciones para cambis de menu al súbmenu *****/
	}

	// Se crea la funcion para cambiar el estado del submenu
	function cambiar_estado_submenu(element, id, nombre){
		let estado = 0;
		if( element.checked ){ estado = 1; }
		let params = {
			action: 'cambiar_estado_submenu',
			id: element.value,
			estado
		}
		$.ajax({
			url: $("#id_url_ajax").val() + "libs/modulos_ajax.php",
			type: 'POST',
			data: params,
			cache: false,
			dataType: 'json',
			beforeSend	: function(jqXHR, settings){
				funct_msg_loading(".nexos-messages");
			},
			error: function (jqXHR, textStatus, errorThrown){
				$(".nexos-messages").empty();
				msg_error+= "<p>" + jqXHR.responseText + "</p>";
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			},
			success: function (data, textStatus, jqXHR){
				$(".nexos-messages").empty();
				cargarDatosSubmenu(id, nombre);
			}
		});
	}	

</script>
