			if (!msg_error) {
				funct_msg_success("#nexos_messages_editar", `<p>Se ha editado el registro con éxito</p>`);
				$("#editar").animate({ scrollTop: 0 }, 600);
				setTimeout(function() { location.reload(false); }, 800);
			}
			if (msg_error) {
				funct_msg_error("#nexos_messages_editar", msg_error); 
				$("#editar").animate({ scrollTop: 0 }, 600);
			}
			$.ajaxSetup({async: true});
		});

		/***** Funciones para el ordenamiento del menú de forma arrastrable *****/
		var fixHelperModified = function(e, tr) {
			var $originals = tr.children();
			var $helper = tr.clone();
			$helper.children().each(function(index) {
				$(this).width($originals.eq(index).width())
			});
			return $helper;
		},
		updateIndex = function(e, ui) {
			let msg_error = '';
			let array = new Array();
			$('td.index', ui.item.parent()).each(function (i) {
				array.push({
					id: $(this).data("id"),
					orden: (i + 1)
				});
				let col_status = `
					<center>
						<span class="icon mdi mdi-dot-circle"></span>
					</center>
				`;
				$(this).html(col_status);
				$(this).closest("tr").find(".orden").text(i + 1);
			});

			$.ajaxSetup({async: false});
			var params = {
				action: "ordenar_menu",
				array,
			};
			$.ajax({
				url: $("#id_url_ajax").val() + "libs/modulos_ajax.php",
				type: 'POST',
				data: params,
				cache: false,
				dataType: 'json',
				beforeSend	: function(jqXHR, settings){
					funct_msg_loading(".nexos-messages");
				},
				error: function (jqXHR, textStatus, errorThrown){
					$(".nexos-messages").empty();
					msg_error+= "<p>" + jqXHR.responseText + "</p>";
					console.log(jqXHR);
					console.log(textStatus);
					console.log(errorThrown);
				},
				success: function (data, textStatus, jqXHR){
					$(".nexos-messages").empty();
					// console.log(data);
					if (data.error) { msg_error+= data.error; }
				}
			});
			if (msg_error) {
				funct_msg_error(".nexos-messages", msg_error); 
				$("html, body").animate({ scrollTop: 0 }, 600);
			}
			$.ajaxSetup({async: false});
		};

		$(".table tbody").sortable({
			helper: fixHelperModified,
			stop: updateIndex
		}).disableSelection();
		/***** Fin - Funciones para el ordenamiento del menú de forma arrastrable *****/
	});

	function formEditar(id, nombre, descripcion){
		if (id != $("#id_editar").val() ) {
			$("#id_editar").val(id);
