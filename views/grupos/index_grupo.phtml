	function Registrar_Grupo() {
		var url2 = $("#id_url_ajax").val() + "libs/trafico2_ajax.php";
		var data = null;
		data = new FormData();
		var cliente = $("#gr_cliente").val();
		var grupo = $("#gr_name").val();
		data.append("accion", 'insertar_grupo');
		data.append("cliente", cliente);
		data.append("nomgrupo", grupo);

		$.ajax({
			url: url2,
			type: 'POST',
			data: data,
			cache: false,
			processData: false, // Don't process the files
			contentType: false, // Set content type to false as jQuery will tell the server its a query string request
			dataType: 'json',
			success: function(data, textStatus, jqXHR) {
				insertcontac();
				// alert('!!Registro Vehiculo exitosamente!!!');
			},
			error: function(jqXHR, textStatus, errorThrown) {
				console.log('no inserto contactos del proveedor');
				console.log(jqXHR);
				console.log(textStatus);
