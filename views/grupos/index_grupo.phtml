		$("#btn_guadargrupo").click(function() {
			var msg_error = '';
			if (!$("#gr_cliente").val()) {
				msg_error += "<p>Debe diligenciar el campo <strong>Cliente</strong> para poder registrar .</p>";
			}
			if (!$("#gr_name").val()) {
				msg_error += "<p>Debe diligenciar el campo <strong>Nombre del grupo</strong> para poder registrar.</p>";
			}
			var cant = $("#cont_contactos").val();
			if (cant > 0) {
				var i;
				for (i = 1; i <= cant; i++) {
					if (typeof $("#sy" + i).val() !== 'undefined') {
						if (!$("#nombres" + i + "").val()) {
							msg_error += "<p>Debe diligenciar el campo <strong>Nombre</strong>en el bloque Contactos para poder registrar.</p>";
						}

						if (!$("#correo" + i + "").val()) {
							msg_error += "<p>Debe diligenciar el campo <strong>Correo</strong>en el bloque Contactos para poder registrar.</p>";
						}
					}
				}
			}
			if ($(".identi").size() <= 0) {
				msg_error += "<p>Debe diligenciar <strong>Mínimo 1 bloque de contacto </strong> para poder registrar.</p>";
			}
			if (!msg_error) {
				Registrar_Grupo();
			} else {
				$("#msg_creargrupo").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-close"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
				$("#crear_grupo").animate({
					scrollTop: 0
				}, 600);
			}
		});

		$("#btn_updategrupo").click(function() {
			var msg_error = '';
			var e = $(".idene").size(); //bloque actual
			var me = $(".identie").size();
			if (e <= 0 && me <= 0) {
				msg_error += "<p>Debe haber Mínimo <strong>Bloque de contactos</strong> para poder actualizar .</p>";
			}
			//anteriores
			if (e > 0) {
				var t;
				var a = $("#ecant_bloque").val();
				for (t = 1; t <= a; t++) {
					if (typeof $("#sd" + t).val() !== 'undefined') {
						if (!$("#nomc" + t + "").val()) {
							msg_error += "<p>Debe ingresar el campo <strong>Nombre " + t + "</strong> en contactos actuales para poder actualizar .</p>";
						}
						if (!$("#emailc" + t + "").val()) {
							msg_error += "<p>Debe ingresar el campo <strong>email " + t + "</strong> en contactos actuales  para poder actualizar .</p>";
						}
					}
				}
			}
			//nuevos
			//bloque nuevo
			if (me > 0) {
				var k;
				var a = $("#mcontacto").val();
				for (k = 1; k <= a; k++) {
					if (typeof $("#se" + k).val() !== 'undefined') {
						if (!$("#nombrese" + k + "").val()) {
							msg_error += "<p>Debe ingresar el campo <strong>Nombre " + k + "</strong> en contactos nuevos para poder actualizar .</p>";
						}
						if (!$("#correoe" + k + "").val()) {
							msg_error += "<p>Debe ingresar el campo <strong> correo " + k + "</strong> en contactos nuevos para poder actualizar .</p>";
						}
					}
				}
			}

			if (!msg_error) {
				Actualizar_Grupo();
			} else {
				$("#msg_edicion_grupo").html('<div role="alert" class="alert alert-danger alert-icon alert-icon-border alert-dismissible"><div class="icon"><span class="mdi mdi-close"></span></div><div class="message"><button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="mdi mdi-close"></span></button><strong>Error!</strong>' + msg_error + '</div></div>');
				$("#edite_grupo").animate({
					scrollTop: 0
				}, 600);
			}

		});

	});

	var url = $("#id_url_ajax").val() + "libs/grupo_ajax.php";

	function consultar_grupos() {
		var group = {
			action: 'consultar_grupo'
		};
		$("#nomgrupo").html('<option value="">Seleccione</option>');
		$.ajax({
			url: url,
			type: 'POST',
			data: group,
			dataType: 'json',
			success: function(data) {
				if (data) {
					data.result.forEach(function(element, index) {
						/*$("#nomgrupo").append('<option value="'+element.nombre_grupo+'">'+element.nombre_grupo+'</option>');*/
						$("#nomgrupo").append('<option value="' + element.id + '">' + element.nombre + ' - ' + element.documento + '</option>');
					});
				}
			},
			error: function(jqXHR, textStatus, errorThrown) {
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			}
		});
	}

