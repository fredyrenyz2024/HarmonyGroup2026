	//ACTUALIZAR
	function Actualizar_Grupo() {

		var url2 = $("#id_url_ajax").val() + "libs/trafico2_ajax.php";
		var data = null;
		data = new FormData();
		data.append("accion", 'actualizar_grupo');
		//Actualizar los actuales
		var cliente = $("#e_cliente").val();
		var nomgrupo = $("#e_grupo").val();
		var idgrupo = $("#idgrupo").val();
		data.append("cliente", cliente);
		data.append("nomgrupo", nomgrupo);
		data.append("idgrupo", idgrupo);
		var e = $(".idene").size(); //bloque actual
		var me = $(".identie").size();
		if (e > 0) {
			var t;
			var a = $("#ecant_bloque").val();
			for (t = 1; t <= a; t++) {
				data.append("aid", $("#idc" + t + "").val());
				data.append("aname", $("#nomc" + t + "").val());
				data.append("atel", $("#telc" + t + "").val());
				data.append("acargo", $("#cargoc" + t + "").val());
				data.append("aarea", $("#areac" + t + "").val());
				data.append("aemail", $("#emailc" + t + "").val());
				data.append("actual", 9);
				data.append("nuevo", 1);
			}
		}
		//Insertar los nuevos
		if (me > 0) {
			var k;
			var a = $("#mcontacto").val();
			for (k = 1; k <= a; k++) {
				if (typeof $("#se" + k).val() !== 'undefined') {
					data.append("nnombre", $("#nombrese" + k + "").val());
					data.append("ncargo", $("#cargoe" + k + "").val());
					data.append("nfijo", $("#fijoe" + k + "").val());
					data.append("narea", $("#areae" + k + "").val());
					data.append("ncorreo", $("#correoe" + k + "").val());
					data.append("nuevo", 8);
					data.append("actual", 1);
				}
			}
		}

		$.ajax({
			url: url2,
			type: 'POST',
			data: data,
			cache: false,
			processData: false, // Don't process the files
			contentType: false, // Set content type to false as jQuery will tell the server its a query string request
			dataType: 'json',
			success: function(data, textStatus, jqXHR) {
				alert('!!Actualizo Datos exitosamente!!!');
				location.reload();
			},
			error: function(jqXHR, textStatus, errorThrown) {
				console.log('no inserto contactos del proveedor');
				console.log(jqXHR);
				console.log(textStatus);
				console.log(errorThrown);
			}
		});
	}


	function insertcontac() {
		var data = null;
