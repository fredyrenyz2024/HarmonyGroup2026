					data.append("accion", 'insertar_contactos');
					data.append("nombre", nom);
					data.append("cargo", cargo);
					data.append("tele", tel);
					data.append("area", area);
					data.append("correo", correo);
					data.append("cliente", cliente);

					$.ajax({
						url: url2,
						type: 'POST',
