var url =$("#id_url_ajax").val() + "libs/grupo_ajax.php";

function registrar_novedad(){
	var novedad=$("#cnovedad").val();
	var inter=$("#cinterpretar").val();
	var color=$("#ccolor").val();
	var alerta=$("#cgenera_alerta").val();
	var ccodigo=$("#ccodigo").val();
	var ccalarma=$("#ccalarma").val();
	var ccsolicita=$("#ccsolicita").val();

	var envio={
		novedad1:novedad,
		inter1:inter,
		color:color,
		alerta1:alerta,
		codigo1:ccodigo,
		alarma1:ccalarma,
		solicita1:ccsolicita,
		action:'registrarnovedad'
	};
	$.ajax({
		url:url,
		type:'POST',
		data:envio,
		dataType:'json',
		success: function(data){
			alert('Datos Registrados Exitosamente!!');
			location.reload();
		},	
		error:function(jqXHR, textStatus, errorThrown){
			console.log(jqXHR);
			console.log(textStatus);
			console.log(errorThrown);
			}	
	});	
}

function editar_novedad(){
	var nove=$("#enovedad").val();
	var color=$("#ecolor").val();
	var inter=$("#einterpretar").val();
	var alerta=$("#egenera_alerta").val();
	var alarma=$("#egenera_alarma").val();
	var solicita=$("#esolicita").val();
	var idt=$("#eidtb").val();
	var codigo=$("#ecodigo").val();

	var edita={
		nove:nove,
		color:color,
		inter:inter,
		alerta:alerta,
		alarma:alarma,
		solicita:solicita,
		idt:idt,
		codigo:codigo,
		action:'actualice_novedad'
	};

	$.ajax({
		url:url,
		type:'POST',
		data:edita,
		dataType:'json',
		success: function(data){
			alert('Datos Registrados Exitosamente!!');
			location.reload();
		},	
		error:function(jqXHR, textStatus, errorThrown){
			console.log(jqXHR);
			console.log(textStatus);
			console.log(errorThrown);
			}	
	});	

}

function solicitudes_novedad(){
	var nom=$("#nomnovedad").val();
	if(nom==''){
		alert('Debe registrar el campo seleccicona la novedad');
	}else{
		var buscar={
			nom:nom,
			action:'buscar_novedad'
		};

		$.ajax({
			url:url,
			type:'POST',
			data:buscar,
			dataType:'json',
			success: function(data){
				if(data){
					var cont=0;
					data.result.forEach(function(element,index){
						cont++;
						var btn_editar;
						btn_editar='<button type="button"  class="btn btn-secondary btn btn-sm mdi mdi-edit" id="btn_edi'+cont+'" data-toggle="modal" data-target="#versolicitud" data-id="'+element.id+'" data-placement="top"  title="Editar novedad"></button>';
						var col="<td class='nexos-txt-success'>"+
							"<center><span class='mdi mdi-dot-circle icon'></span></center>"+
								"</td>";

							var descripcion_cliente='';	
						if(element.interpretacion!=null){
							descripcion_cliente=element.interpretacion;
						}else{
							descripcion_cliente='';
						}	
						$("#body_esconder").append('<tr>'+
							col+
							'<td>'+element.novedad+'</td>'+
							'<td>'+descripcion_cliente+'</td>'+
							'<td>'+btn_editar+'</td></tr>');

						$("#btn_edi"+cont+"").click(function(){
							var id=$(this).attr('data-id');
							var traer={
								id:id,
								action:'traer_aedicion'
							};
							$.ajax({
			                  url:url,
			                  type:'POST',
			                  data:traer,
			                  dataType:'json',
			                  success: function(data){
			                  	if(data){
			           
			                  		$("#enovedad").val(data.result[0].novedad);
			                  		$("#ecodigo").val(data.result[0].codigo);
			                  		//$("#").val(data.result[0].);

			                  		if(data.result[0].genera_alerta=='NO'){
			                  			$("#egenera_alerta").html('<option value="NO">NO</option>'+
			                  				'<option value="SI">SI</option>');
			                  		}
			                  		if(data.result[0].genera_alerta=='SI'){
			                  			$("#egenera_alerta").html(
			                  				'<option value="SI">SI</option>'+
			                  				'<option value="NO">NO</option>');
			                  		}
			                  		if(data.result[0].color_alerta==0){
			                  			$("#ecolor").html('<option value="0">Seleccione</option>'+
			                  				'<option value="1">Grave</option>'+
			                  				'<option value="2">Normal</option>'+
			                  				'<option value="3">Leve</option>'+
			                  				'<option value="4">Urgente</option>');
			                  		}
			                  		if(data.result[0].color_alerta==1){
			                  			$("#ecolor").html(
			                  				'<option value="2">Normal</option>'+
			                  				'<option value="3">Leve</option>'+
			                  				'<option value="4">Urgente</option>');
			                  		}
			                  		if(data.result[0].color_alerta==2){
			                  			$("#ecolor").html('<option value="2">Normal</option>'+'<option value="1">Grave</option>'+
			                  				'<option value="3">Leve</option>'+
			                  				'<option value="4">Urgente</option>');
			                  		}

			                  		if(data.result[0].color_alerta==3){
			                  			$("#ecolor").html('<option value="3">Leve</option>'+'<option value="1">Grave</option>'+
			                  				'<option value="2">Normal</option>'+
			                  				'<option value="4">Urgente</option>');
			                  		}

			                  		if(data.result[0].color_alerta==4){
			                  			$("#ecolor").html('<option value="4">Urgente</option>'+'<option value="1">Grave</option>'+
			                  				'<option value="2">Normal</option>'+
			                  				'<option value="3">Leve</option>');
			                  		}
			                  		$("#einterpretar").val(data.result[0].interpretacion);
			                  		
			                  		if(data.result[0].alarma=='NO'){
			                  			$("#egenera_alarma").html(
			                  				'<option value="NO">NO</option>'+
			                  				'<option value="SI">SI</option>');
			                  		}
			                  		if(data.result[0].alarma=='SI'){
